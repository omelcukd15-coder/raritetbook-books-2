{"id":"komarov-viskala","slug":"komarov-viskala","shard":1,"title":"Вискала","altTitles":[],"author":"Петр Степанович Комаров","authorShort":"П. С. Комаров","authorSlug":"komarov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1939","editionYear":"1939","description":"Комаров П. С. Избранное: Стихотворения, поэмы","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%92%D0%B8%D1%81%D0%BA%D0%B0%D0%BB%D0%B0_%28%D0%9A%D0%BE%D0%BC%D0%B0%D1%80%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1939)","downloadAllowed":true,"fb2Url":"/archive/books/komarov/komarov-viskala/original.fb2","coverUrl":"/archive/books/komarov/komarov-viskala/cover.webp","stats":{"chaptersCount":7,"wordsCount":1248,"charsCount":7541,"readingMinutes":7},"toc":[{"id":"chapter-1","title":"Глава 1"},{"id":"chapter-2","title":"1"},{"id":"chapter-3","title":"2"},{"id":"chapter-4","title":"3"},{"id":"chapter-5","title":"4"},{"id":"chapter-6","title":"5"},{"id":"chapter-7","title":"6"}],"chapters":[{"id":"chapter-1","title":"Глава 1","content":[{"type":"paragraph","text":"Комаров П. С. Избранное: Стихотворения, поэмы."},{"type":"paragraph","text":"М.: Сов. Россия, 1982."},{"type":"paragraph","text":"ВИСКАЛА 1"},{"type":"paragraph","text":"(Нивхская сказка)"},{"type":"paragraph","text":"1 Вискала — богатырь."}]},{"id":"chapter-2","title":"1","content":[{"type":"paragraph","text":"В глубоком ущелье,"},{"type":"paragraph","text":"Меж голых заоблачных скал,"},{"type":"paragraph","text":"Куда и орлы не летали,"},{"type":"paragraph","text":"В удушливом логове"},{"type":"paragraph","text":"Злой поселился Ыкиз."},{"type":"paragraph","text":"На лапы кривые —"},{"type":"paragraph","text":"Пургой перекрученный дуб —"},{"type":"paragraph","text":"Он голову клал осторожно,"},{"type":"paragraph","text":"И пеклом казалась"},{"type":"paragraph","text":"Гремучая желтая пасть."},{"type":"paragraph","text":"Он был ненасытен."},{"type":"paragraph","text":"Ворочая кремни зубов,"},{"type":"paragraph","text":"Как две остроги исполинских,"},{"type":"paragraph","text":"Мгновенно и жадно"},{"type":"paragraph","text":"Оленя проглатывал он."},{"type":"paragraph","text":"Завидя добычу,"},{"type":"paragraph","text":"Зеленым сверкали огнем"},{"type":"paragraph","text":"Глаза его — озеро в тине."},{"type":"paragraph","text":"Он жил только ночью, —"},{"type":"paragraph","text":"Слепил его солнечный свет."},{"type":"paragraph","text":"И слышали нивхи,"},{"type":"paragraph","text":"Как глухо в полуночной мгле"},{"type":"paragraph","text":"Вздыхал он — и скалы дрожали,"},{"type":"paragraph","text":"Всю ночь до рассвета"},{"type":"paragraph","text":"Над ними клубился туман."},{"type":"paragraph","text":"Несметные духи"},{"type":"paragraph","text":"Шныряли по нивхской земле —"},{"type":"paragraph","text":"Немые посланцы Ыкиза."},{"type":"paragraph","text":"О, горе вам, нивхи!"},{"type":"paragraph","text":"О, горе вам, люди тайги!"},{"type":"paragraph","text":"По следу, как тени"},{"type":"paragraph","text":"Голодных, некормленых псов,"},{"type":"paragraph","text":"Ползли с воспаленными ртами"},{"type":"paragraph","text":"За нартой охотника"},{"type":"paragraph","text":"Черные бестии зла."},{"type":"paragraph","text":"И тот, кто с охоты"},{"type":"paragraph","text":"Лисицу и белку принес,"},{"type":"paragraph","text":"Наутро их больше не видел."},{"type":"paragraph","text":"…На камнях замшелых"},{"type":"paragraph","text":"Ворочался алчный Ыкиз."},{"type":"paragraph","text":"Он жил только ночью,"},{"type":"paragraph","text":"А ночь иногда не длинней,"},{"type":"paragraph","text":"Чем след кабарги к водопою."},{"type":"paragraph","text":"— Да будет иначе! —"},{"type":"paragraph","text":"Он злобно тогда прошипел."},{"type":"paragraph","text":"— Велик и могуч я,"},{"type":"paragraph","text":"Мне равного нет на земле!"},{"type":"paragraph","text":"На страх и проклятие людям"},{"type":"paragraph","text":"Я землю и воду"},{"type":"paragraph","text":"Окутаю вечною тьмой!"},{"type":"paragraph","text":"В нем злоба кипела,"},{"type":"paragraph","text":"Как смолы в могильной сосне."},{"type":"paragraph","text":"И в логове стал выжидать он,"},{"type":"paragraph","text":"Чтоб солнце под вечер"},{"type":"paragraph","text":"Достать ему с каменных скал."},{"type":"paragraph","text":"И вот он поднялся,"},{"type":"paragraph","text":"И тысячи духов за ним,"},{"type":"paragraph","text":"Цепляясь за выступы камня,"},{"type":"paragraph","text":"Полезли на скалы,"},{"type":"paragraph","text":"Где даже орел не бывал."},{"type":"paragraph","text":"Свинцовые тучи"},{"type":"paragraph","text":"На небо нахлынули враз,"},{"type":"paragraph","text":"И грохотом грозного грома"},{"type":"paragraph","text":"Огромные горы"},{"type":"paragraph","text":"До острых вершин сотрясло."},{"type":"paragraph","text":"Столетние пихты"},{"type":"paragraph","text":"С корнями летели во мглу,"},{"type":"paragraph","text":"Трещали и лопались кедры,"},{"type":"paragraph","text":"Как стебли былинок,"},{"type":"paragraph","text":"Гонимые в сумрак песков."},{"type":"paragraph","text":"Земля пошатнулась,"},{"type":"paragraph","text":"Меж сопок стонала река,"},{"type":"paragraph","text":"И люди попадали в юртах,"},{"type":"paragraph","text":"И звери от страха"},{"type":"paragraph","text":"В глубокие норы ушли."},{"type":"paragraph","text":"А скопища духов,"},{"type":"paragraph","text":"Что вел в наступленье Ыкиз,"},{"type":"paragraph","text":"Скрежеща, стеная и корчась"},{"type":"paragraph","text":"Под солнцем горячим,"},{"type":"paragraph","text":"Тащили в ущелье его."},{"type":"paragraph","text":"Карабкаясь, никли"},{"type":"paragraph","text":"И вновь поднимались наверх,"},{"type":"paragraph","text":"Сгорали до серого пепла,"},{"type":"paragraph","text":"Но бездна рождала"},{"type":"paragraph","text":"Все новые полчища их…"},{"type":"paragraph","text":"И утра не стало"},{"type":"paragraph","text":"На нашей печальной земле, —"},{"type":"paragraph","text":"Земля не увидела солнца."},{"type":"paragraph","text":"О, горе вам, люди"},{"type":"paragraph","text":"Угрюмых лесов и долин!.."}]},{"id":"chapter-3","title":"2","content":[{"type":"paragraph","text":"В негреющих юртах —"},{"type":"paragraph","text":"Голодная длинная ночь,"},{"type":"paragraph","text":"За юртами — духи и совы."},{"type":"paragraph","text":"Усталый охотник"},{"type":"paragraph","text":"С пустыми руками идет."},{"type":"paragraph","text":"Где белка и соболь?"},{"type":"paragraph","text":"Их след перепутан во мгле,"},{"type":"paragraph","text":"И в сетях не плещется рыба."},{"type":"paragraph","text":"Злодейская полночь"},{"type":"paragraph","text":"Сама для охотника — сеть."},{"type":"paragraph","text":"Где птицы дневные?"},{"type":"paragraph","text":"Их гонит пугающий мрак"},{"type":"paragraph","text":"На север, на юг и на запад,"},{"type":"paragraph","text":"И, крылья ломая,"},{"type":"paragraph","text":"Им ночь обрывает полет."},{"type":"paragraph","text":"Мрак смерти и тленья…"},{"type":"paragraph","text":"Сжимая пустые сосцы"},{"type":"paragraph","text":"Сухими, как прутья, руками,"},{"type":"paragraph","text":"У плачущей матери"},{"type":"paragraph","text":"Гибнет родное дитя."},{"type":"paragraph","text":"Рожденное видеть,"},{"type":"paragraph","text":"Оно умирает во тьме,"},{"type":"paragraph","text":"Не зная ни света, ни солнца,"},{"type":"paragraph","text":"Запомнив одни лишь"},{"type":"paragraph","text":"Чуть слышные стопы вокруг."},{"type":"paragraph","text":"Пустынное небо"},{"type":"paragraph","text":"Над холодом скорбной земли."},{"type":"paragraph","text":"Блуждают кругом, как слепые,"},{"type":"paragraph","text":"Унылые люди,"},{"type":"paragraph","text":"Неясные призраки их."},{"type":"paragraph","text":"А в логове глухо"},{"type":"paragraph","text":"Вздыхает довольный Ыкиз,"},{"type":"paragraph","text":"И пляшут несметные духи."},{"type":"paragraph","text":"…Камлают шаманы,"},{"type":"paragraph","text":"Пугая недремлющих сов."}]},{"id":"chapter-4","title":"3","content":[{"type":"paragraph","text":"На долгие годы"},{"type":"paragraph","text":"Немыслимой тьмы океан"},{"type":"paragraph","text":"Разлился в невидимом мире,"},{"type":"paragraph","text":"Где тень человека"},{"type":"paragraph","text":"Сливается с тенью долин;"},{"type":"paragraph","text":"Где мех горностая —"},{"type":"paragraph","text":"Белее хинганских снегов —"},{"type":"paragraph","text":"Становится мехом лисицы"},{"type":"paragraph","text":"(Мир вечного мрака"},{"type":"paragraph","text":"Не знает различья в цветах)."},{"type":"paragraph","text":"Но вот за горами,"},{"type":"paragraph","text":"За тысячью рек и озер,"},{"type":"paragraph","text":"Где юрты из белого камня,"},{"type":"paragraph","text":"На радость народу"},{"type":"paragraph","text":"Родился большой человек."},{"type":"paragraph","text":"Он рос великаном,"},{"type":"paragraph","text":"Каких не найти среди нас."},{"type":"paragraph","text":"Глазами, как летние зори,"},{"type":"paragraph","text":"Тепло излучая,"},{"type":"paragraph","text":"Он видел на тысячи верст."},{"type":"paragraph","text":"Умелые руки"},{"type":"paragraph","text":"Творили и делали все,"},{"type":"paragraph","text":"Чем жизнь человека богата."},{"type":"paragraph","text":"Искуснее мастера"},{"type":"paragraph","text":"Вряд ли увидит земля."},{"type":"paragraph","text":"Все мысли народа"},{"type":"paragraph","text":"Сходились в его голове, —"},{"type":"paragraph","text":"Так птицы слетаются в стаи,"},{"type":"paragraph","text":"Когда под ветрами"},{"type":"paragraph","text":"Осенние листья шумят."},{"type":"paragraph","text":"И не было равных"},{"type":"paragraph","text":"Среди мудрецов на земле"},{"type":"paragraph","text":"Ему — человеку, чей разум,"},{"type":"paragraph","text":"Чье сердце и силу"},{"type":"paragraph","text":"Имеет один вискала."},{"type":"paragraph","text":"Его называли"},{"type":"paragraph","text":"Негаснущим именем — Вал,"},{"type":"paragraph","text":"Что солнечный свет означает."},{"type":"paragraph","text":"И люди простые,"},{"type":"paragraph","text":"Как к солнцу, тянулись к нему."},{"type":"paragraph","text":"И тот, кто был рядом, —"},{"type":"paragraph","text":"Тот силу его обретал"},{"type":"paragraph","text":"И разум сверкающий Вала."},{"type":"paragraph","text":"Огонь его сердца"},{"type":"paragraph","text":"В других отзывался сердцах."},{"type":"paragraph","text":"…В незримые дали"},{"type":"paragraph","text":"Смотрел иногда богатырь —"},{"type":"paragraph","text":"Орел, расправляющий крылья."},{"type":"paragraph","text":"И был он задумчив,"},{"type":"paragraph","text":"Суров и печален тогда."},{"type":"paragraph","text":"Орлиному взору"},{"type":"paragraph","text":"На многие тысячи верст"},{"type":"paragraph","text":"Картины земли открывались:"},{"type":"paragraph","text":"Убогие юрты,"},{"type":"paragraph","text":"Тоска одиноких долин."},{"type":"paragraph","text":"Вон злобные твари"},{"type":"paragraph","text":"По следу идут за судьбой"},{"type":"paragraph","text":"Голодного нивха, и люди,"},{"type":"paragraph","text":"Покорные тварям,"},{"type":"paragraph","text":"Бредут в темноте наугад."},{"type":"paragraph","text":"А дальше — ущелье"},{"type":"paragraph","text":"Буранов и северных вьюг,"},{"type":"paragraph","text":"Снегов вековые наносы."},{"type":"paragraph","text":"Там спрятано солнце"},{"type":"paragraph","text":"Угрюмой, печальной земли…"}]},{"id":"chapter-5","title":"4","content":[{"type":"paragraph","text":"Как с гор Чаятына"},{"type":"paragraph","text":"Сбегает весенний поток"},{"type":"paragraph","text":"На светлое ложе Амгуни, —"},{"type":"paragraph","text":"Так сильное племя"},{"type":"paragraph","text":"По призыву Вала пришло."},{"type":"paragraph","text":"— Пора наступила, —"},{"type":"paragraph","text":"Промолвил воинственный Вал, —"},{"type":"paragraph","text":"Пойдем во владенья Ыкиза"},{"type":"paragraph","text":"И ясное солнце"},{"type":"paragraph","text":"Родимому краю вернем!"},{"type":"paragraph","text":"— Пора наступила! —"},{"type":"paragraph","text":"Воскликнул другой богатырь"},{"type":"paragraph","text":"Со строгим лицом, на котором"},{"type":"paragraph","text":"Безмерная храбрость"},{"type":"paragraph","text":"Свои написала черты."},{"type":"paragraph","text":"То Пилькар воскликнул —"},{"type":"paragraph","text":"Провидец и пламенный друг,"},{"type":"paragraph","text":"Товарищ великого Вала."},{"type":"paragraph","text":"Средь сильных — сильнейший"},{"type":"paragraph","text":"И мудрый он был вискала."},{"type":"paragraph","text":"— Веди нас к ущелью,"},{"type":"paragraph","text":"Мы все за тобою пойдем! —"},{"type":"paragraph","text":"Неслись голоса громовые,"},{"type":"paragraph","text":"Сгибая деревья,"},{"type":"paragraph","text":"Как шумные травы в степи."},{"type":"paragraph","text":"И тысячи храбрых"},{"type":"paragraph","text":"Отправились в дальний поход"},{"type":"paragraph","text":"И верили — будет победа!"},{"type":"paragraph","text":"К народному счастью"},{"type":"paragraph","text":"Ведет их решительный Вал."}]},{"id":"chapter-6","title":"5","content":[{"type":"paragraph","text":"Не месяцы — годы"},{"type":"paragraph","text":"Земля содрогалась от бурь."},{"type":"paragraph","text":"Казалось, глухие вулканы,"},{"type":"paragraph","text":"Огонь исторгая,"},{"type":"paragraph","text":"Ворочались в недрах ее."},{"type":"paragraph","text":"То грозная битва"},{"type":"paragraph","text":"Во мгле разгоралась у скал, —"},{"type":"paragraph","text":"Так два океанских прибоя,"},{"type":"paragraph","text":"Сшибаясь валами,"},{"type":"paragraph","text":"Прибрежные горы дробят."},{"type":"paragraph","text":"Почуяв опасность,"},{"type":"paragraph","text":"Ползло из ущелий сырых"},{"type":"paragraph","text":"Сопящее войско Ыкиза —"},{"type":"paragraph","text":"Тяжелые тучи"},{"type":"paragraph","text":"На небе тайфунов и гроз."},{"type":"paragraph","text":"Из тьмы надвигаясь,"},{"type":"paragraph","text":"Срываясь с холодных камней,"},{"type":"paragraph","text":"Шипели зубастые твари,"},{"type":"paragraph","text":"Свивались узлами"},{"type":"paragraph","text":"Вокруг непокорной груди."},{"type":"paragraph","text":"То руки сплетали"},{"type":"paragraph","text":"Кривыми кореньями лап,"},{"type":"paragraph","text":"То грызли могучее тело."},{"type":"paragraph","text":"Неравные силы"},{"type":"paragraph","text":"На поле сраженья сошлись."},{"type":"paragraph","text":"Но не было трусов"},{"type":"paragraph","text":"Среди молодых вискала,"},{"type":"paragraph","text":"И если они умирали,"},{"type":"paragraph","text":"То с кличем победным,"},{"type":"paragraph","text":"С единственным кличем: «Вперед!»"},{"type":"paragraph","text":"И новые силы"},{"type":"paragraph","text":"Тогда прибавлялись у тех,"},{"type":"paragraph","text":"Кто шел под знаменами Вала,"},{"type":"paragraph","text":"Чтоб солнце светило,"},{"type":"paragraph","text":"Чтоб всех согревало оно."},{"type":"paragraph","text":"Хватая руками"},{"type":"paragraph","text":"Обломки гранитной скалы,"},{"type":"paragraph","text":"Один их бросает, как бомбы,"},{"type":"paragraph","text":"Разящие метко,"},{"type":"paragraph","text":"Врагов сокрушая кругом;"},{"type":"paragraph","text":"Другой врукопашную"},{"type":"paragraph","text":"Валит густые ряды,"},{"type":"paragraph","text":"А третий их топчет ногами,"},{"type":"paragraph","text":"Четвертый и пятый —"},{"type":"paragraph","text":"Пронзают стальной острогой."},{"type":"paragraph","text":"Там Пилькар могучий,"},{"type":"paragraph","text":"Из сумрака выхватив кедр,"},{"type":"paragraph","text":"Крушит им налево, направо"},{"type":"paragraph","text":"И воздух со свистом"},{"type":"paragraph","text":"То справа, то слева сечет."},{"type":"paragraph","text":"Он раз обернется —"},{"type":"paragraph","text":"Навалены груды врагов,"},{"type":"paragraph","text":"Еще раз — навалены горы."},{"type":"paragraph","text":"А ярость немая"},{"type":"paragraph","text":"Их гонит и гонит из пор."},{"type":"paragraph","text":"И много отважных"},{"type":"paragraph","text":"В неравном бою полегло…"},{"type":"paragraph","text":"Но вот под железным напором"},{"type":"paragraph","text":"Скала пошатнулась"},{"type":"paragraph","text":"И с грохотом рухнула вниз."},{"type":"paragraph","text":"Плечом богатырским"},{"type":"paragraph","text":"Нащупав удобный уступ,"},{"type":"paragraph","text":"Натужился Вал, приподнялся, —"},{"type":"paragraph","text":"И злого Ыкиза"},{"type":"paragraph","text":"Земля схоронила навек."},{"type":"paragraph","text":"И дрогнуло войско"},{"type":"paragraph","text":"Уродливых тварей его,"},{"type":"paragraph","text":"По темным лесам рассыпаясь, —"},{"type":"paragraph","text":"И вздох облегченья"},{"type":"paragraph","text":"Услышала наша земля."}]},{"id":"chapter-7","title":"6","content":[{"type":"paragraph","text":"На дне каменистом"},{"type":"paragraph","text":"Ущелья буранов и вьюг"},{"type":"paragraph","text":"Запрятано счастье земное."},{"type":"paragraph","text":"Три глыбы гранита"},{"type":"paragraph","text":"К нему преграждают пути."},{"type":"paragraph","text":"Но Пилькар те глыбы"},{"type":"paragraph","text":"Швырял, прикасаясь едва, —"},{"type":"paragraph","text":"И тьмы покрывало срывая,"},{"type":"paragraph","text":"Со дна каменистого"},{"type":"paragraph","text":"Хлынул стремительный день."},{"type":"paragraph","text":"Горячее солнце"},{"type":"paragraph","text":"Подняв к опаленной груди,"},{"type":"paragraph","text":"С ним Пилькар взобрался на скалы,"},{"type":"paragraph","text":"И падали звезды"},{"type":"paragraph","text":"С широких ладоней его."},{"type":"paragraph","text":"На горной вершине,"},{"type":"paragraph","text":"Открытой просторам земли,"},{"type":"paragraph","text":"Взмахнул он всесильной рукою —"},{"type":"paragraph","text":"И ясное солнце"},{"type":"paragraph","text":"Ушло в голубую лазурь."},{"type":"paragraph","text":"Мир, полный сиянья,"},{"type":"paragraph","text":"Предстал перед взором людей —"},{"type":"paragraph","text":"Прозрачный, ликующий, чистый."},{"type":"paragraph","text":"Долины сверкали,"},{"type":"paragraph","text":"Холмы и поляны цвели."},{"type":"paragraph","text":"Леса распустились,"},{"type":"paragraph","text":"И тополь, и клен у ручья —"},{"type":"paragraph","text":"В наряде из трепетных листьев,"},{"type":"paragraph","text":"Стволы разгибая,"},{"type":"paragraph","text":"Неслышно роняли росу."},{"type":"paragraph","text":"Лисица и соболь"},{"type":"paragraph","text":"К опушке детей привели."},{"type":"paragraph","text":"Веселые птицы запели,"},{"type":"paragraph","text":"Навек прославляя"},{"type":"paragraph","text":"Весенней земли торжество."},{"type":"paragraph","text":"А в стойбищах люди"},{"type":"paragraph","text":"Смеются и плачут вокруг"},{"type":"paragraph","text":"И землю родную целуют."},{"type":"paragraph","text":"От счастья смеются,"},{"type":"paragraph","text":"От радости плачут они!"},{"type":"paragraph","text":"Апрель — май 1939 г."}]}]}