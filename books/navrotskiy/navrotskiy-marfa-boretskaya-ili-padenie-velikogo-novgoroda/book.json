{"id":"navrotskiy-marfa-boretskaya-ili-padenie-velikogo-novgoroda","slug":"navrotskiy-marfa-boretskaya-ili-padenie-velikogo-novgoroda","shard":1,"title":"Марфа Борецкая, или Падение Великого Новгорода","altTitles":[],"author":"Александр Александрович Навроцкий","authorShort":"А. А. Навроцкий","authorSlug":"navrotskiy","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1901","editionYear":"1901","description":"Навроцкий А. А","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9C%D0%B0%D1%80%D1%84%D0%B0_%D0%91%D0%BE%D1%80%D0%B5%D1%86%D0%BA%D0%B0%D1%8F%2C_%D0%B8%D0%BB%D0%B8_%D0%9F%D0%B0%D0%B4%D0%B5%D0%BD%D0%B8%D0%B5_%D0%92%D0%B5%D0%BB%D0%B8%D0%BA%D0%BE%D0%B3%D0%BE_%D0%9D%D0%BE%D0%B2%D0%B3%D0%BE%D1%80%D0%BE%D0%B4%D0%B0_%28%D0%9D%D0%B0%D0%B2%D1%80%D0%BE%D1%86%D0%BA%D0%B8%D0%B9%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1901)","downloadAllowed":true,"fb2Url":"/archive/books/navrotskiy/navrotskiy-marfa-boretskaya-ili-padenie-velikogo-novgoroda/original.fb2","coverUrl":"/archive/books/navrotskiy/navrotskiy-marfa-boretskaya-ili-padenie-velikogo-novgoroda/cover.webp","stats":{"chaptersCount":3,"wordsCount":927,"charsCount":5649,"readingMinutes":5},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Навроцкий А. А."},{"type":"paragraph","text":"Марфа Борецкая, или Падение Великого Новгорода."},{"type":"paragraph","text":"Фрагменты драмы."},{"type":"paragraph","text":"На Москве-реке, во Кремле святом,"},{"type":"paragraph","text":"Во дворце своём разукрашенном"},{"type":"paragraph","text":"Господин Руси и великий князь"},{"type":"paragraph","text":"Государь Иван, сын Васильевич"},{"type":"paragraph","text":"За столом сидит в своей горенке."},{"type":"paragraph","text":"Перед ним стоит Марфа старица"},{"type":"paragraph","text":"Дочь купецкая и честна вдова"},{"type":"paragraph","text":"Новгородского свет-посадника."},{"type":"paragraph","text":"Росту среднего и дородная,"},{"type":"paragraph","text":"Сановитая с головы до ног;"},{"type":"paragraph","text":"От замужества к властной почести"},{"type":"paragraph","text":"По достоинству приученная."},{"type":"paragraph","text":"Хотя скованны руки белые,"},{"type":"paragraph","text":"Высоко она держит голову,"},{"type":"paragraph","text":"Смотрит псицею в очи княжие —"},{"type":"paragraph","text":"И невольно он перед узницей"},{"type":"paragraph","text":"Опустил свой взор повелительный."},{"type":"paragraph","text":"Говорит она мерным голосом,"},{"type":"paragraph","text":"Речь умно ведёт, с расстановкою."},{"type":"paragraph","text":"« Ты послушай, князь, меня, старицу,"},{"type":"paragraph","text":"От моих речей станешь опытней;"},{"type":"paragraph","text":"Ведь недаром я, с Божьей помощью,"},{"type":"paragraph","text":"Столько лет жила, управляла там"},{"type":"paragraph","text":"Буйной вольницей новгородскою!"},{"type":"paragraph","text":"Покарал вас Бог за усобицы."},{"type":"paragraph","text":"И твой род княжий, и твоя вся Русь"},{"type":"paragraph","text":"Под ярмом, в крови, из последних сил"},{"type":"paragraph","text":"Сколько лет ползли, извиваясь,"},{"type":"paragraph","text":"Под татарской злой нагайкою."},{"type":"paragraph","text":"Ну, а Новгород не достался им."},{"type":"paragraph","text":"Не добрались к нам за болотами;"},{"type":"paragraph","text":"Охраняла нас сила Божия"},{"type":"paragraph","text":"По предстательству Его мудрости."},{"type":"paragraph","text":"Не нарушился вечевой уклад,"},{"type":"paragraph","text":"От былых времён установленный."},{"type":"paragraph","text":"Оттого-то в нас и сильна она,"},{"type":"paragraph","text":"Наша волюшка вековечная."},{"type":"paragraph","text":"Ты сломил её не прямым путём,"},{"type":"paragraph","text":"Не в честном бою, а раздорами,"},{"type":"paragraph","text":"Смутой подкупом, клятвой рушенной,"},{"type":"paragraph","text":"Византийскою пришлой хитростью."},{"type":"paragraph","text":"Что ж, на всех одна воля Божия:"},{"type":"paragraph","text":"Что назначено, то и сбудется!"},{"type":"paragraph","text":"Правда, спора нет, и у нас порой"},{"type":"paragraph","text":"Непорядок был да усобица;"},{"type":"paragraph","text":"Иногда умом, чаще подкупом"},{"type":"paragraph","text":"Люди хитрые вольных путали."},{"type":"paragraph","text":"Но зато в делах необыденных,"},{"type":"paragraph","text":"Коль придёт беда иль нагрянет враг,"},{"type":"paragraph","text":"Наши молодцы не терялися,"},{"type":"paragraph","text":"За княжой кафтан не хваталися,"},{"type":"paragraph","text":"А, в одну семью собираяся,"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Мудрых, опытных речи слушали,"},{"type":"paragraph","text":"И решали все, помолившись вперёд,"},{"type":"paragraph","text":"Как тот лиха им избавлятися."},{"type":"paragraph","text":"Ох, умён ты, князь! Догадался сам,"},{"type":"paragraph","text":"Что увез от нас с веча колокол."},{"type":"paragraph","text":"С ни не только звон, с ним навек увёз"},{"type":"paragraph","text":"Стародавнюю нашу волюшку."},{"type":"paragraph","text":"Вижу ясно я, сердцем чувствую,"},{"type":"paragraph","text":"Что пришёл конец Нову городу."},{"type":"paragraph","text":"И уж если нам так сулил господь"},{"type":"paragraph","text":"От твоей руки стать холопами —"},{"type":"paragraph","text":"Не давай ты, князь, этой волюшке"},{"type":"paragraph","text":"Без следа вконец миноватися."},{"type":"paragraph","text":"Сей ты вольницу новгородскую!"},{"type":"paragraph","text":"Рассевай её по своей земле!"},{"type":"paragraph","text":"Пригодится, верь, во грядущи дни"},{"type":"paragraph","text":"И сослужит тебе службу честную."},{"type":"paragraph","text":"Ведь не вечен день, ночью мерится."},{"type":"paragraph","text":"Неравно придёт неурядица,"},{"type":"paragraph","text":"Да твой род княжой замешается,"},{"type":"paragraph","text":"Так и вся земля расшатается;"},{"type":"paragraph","text":"Не привыкли ведь без указки жить,"},{"type":"paragraph","text":"Своим разумом управлятися."},{"type":"paragraph","text":"Вот тогда-то, князь, во лихие дни,"},{"type":"paragraph","text":"От живых корней молодняк частой,"},{"type":"paragraph","text":"И научит вас, как изжить беду,"},{"type":"paragraph","text":"Как мирским умом разобратися,"},{"type":"paragraph","text":"Как почин начать к устроению."},{"type":"paragraph","text":"Ведь не с крыши дом новый строится,"},{"type":"paragraph","text":"А с основ- столбов, в землю кладенных…"},{"type":"paragraph","text":"Ну, спасибо, князь, что хотя меня"},{"type":"paragraph","text":"Обобрал ты всю, но помиловал;"},{"type":"paragraph","text":"Не велел казнить, даёшь времечко"},{"type":"paragraph","text":"Во грехах своих разобратися."},{"type":"paragraph","text":"И пора уж мне, грешной старице,"},{"type":"paragraph","text":"К часу смертному приготовиться."},{"type":"paragraph","text":"Об одном прошу: как настанет он,"},{"type":"paragraph","text":"Не лиши меня покаяния;"},{"type":"paragraph","text":"Не клади запрет на последний зов."},{"type":"paragraph","text":"Прикажи прислать старца доброго,"},{"type":"paragraph","text":"Чернеца-попа настоящего,"},{"type":"paragraph","text":"Что бы я пред ним, как пред Господом,"},{"type":"paragraph","text":"Во грехах моих исповедалась"},{"type":"paragraph","text":"И, с молитвою на исход души,"},{"type":"paragraph","text":"С телом грешным разлучилася."},{"type":"paragraph","text":"А лишишь меня этой радости,"},{"type":"paragraph","text":"На себя возьмёшь бремя тяжкое,"},{"type":"paragraph","text":"И ответишь ты перед Господом;"},{"type":"paragraph","text":"Ведь и твой черед умирать придёт»."},{"type":"paragraph","text":"И замолкла речь вещей старицы,"},{"type":"paragraph","text":"От души слова, страх не ведавшей."},{"type":"paragraph","text":"Повернулась она медленно"},{"type":"paragraph","text":"И сама пошла в клеть подземную,"},{"type":"paragraph","text":"В заточение до кончины дней."},{"type":"paragraph","text":"Князь Иван её не удерживал,"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Оперся на стол и задумался…"},{"type":"paragraph","text":"Знать, затронула сердце властное"},{"type":"paragraph","text":"Речь свободна, новгородская."},{"type":"paragraph","text":"Мы видим Марфу на сцене в тяжкие для неё минуты: она только что получила известие о том, что её сын Дмитрий попал в плен. Но и сейчас она думает не о своём горе, а о своём долге:"},{"type":"paragraph","text":"В плену мой сын, отважный, храбрый Митя."},{"type":"paragraph","text":"Что ждёт его? Безжалостен Иван."},{"type":"paragraph","text":"Тюрьма иль казнь, позор и униженье;"},{"type":"paragraph","text":"Искусен он глумиться над врагом."},{"type":"paragraph","text":"Как сжалось сердце. Хочется рыдать."},{"type":"paragraph","text":"Нельзя! Нельзя! Я твёрдости примером"},{"type":"paragraph","text":"Служить должна…"},{"type":"paragraph","text":"Перед врагом смириться не могу."},{"type":"paragraph","text":"Хоть баба я! Но дух во мне не женский,"},{"type":"paragraph","text":"И не простит обиды никому."},{"type":"paragraph","text":"Народное я дело подняла"},{"type":"paragraph","text":"Себе на плечи; и хоть тяжко сердцу,"},{"type":"paragraph","text":"И стоны грудь наполнили мою —"},{"type":"paragraph","text":"Я всем пожертвую, но не покину"},{"type":"paragraph","text":"Борьбы с Москвой коварной никогда!"},{"type":"paragraph","text":"И далее:"},{"type":"paragraph","text":"Я мать"},{"type":"paragraph","text":"Моих детей; скорблю о них глубоко;"},{"type":"paragraph","text":"Но участь Новгорода выше для меня"},{"type":"paragraph","text":"Семьи и жизни. За него родного,"},{"type":"paragraph","text":"Мы постоим!"},{"type":"paragraph","text":"Она призывает послать гонцов за помощью в Литву, но лишь потому, что видит в этом средство отстоять свободу:"},{"type":"paragraph","text":"Встанем все за Новгород Великий"},{"type":"paragraph","text":"И вече наше!"},{"type":"paragraph","text":"В другой сцене она так поясняет свои побуждения:"},{"type":"paragraph","text":"В Литве без денег толка не добьёшься;"},{"type":"paragraph","text":"А я теперь не стану их жалеть."},{"type":"paragraph","text":"Лишь удалось бы помощи дождаться"},{"type":"paragraph","text":"И Новгород родной освободить"},{"type":"paragraph","text":"От кабалы московской…"},{"type":"paragraph","text":"Что ждёт меня? Не знаю! Но до смерти,"},{"type":"paragraph","text":"Пока во мне хоть капля крови есть,"},{"type":"paragraph","text":"Не перестану я искать защиты"},{"type":"paragraph","text":"Родного города! Литву и Свею,"},{"type":"paragraph","text":"Ганзу и пруссов, ляхов и татар"},{"type":"paragraph","text":"Сплочу в союз я ненависти общей"},{"type":"paragraph","text":"К Москве коварной."},{"type":"paragraph","text":"Её решимость вдохновляет новгородцев, которые говорят:"},{"type":"paragraph","text":"Свободная душа!"},{"type":"paragraph","text":"С ней Новгород Ивану не поддастся."},{"type":"paragraph","text":"Злобно, но верно оценивают её роль и враги:"},{"type":"paragraph","text":"Заводчицей всему"},{"type":"paragraph","text":"Борецкая; в ней главная препона."},{"type":"paragraph","text":"Как сковородкой на огне вертит"},{"type":"paragraph","text":"Всем городом."},{"type":"paragraph","text":"В часы поражений Марфу не покидает уверенность, что ненависть к поработителям будет жить в народе и когда-нибудь разгорится пожаром, что младенцы всосут её с молоком матерей, и она будет править их сердцами. Томясь в тюрьме, она будет думать лишь о том, что бы её родной город не разлучился со свободой."},{"type":"paragraph","text":"Опубликовано в сборнике Навроцкого А. А. «Памяти Великого Новгорода», СПб., «Типография В. Безобразова», 1901 г. С. 46 — 98."},{"type":"paragraph","text":"1901 г."},{"type":"paragraph","text":"Источник текста: Погодин М. П. «Марфа, посадница Новгородская», М., « Наука», 2015 г. Серия «Литературные памятники». С. 247—250, 344—346, 364."}]}]}