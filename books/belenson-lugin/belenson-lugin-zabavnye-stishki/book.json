{"id":"belenson-lugin-zabavnye-stishki","slug":"belenson-lugin-zabavnye-stishki","shard":1,"title":"Забавные стишки","altTitles":[],"author":"Александр Эммануилович Беленсон-Лугин","authorShort":"А. Э. Беленсон-Лугин","authorSlug":"belenson-lugin","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1914","editionYear":"1914","description":"Грум","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%97%D0%B0%D0%B1%D0%B0%D0%B2%D0%BD%D1%8B%D0%B5_%D1%81%D1%82%D0%B8%D1%88%D0%BA%D0%B8_%28%D0%91%D0%B5%D0%BB%D0%B5%D0%BD%D1%81%D0%BE%D0%BD-%D0%9B%D1%83%D0%B3%D0%B8%D0%BD%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1914)","downloadAllowed":true,"fb2Url":"/archive/books/belenson-lugin/belenson-lugin-zabavnye-stishki/original.fb2","coverUrl":"/archive/books/belenson-lugin/belenson-lugin-zabavnye-stishki/cover.webp","stats":{"chaptersCount":1,"wordsCount":1466,"charsCount":9211,"readingMinutes":8},"toc":[{"id":"chapter-1","title":"Забавные стишки"}],"chapters":[{"id":"chapter-1","title":"Забавные стишки","content":[{"type":"paragraph","text":"Грум"},{"type":"paragraph","text":"Н. И. Кулъбину"},{"type":"paragraph","text":"Так тяжело жить, не имея грума, —"},{"type":"paragraph","text":"Над этим я не задумывался ранее."},{"type":"paragraph","text":"Куртку с галунами заказали б ему мы,"},{"type":"paragraph","text":"Как это делают лорды Великобритании!"},{"type":"paragraph","text":"Если мечта моя осуществится,"},{"type":"paragraph","text":"Очень скоро все переменится к лучшему:"},{"type":"paragraph","text":"Нас станут посещать только знатные лица"},{"type":"paragraph","text":"И скукою мы конечно меньше будем мучимы."},{"type":"paragraph","text":"Таити"},{"type":"paragraph","text":"Со мной простись, моя Таис:"},{"type":"paragraph","text":"Готов корабль отплыть в Таити,"},{"type":"paragraph","text":"Где томно гнет к земле маис"},{"type":"paragraph","text":"Свои оранжевые нити."},{"type":"paragraph","text":"Печальна ты? так не таись, —"},{"type":"paragraph","text":"Матросы без меня плывите:"},{"type":"paragraph","text":"Уста мне слаще, чем маис"},{"type":"paragraph","text":"Таис желанней, чем Таити!"},{"type":"paragraph","text":"Дуэль"},{"type":"paragraph","text":"Два фрака, два лица бесстрастных"},{"type":"paragraph","text":"Обычный отдают поклон."},{"type":"paragraph","text":"Два дула равных и опасных,"},{"type":"paragraph","text":"Два секунданта с двух сторон"},{"type":"paragraph","text":"Два длинных шага отмеряют."},{"type":"paragraph","text":"Два слова тщетны — примирить,"},{"type":"paragraph","text":"Два встречных выстрела решают"},{"type":"paragraph","text":"Кому из двух остаться жить?"},{"type":"paragraph","text":"Тонкую шпагу сгибая"},{"type":"paragraph","text":"Скажу вам: — Аглая,"},{"type":"paragraph","text":"Будьте моею!"},{"type":"paragraph","text":"Тонкие губы сжимая,"},{"type":"paragraph","text":"Вы шепнете: — не знаю, —"},{"type":"paragraph","text":"Смущенно бледнея."},{"type":"paragraph","text":"Играя цепью лорнета,"},{"type":"paragraph","text":"Признаюсь: — Нинетта,"},{"type":"paragraph","text":"Я — раб навеки!"},{"type":"paragraph","text":"Играя сердцем поэта,"},{"type":"paragraph","text":"Мне не давши ответа,"},{"type":"paragraph","text":"Вы сомкнете веки."},{"type":"paragraph","text":"Бархатный камзол я скину"},{"type":"paragraph","text":"Для вас, Катарина,"},{"type":"paragraph","text":"Страстью волнуем."},{"type":"paragraph","text":"Бархатную грудь и спину"},{"type":"paragraph","text":"Отдадите невинно"},{"type":"paragraph","text":"Моим поцелуям."},{"type":"paragraph","text":"Испанские стишки"},{"type":"paragraph","text":"Стройную, чья грудь темнее бронзы,"},{"type":"paragraph","text":"Чьи уста нежнее глаз газели,"},{"type":"paragraph","text":"Донну Розу любит дон Алонзо, —"},{"type":"paragraph","text":"Роза любит дона Мигуэля."},{"type":"paragraph","text":"Он — Эльвиру, что за блеск дуката"},{"type":"paragraph","text":"Для сеньоров пляшет неустанно,"},{"type":"paragraph","text":"Рот прекрасной сладостней граната,"},{"type":"paragraph","text":"Но… в Алонзо влюблена гитана."},{"type":"paragraph","text":"; М. А. Кузмину"},{"type":"paragraph","text":"Люблю носить камзол атласный, шпагу,"},{"type":"paragraph","text":"Парик напудренный и бархатный жилет,"},{"type":"paragraph","text":"Пить старую мадеру иль малагу"},{"type":"paragraph","text":"И сочинять нескромный триолет."},{"type":"paragraph","text":"— Читать, скучая, манускрипт арабский,"},{"type":"paragraph","text":"Пока появится, звеня браслетом, друг"},{"type":"paragraph","text":"И предаваться безрассудной ласке"},{"type":"paragraph","text":"Изнеженных продолговатых рук…"},{"type":"paragraph","text":"Имена"},{"type":"paragraph","text":"Всех бесстыдниц вы блудливей,"},{"type":"paragraph","text":"О, Агнесса,"},{"type":"paragraph","text":"Всех возлюбленных счастливей"},{"type":"paragraph","text":"Ваш, — повеса."},{"type":"paragraph","text":"Всех прелестниц вы прелестней,"},{"type":"paragraph","text":"Виолетта,"},{"type":"paragraph","text":"Всех чудес ваш смех чудесней"},{"type":"paragraph","text":"Для поэта."},{"type":"paragraph","text":"Всех красавиц вы прекрасней,"},{"type":"paragraph","text":"О, Елена,"},{"type":"paragraph","text":"Всех мужей ваш муж несчастней,"},{"type":"paragraph","text":"Несомненно."},{"type":"paragraph","text":"Всех жеманниц вы жеманней,"},{"type":"paragraph","text":"Габриэла,"},{"type":"paragraph","text":"Всех желаний мне желанней"},{"type":"paragraph","text":"Ваше тело."},{"type":"paragraph","text":"Гватемала"},{"type":"paragraph","text":"Владетельным принцем Гватемалы"},{"type":"paragraph","text":"Стать могу ради вас, это легко мне,"},{"type":"paragraph","text":"Но ведь вам Гватемалы пожалуй мало,"},{"type":"paragraph","text":"А страны другой подходящей я не помню!"},{"type":"paragraph","text":"Эфиопка"},{"type":"paragraph","text":"Что может быть новей, прелестней и проще"},{"type":"paragraph","text":"Непонятных признаний, сказанных так робко,"},{"type":"paragraph","text":"Любовных свиданий в оливковой роще"},{"type":"paragraph","text":"С черною безусловно, юной эфиопкой!"},{"type":"paragraph","text":"Как это наивно, забавно и мило,"},{"type":"paragraph","text":"Что она ничуть не похожа на лоретку"},{"type":"paragraph","text":"И не смущается пасти крокодила,"},{"type":"paragraph","text":"Разинутой убедительно и метко!"},{"type":"paragraph","text":"Гваделупа"},{"type":"paragraph","text":"Кто любит, не закован в латы,"},{"type":"paragraph","text":"Но сердце тот открыть готов:"},{"type":"paragraph","text":"Я точным взором адвоката"},{"type":"paragraph","text":"Сказать сумею все без слов."},{"type":"paragraph","text":"Вы на любезности не скупы"},{"type":"paragraph","text":"И снисходительны к гостям,"},{"type":"paragraph","text":"Но как туземец Гваделупы"},{"type":"paragraph","text":"Я безразличен буду вам."},{"type":"paragraph","text":"Оранжевый локон"},{"type":"paragraph","text":"Тот прав, любовью кто влеком"},{"type":"paragraph","text":"И лучше нежности нет свата,"},{"type":"paragraph","text":"Свои признанья виновато"},{"type":"paragraph","text":"Я повторял, глотая ром"},{"type":"paragraph","text":"Мне улыбнулась раз, не два ты,"},{"type":"paragraph","text":"Но первый я шепнул: «пойдем»,"},{"type":"paragraph","text":"И, недопив нелепый ром,"},{"type":"paragraph","text":"Мы вдруг оставили Privato."},{"type":"paragraph","text":"Актриса"},{"type":"paragraph","text":"Явлюсь с обещанным визитом"},{"type":"paragraph","text":"К тебе в hotel часам к пяти —"},{"type":"paragraph","text":"Пить кофе с английским бисквитом"},{"type":"paragraph","text":"И вздор насмешливый плести…"},{"type":"paragraph","text":"Уеду ласковый и старый"},{"type":"paragraph","text":"В надежде той, что ты верна,"},{"type":"paragraph","text":"И полной даме в душном баре"},{"type":"paragraph","text":"Лениво закажу вина."},{"type":"paragraph","text":"Дирижабль Нана"},{"type":"paragraph","text":"Ко мне заехала на час ты,"},{"type":"paragraph","text":"Ждал дирижабль у окна."},{"type":"paragraph","text":"Твои уста нежнее пасты"},{"type":"paragraph","text":"О, атмосферная Нана!"},{"type":"paragraph","text":"Они мои совсем не часто,"},{"type":"paragraph","text":"Любовь случайная хитра:"},{"type":"paragraph","text":"Ко мне заехала на час ты,"},{"type":"paragraph","text":"Ждал дирижабль до утра…"},{"type":"paragraph","text":"Лизетта"},{"type":"paragraph","text":"Наклонясь над личиком овальным,"},{"type":"paragraph","text":"Спрашивает граф с лицом печальным,"},{"type":"paragraph","text":"Шпагою играя: «любишь ли, Лизетта»?"},{"type":"paragraph","text":"Наклонясь над вышивкой по тюлю,"},{"type":"paragraph","text":"Отвечает, побледнев: «люблю ли?"},{"type":"paragraph","text":"Я совсем еще не думала об этом»."},{"type":"paragraph","text":"Долго пальцы тонкие целуя,"},{"type":"paragraph","text":"Шепчет граф: «но без ума люблю я,"},{"type":"paragraph","text":"Не пытай меня холодностью, Лизетта»!"},{"type":"paragraph","text":"Долго разбирая клубок нитей,"},{"type":"paragraph","text":"Говорит прелестница: «идите,"},{"type":"paragraph","text":"И вернитесь завтра за моим ответом»."},{"type":"paragraph","text":"Обнимая ноги милой страстно,"},{"type":"paragraph","text":"Молит граф: «любовь моя опасна,"},{"type":"paragraph","text":"Ждать не стану я, жестокая Лизетта»!"},{"type":"paragraph","text":"Обнимая нежными руками,"},{"type":"paragraph","text":"Шепчет: «за меня ответьте ж сами»,"},{"type":"paragraph","text":"И стыдливо губы отдает при этом…"},{"type":"paragraph","text":"Уже не солдат"},{"type":"paragraph","text":"В девять часов не услышу сигнального рожка,"},{"type":"paragraph","text":"На поверку в шеренгу не стану вместе с другими,"},{"type":"paragraph","text":"Вздохнув, не подумаю: «хоть служба моя и легка,"},{"type":"paragraph","text":"Все ж лучше быть с той, чье мило по-прежнему имя»"},{"type":"paragraph","text":"Приеду к вам, забуду скоро казарменный гул,"},{"type":"paragraph","text":"И часы, проведенные с винтовкой в карауле,"},{"type":"paragraph","text":"И стройную сестру, на которую нежно взглянул"},{"type":"paragraph","text":"В коридоре лазарета. На нее одну ли?!"},{"type":"paragraph","text":"Вечер"},{"type":"paragraph","text":"Темнеет небо, розовея,"},{"type":"paragraph","text":"Влажнеют губы и вуаль,"},{"type":"paragraph","text":"Мой нежный взор следит за нею,"},{"type":"paragraph","text":"За парусом, плывущим вдаль."},{"type":"paragraph","text":"Свежей, но матовее кожа"},{"type":"paragraph","text":"И шепот стынет: мы молчим,"},{"type":"paragraph","text":"Ее лицо как будто строже,"},{"type":"paragraph","text":"Лицо, которым я томим."},{"type":"paragraph","text":"Скучают бледные магнолии,"},{"type":"paragraph","text":"Как дамы в углубленьях лож…"},{"type":"paragraph","text":"Что ночь несет, не все равно ли:"},{"type":"paragraph","text":"И вечер наш на ночь похож!"},{"type":"paragraph","text":"У фонтана"},{"type":"paragraph","text":"Н. Е. Добычиной"},{"type":"paragraph","text":"Два силуэта близятся к фонтану,"},{"type":"paragraph","text":"То — встречи тайной миг: Анри и Жанна"},{"type":"paragraph","text":"Поклон воздушный отдают жеманно."},{"type":"paragraph","text":"Подруги нежной кринолин так пышен,"},{"type":"paragraph","text":"Ей друг дарит пригоршни сладких вишен,"},{"type":"paragraph","text":"Их шепот тихий никому не слышен."},{"type":"paragraph","text":"Вот наклонились оба над бассейном,"},{"type":"paragraph","text":"В восторге трепетно-благоговейном"},{"type":"paragraph","text":"Любуется Анри лицом лилейным."},{"type":"paragraph","text":"И серебрит луна камзол атласный,"},{"type":"paragraph","text":"Улыбки Жанны отраженно-ясны:"},{"type":"paragraph","text":"Свиданья в парке ночью безопасны."},{"type":"paragraph","text":"Бегут часы без отдыха и цели,"},{"type":"paragraph","text":"От влажности уста похолодели,"},{"type":"paragraph","text":"Уже пастух играет на свирели."},{"type":"paragraph","text":"День недалек, — «до завтра, здесь, в аллее»!"},{"type":"paragraph","text":"Влюбленные, смущаясь и бледнея,"},{"type":"paragraph","text":"Меняются цветками орхидеи."},{"type":"paragraph","text":"Прощание"},{"type":"paragraph","text":"О, друг, которого ни разу я не встретил,"},{"type":"paragraph","text":"Подруга верная, которой изменил!.."},{"type":"paragraph","text":"О, ранний шепот поседевших ветел"},{"type":"paragraph","text":"В саду, где я вздыхал, скучал, любил!"},{"type":"paragraph","text":"Так близко был ты, друг, но знака не приметил,"},{"type":"paragraph","text":"Ты, что обманута, зачем тебе я мил?"},{"type":"paragraph","text":"И для чего час утренний так светел:"},{"type":"paragraph","text":"К забвенью лишь я нежность сохранил!"},{"type":"paragraph","text":"Я сижу за столом и равнодушно спорю,"},{"type":"paragraph","text":"Слишком сосредоточенно глядя на дорогу,"},{"type":"paragraph","text":"В моем ровном тоне и тщательном проборе"},{"type":"paragraph","text":"Пренебрежения ко всем чрезмерно много."},{"type":"paragraph","text":"Потом, наконец, дождусь, мы уйдем, — в аллее"},{"type":"paragraph","text":"Я прочту свои новые стихи очень ровно,"},{"type":"paragraph","text":"Вы будете вслушиваться, слегка бледнея,"},{"type":"paragraph","text":"И конечно вам все понравится безусловно."},{"type":"paragraph","text":"Улан"},{"type":"paragraph","text":"l."},{"type":"paragraph","text":"В этой комнате с голубым светом"},{"type":"paragraph","text":"Вчера сидел улан со шпорами, —"},{"type":"paragraph","text":"Ушел ли он влюбленным и согретым"},{"type":"paragraph","text":"Вашими нежными как часто взорами?"},{"type":"paragraph","text":"Пленил ли он вас высокой каской"},{"type":"paragraph","text":"Или шнурами необычными,"},{"type":"paragraph","text":"Подарили ли вы хоть одну ласку"},{"type":"paragraph","text":"Своими руками, мне так привычными?"},{"type":"paragraph","text":"Ах, я совсем ничего не знаю"},{"type":"paragraph","text":"И обречен часам томительным…"},{"type":"paragraph","text":"Что делали вы, изменница злая,"},{"type":"paragraph","text":"Наедине с уланом обольстительным?"},{"type":"paragraph","text":"2"},{"type":"paragraph","text":"Встречайтесь чаще с молодым уланом:"},{"type":"paragraph","text":"Вас нежным звоном шпор утешит он наверно,"},{"type":"paragraph","text":"Своим влюбленным взором искренним и странным"},{"type":"paragraph","text":"Напомнит мой — насмешливый, но верный."},{"type":"paragraph","text":"Стихом своим по-детски торопливым"},{"type":"paragraph","text":"Напомнит мой — всегда размеренный и ясный,"},{"type":"paragraph","text":"А вы лицом таким внимательным и лживым"},{"type":"paragraph","text":"Ему не скажете, что безучастны."},{"type":"paragraph","text":"Быть может вам признанья не насучат"},{"type":"paragraph","text":"И даже станет девственность его желанна,"},{"type":"paragraph","text":"Но ваша страсть ко мне, что до сих пор вас мучит,"},{"type":"paragraph","text":"От сладкого греха спасет… улана."},{"type":"paragraph","text":"На вокзале"},{"type":"paragraph","text":"Томительность минут прервет звонок третий,"},{"type":"paragraph","text":"Вдруг странным покажется ваш профиль тонкий."},{"type":"paragraph","text":"Уйдет поезд, как все уходит на свете,"},{"type":"paragraph","text":"А я останусь и не брошусь вдогонку…"},{"type":"paragraph","text":"Спешит неверным шагом к пристани,"},{"type":"paragraph","text":"Где отдыхают корабли,"},{"type":"paragraph","text":"И смотрит с каждым часом пристальней,"},{"type":"paragraph","text":"Не видно ль мачты там, вдали?"},{"type":"paragraph","text":"Не замечает нежных юношей,"},{"type":"paragraph","text":"Пришедших стройною гурьбой,"},{"type":"paragraph","text":"И дамы в палевом, засунувшей"},{"type":"paragraph","text":"Фиалки за корсаж тугой."},{"type":"paragraph","text":"Его не тешит тело гибкое,"},{"type":"paragraph","text":"Воздушное как бег трирем,"},{"type":"paragraph","text":"И не ответит он улыбкою,"},{"type":"paragraph","text":"Подав надежду сразу всем."},{"type":"paragraph","text":"Кого он ждет, не друга ль милого,"},{"type":"paragraph","text":"Ему приславшего поклон?"},{"type":"paragraph","text":"Да только верно друг забыл его,"},{"type":"paragraph","text":"Красоткой ветреной пленен."},{"type":"paragraph","text":"И тщетно ждет, мечтой отравленный,"},{"type":"paragraph","text":"С своей печалью говоря:"},{"type":"paragraph","text":"Корабль, вестник шумных гаваней,"},{"type":"paragraph","text":"Уж где-то бросил якоря…"},{"type":"paragraph","text":"Признания"},{"type":"paragraph","text":"Ф. А. Глинской"},{"type":"paragraph","text":"Когда умрете, черным шелком"},{"type":"paragraph","text":"Украшу скорбно туалет,"},{"type":"paragraph","text":"Покорен буду праздным толкам:"},{"type":"paragraph","text":"«Красавица… лишь двадцать лет»…"},{"type":"paragraph","text":"Покрою слоем пудры щеки"},{"type":"paragraph","text":"И слоем мертвенным белил:"},{"type":"paragraph","text":"Пусть скажут все: «судьба жестока,"},{"type":"paragraph","text":"Как он умершую любил»!"},{"type":"paragraph","text":"С усталостью больной во взоре"},{"type":"paragraph","text":"В прощальный час склонюсь средь роз,"},{"type":"paragraph","text":"Но не забуду ни пробора,"},{"type":"paragraph","text":"Ни manicure, ни томных поз."},{"type":"paragraph","text":"Придя к себе, стихи раскрою,"},{"type":"paragraph","text":"Их темной обведу каймой"},{"type":"paragraph","text":"И может быть вздохну с тоскою:"},{"type":"paragraph","text":"Ах, я писал для вас одной!.."},{"type":"paragraph","text":"Прогулка"},{"type":"paragraph","text":"Карета, запряженная четверкой"},{"type":"paragraph","text":"Лошадок стриженных, гладких,"},{"type":"paragraph","text":"Лакей почтительный и зоркий,"},{"type":"paragraph","text":"Легко стоящий на запятках."},{"type":"paragraph","text":"Окрик неожиданно-веский,"},{"type":"paragraph","text":"Вызывающий улыбку: «правее»,"},{"type":"paragraph","text":"Глухо спущенные занавески."},{"type":"paragraph","text":"Добродушный кучер в ливрее."},{"type":"paragraph","text":"На дверцах две крошечные коронки"},{"type":"paragraph","text":"С уже потускневшей позолотой,"},{"type":"paragraph","text":"Чей-то профиль уступчиво-тонкий,"},{"type":"paragraph","text":"Чьи-то губы, ждущие чего-то…"},{"type":"paragraph","text":"Вот и дома, — подъезд со львами,"},{"type":"paragraph","text":"Стерегущими внушительно и кротко."},{"type":"paragraph","text":"Клянусь, не скучно было с вами,"},{"type":"paragraph","text":"Слишком любезная ко мне красотка!"},{"type":"paragraph","text":"Исполнен церемонной грации,"},{"type":"paragraph","text":"С улыбкой важной богдыхана"},{"type":"paragraph","text":"Я декламировал Горация"},{"type":"paragraph","text":"Китаянке благоуханной."},{"type":"paragraph","text":"Дремали мандарины строгие, —"},{"type":"paragraph","text":"Так видно принято в Пекине,"},{"type":"paragraph","text":"Любовный вздох при каждом слоге я"},{"type":"paragraph","text":"Лукаво добавлял к латыни."},{"type":"paragraph","text":"Н. Н. Евреинову"},{"type":"paragraph","text":"Китаянка"},{"type":"paragraph","text":"В Китае, тая, гейша милая,"},{"type":"paragraph","text":"Вздыхая, пьет душистый чай."},{"type":"paragraph","text":"Но поступлю конечно мило я:"},{"type":"paragraph","text":"В Китай приеду невзначай."},{"type":"paragraph","text":"Лишь денег нет, — случайность странная,"},{"type":"paragraph","text":"Мою решимость не смущай."},{"type":"paragraph","text":"Ах, если денег не достану я,"},{"type":"paragraph","text":"Как попаду в Китай, в Китай?!"},{"type":"paragraph","text":"Танго"},{"type":"paragraph","text":"(Забавная песенка)"},{"type":"paragraph","text":"Марго быстрей чем Конго,"},{"type":"paragraph","text":"Марго опасней Ганга,"},{"type":"paragraph","text":"Когда под звуки гонга"},{"type":"paragraph","text":"Танцует танец танго!"},{"type":"paragraph","text":"Впервые: Забавные стишки / Александр Беленсон; Рис. Н. И. Кульбина. — Санкт-Петербург: тип. журн. «Сатирикон», 1914. — 43 с. ил.; 17 см."}]}]}