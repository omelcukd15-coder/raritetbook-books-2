{"id":"galperin-dva-romansa","slug":"galperin-dva-romansa","shard":1,"title":"Два романса","altTitles":[],"author":"Михаил Петрович Гальперин","authorShort":"М. П. Гальперин","authorSlug":"galperin","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1916","editionYear":"1916","description":"Два романса (М. П. Гальперин): Михаил Гальперин","historicalNote":"Проверенное издание (1916).","sourceUrl":"https://ru.wikisource.org/wiki/%D0%94%D0%B2%D0%B0_%D1%80%D0%BE%D0%BC%D0%B0%D0%BD%D1%81%D0%B0_%28%D0%93%D0%B0%D0%BB%D1%8C%D0%BF%D0%B5%D1%80%D0%B8%D0%BD%29","legalStatus":"Общественное достояние (PD-old; 1916)","downloadAllowed":true,"fb2Url":"/archive/books/galperin/galperin-dva-romansa/original.fb2","coverUrl":"/archive/books/galperin/galperin-dva-romansa/cover.webp","stats":{"chaptersCount":1,"wordsCount":168,"charsCount":1033,"readingMinutes":2},"toc":[{"id":"chapter-1","title":"Два романса"}],"chapters":[{"id":"chapter-1","title":"Два романса","content":[{"type":"paragraph","text":"Михаил Гальперин"},{"type":"paragraph","text":"Два романса"},{"type":"paragraph","text":"Ветка сирени"},{"type":"paragraph","text":"Романс"},{"type":"paragraph","text":"Музыка А. Волошина"},{"type":"paragraph","text":"Слова М. Гальперина"},{"type":"paragraph","text":"У вагона я ждал, расставаясь с тобой,"},{"type":"paragraph","text":"Полный грусти прощальных мгновений,"},{"type":"paragraph","text":"И в мечтах о былом, вся душою со мной,"},{"type":"paragraph","text":"Ты мне бросила ветку сирени."},{"type":"paragraph","text":"Резкий голос звонка нас от дум оторвал,"},{"type":"paragraph","text":"Налетели потоки сомнений."},{"type":"paragraph","text":"И, тебе глядя в след, весь в слезах, целовал"},{"type":"paragraph","text":"Я прощальную ветку сирени…"},{"type":"paragraph","text":"Поезд где-то исчез в серой дымке вдали,"},{"type":"paragraph","text":"Проплывали вечерние тени,"},{"type":"paragraph","text":"И бесцельно я брел по дороге в пыли"},{"type":"paragraph","text":"С одинокою веткой сирени."},{"type":"paragraph","text":"Я вернулся к себе… Этот вечер унес"},{"type":"paragraph","text":"Все надежды, всю радость стремлений…"},{"type":"paragraph","text":"В эту ночь отцвела от объятий и слез"},{"type":"paragraph","text":"Истомленная ветка сирени…"},{"type":"paragraph","text":"Старая сказка"},{"type":"paragraph","text":"Музыка Бориса Прозоровского"},{"type":"paragraph","text":"Слова Михаила Гальперина"},{"type":"paragraph","text":"С каждым ударом все ближе развязка,"},{"type":"paragraph","text":"Жутко в глухой тишине."},{"type":"paragraph","text":"Старая сказка, знакомая сказка,"},{"type":"paragraph","text":"Как надоела ты мне."},{"type":"paragraph","text":"Ночи и дни в утомительной смене"},{"type":"paragraph","text":"Мерно и сонно плывут."},{"type":"paragraph","text":"В сумраке прошлого чудятся тени"},{"type":"paragraph","text":"Светлых обманных минут."},{"type":"paragraph","text":"Ложь и порывы, притворство и маска,"},{"type":"paragraph","text":"Скорбь об утраченном дне."},{"type":"paragraph","text":"Старая сказка, проклятая сказка,"},{"type":"paragraph","text":"Как надоела ты мне!"}]}]}