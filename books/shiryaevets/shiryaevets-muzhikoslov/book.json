{"id":"shiryaevets-muzhikoslov","slug":"shiryaevets-muzhikoslov","shard":1,"title":"Мужикослов","altTitles":[],"author":"Александр Васильевич Ширяевец","authorShort":"А. В. Ширяевец","authorSlug":"shiryaevets","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1924","editionYear":"1924","description":"Мужикослов","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9C%D1%83%D0%B6%D0%B8%D0%BA%D0%BE%D1%81%D0%BB%D0%BE%D0%B2_%28%D0%A8%D0%B8%D1%80%D1%8F%D0%B5%D0%B2%D0%B5%D1%86%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1924)","downloadAllowed":true,"fb2Url":"/archive/books/shiryaevets/shiryaevets-muzhikoslov/original.fb2","coverUrl":"/archive/books/shiryaevets/shiryaevets-muzhikoslov/cover.webp","stats":{"chaptersCount":4,"wordsCount":508,"charsCount":3316,"readingMinutes":3},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Мужикослов"},{"type":"paragraph","text":"Оригинал здесь — http://nk-poety.narod.ru/win/main/main.html"},{"type":"paragraph","text":"МУЖИКОСЛОВ"},{"type":"paragraph","text":"1924"},{"type":"paragraph","text":"Памяти матери моей Марии Ермоловны"},{"type":"paragraph","text":"I"},{"type":"paragraph","text":"Космы ночи"},{"type":"paragraph","text":"Прикрыли село,"},{"type":"paragraph","text":"А над нивами, над бором"},{"type":"paragraph","text":"Волхование звездное шло…"},{"type":"paragraph","text":"Вышний пастырь плелся дозором,"},{"type":"paragraph","text":"Важеватый,"},{"type":"paragraph","text":"С янтарь-клюкой,"},{"type":"paragraph","text":"И пророчил, пророчил, пророчил"},{"type":"paragraph","text":"Над лохматой"},{"type":"paragraph","text":"Моей башкой."},{"type":"paragraph","text":"II"},{"type":"paragraph","text":"О полночи"},{"type":"paragraph","text":"Вскочил, как пьяный,"},{"type":"paragraph","text":"Замутила тоска-туга,"},{"type":"paragraph","text":"Будто ловит меня арканом,"},{"type":"paragraph","text":"Топчет-топчет конем баскак."},{"type":"paragraph","text":"Будто вспыхнул, горит домишко,"},{"type":"paragraph","text":"Бабий рев, рев набатный в селе!"},{"type":"paragraph","text":"Свищут стрелы. Сестра нагишкой"},{"type":"paragraph","text":"На татарском лежит седле!"},{"type":"paragraph","text":"III"},{"type":"paragraph","text":"Фу ты, леший! Сестренка здеся,"},{"type":"paragraph","text":"Дом целехонек… что за блажь!"},{"type":"paragraph","text":"Ходит пастырь с мудреной вестью,"},{"type":"paragraph","text":"Ставит-ладит златой шалаш…"},{"type":"paragraph","text":"Ворохнулся младенчик хлипко,"},{"type":"paragraph","text":"Ткнула соску ему жена;"},{"type":"paragraph","text":"Поскрипела недолго зыбка,"},{"type":"paragraph","text":"Тишь да гладь… Петухи… Луна…"},{"type":"paragraph","text":"IV"},{"type":"paragraph","text":"Высуну в окно"},{"type":"paragraph","text":"Несуразную"},{"type":"paragraph","text":"Рожу,"},{"type":"paragraph","text":"Надышусь"},{"type":"paragraph","text":"Сеновалом"},{"type":"paragraph","text":"И летом,"},{"type":"paragraph","text":"Авось"},{"type":"paragraph","text":"Малость"},{"type":"paragraph","text":"Вздремну-усну…"},{"type":"paragraph","text":"Нету!"},{"type":"paragraph","text":"Напирает"},{"type":"paragraph","text":"Бередит одно"},{"type":"paragraph","text":"Да то же:"},{"type":"paragraph","text":"Как жилось,"},{"type":"paragraph","text":"Что знавала"},{"type":"paragraph","text":"В свою весну"},{"type":"paragraph","text":"Чумазая"},{"type":"paragraph","text":"Русь."},{"type":"paragraph","text":"V"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Накрывается тучей-схимою"},{"type":"paragraph","text":"Вышний пастырь, а звезды кудесно"},{"type":"paragraph","text":"Ярки."},{"type":"paragraph","text":"Вот встают они, праотцы, деды,"},{"type":"paragraph","text":"Отцы мои —"},{"type":"paragraph","text":"Мужики, мужики, мужики!"},{"type":"paragraph","text":"Всласть поели немного вы ситного,"},{"type":"paragraph","text":"Пмво ячное, мед протекли мимо ртов…"},{"type":"paragraph","text":"За лихое тягло, за судьбу челобитную"},{"type":"paragraph","text":"Быть вам, быть окол райских кустов!"},{"type":"paragraph","text":"VI"},{"type":"paragraph","text":"Тяти! Деды!"},{"type":"paragraph","text":"Лапотники,"},{"type":"paragraph","text":"Пахотники,"},{"type":"paragraph","text":"Чернокостники — смерды!"},{"type":"paragraph","text":"А кто с альпийских лысин"},{"type":"paragraph","text":"Свистнул"},{"type":"paragraph","text":"На весь мир?"},{"type":"paragraph","text":"Вы!"},{"type":"paragraph","text":"Вы!"},{"type":"paragraph","text":"Кто песенных"},{"type":"paragraph","text":"Жар-птиц метнул по свету?"},{"type":"paragraph","text":"Вы!"},{"type":"paragraph","text":"Вы!"},{"type":"paragraph","text":"Печальники,"},{"type":"paragraph","text":"Кабальники,"},{"type":"paragraph","text":"Безвестники,"},{"type":"paragraph","text":"Смерды…"},{"type":"paragraph","text":"VII"},{"type":"paragraph","text":"Тихо… тихо…"},{"type":"paragraph","text":"А сердце все мечется, мечется,"},{"type":"paragraph","text":"Все торчу у окна,"},{"type":"paragraph","text":"Не сплю…"},{"type":"paragraph","text":"И мерещится:"},{"type":"paragraph","text":"Не луна —"},{"type":"paragraph","text":"Салтычиха,"},{"type":"paragraph","text":"Салтычиха,"},{"type":"paragraph","text":"Мне бросает на шею петлю!.."},{"type":"paragraph","text":"VIII"},{"type":"paragraph","text":"Али Спас никогда не поможет?"},{"type":"paragraph","text":"Вековечный отмою срам!"},{"type":"paragraph","text":"На коня! Где булатный ножик?"},{"type":"paragraph","text":"Ускачу к донским ковылям!"},{"type":"paragraph","text":"Снеговые пусть плачут хлопья"},{"type":"paragraph","text":"Над костями, под вьюжный пляс!"},{"type":"paragraph","text":"Глубже Волги тоска холопья!"},{"type":"paragraph","text":"Рассчитаюсь, отцы, за вас!"},{"type":"paragraph","text":"IX"},{"type":"paragraph","text":"Храпанула пеганка… Чую,"},{"type":"paragraph","text":"Лезет шатко к ней домовой…"},{"type":"paragraph","text":"Вышний пастырь вблизи кочует"},{"type":"paragraph","text":"И глядит на шалашик свой."},{"type":"paragraph","text":"Нету схимы, сиянье льется,"},{"type":"paragraph","text":"Да словес золотых не понять…"},{"type":"paragraph","text":"Положил клюку у колодца,"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Домовой от пеганки — драть."},{"type":"paragraph","text":"X"},{"type":"paragraph","text":"… Мамыньки! Баушки!"},{"type":"paragraph","text":"Арины Родионовны!"},{"type":"paragraph","text":"Зацапанные барами —"},{"type":"paragraph","text":"Блуднями"},{"type":"paragraph","text":"Для соромной забавушки!"},{"type":"paragraph","text":"Рано вас сгорбили"},{"type":"paragraph","text":"Буднями"},{"type":"paragraph","text":"Черными!"},{"type":"paragraph","text":"Радости видано много ли?"},{"type":"paragraph","text":"Не вы ли"},{"type":"paragraph","text":"Поили"},{"type":"paragraph","text":"Песнями, сказами ярыми"},{"type":"paragraph","text":"Пушкиных, Корсаковых, Гоголей!"},{"type":"paragraph","text":"А самим — оплеухи, пинки,"},{"type":"paragraph","text":"Синяки,"},{"type":"paragraph","text":"Да могилки незнаемые, убогие!"},{"type":"paragraph","text":"XI"},{"type":"paragraph","text":"Распалилась мужицкая дума!"},{"type":"paragraph","text":"Чу, засеченных смертный крик!"},{"type":"paragraph","text":"Брызжут искры костра Аввакума,"},{"type":"paragraph","text":"Слышу Разина грозный зык!"},{"type":"paragraph","text":"Эй, Ивана Великого вышка,"},{"type":"paragraph","text":"Разнеси-ка пожарче звон!"},{"type":"paragraph","text":"Да не я ли Отрепьев Гришка?"},{"type":"paragraph","text":"Только я не отдал свой трон!"},{"type":"paragraph","text":"XII"},{"type":"paragraph","text":"Пьянчуги,"},{"type":"paragraph","text":"Святые угодники,"},{"type":"paragraph","text":"Муромцы, Пугачи, Ермаки,"},{"type":"paragraph","text":"Юродные, буйноголовые —"},{"type":"paragraph","text":"Други!"},{"type":"paragraph","text":"Сродники! Сродники!"},{"type":"paragraph","text":"Бью челом вам я,"},{"type":"paragraph","text":"Бью челом."},{"type":"paragraph","text":"XIII"},{"type":"paragraph","text":"Крест ли, меч ли возьму — не знаю,"},{"type":"paragraph","text":"Помолюсь кому — невдомек!"},{"type":"paragraph","text":"Только в каждом — душа родная!"},{"type":"paragraph","text":"Каждый с лаской меня берег."},{"type":"paragraph","text":"Для чего?"},{"type":"paragraph","text":"Да не выпрыгни, сердце!"},{"type":"paragraph","text":"Знаю! Понял! Не блажь, не бред!"},{"type":"paragraph","text":"Душегубцы и страстотерпцы,"},{"type":"paragraph","text":"На холопский гляньте рассвет!"},{"type":"paragraph","text":"XIV"},{"type":"paragraph","text":"Ой, да скинем, братцы,"},{"type":"paragraph","text":"Шобоны!"},{"type":"paragraph","text":"Не иное ль уготовано!"},{"type":"paragraph","text":"Может, святцы-то"},{"type":"paragraph","text":"Облыжные:"},{"type":"paragraph","text":"Да смеяться,"},{"type":"paragraph","text":"А не плакать нам!"},{"type":"paragraph","text":"Эвон что на нас накаркали!"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Зарудеем, братцы,"},{"type":"paragraph","text":"Вишнями!"},{"type":"paragraph","text":"Выходи на загулянье!"},{"type":"paragraph","text":"На велико пированье!"},{"type":"paragraph","text":"Подымайся, солнце жаркое!"},{"type":"paragraph","text":"Зазвони, пляши над крышами!"},{"type":"paragraph","text":"XV"},{"type":"paragraph","text":"… Прокричал о заре байку кочет,"},{"type":"paragraph","text":"Засмеялась она…"},{"type":"paragraph","text":"На покой"},{"type":"paragraph","text":"Вышний пастырь идет и пророчит,"},{"type":"paragraph","text":"Над моей все пророчит башкой."},{"type":"paragraph","text":"1921"}]}]}