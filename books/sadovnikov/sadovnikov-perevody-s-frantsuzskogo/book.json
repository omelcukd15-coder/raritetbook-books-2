{"id":"sadovnikov-perevody-s-frantsuzskogo","slug":"sadovnikov-perevody-s-frantsuzskogo","shard":1,"title":"Переводы с французского","altTitles":[],"author":"Дмитрий Николаевич Садовников","authorShort":"Д. Н. Садовников","authorSlug":"sadovnikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1883","editionYear":"1883","description":"(1855—1929 гг.)","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9F%D0%B5%D1%80%D0%B5%D0%B2%D0%BE%D0%B4%D1%8B_%D1%81_%D1%84%D1%80%D0%B0%D0%BD%D1%86%D1%83%D0%B7%D1%81%D0%BA%D0%BE%D0%B3%D0%BE_%28%D0%A1%D0%B0%D0%B4%D0%BE%D0%B2%D0%BD%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1883)","downloadAllowed":true,"fb2Url":"/archive/books/sadovnikov/sadovnikov-perevody-s-frantsuzskogo/original.fb2","coverUrl":"/archive/books/sadovnikov/sadovnikov-perevody-s-frantsuzskogo/cover.webp","stats":{"chaptersCount":4,"wordsCount":1378,"charsCount":8416,"readingMinutes":8},"toc":[{"id":"chapter-1","title":"Морис Бушор"},{"id":"chapter-2","title":"Из «Современного Фауста»."},{"id":"chapter-3","title":"Андре Терье"},{"id":"chapter-4","title":"Рене Франсуа Арман Сюлли-Прюдом"}],"chapters":[{"id":"chapter-1","title":"Морис Бушор","content":[{"type":"paragraph","text":"(1855—1929 гг.)."},{"type":"paragraph","text":"Весёлые песни. I."},{"type":"paragraph","text":"Для философа-бродяги"},{"type":"paragraph","text":"Всюду пища, всюду тема:"},{"type":"paragraph","text":"На любом просёлке пыльном"},{"type":"paragraph","text":"Вырастает вдруг поэма."},{"type":"paragraph","text":"Путь хорош — я отправляюсь:"},{"type":"paragraph","text":"Опьяняющим мечтаньям"},{"type":"paragraph","text":"Предаюсь и восхищаюсь —"},{"type":"paragraph","text":"Ну, хоть солнечным сияньем…"},{"type":"paragraph","text":"Провожу цыганом истым"},{"type":"paragraph","text":"Ночь в лесу, под небом чистым;"},{"type":"paragraph","text":"На заре иду опять,"},{"type":"paragraph","text":"И, вдобавок, дарованьем"},{"type":"paragraph","text":"Обладаю: смех с рыданьем"},{"type":"paragraph","text":"В смелой песне сочетать."},{"type":"paragraph","text":"II."},{"type":"paragraph","text":"Из цветов моя милая — лучший цветок"},{"type":"paragraph","text":"И светлей самой радостной грёзы;"},{"type":"paragraph","text":"От неё по стволам бьёт живительный сок"},{"type":"paragraph","text":"И росы осушаются слёзы."},{"type":"paragraph","text":"Всё при ней получает особенный свет:"},{"type":"paragraph","text":"Соловей запевает свой лучший куплет,"},{"type":"paragraph","text":"А душистая зыбь белокурых волос"},{"type":"paragraph","text":"Оживляет дыхание роз."},{"type":"paragraph","text":"И когда в белом платье мелькает она"},{"type":"paragraph","text":"Меж дерев, как фиалка лесная, скромна,"},{"type":"paragraph","text":"Я подругу свою молодую"},{"type":"paragraph","text":"Принимаю за фею земную."},{"type":"paragraph","text":"III."},{"type":"paragraph","text":"Близок день, когда, как боги,"},{"type":"paragraph","text":"Удивляя мир окрестный,"},{"type":"paragraph","text":"Мы наденем яркий пурпур,"},{"type":"paragraph","text":"Бросив платья траур тесный;"},{"type":"paragraph","text":"Или, в бархат драпируясь,"},{"type":"paragraph","text":"Станем в царственные позы"},{"type":"paragraph","text":"И от мимо проходящих"},{"type":"paragraph","text":"Будем ждать апофеоза."},{"type":"paragraph","text":"Под плюмажем чёрной шляпы,"},{"type":"paragraph","text":"Под кокетливым беретом —"},{"type":"paragraph","text":"Мы откроем шумный праздник"},{"type":"paragraph","text":"Феерическим балетом."},{"type":"paragraph","text":"Кто-нибудь возьмёт гитару,"},{"type":"paragraph","text":"Ток наденет оперённый,"},{"type":"paragraph","text":"Под окном любой красотки"},{"type":"paragraph","text":"Распевая, как влюблённый."},{"type":"paragraph","text":"Кто-нибудь в фламандской шляпе,"},{"type":"paragraph","text":"Ус кручёный выставляя,"},{"type":"paragraph","text":"Расположится у бочки,"},{"type":"paragraph","text":"Шумно жажду утоляя."},{"type":"paragraph","text":"И в костюмах разнородных,"},{"type":"paragraph","text":"По профессии одеты,"},{"type":"paragraph","text":"Вместе съедемся в Париже"},{"type":"paragraph","text":"Мы — артисты и поэты."},{"type":"paragraph","text":"Под напев весёлых песен"},{"type":"paragraph","text":"Гордо двинемся верхами"},{"type":"paragraph","text":"И в блестящих колесницах,"},{"type":"paragraph","text":"А полиция — за нами."},{"type":"paragraph","text":"Ну, а если горожане"},{"type":"paragraph","text":"Пустят в нас свои каменья —"},{"type":"paragraph","text":"Мы поклонами ответим"},{"type":"paragraph","text":"Горделивого презренья."},{"type":"paragraph","text":"1882 г."}]},{"id":"chapter-2","title":"Из «Современного Фауста».","content":[{"type":"paragraph","text":"Сонеты Фауста. I."},{"type":"paragraph","text":"С одной тоской делю свои скитанья —"},{"type":"paragraph","text":"Пусть небо, празднуя свободу и покой,"},{"type":"paragraph","text":"Мильоны ярких звёзд зажжёт над головой,"},{"type":"paragraph","text":"Не попрошу у звёзд я состраданья."},{"type":"paragraph","text":"Светилу дня не услыхать признанья:"},{"type":"paragraph","text":"Бесстрастно и оно, как этот мир земной,"},{"type":"paragraph","text":"Лишённый разума, холодный и немой"},{"type":"paragraph","text":"И умереть готовый без сознанья."},{"type":"paragraph","text":"Моя душа таит лишь отраженье"},{"type":"paragraph","text":"Бегущих лет, могучее стремленье,"},{"type":"paragraph","text":"Несущее Вселенную вперёд…"},{"type":"paragraph","text":"Напрасно я найти ответ стараюсь:"},{"type":"paragraph","text":"Никто тоски гнетущей не поймёт;"},{"type":"paragraph","text":"И я под гнётом дум своих склоняюсь."},{"type":"paragraph","text":"II."},{"type":"paragraph","text":"На оргии, где крики шум и пенье,"},{"type":"paragraph","text":"Где вился дым и пенился бокал,"},{"type":"paragraph","text":"Я, как больной, почти изнемогал,"},{"type":"paragraph","text":"А ум терзало старое сомненье."},{"type":"paragraph","text":"О женщины, годитесь ли в сравненье"},{"type":"paragraph","text":"Вы с той, чьих уст улыбку я срывал?"},{"type":"paragraph","text":"А ты, вино… Твой пурпур и опал…"},{"type":"paragraph","text":"Я пил его в минуты вдохновенья!"},{"type":"paragraph","text":"Нет, ни вино, ни песня, ни лобзание"},{"type":"paragraph","text":"Не освежат! Я, прочное создание,"},{"type":"paragraph","text":"Бежать бы должен с пира суеты…"},{"type":"paragraph","text":"Испивши чашу жизненного яда,"},{"type":"paragraph","text":"Ужель найти, безумец, хочешь ты"},{"type":"paragraph","text":"Могилу дум в отраве винограда?"},{"type":"paragraph","text":"III."},{"type":"paragraph","text":"Без Бога мир, ничем не возмутимый,"},{"type":"paragraph","text":"Свершает празднично обыденный свой ход,"},{"type":"paragraph","text":"Безостановочно ведёт круговорот,"},{"type":"paragraph","text":"Где дни весны сменяются на зимы."},{"type":"paragraph","text":"Мир движется вперёд неутомимый;"},{"type":"paragraph","text":"И что же? Человек его порой клянёт,"},{"type":"paragraph","text":"Порой ему благодаренья шлёт,"},{"type":"paragraph","text":"Забыв про то, что он неумолимый!"},{"type":"paragraph","text":"Вселенная, лишённая сознанья,"},{"type":"paragraph","text":"Не слушает молитвы и стенанья."},{"type":"paragraph","text":"Умрём — на прахе вырастут цветы…"},{"type":"paragraph","text":"Она, не мучаясь безумною тоскою,"},{"type":"paragraph","text":"Стирает всё: и скорби и мечты,"},{"type":"paragraph","text":"И давит сердце мне лавиной снеговою."},{"type":"paragraph","text":"IV."},{"type":"paragraph","text":"Ах, если б это небо вдруг упало,"},{"type":"paragraph","text":"А море запылало, как горнило!.."},{"type":"paragraph","text":"Когда бы мир всё это обновило"},{"type":"paragraph","text":"И легче грудь усталая дышала!"},{"type":"paragraph","text":"Что, если бы в порыве бури, шквала"},{"type":"paragraph","text":"Дождём из звёзд всю землю затопило"},{"type":"paragraph","text":"И в хаосе бездонном поглотило"},{"type":"paragraph","text":"Весь этот мир, где радостей так мало?"},{"type":"paragraph","text":"Но нет… Лазурь по-прежнему сияет,"},{"type":"paragraph","text":"Дыханье трав как фимиам взлетает,"},{"type":"paragraph","text":"Сливается с пурпуровым закатом."},{"type":"paragraph","text":"Лишь я один; суровый и угрюмый,"},{"type":"paragraph","text":"Хоть залит край небес вечерним златом,"},{"type":"paragraph","text":"Несу с собой повсюду те же думы."},{"type":"paragraph","text":"1882 г."}]},{"id":"chapter-3","title":"Андре Терье","content":[{"type":"paragraph","text":"(1833—1907 гг.)."},{"type":"paragraph","text":"Крестьянская мыза. Вокруг крестьянской мызы"},{"type":"paragraph","text":"Стоить лесная тишь;"},{"type":"paragraph","text":"Весь двор зарос травою,"},{"type":"paragraph","text":"Трава на склоне крыш…"},{"type":"paragraph","text":"Меж городом и мызой"},{"type":"paragraph","text":"Лежит сплошной оплот"},{"type":"paragraph","text":"Лесов необозримых"},{"type":"paragraph","text":"И высохших болот…"},{"type":"paragraph","text":"На мызе доживает"},{"type":"paragraph","text":"Шестой десяток лет"},{"type":"paragraph","text":"Старик — ещё здоровый,"},{"type":"paragraph","text":"Широкоплечий дед;"},{"type":"paragraph","text":"Затем, работник ловкий —"},{"type":"paragraph","text":"Его женатый сын,"},{"type":"paragraph","text":"Да внучек малолетний,"},{"type":"paragraph","text":"Крикливый властелин."},{"type":"paragraph","text":"Едва ль не больше века"},{"type":"paragraph","text":"Здесь, — в стороне глухой, —"},{"type":"paragraph","text":"Работало семейство"},{"type":"paragraph","text":"Косою и сохой."},{"type":"paragraph","text":"Кровать стояла та же"},{"type":"paragraph","text":"И сотню лет назад;"},{"type":"paragraph","text":"Качалка укачала"},{"type":"paragraph","text":"Десятка два ребят."},{"type":"paragraph","text":"И счастливы на мызе;"},{"type":"paragraph","text":"В апреле всё поёт;"},{"type":"paragraph","text":"В июне земляника,"},{"type":"paragraph","text":"Под осень зреет плод."},{"type":"paragraph","text":"Даст Бог и урожая"},{"type":"paragraph","text":"От брошенных семян,"},{"type":"paragraph","text":"А внучек подрастает, —"},{"type":"paragraph","text":"И славный мальчуган."},{"type":"paragraph","text":"Случается нередко"},{"type":"paragraph","text":"Прохожий вечерком"},{"type":"paragraph","text":"Зайдёт и порасскажет"},{"type":"paragraph","text":"О слухе городском, —"},{"type":"paragraph","text":"Но вести отчего-то,"},{"type":"paragraph","text":"Пройдя окрестный лес,"},{"type":"paragraph","text":"Размеры принимают"},{"type":"paragraph","text":"Неслыханных чудес."},{"type":"paragraph","text":"И так идут за днями"},{"type":"paragraph","text":"Однообразно дни,"},{"type":"paragraph","text":"Обычные заботы"},{"type":"paragraph","text":"Ведут с собой они."},{"type":"paragraph","text":"Простые эти люди —"},{"type":"paragraph","text":"В работе круглый год,"},{"type":"paragraph","text":"А мальчик здоровеет"},{"type":"paragraph","text":"И по часам растёт."},{"type":"paragraph","text":"Начнёт и он работать,"},{"type":"paragraph","text":"Не опуская рук, —"},{"type":"paragraph","text":"Махать цепом проворным,"},{"type":"paragraph","text":"Вести тяжелый плуг;"},{"type":"paragraph","text":"А ус когда пробьется"},{"type":"paragraph","text":"Да стукнет двадцать лет, —"},{"type":"paragraph","text":"И в сердце развернется"},{"type":"paragraph","text":"Любви весенний цвет;"},{"type":"paragraph","text":"Жену себе в соседях"},{"type":"paragraph","text":"Возьмёт он в свой черёд, —"},{"type":"paragraph","text":"Когда его в солдаты"},{"type":"paragraph","text":"Сержант не заберёт,"},{"type":"paragraph","text":"Негаданно-нежданно"},{"type":"paragraph","text":"Не выбросит войной"},{"type":"paragraph","text":"На чуждую границу"},{"type":"paragraph","text":"С шинелью за спиной…"},{"type":"paragraph","text":"1882 г."},{"type":"paragraph","text":"Малиновка. Когда проходит май, кончается весна,"},{"type":"paragraph","text":"Малиновку в саду я часто вспоминаю:"},{"type":"paragraph","text":"В тени орешника, на гнёздышке она"},{"type":"paragraph","text":"Поёт привет красавцу маю."},{"type":"paragraph","text":"Цветущий ломонос, приманка для роёв,"},{"type":"paragraph","text":"Прикрыл её гнездо, от взоров охраняя,"},{"type":"paragraph","text":"И вот она поёт в густой тени кустов"},{"type":"paragraph","text":"О блеске и сиянье мая."},{"type":"paragraph","text":"Как песня коротка! Могу её сравнить"},{"type":"paragraph","text":"С минутной радостью, подругою страданья;"},{"type":"paragraph","text":"Она мне говорит: «Весны не воротить,"},{"type":"paragraph","text":"А с ней и жизни обаянья»."},{"type":"paragraph","text":"Не в силах мы цветы весенние вернуть,"},{"type":"paragraph","text":"Рождённые от ласк проснувшейся природы, —"},{"type":"paragraph","text":"Ни первую любовь, попавшую к нам в грудь,"},{"type":"paragraph","text":"Ни молодые наши годы."},{"type":"paragraph","text":"1883 г."},{"type":"paragraph","text":"Ласточки. Под карнизами окон, вблизи черепиц,"},{"type":"paragraph","text":"Мы впервые открыли глаза;"},{"type":"paragraph","text":"Там носились мы вольною стаею птиц,"},{"type":"paragraph","text":"Возле стен, где взбегает лоза."},{"type":"paragraph","text":"Задрожала трава от угроз сентября,"},{"type":"paragraph","text":"Собрались все мы дружно в отлёт"},{"type":"paragraph","text":"К той земля, где кругом так синеют моря,"},{"type":"paragraph","text":"Где так солнце горячее жжёт."},{"type":"paragraph","text":"Мы сидели на розовом сфинксе песков,"},{"type":"paragraph","text":"Что глядит в предрассветную даль,"},{"type":"paragraph","text":"Но оставленных жаль было нам городов"},{"type":"paragraph","text":"И покинутых гнёзд было жаль…"},{"type":"paragraph","text":"Колокольня знакомая снилась опять,"},{"type":"paragraph","text":"Рядом лип благовонная сень;"},{"type":"paragraph","text":"Старый мост, под который привыкли летать,"},{"type":"paragraph","text":"Где такая отрадная тень."},{"type":"paragraph","text":"Мы скучали в пустыне о крае родном,"},{"type":"paragraph","text":"О желанной и юной весне,"},{"type":"paragraph","text":"О душистых садах и гнезде под окном"},{"type":"paragraph","text":"На далёкой родной стороне."},{"type":"paragraph","text":"1883 г."},{"type":"paragraph","text":"Перепёлка. Хлеб стоит на ниве спелый и наливный;"},{"type":"paragraph","text":"Ветер пробегает по его волнам…"},{"type":"paragraph","text":"Чу! Раздался в поле смелый и призывный"},{"type":"paragraph","text":"Голос перепёлки, прилетевшей к нам."},{"type":"paragraph","text":"Вечером и рано, рано до рассвета"},{"type":"paragraph","text":"Слышится яснее бой перепелов;"},{"type":"paragraph","text":"И пока над полем тихо дышит лето,"},{"type":"paragraph","text":"Звонко раздаётся их любовный зов:"},{"type":"paragraph","text":"Под! Полоть! Ва! Ва!"},{"type":"paragraph","text":"Истые цыгане! Племя кочевое!"},{"type":"paragraph","text":"Не сегодня — завтра случай вас сведёт."},{"type":"paragraph","text":"Ночью — в одиночку, а под утро двое,"},{"type":"paragraph","text":"Парой веселее, но не без хлопот…"},{"type":"paragraph","text":"Свито из соломы гнёздышко под небом,"},{"type":"paragraph","text":"Есть приют надёжный; стол давно готов:"},{"type":"paragraph","text":"Будете питаться этим спелым хлебом,"},{"type":"paragraph","text":"Бегать меж колосьев и среди цветов."},{"type":"paragraph","text":"Под! Полоть! Ва! Ва!"},{"type":"paragraph","text":"Разбежались детки от родимой матки…"},{"type":"paragraph","text":"Вдруг пришёл охотник, приложился: «Трах»!"},{"type":"paragraph","text":"Как вы испугались, глупые ребятки,"},{"type":"paragraph","text":"Вы ещё не знали, что такое страх!"},{"type":"paragraph","text":"От людей подальше, а не то ведь худо —"},{"type":"paragraph","text":"Бойтесь вы людского страшного ствола;"},{"type":"paragraph","text":"Там из вас готовят лакомые блюда,"},{"type":"paragraph","text":"Сразу попадёте вы на вертела!"},{"type":"paragraph","text":"Под! Полоть! Ва! Ва!"},{"type":"paragraph","text":"Но не знает страха птица кочевая:"},{"type":"paragraph","text":"Тучами садится по разливу нив,"},{"type":"paragraph","text":"Будто против смерти, песни распевая,"},{"type":"paragraph","text":"Жизни посылая радостный призыв,"},{"type":"paragraph","text":"Бодрая, живая странствует по свету"},{"type":"paragraph","text":"Морем и землёю правя свой полёт."},{"type":"paragraph","text":"Каждый год на север прилетает к лету"},{"type":"paragraph","text":"И поёт, и любит, любит, и поёт:"},{"type":"paragraph","text":"Под! Полоть! Ва! Ва!"},{"type":"paragraph","text":"1883 г."}]},{"id":"chapter-4","title":"Рене Франсуа Арман Сюлли-Прюдом","content":[{"type":"paragraph","text":"(1839—1907 гг.)."},{"type":"paragraph","text":"Возвращаясь из музея. Возвращаясь из музея,"},{"type":"paragraph","text":"Где стоят, как снег, белея,"},{"type":"paragraph","text":"Полны гордого молчанья"},{"type":"paragraph","text":"Афродиты (в древнегреческой мифологии, богини красоты и любви, той же, что в римской — Венеры) изваянья,"},{"type":"paragraph","text":"Думал я, что эти боги"},{"type":"paragraph","text":"Рождены стоять в чертоге (чертог (устар.) — пышное, великолепное здание или помещение):"},{"type":"paragraph","text":"Прелесть их неоценима…"},{"type":"paragraph","text":"Но когда прошла ты мимо —"},{"type":"paragraph","text":"Заслонило мир искусства"},{"type":"paragraph","text":"Сердца тягостное чувство —"},{"type":"paragraph","text":"Афродита в пышном зале;"},{"type":"paragraph","text":"С этой чудной головкой"},{"type":"paragraph","text":"Ты идёшь походкой лёгкой,"},{"type":"paragraph","text":"В старом платье, вьются сзади"},{"type":"paragraph","text":"Кос волнистых, пышных пряди…"},{"type":"paragraph","text":"День и ночь иглой проворной"},{"type":"paragraph","text":"Ты работаешь упорно:"},{"type":"paragraph","text":"Вижу — палец твой исколот;"},{"type":"paragraph","text":"В дверь стучат нужда и голод, —"},{"type":"paragraph","text":"Чуждый жизненной тревоги,"},{"type":"paragraph","text":"Мрамор просится в чертоги:"},{"type":"paragraph","text":"Ты же, бедное созданье,"},{"type":"paragraph","text":"Скромно просишь подаянья."},{"type":"paragraph","text":"Не обставят, как статую,"},{"type":"paragraph","text":"Красоту твою живую:"},{"type":"paragraph","text":"Будит в нас восторга пламень"},{"type":"paragraph","text":"Лишь один бездушный камень."},{"type":"paragraph","text":"Да, с тобой судьба сурова."},{"type":"paragraph","text":"Ищешь хлеба ты и крова."},{"type":"paragraph","text":"Мертвецы — на пьедесталах,"},{"type":"paragraph","text":"А живые мрут в подвалах."},{"type":"paragraph","text":"1883 г."}]}]}