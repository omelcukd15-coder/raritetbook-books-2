{"id":"pleshcheev-perevody-s-angliyskogo","slug":"pleshcheev-perevody-s-angliyskogo","shard":1,"title":"Переводы с английского","altTitles":[],"author":"Алексей Николаевич Плещеев","authorShort":"А. Н. Плещеев","authorSlug":"pleshcheev","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1881","editionYear":"1881","description":"Переводы с английского","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9F%D0%B5%D1%80%D0%B5%D0%B2%D0%BE%D0%B4%D1%8B_%D1%81_%D0%B0%D0%BD%D0%B3%D0%BB%D0%B8%D0%B9%D1%81%D0%BA%D0%BE%D0%B3%D0%BE_%28%D0%9F%D0%BB%D0%B5%D1%89%D0%B5%D0%B5%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1881)","downloadAllowed":true,"fb2Url":"/archive/books/pleshcheev/pleshcheev-perevody-s-angliyskogo/original.fb2","coverUrl":"/archive/books/pleshcheev/pleshcheev-perevody-s-angliyskogo/cover.webp","stats":{"chaptersCount":3,"wordsCount":704,"charsCount":4019,"readingMinutes":4},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Переводы с английского"},{"type":"paragraph","text":"НЕИЗВЕСТНЫЕ ПОЭТЫ"},{"type":"paragraph","text":"ЖАЛОБА ИРЛАНДСКОГО ВЫХОДЦА"},{"type":"paragraph","text":"Иду я тропинкой заглохшей,"},{"type":"paragraph","text":"Поникнув на грудь головой."},{"type":"paragraph","text":"Здесь утром весенним однажды"},{"type":"paragraph","text":"Мы встретились, Мери, с тобой."},{"type":"paragraph","text":"Зеленая рожь колыхалась,"},{"type":"paragraph","text":"И звонко пел зяблик в кустах,"},{"type":"paragraph","text":"Светилась любовь в твоем взоре,"},{"type":"paragraph","text":"И розы цвели на устах."},{"type":"paragraph","text":"Но многое здесь изменилось:"},{"type":"paragraph","text":"Всё так же прекрасна весна,"},{"type":"paragraph","text":"По-прежнему рожь зеленеет"},{"type":"paragraph","text":"И зяблика песня слышна."},{"type":"paragraph","text":"Но руки твои, дорогая,"},{"type":"paragraph","text":"Моих не сжимают уж рук,"},{"type":"paragraph","text":"И тщетно хочу я услышать"},{"type":"paragraph","text":"Любимого голоса звук!"},{"type":"paragraph","text":"Знакомая взорам ограда"},{"type":"paragraph","text":"Белеет опять предо мной-"},{"type":"paragraph","text":"Ограда той маленькой церкви,"},{"type":"paragraph","text":"Где н’азвал тебя я женой."},{"type":"paragraph","text":"А вот и погост… Нарушают"},{"type":"paragraph","text":"Шаги мои часто твой сон…"},{"type":"paragraph","text":"Сюда отнесли тебя, Мери;"},{"type":"paragraph","text":"И здесь же твой сын схоронен…"},{"type":"paragraph","text":"Теперь я один, моя Мери,"},{"type":"paragraph","text":"Не нужен бедняк никому;"},{"type":"paragraph","text":"Но тем дорожит он сильнее"},{"type":"paragraph","text":"Могилами близких ему."},{"type":"paragraph","text":"Была моя жизнь трудовая"},{"type":"paragraph","text":"Тобою одной лишь светла,"},{"type":"paragraph","text":"И некого больше любить мне"},{"type":"paragraph","text":"С тех пор, как ты в землю сошла."},{"type":"paragraph","text":"Слабели не раз мои силы"},{"type":"paragraph","text":"Под гнетом нужды и труда,"},{"type":"paragraph","text":"И к небу и к людям кипела"},{"type":"paragraph","text":"В измученном сердце вражда!"},{"type":"paragraph","text":"Но ты, ты не падала духом,"},{"type":"paragraph","text":"Ясна оставалась в борьбе,"},{"type":"paragraph","text":"И вот почему я взываю,"},{"type":"paragraph","text":"Хоть ты и не слышишь, к тебе:"},{"type":"paragraph","text":"Спасибо тебе, дорогая!"},{"type":"paragraph","text":"Ведь голод томил и тебя…"},{"type":"paragraph","text":"И ты настрадалась немало,"},{"type":"paragraph","text":"Но только молчала, любя."},{"type":"paragraph","text":"Спасибо тебе за улыбку,"},{"type":"paragraph","text":"За каждый сердечный привет…"},{"type":"paragraph","text":"Спасибо за то, что ушла ты"},{"type":"paragraph","text":"В тот край, где страдания нет!"},{"type":"paragraph","text":"Надолго с тобой я прощаюсь…"},{"type":"paragraph","text":"Пройдут на чужбине года,"},{"type":"paragraph","text":"И старость настанет; но помнить"},{"type":"paragraph","text":"О Мери я буду всегда."}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Они говорят, что работы"},{"type":"paragraph","text":"Там больше и солнце ясней…"},{"type":"paragraph","text":"Но всё буду сердцем стремиться"},{"type":"paragraph","text":"Я к родине бедной своей!"},{"type":"paragraph","text":"Закрою ль глаза я порою,"},{"type":"paragraph","text":"Бродя в первобытных лесах,"},{"type":"paragraph","text":"Туда унесут меня мысли,"},{"type":"paragraph","text":"Где милый покоится прах…"},{"type":"paragraph","text":"Мне будет казаться, что Мери"},{"type":"paragraph","text":"Ко мне, улыбаясь, идет,"},{"type":"paragraph","text":"И рожь зеленеет, и зяблик"},{"type":"paragraph","text":"В кустах свою песню поет."},{"type":"paragraph","text":"(1867)"},{"type":"paragraph","text":"ПОИСКИ"},{"type":"paragraph","text":"Ищите его по долинам,"},{"type":"paragraph","text":"Где быстрые реки журчат,"},{"type":"paragraph","text":"На горных вершинах ищите,"},{"type":"paragraph","text":"Где жалобно птицы кричат,"},{"type":"paragraph","text":"В пустыне, где странников звезды"},{"type":"paragraph","text":"Путем незнакомым ведут."},{"type":"paragraph","text":"Того, кто мне жизни дороже,"},{"type":"paragraph","text":"Быть может, найдете вы тут."},{"type":"paragraph","text":"Искали они его всюду,"},{"type":"paragraph","text":"Кипя беспредельной враждой;"},{"type":"paragraph","text":"Искали в оврагах, поросших"},{"type":"paragraph","text":"Высокой шумящей травой,"},{"type":"paragraph","text":"И бешено к горным ущельям"},{"type":"paragraph","text":"Своих они гнали коней;"},{"type":"paragraph","text":"Но тщетно: он был уж далеко…"},{"type":"paragraph","text":"Позорных избег он цепей."},{"type":"paragraph","text":"Чего они мне ни сулили,"},{"type":"paragraph","text":"Чтоб я им сказала, в каких"},{"type":"paragraph","text":"Местах отдаленных укрыться"},{"type":"paragraph","text":"Изгнаннику легче от них."},{"type":"paragraph","text":"Глупцы! Если б даже корона"},{"type":"paragraph","text":"Наградою быть мне могла,"},{"type":"paragraph","text":"Улыбку гонимого ими"},{"type":"paragraph","text":"Короне бы я предпочла!"},{"type":"paragraph","text":"Украдкой ему приносила"},{"type":"paragraph","text":"Я хлеба, вина и плодов;"},{"type":"paragraph","text":"В об’ятьях его проводила"},{"type":"paragraph","text":"Я много счастливых часов."},{"type":"paragraph","text":"От мест, где мой милый укрылся,"},{"type":"paragraph","text":"Бегите, враги! У него"},{"type":"paragraph","text":"В запасе есть меткие пули…"},{"type":"paragraph","text":"Они не щадят никого!"},{"type":"paragraph","text":"Искали они его всюду:"},{"type":"paragraph","text":"В долинах, в лесу и в горах,"},{"type":"paragraph","text":"И криком своим наводили"},{"type":"paragraph","text":"На женщин и девушек страх;"},{"type":"paragraph","text":"А в чаще лесной, где сплелися"},{"type":"paragraph","text":"И дуб, и орешник, и вяз,"},{"type":"paragraph","text":"Я сон беглеца охраняла,"},{"type":"paragraph","text":"К его изголовью склонясь…"},{"type":"paragraph","text":"(1873)"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"ЛЕГЕНДА"},{"type":"paragraph","text":"Был у Христа-младенца сад,"},{"type":"paragraph","text":"И много роз взрастил он в нем;"},{"type":"paragraph","text":"Он трижды в день их поливал,"},{"type":"paragraph","text":"Чтоб сплесть венок себе потом."},{"type":"paragraph","text":"Когда же розы расцвели,"},{"type":"paragraph","text":"Детей еврейских с’озвал он;"},{"type":"paragraph","text":"Они сорвали по цветку,"},{"type":"paragraph","text":"И сад был весь опустошен."},{"type":"paragraph","text":"«Как ты сплетешь теперь венок?"},{"type":"paragraph","text":"В твоем саду нет больше роз!»"},{"type":"paragraph","text":"— «Вы позабыли, что шипы"},{"type":"paragraph","text":"Остались мне», — сказал Христос."},{"type":"paragraph","text":"И из шипов они сплели"},{"type":"paragraph","text":"Венок колючий для него,"},{"type":"paragraph","text":"И капли крови вместо роз"},{"type":"paragraph","text":"Чело украсили его."},{"type":"paragraph","text":"(1877)"},{"type":"paragraph","text":"ДЖОНИ ФА"},{"type":"paragraph","text":"(Из шотландских народных баллад)"},{"type":"paragraph","text":"Пред замком шумная толпа"},{"type":"paragraph","text":"Цыган поет, играет…"},{"type":"paragraph","text":"Хозяйка замка вниз сошла"},{"type":"paragraph","text":"И песням их внимает…"},{"type":"paragraph","text":"«Пойдем, — сказал ей Джони Фа, —"},{"type":"paragraph","text":"Красавица, со мною,"},{"type":"paragraph","text":"И мужу не сыскать тебя,"},{"type":"paragraph","text":"Ручаюсь головою!..»"},{"type":"paragraph","text":"И обнял правою рукой"},{"type":"paragraph","text":"Красавицу он смело,"},{"type":"paragraph","text":"Кольцо на палец Джони Фа"},{"type":"paragraph","text":"Она свое надела."},{"type":"paragraph","text":"«Прощайте все — родные, муж!"},{"type":"paragraph","text":"Судьба моя такая!"},{"type":"paragraph","text":"Скорее плащ мне, чтоб идти"},{"type":"paragraph","text":"С цыганами могла я."},{"type":"paragraph","text":"В постели пышной ночи я"},{"type":"paragraph","text":"Здесь с мужем проводила;"},{"type":"paragraph","text":"Теперь в лесу зеленом спать"},{"type":"paragraph","text":"Я буду рядом с милым!»"},{"type":"paragraph","text":"Вернулся лорд, и в тот же миг"},{"type":"paragraph","text":"Спросил он, где же супруга."},{"type":"paragraph","text":"«Она с цыганами ушла», —"},{"type":"paragraph","text":"Ответила прислуга."},{"type":"paragraph","text":"«Седлать коней! Недалеко"},{"type":"paragraph","text":"Еще она отсюда."},{"type":"paragraph","text":"Пока я не найду ее,"},{"type":"paragraph","text":"Ни пить, ни есть не буду!»"},{"type":"paragraph","text":"И сорок всадников лихих"},{"type":"paragraph","text":"В погоню поскакали;"},{"type":"paragraph","text":"Но все они до одного"},{"type":"paragraph","text":"В лесу зеленом пали!"},{"type":"paragraph","text":"(1881)"}]}]}