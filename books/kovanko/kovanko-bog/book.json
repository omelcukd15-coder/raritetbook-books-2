{"id":"kovanko-bog","slug":"kovanko-bog","shard":1,"title":"Бог","altTitles":[],"author":"Иван Афанасьевич Кованько","authorShort":"И. А. Кованько","authorSlug":"kovanko","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1902","editionYear":"1902","description":"Ода","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%91%D0%BE%D0%B3_%28%D0%9A%D0%BE%D0%B2%D0%B0%D0%BD%D1%8C%D0%BA%D0%BE%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1902)","downloadAllowed":true,"fb2Url":"/archive/books/kovanko/kovanko-bog/original.fb2","coverUrl":"/archive/books/kovanko/kovanko-bog/cover.webp","stats":{"chaptersCount":4,"wordsCount":826,"charsCount":4989,"readingMinutes":5},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Ода."},{"type":"paragraph","text":"1."},{"type":"paragraph","text":"Затмись в уме, всяк помысл тленный,"},{"type":"paragraph","text":"Исчезни, суетность, мечта!"},{"type":"paragraph","text":"Предмет великий, несравненный"},{"type":"paragraph","text":"Хотят хвалить мои уста:"},{"type":"paragraph","text":"Хотят хвалить существ Начало,"},{"type":"paragraph","text":"Что прежде ввек собой сияло"},{"type":"paragraph","text":"Над тьмой бездонной пустоты,"},{"type":"paragraph","text":"И Коего всемощна сила"},{"type":"paragraph","text":"Единой мыслью сотворила"},{"type":"paragraph","text":"И дня, и ночи красоты."},{"type":"paragraph","text":"2."},{"type":"paragraph","text":"Но сколь возвышенное пенье"},{"type":"paragraph","text":"Быть должно ради темы сей!"},{"type":"paragraph","text":"Здесь и горяще исступленье"},{"type":"paragraph","text":"Мороз полярных есть морей!"},{"type":"paragraph","text":"Где ж почерпнуть довольство жара?"},{"type":"paragraph","text":"О Гекла, Этна, Сольфатара (во всякой другой материи это было бы чрезмерно, а здесь оно прилично изображает величину энтузиазма),"},{"type":"paragraph","text":"Вулканы целой всей Земли!"},{"type":"paragraph","text":"Пролейте в дух мой распалённый"},{"type":"paragraph","text":"Весь огнь, внутри вас заключённый,"},{"type":"paragraph","text":"И, атмосфера, мне внемли!"},{"type":"paragraph","text":"3."},{"type":"paragraph","text":"Внемли — и грому струн священных"},{"type":"paragraph","text":"Вторь миллионами громов,"},{"type":"paragraph","text":"Дабы до самых отдаленных"},{"type":"paragraph","text":"Мой гимн, промчавшись, всех миров,"},{"type":"paragraph","text":"Такой гармонией волшебной"},{"type":"paragraph","text":"В сочувственный восторг, хвалебной"},{"type":"paragraph","text":"Создания все настроить мог;"},{"type":"paragraph","text":"Дабы от края в край Вселенной"},{"type":"paragraph","text":"Стремился хор непректновенный:"},{"type":"paragraph","text":"«Премудр, пресвят, предивен Бог»!!!"},{"type":"paragraph","text":"4."},{"type":"paragraph","text":"Так! Порознь каждого атома"},{"type":"paragraph","text":"Тебе, творец, хвалой должно:"},{"type":"paragraph","text":"Но песнь до Эмпиреев дома"},{"type":"paragraph","text":"Возможет ли вознесть она?"},{"type":"paragraph","text":"Хотя б с стократной быстротою"},{"type":"paragraph","text":"Против предписанной Тобою"},{"type":"paragraph","text":"Луч солнечный квадриллион"},{"type":"paragraph","text":"Веков летел в твои чертоги:"},{"type":"paragraph","text":"Однако от конца дороги"},{"type":"paragraph","text":"Ещё б далёк, далёк был он."},{"type":"paragraph","text":"5."},{"type":"paragraph","text":"Далёк! И путь бы, им свершённый"},{"type":"paragraph","text":"В пути до цели своея —"},{"type":"paragraph","text":"Иглы, со тщаньем утончённой,"},{"type":"paragraph","text":"Едва б был точкой острия."},{"type":"paragraph","text":"О, всеужасная стремнина!"},{"type":"paragraph","text":"О, исступлённая пучина!"},{"type":"paragraph","text":"Здесь херувимский ум падёт!.."},{"type":"paragraph","text":"Какой же глас, какие громы"},{"type":"paragraph","text":"К тебе на вечной славы холмы"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Возмогут донестись?.. Но нет!"},{"type":"paragraph","text":"6."},{"type":"paragraph","text":"Ты с высоты высот беззвестных"},{"type":"paragraph","text":"Зришь средоточие земли;"},{"type":"paragraph","text":"Читаешь мысль духов телесных,"},{"type":"paragraph","text":"Подёнки (насекомого, однодневки) слышишь вздох в пыли."},{"type":"paragraph","text":"И с ясностью такой же звука"},{"type":"paragraph","text":"Для Твоего, как ныне, слуха"},{"type":"paragraph","text":"Гремел стих слабый, бренный сей"},{"type":"paragraph","text":"Ещё во оно мёртво время,"},{"type":"paragraph","text":"Когда стихий хаосно семя"},{"type":"paragraph","text":"Включалося во тьме своей!"},{"type":"paragraph","text":"7."},{"type":"paragraph","text":"Велик Ты, льющий свет, громады"},{"type":"paragraph","text":"В эфире зыбком утвердив!"},{"type":"paragraph","text":"Велик Ты, тварей мириады"},{"type":"paragraph","text":"И в капле влаги породив!.."},{"type":"paragraph","text":"Везде я исступлён Тобою!"},{"type":"paragraph","text":"И там, и здесь мой взор с трубою"},{"type":"paragraph","text":"Несчётны цепи зрит миров,"},{"type":"paragraph","text":"А духи неба просвещены"},{"type":"paragraph","text":"И в звеньях сих цепей Вселенной"},{"type":"paragraph","text":"Находят что-то, правда, вновь!"},{"type":"paragraph","text":"8."},{"type":"paragraph","text":"Хотя же кольца мирозданья"},{"type":"paragraph","text":"Числом и вечности равны (столь же неисчислимы и неизмеримы, как вечность):"},{"type":"paragraph","text":"Но Ты в связи и без слиянья"},{"type":"paragraph","text":"Их разность свойств, величины"},{"type":"paragraph","text":"И внутреннее устроенье"},{"type":"paragraph","text":"Обозреваешь во мгновенье,"},{"type":"paragraph","text":"Держа на длани всё одной…"},{"type":"paragraph","text":"Увы! Увы! Я исчезаю,"},{"type":"paragraph","text":"Когда сравнить себя дерзаю,"},{"type":"paragraph","text":"О бездна многих бездн, с Тобой."},{"type":"paragraph","text":"9."},{"type":"paragraph","text":"Ты безначален, бесконечный,"},{"type":"paragraph","text":"А я едва рождён — и вмиг,"},{"type":"paragraph","text":"Как рдян след молнии быстротечный,"},{"type":"paragraph","text":"Уж гасну в недрах туч густых,"},{"type":"paragraph","text":"Иль сходен с нитью паутины:"},{"type":"paragraph","text":"Лишь ветер дунет, и кончины"},{"type":"paragraph","text":"Моей вина дыханье то."},{"type":"paragraph","text":"Ты непременен, неразделен,"},{"type":"paragraph","text":"Ты в совершенствах беспределен, —"},{"type":"paragraph","text":"Я вихрь, смесь праха, червь, ничто."},{"type":"paragraph","text":"10."},{"type":"paragraph","text":"Ничто — и купно бог могучий!"},{"type":"paragraph","text":"Я горы преношу с их мест,"},{"type":"paragraph","text":"Хожу чрез океан ревущий,"},{"type":"paragraph","text":"Путь меряю комет и звезд,"},{"type":"paragraph","text":"Грозу у неба исторгаю,"},{"type":"paragraph","text":"Трясу землёй и возлагаю"},{"type":"paragraph","text":"Систему Солнечну на вес (астрономам ныне известна величина каждой планеты порознь, и притом известно, что Солнце заключает в 580 раз более вещества в себе, нежели все планеты, вместе взятые)…"},{"type":"paragraph","text":"Ах! Где я? Где?.. В себе теряюсь…"},{"type":"paragraph","text":"Парю… Блуждаю… Низвергаюсь…"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"И сам я бездной стал чудес!"},{"type":"paragraph","text":"11."},{"type":"paragraph","text":"Я бог! Но благостью Твоею,"},{"type":"paragraph","text":"Творец Вселенной, я таков!"},{"type":"paragraph","text":"Я бог! Я бог! И не сотлею,"},{"type":"paragraph","text":"Упавши в хладный смертный ров…"},{"type":"paragraph","text":"О радость!.. И почто ж бы вечность"},{"type":"paragraph","text":"Вливать мне в грудь, коль скоротечность"},{"type":"paragraph","text":"Избрал Ты жребием моим?"},{"type":"paragraph","text":"Так! Ты не можешь быть тираном,"},{"type":"paragraph","text":"Что б муки услаждать обманом,"},{"type":"paragraph","text":"Для продолженья власти им."},{"type":"paragraph","text":"12."},{"type":"paragraph","text":"Пускай, пускай дробятся сферы"},{"type":"paragraph","text":"Над бренною моей главой:"},{"type":"paragraph","text":"Но сквозь алмазный щит сей веры,"},{"type":"paragraph","text":"Воззрев на ужас бури той,"},{"type":"paragraph","text":"Увижу смерть в нём осклабленную,"},{"type":"paragraph","text":"В виссон эфирный облачённую,"},{"type":"paragraph","text":"С ключом от области отрад,"},{"type":"paragraph","text":"Она мне ход прямой укажет,"},{"type":"paragraph","text":"Даст ключ свой с ласкою и скажет:"},{"type":"paragraph","text":"«Спеши Нетления во град»!"},{"type":"paragraph","text":"13."},{"type":"paragraph","text":"Вот! Я и жизни долготою,"},{"type":"paragraph","text":"Не только по уму, есть бог!"},{"type":"paragraph","text":"Каков же Ты, Кто таковою"},{"type":"paragraph","text":"Себя прославить тварью мог!!!"},{"type":"paragraph","text":"Каков Твой образ, свет и сила!!!"},{"type":"paragraph","text":"Ах! Тщетно мысль моя парила"},{"type":"paragraph","text":"Представить начертанье им…"},{"type":"paragraph","text":"Опять в ничтожество ввергаюсь!"},{"type":"paragraph","text":"К Тебе чем выше воскрыляюсь,"},{"type":"paragraph","text":"Тем больше Ты непостижим."},{"type":"paragraph","text":"14."},{"type":"paragraph","text":"Среди невообразимой ночи"},{"type":"paragraph","text":"Сокрыл Ты славы блеск Своей,"},{"type":"paragraph","text":"И даже серафимов очи"},{"type":"paragraph","text":"Лишь видят тень Твоих лучей, —"},{"type":"paragraph","text":"Но даже с тению Твоею"},{"type":"paragraph","text":"Сравнить сиянья я не смею"},{"type":"paragraph","text":"От сопряжённых во одно"},{"type":"paragraph","text":"Несчётных чудных тел горящих,"},{"type":"paragraph","text":"По синеве небес летящих,"},{"type":"paragraph","text":"Пред нею (тенью) и оно (сияние) — пятно!"},{"type":"paragraph","text":"15."},{"type":"paragraph","text":"А если б из твердынь вдруг мрачных"},{"type":"paragraph","text":"Блеснул Ты полной лепотой:"},{"type":"paragraph","text":"То б и бессмертных, огнезрачных,"},{"type":"paragraph","text":"Над всем возвышенных Тобой,"},{"type":"paragraph","text":"Низверг и истребил б навеки."},{"type":"paragraph","text":"Почто же буйны человеки,"},{"type":"paragraph","text":"Почто постичь Тебя хотят,"},{"type":"paragraph","text":"Когда постичь тебя не можно?"},{"type":"paragraph","text":"«Ты есть, — довольно, — то не ложно», —"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Эфир, земля с водой гласят."},{"type":"paragraph","text":"16."},{"type":"paragraph","text":"Но дух мой утомлён полетом,"},{"type":"paragraph","text":"Все силы ослабели в нём, —"},{"type":"paragraph","text":"Благоволи ж хотя б отсветом"},{"type":"paragraph","text":"Ты в сердце воссиять моём!"},{"type":"paragraph","text":"Твоим присутствием священным"},{"type":"paragraph","text":"Оно пребудет утвержденным"},{"type":"paragraph","text":"Против ударов, бед, скорбей;"},{"type":"paragraph","text":"А радостно его биенье —"},{"type":"paragraph","text":"Тебе приятнейшее пенье,"},{"type":"paragraph","text":"Тебе, Отец своих детей!"},{"type":"paragraph","text":"1802 г."},{"type":"paragraph","text":"Источник текста: «Новости русской литературы», ч. 1. 1802 г. С. 9 — 16."}]}]}