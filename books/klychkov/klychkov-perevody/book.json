{"id":"klychkov-perevody","slug":"klychkov-perevody","shard":1,"title":"Переводы","altTitles":[],"author":"Сергей Антонович Клычков","authorShort":"С. А. Клычков","authorSlug":"klychkov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1937","editionYear":"1937","description":"Переводы","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9F%D0%B5%D1%80%D0%B5%D0%B2%D0%BE%D0%B4%D1%8B_%28%D0%9A%D0%BB%D1%8B%D1%87%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1937)","downloadAllowed":true,"fb2Url":"/archive/books/klychkov/klychkov-perevody/original.fb2","coverUrl":"/archive/books/klychkov/klychkov-perevody/cover.webp","stats":{"chaptersCount":6,"wordsCount":1018,"charsCount":5936,"readingMinutes":6},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Переводы"},{"type":"paragraph","text":"Оригинал здесь — http://www.vekperevoda.com/1887/klychkov.htm"},{"type":"paragraph","text":"АКАКИЙ ЦЕРЕТЕЛИ"},{"type":"paragraph","text":"(1840—1915)"},{"type":"paragraph","text":"Я в желчь и боль мешаю слезы"},{"type":"paragraph","text":"И в горький уксус горный мед,"},{"type":"paragraph","text":"И вот"},{"type":"paragraph","text":"Зависимо от дозы"},{"type":"paragraph","text":"Душа то плачет, то поет…"},{"type":"paragraph","text":"Равно на розу"},{"type":"paragraph","text":"И терновник"},{"type":"paragraph","text":"Садится с песней соловей:"},{"type":"paragraph","text":"Так я ль причина, я ль виновник"},{"type":"paragraph","text":"Столь сладкой горечи своей?"},{"type":"paragraph","text":"СЕРДЦЕ ПОЭТА"},{"type":"paragraph","text":"В бурю, в ненастье,"},{"type":"paragraph","text":"В горе,"},{"type":"paragraph","text":"В напасти"},{"type":"paragraph","text":"Сердце поэта — как море…"},{"type":"paragraph","text":"Полны"},{"type":"paragraph","text":"Раздора,"},{"type":"paragraph","text":"Волны,"},{"type":"paragraph","text":"Как горы,"},{"type":"paragraph","text":"Высятся в диком просторе…"},{"type":"paragraph","text":"В гуле и реве,"},{"type":"paragraph","text":"С тучами вровень"},{"type":"paragraph","text":"Гребнями волны свисают…"},{"type":"paragraph","text":"В бешеной качке"},{"type":"paragraph","text":"Лодку рыбачки"},{"type":"paragraph","text":"Так и бросает, так и бросает…"},{"type":"paragraph","text":"В сердце кручина"},{"type":"paragraph","text":"Глубже пучины:"},{"type":"paragraph","text":"Лучше в волненье такое"},{"type":"paragraph","text":"Стать"},{"type":"paragraph","text":"На причале,"},{"type":"paragraph","text":"Ждать"},{"type":"paragraph","text":"Без печали"},{"type":"paragraph","text":"Сладкого часа покоя."},{"type":"paragraph","text":"Жди терпеливо"},{"type":"paragraph","text":"В час непогоды:"},{"type":"paragraph","text":"После угрюмой невзгоды"},{"type":"paragraph","text":"Плавны, красивы"},{"type":"paragraph","text":"Воды прилива —"},{"type":"paragraph","text":"Счастья глубокие воды…"},{"type":"paragraph","text":"Можно без весел"},{"type":"paragraph","text":"Плыть над пучиной,"},{"type":"paragraph","text":"Даже и парус не нужен…"},{"type":"paragraph","text":"Кто ж это бросил,"},{"type":"paragraph","text":"Кто в нее кинул"},{"type":"paragraph","text":"Столько веселых жемчужин?.."},{"type":"paragraph","text":"Я подверну колки потуже,"},{"type":"paragraph","text":"Чтоб в струнах был высокий строй:"},{"type":"paragraph","text":"Пусть правде мой чонгури служит"},{"type":"paragraph","text":"Своею звонкой чистотой…"},{"type":"paragraph","text":"Чтоб в гармоническом созвучьи"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"На струнах трепетала жизнь,"},{"type":"paragraph","text":"И вместе с радостью певучей"},{"type":"paragraph","text":"Страданья жгучие слились…"},{"type":"paragraph","text":"Чтоб строй магнитного двугласья"},{"type":"paragraph","text":"Из сердца каждого исторг"},{"type":"paragraph","text":"И жажду братского участья,"},{"type":"paragraph","text":"И гордый подвига восторг…"},{"type":"paragraph","text":"Чтоб у несчастных, угнетенных"},{"type":"paragraph","text":"Обсохли слезы на глазах,"},{"type":"paragraph","text":"А угнетатель, слыша стон их,"},{"type":"paragraph","text":"Познал раскаянье и страх…"},{"type":"paragraph","text":"С моим чонгури бить баклуши"},{"type":"paragraph","text":"Не буду я в таком строю…"},{"type":"paragraph","text":"Меня ты только чувством слушай,"},{"type":"paragraph","text":"А чувством я-то уж спою…"},{"type":"paragraph","text":"И пусть ни встать, ни сесть на месте,"},{"type":"paragraph","text":"Пускай отнимется рука,"},{"type":"paragraph","text":"Когда струна на лжи и лести"},{"type":"paragraph","text":"Соскочит с крепкого колка."},{"type":"paragraph","text":"ВАЖА ПШАВЕЛА"},{"type":"paragraph","text":"(1861—1915)"},{"type":"paragraph","text":"КТО МОЛОДЕЦ?"},{"type":"paragraph","text":"Кто молодец у нас, друзья и братцы?"},{"type":"paragraph","text":"Кого мы назовем, чтоб по нему"},{"type":"paragraph","text":"Другим не стыдно"},{"type":"paragraph","text":"Было поравняться"},{"type":"paragraph","text":"И не было б обидно никому?"},{"type":"paragraph","text":"Чей гордый стан и стройную"},{"type":"paragraph","text":"Осанку"},{"type":"paragraph","text":"Своей чеканкой"},{"type":"paragraph","text":"Украшает меч?"},{"type":"paragraph","text":"Кто средь врагов"},{"type":"paragraph","text":"Всегда готов достойно"},{"type":"paragraph","text":"Слугою нашей родины полечь?"},{"type":"paragraph","text":"В крови мечи и острые кинжалы,"},{"type":"paragraph","text":"Недвижны в алом"},{"type":"paragraph","text":"Озере пловцы:"},{"type":"paragraph","text":"Лежат"},{"type":"paragraph","text":"Бойцы,"},{"type":"paragraph","text":"Кружат"},{"type":"paragraph","text":"Щитов осколки,"},{"type":"paragraph","text":"Коней за чёлки"},{"type":"paragraph","text":"Тянут мертвецы…"},{"type":"paragraph","text":"Глаза — в глаза… сердца, как копья, крепки…"},{"type":"paragraph","text":"Ломает копья в щепки"},{"type":"paragraph","text":"Смерть-карга,"},{"type":"paragraph","text":"Накидывая саваны на шлемы"},{"type":"paragraph","text":"Рукой знакомой"},{"type":"paragraph","text":"Старого врага."},{"type":"paragraph","text":"Кто, ястребом витая пред судьбою,"},{"type":"paragraph","text":"Погонит смерть со смехом"},{"type":"paragraph","text":"Пред собой,"},{"type":"paragraph","text":"В доспехах"},{"type":"paragraph","text":"Первым кинется для боя,"},{"type":"paragraph","text":"И, всех поздней, последним кончит бой?"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"И кто ж,"},{"type":"paragraph","text":"Когда идет дележ"},{"type":"paragraph","text":"Добычи,"},{"type":"paragraph","text":"Без устали сражается с врагом,"},{"type":"paragraph","text":"Обходит войско спящее, в обычай"},{"type":"paragraph","text":"Заботясь о себе и о другом."},{"type":"paragraph","text":"И кто в большом и малом"},{"type":"paragraph","text":"Без посула —"},{"type":"paragraph","text":"Слуга аулу,"},{"type":"paragraph","text":"Хоть и не в долгу?"},{"type":"paragraph","text":"Кому под кровлей сакли одеялом"},{"type":"paragraph","text":"И ложем служит ненависть врагу?"},{"type":"paragraph","text":"Кто силу, что всегда сечет"},{"type":"paragraph","text":"Солому,"},{"type":"paragraph","text":"С умом"},{"type":"paragraph","text":"И без обиды укорит?"},{"type":"paragraph","text":"И кто воздаст почет,"},{"type":"paragraph","text":"Хвалу другому"},{"type":"paragraph","text":"И о себе самом"},{"type":"paragraph","text":"Не говорит?"},{"type":"paragraph","text":"Кто в Хевсуретии, как солнце с неба,"},{"type":"paragraph","text":"Несет тепло такой же голытьбе,"},{"type":"paragraph","text":"Отдал кусок, сам не имея хлеба,"},{"type":"paragraph","text":"Одно оставив имя по себе…"},{"type":"paragraph","text":"Так за кого ж мы здравицу подымем"},{"type":"paragraph","text":"И за кого вдвойне —"},{"type":"paragraph","text":"Душе в помин?"},{"type":"paragraph","text":"Кто поцелуй один"},{"type":"paragraph","text":"Своей любимой"},{"type":"paragraph","text":"Принял, как дар за раны на войне?"},{"type":"paragraph","text":"Кто это ложу"},{"type":"paragraph","text":"Предпочел могилу,"},{"type":"paragraph","text":"Носилку тоже"},{"type":"paragraph","text":"Принял за коня,"},{"type":"paragraph","text":"А бурку — за плиту, а слезы милой —"},{"type":"paragraph","text":"За мерку рассыпного ячменя?"},{"type":"paragraph","text":"Кому плач женщин смехом показался,"},{"type":"paragraph","text":"Кто в мир иной влетел с мечом"},{"type":"paragraph","text":"В руках,"},{"type":"paragraph","text":"На скакуне"},{"type":"paragraph","text":"С лучом,"},{"type":"paragraph","text":"Вплетенным в гриву,"},{"type":"paragraph","text":"Над кем счастливым"},{"type":"paragraph","text":"В облаках"},{"type":"paragraph","text":"В предсмертный час его раздался"},{"type":"paragraph","text":"Орлиный грозный клекот в вышине?"},{"type":"paragraph","text":"Кого царь Грузии Ираклий старый"},{"type":"paragraph","text":"С собой посадит"},{"type":"paragraph","text":"Рядом"},{"type":"paragraph","text":"Сядет"},{"type":"paragraph","text":"Сам?"},{"type":"paragraph","text":"Кому, светя улыбкой и нарядом,"},{"type":"paragraph","text":"Прильнет Тамара"},{"type":"paragraph","text":"К неживым устам?"},{"type":"paragraph","text":"Так вот кого мы вспоминаем хором!"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Соасем не вас: бродяги, трусы вы!"},{"type":"paragraph","text":"На брюхо вы — коровы-ненажоры"},{"type":"paragraph","text":"И ишаки с ушей до головы!"},{"type":"paragraph","text":"Едва ли в праздности вы пригодитесь"},{"type":"paragraph","text":"На что-нибудь хорошее кому,"},{"type":"paragraph","text":"И если б был такой меж вами витязь"},{"type":"paragraph","text":"Вы лопнули б от зависти к нему!"},{"type":"paragraph","text":"В могилу смерть столкнет вас из презренья,"},{"type":"paragraph","text":"И настучитесь вы на том свету,"},{"type":"paragraph","text":"У горнего,"},{"type":"paragraph","text":"У зорнего"},{"type":"paragraph","text":"Селенья"},{"type":"paragraph","text":"Впервые разглядевши высоту!"},{"type":"paragraph","text":"ГЕОРГИЙ ЛЕОНИДЗЕ"},{"type":"paragraph","text":"(1899—1966)"},{"type":"paragraph","text":"Стихам и чонгури"},{"type":"paragraph","text":"Нужно ль поклоненье:"},{"type":"paragraph","text":"Есть Данта в хевсуре"},{"type":"paragraph","text":"Любом отраженье!"},{"type":"paragraph","text":"И в слабом порханье"},{"type":"paragraph","text":"Беспомощной птицы"},{"type":"paragraph","text":"Есть пыл, трепетанье"},{"type":"paragraph","text":"Далекой зарницы."},{"type":"paragraph","text":"С высокого пика"},{"type":"paragraph","text":"Снег, тая, струится"},{"type":"paragraph","text":"И в пеньи Бесика"},{"type":"paragraph","text":"С ручьем не сравнится…"},{"type":"paragraph","text":"И искрятся светом"},{"type":"paragraph","text":"В падении камни —"},{"type":"paragraph","text":"И сердцу ль при этом"},{"type":"paragraph","text":"Дивиться всегда мне?"},{"type":"paragraph","text":"ПАМЯТИ ВАЖА ПШАВЕЛА"},{"type":"paragraph","text":"Ты — герой"},{"type":"paragraph","text":"И в горних сенях"},{"type":"paragraph","text":"Ты к горе пришел горой…"},{"type":"paragraph","text":"Сохранив в своих коленях,"},{"type":"paragraph","text":"Как и в струнах, горный строй…"},{"type":"paragraph","text":"Обессиленный цепями,"},{"type":"paragraph","text":"Вновь стоишь ты среди нас…"},{"type":"paragraph","text":"Держишь облако, как знамя,"},{"type":"paragraph","text":"Щуря выколотый глаз."},{"type":"paragraph","text":"И когда мы гроб открыли,"},{"type":"paragraph","text":"Где царили"},{"type":"paragraph","text":"Тлен и смерть,"},{"type":"paragraph","text":"Распластав над нами крылья,"},{"type":"paragraph","text":"Семь орлов вспарили"},{"type":"paragraph","text":"В твердь…"},{"type":"paragraph","text":"Незадаром ждали песни"},{"type":"paragraph","text":"Скалы с облачной межи —"},{"type":"paragraph","text":"Снова,"},{"type":"paragraph","text":"Как листва, воскреснет"},{"type":"paragraph","text":"Слово"},{"type":"paragraph","text":"Певчее Важи…"},{"type":"paragraph","text":"Мелкий щебень, теплый гравий"},{"type":"paragraph","text":"Растолкает в грудь тебя,"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Снова кости ты расправишь"},{"type":"paragraph","text":"В пене горного ручья."},{"type":"paragraph","text":"Смертью скованные длани"},{"type":"paragraph","text":"Схватит дикий можжевель,"},{"type":"paragraph","text":"И в лице твоем проглянет"},{"type":"paragraph","text":"Снова розовый апрель."},{"type":"paragraph","text":"Вон высоко"},{"type":"paragraph","text":"И далеко"},{"type":"paragraph","text":"Гор тигриная семья,"},{"type":"paragraph","text":"И над нею слышен клекот —"},{"type":"paragraph","text":"Песня трубная твоя."},{"type":"paragraph","text":"И когда одно лишь слово"},{"type":"paragraph","text":"С высоты обвал стряхнет,"},{"type":"paragraph","text":"В камнях тур круглоголовый"},{"type":"paragraph","text":"Новым рогом прорастет…"},{"type":"paragraph","text":"Это слово, нет, не слово:"},{"type":"paragraph","text":"Это — крупный частый град!"},{"type":"paragraph","text":"Это звон"},{"type":"paragraph","text":"Знамен"},{"type":"paragraph","text":"Багровых,"},{"type":"paragraph","text":"Это блеск и водопад!"},{"type":"paragraph","text":"Нас оно, как дождь, взрастило,"},{"type":"paragraph","text":"Нам скрепило"},{"type":"paragraph","text":"Костяки,"},{"type":"paragraph","text":"Дало сердцу радость, силу"},{"type":"paragraph","text":"Влило"},{"type":"paragraph","text":"В мускулы руки."},{"type":"paragraph","text":"Это слово было"},{"type":"paragraph","text":"Криком,"},{"type":"paragraph","text":"Этародина — тюрьмой…"},{"type":"paragraph","text":"Но, сойдя в цепях в могилу,"},{"type":"paragraph","text":"Ты под знаменем великим"},{"type":"paragraph","text":"Возвращаешься домой."},{"type":"paragraph","text":"СТАРЫЕ ПОЭТЫ"},{"type":"paragraph","text":"Я болен любовью"},{"type":"paragraph","text":"К поэтам старинным,"},{"type":"paragraph","text":"Их Грузия с кровью"},{"type":"paragraph","text":"Своею слила…"},{"type":"paragraph","text":"Они распевали в саду соловьином,"},{"type":"paragraph","text":"Писали стихи над лукою седла."},{"type":"paragraph","text":"И пели они, как дожди, как буруны,"},{"type":"paragraph","text":"Как тысячи птиц под немой"},{"type":"paragraph","text":"Высотой,"},{"type":"paragraph","text":"И были легки и упруги"},{"type":"paragraph","text":"Их струны,"},{"type":"paragraph","text":"И хриплой натуги"},{"type":"paragraph","text":"Не ведал их строй."},{"type":"paragraph","text":"В пожары ль, в сраженья ли, в мор ли великий"},{"type":"paragraph","text":"Все так же по силе"},{"type":"paragraph","text":"Их песня свежа…"},{"type":"paragraph","text":"Вот Гурамишвили,"},{"type":"paragraph","text":"Веселый Бесики,"},{"type":"paragraph","text":"Вот Шота и тогровокожий Важа."},{"type":"paragraph","text":"Стихи их, как полые воды…"},{"type":"paragraph","text":"Как реки,"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Они оросили родную страну…"},{"type":"paragraph","text":"Они в озареньи"},{"type":"paragraph","text":"На годы,"},{"type":"paragraph","text":"На веки,"},{"type":"paragraph","text":"Забвенья"},{"type":"paragraph","text":"Не зная, у смерти в плену."},{"type":"paragraph","text":"Мы слышим из черной"},{"type":"paragraph","text":"Могилы их трели,"},{"type":"paragraph","text":"Их клекот нагорный —"},{"type":"paragraph","text":"Уже неживых…"},{"type":"paragraph","text":"Навек они птицами в звездах"},{"type":"paragraph","text":"Засели"},{"type":"paragraph","text":"На гнездах, Сплетенных из струн золотых."}]}]}