{"id":"klychkov-bova","slug":"klychkov-bova","shard":1,"title":"Бова","altTitles":[],"author":"Сергей Антонович Клычков","authorShort":"С. А. Клычков","authorSlug":"klychkov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1918","editionYear":"1918","description":"Бова","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%91%D0%BE%D0%B2%D0%B0_%28%D0%9A%D0%BB%D1%8B%D1%87%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1918)","downloadAllowed":true,"fb2Url":"/archive/books/klychkov/klychkov-bova/original.fb2","coverUrl":"/archive/books/klychkov/klychkov-bova/cover.webp","stats":{"chaptersCount":3,"wordsCount":507,"charsCount":3089,"readingMinutes":3},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Бова"},{"type":"paragraph","text":"Оригинал здесь — http://nk-poety.narod.ru/win/main/main.html"},{"type":"paragraph","text":"С снегов"},{"type":"paragraph","text":"И льдин,"},{"type":"paragraph","text":"С нагих плечей"},{"type":"paragraph","text":"Высоких гор"},{"type":"paragraph","text":"В сырой простор"},{"type":"paragraph","text":"Степей, лугов,"},{"type":"paragraph","text":"Полян,"},{"type":"paragraph","text":"Долин"},{"type":"paragraph","text":"Плывет туман,"},{"type":"paragraph","text":"Ночей"},{"type":"paragraph","text":"Убор —"},{"type":"paragraph","text":"Шатер"},{"type":"paragraph","text":"Седых богатырей."},{"type":"paragraph","text":"В дальней, дальней стороне,"},{"type":"paragraph","text":"Где светает синева,"},{"type":"paragraph","text":"Где синеет Торова,"},{"type":"paragraph","text":"В красном лисьем зипуне"},{"type":"paragraph","text":"Выезжает на коне"},{"type":"paragraph","text":"Из грозовых туч Бова."},{"type":"paragraph","text":"Колосится под луной"},{"type":"paragraph","text":"Звезд высоких полоса,"},{"type":"paragraph","text":"Под туманной пеленой"},{"type":"paragraph","text":"Спит приморская коса…"},{"type":"paragraph","text":"Облака как паруса"},{"type":"paragraph","text":"Над вспенённою волной…"},{"type":"paragraph","text":"И стучит студеный ключ"},{"type":"paragraph","text":"В звонком, горном хрустале,"},{"type":"paragraph","text":"И сверкает булава,"},{"type":"paragraph","text":"И, спускаясь по скале,"},{"type":"paragraph","text":"Выезжает из-за туч"},{"type":"paragraph","text":"К морю синему Бова…"},{"type":"paragraph","text":"Над пучиной на волне"},{"type":"paragraph","text":"Диво Дивное сидит,"},{"type":"paragraph","text":"Вдоль по морю на коне"},{"type":"paragraph","text":"Диво новое катит…"},{"type":"paragraph","text":"Озарилися луга,"},{"type":"paragraph","text":"Загорелися леса,"},{"type":"paragraph","text":"И согнулась в небеса"},{"type":"paragraph","text":"Разноцветная дуга…"},{"type":"paragraph","text":"В колесницу бьется вал"},{"type":"paragraph","text":"И среди пучин упал"},{"type":"paragraph","text":"В набегающий прибой"},{"type":"paragraph","text":"Край одежды голубой:"},{"type":"paragraph","text":"Скачет Диво и, гоня"},{"type":"paragraph","text":"Непокорного коня,"},{"type":"paragraph","text":"Отряхает с бороды"},{"type":"paragraph","text":"Волн бушующих ряды"},{"type":"paragraph","text":"И над утренней звездой"},{"type":"paragraph","text":"Машет шелковой уздой…"},{"type":"paragraph","text":"Пролетела бирюзою"},{"type":"paragraph","text":"Стая трепетных зарниц,"},{"type":"paragraph","text":"И серебряной слезою"},{"type":"paragraph","text":"С тихо дремлющих ресниц"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Голубеющих небес"},{"type":"paragraph","text":"Месяц канул в дальний лес…"},{"type":"paragraph","text":"Вот у царственных палат"},{"type":"paragraph","text":"Море синее стоит,"},{"type":"paragraph","text":"У расписанных ворот"},{"type":"paragraph","text":"Водят волны хоровод"},{"type":"paragraph","text":"И Бова из тяжких лат"},{"type":"paragraph","text":"Коня досыта поит…"},{"type":"paragraph","text":"По хоромам на боках"},{"type":"paragraph","text":"Под туманом темный сад,"},{"type":"paragraph","text":"Облака в саду висят,"},{"type":"paragraph","text":"На пушистых облаках"},{"type":"paragraph","text":"Дуги-радуги горят…"},{"type":"paragraph","text":"Вот у самых у хором"},{"type":"paragraph","text":"Луг зеленый лег ковром;"},{"type":"paragraph","text":"На морские берега"},{"type":"paragraph","text":"Трубят медные рога,"},{"type":"paragraph","text":"Королевна в терему"},{"type":"paragraph","text":"Улыбается ему,"},{"type":"paragraph","text":"Белой ручкою зовет,"},{"type":"paragraph","text":"Манит коня к закрому,"},{"type":"paragraph","text":"Меру зерен подает."},{"type":"paragraph","text":"Очи — свежая роса,"},{"type":"paragraph","text":"Брови — словно паруса,"},{"type":"paragraph","text":"Накрененные волной"},{"type":"paragraph","text":"Над прозрачной глубиной…"},{"type":"paragraph","text":"Речи — птичьи голоса,"},{"type":"paragraph","text":"Косы — темные леса,"},{"type":"paragraph","text":"И легка, как облака,"},{"type":"paragraph","text":"Белоснежная рука…"},{"type":"paragraph","text":"На пиру Бова сам-друг"},{"type":"paragraph","text":"Головой у белых плеч,"},{"type":"paragraph","text":"Отдал латы, лук и меч,"},{"type":"paragraph","text":"Пьет и ест из белых рук…"},{"type":"paragraph","text":"На шелковом поводу"},{"type":"paragraph","text":"Ходит конь в густом саду,"},{"type":"paragraph","text":"А седые сторожа,"},{"type":"paragraph","text":"Очи старые смежа,"},{"type":"paragraph","text":"Важно гладят у ворот"},{"type":"paragraph","text":"Вдоль серебряных бород…"},{"type":"paragraph","text":"На пиру Бова сам-друг,"},{"type":"paragraph","text":"Пьет и ест из белых рук,"},{"type":"paragraph","text":"Королевна в терему"},{"type":"paragraph","text":"Улыбается ему,"},{"type":"paragraph","text":"Подливает в чашу мед,"},{"type":"paragraph","text":"Тихо песенку поет:"},{"type":"paragraph","text":"— Я царевна-королевна,"},{"type":"paragraph","text":"В терему одна живу…"},{"type":"paragraph","text":"Полонила я недавно"},{"type":"paragraph","text":"Королевича-Бову."},{"type":"paragraph","text":"Потерял он коня в сече,"},{"type":"paragraph","text":"Меч каленый заковал,"},{"type":"paragraph","text":"Его латами играет"},{"type":"paragraph","text":"Голубой, далекий вал…"},{"type":"paragraph","text":"Широко кругом, богато,"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Всё одето в синеву,"},{"type":"paragraph","text":"Не скажу, кого люблю я —"},{"type":"paragraph","text":"Королевича-Бову!"},{"type":"paragraph","text":"Где лежит он — золотая"},{"type":"paragraph","text":"В небо выросла гора…"},{"type":"paragraph","text":"Я умру — велю насыпать"},{"type":"paragraph","text":"Рядом гору серебра!"},{"type":"paragraph","text":"Я царевна-королевна,"},{"type":"paragraph","text":"В терему одна живу,"},{"type":"paragraph","text":"Хоронила я недавно"},{"type":"paragraph","text":"Королевича-Бову…"},{"type":"paragraph","text":"Где гаснут звезды на заре,"},{"type":"paragraph","text":"Где рассветает синева,"},{"type":"paragraph","text":"Один в туманном серебре"},{"type":"paragraph","text":"Спит очарованный Бова…"},{"type":"paragraph","text":"Из очарованных кудрей"},{"type":"paragraph","text":"Течет серебряный ручей,"},{"type":"paragraph","text":"С его могучей головы"},{"type":"paragraph","text":"Волна широкая кудрей"},{"type":"paragraph","text":"Лежит в долинах меж травы"},{"type":"paragraph","text":"И стелется по дну морей…"},{"type":"paragraph","text":"Цветут цветы у алых губ,"},{"type":"paragraph","text":"Из сердца вырос крепкий дуб!"},{"type":"paragraph","text":"Высоко в небе дуб стоит,"},{"type":"paragraph","text":"Над ним, прозрачна и светла,"},{"type":"paragraph","text":"Корона звездная горит,"},{"type":"paragraph","text":"А корни омывает мгла"},{"type":"paragraph","text":"И глубина земли таит…"},{"type":"paragraph","text":"В его ветвях станицы сов"},{"type":"paragraph","text":"Жестокой тешатся игрой,"},{"type":"paragraph","text":"Когда вечернею порой"},{"type":"paragraph","text":"Они слетятся из лесов"},{"type":"paragraph","text":"Делить добычу над горой:"},{"type":"paragraph","text":"Так жутко слушать их полет,"},{"type":"paragraph","text":"Следить их медленную тень —"},{"type":"paragraph","text":"С их черных крыльв мрак плывет"},{"type":"paragraph","text":"Над снами дальних деревень,"},{"type":"paragraph","text":"Забывших навсегда Бову"},{"type":"paragraph","text":"И в снах своих, и наяву…"}]}]}