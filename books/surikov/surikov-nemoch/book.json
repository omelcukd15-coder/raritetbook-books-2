{"id":"surikov-nemoch","slug":"surikov-nemoch","shard":1,"title":"Немочь","altTitles":[],"author":"Иван Захарович Суриков","authorShort":"И. З. Суриков","authorSlug":"surikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1873","editionYear":"1873","description":"НЕМОЧЬ","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9D%D0%B5%D0%BC%D0%BE%D1%87%D1%8C_%28%D0%A1%D1%83%D1%80%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1873)","downloadAllowed":true,"fb2Url":"/archive/books/surikov/surikov-nemoch/original.fb2","coverUrl":"/archive/books/surikov/surikov-nemoch/cover.webp","stats":{"chaptersCount":3,"wordsCount":607,"charsCount":4075,"readingMinutes":3},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"НЕМОЧЬ"},{"type":"paragraph","text":"1"},{"type":"paragraph","text":"Затужился, запечалился"},{"type":"paragraph","text":"Муж Терентий, сокрушается,"},{"type":"paragraph","text":"Ходит взад-вперед по горенке"},{"type":"paragraph","text":"Да кручиной убивается."},{"type":"paragraph","text":"У Терентья, мужа старого,"},{"type":"paragraph","text":"Злое горе приключилося:"},{"type":"paragraph","text":"У жены его, красавицы,"},{"type":"paragraph","text":"Злая немочь расходилася."},{"type":"paragraph","text":"Началась она с головушки,"},{"type":"paragraph","text":"Ко белым грудям ударилась,"},{"type":"paragraph","text":"Разлилась по всем суставчикам…"},{"type":"paragraph","text":"Брал он знахарку — не справилась."},{"type":"paragraph","text":"И поили бабу травами,"},{"type":"paragraph","text":"И в горячей бане парили,"},{"type":"paragraph","text":"И с угля водою прыскали,"},{"type":"paragraph","text":"Да злой немочи не сбавили."},{"type":"paragraph","text":"Немочь, знай, над бабой тешится,"},{"type":"paragraph","text":"Неподатная, упорная;"},{"type":"paragraph","text":"Знать, что немочь та не пришлая,"},{"type":"paragraph","text":"А людями наговорная…"},{"type":"paragraph","text":"2"},{"type":"paragraph","text":"Хороша жена Терентьева:"},{"type":"paragraph","text":"Заглядишься, залюбуешься;"},{"type":"paragraph","text":"Немочь злую ее видючи,"},{"type":"paragraph","text":"Разгрустишься, растоскуешься."},{"type":"paragraph","text":"Вот лежит она в постелюшке,"},{"type":"paragraph","text":"Грудь высоко поднимается,"},{"type":"paragraph","text":"И ее густая косынька"},{"type":"paragraph","text":"По подушке рассыпается."},{"type":"paragraph","text":"Жаром пышут щеки белые,"},{"type":"paragraph","text":"И под длинными ресницами"},{"type":"paragraph","text":"Очи черные красавицы"},{"type":"paragraph","text":"Блещут яркими зарницами."},{"type":"paragraph","text":"Руки полные раскинуты,"},{"type":"paragraph","text":"Одеяло с груди сбилося,"},{"type":"paragraph","text":"Прочь с плеча рубашка съехала,"},{"type":"paragraph","text":"И полгруди обнажилося."},{"type":"paragraph","text":"«Ox, Терентий-муж, Данилович,"},{"type":"paragraph","text":"Тяжело мне, нету моченьки! —"},{"type":"paragraph","text":"Говорит она, вздыхаючи,"},{"type":"paragraph","text":"На него уставя оченьки.-"},{"type":"paragraph","text":"Ты сходи-ка в ту сторонушку,"},{"type":"paragraph","text":"Где игрой гусляры славятся;"},{"type":"paragraph","text":"Пусть меня потешат песнями, —"},{"type":"paragraph","text":"Может, немочь и убавится»."},{"type":"paragraph","text":"Молодой жене Данилович"},{"type":"paragraph","text":"Не перечит, собирается;"},{"type":"paragraph","text":"Взявши шапку, за гуслярами"},{"type":"paragraph","text":"В дальний город отправляется."},{"type":"paragraph","text":"3"},{"type":"paragraph","text":"Ходит муж Терентий городом,"},{"type":"paragraph","text":"Выбивается из моченьки,"},{"type":"paragraph","text":"А гусляров не видать нигде…"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Время близко темной ноченьки."},{"type":"paragraph","text":"Еле двигает Данилович"},{"type":"paragraph","text":"Свои ноженьки усталые;"},{"type":"paragraph","text":"Вот ему навстречу с гуслями"},{"type":"paragraph","text":"Идут молодцы удалые."},{"type":"paragraph","text":"Идут молодцы удалые,"},{"type":"paragraph","text":"На гуслях своих играючи,"},{"type":"paragraph","text":"Звонкой песнею потешною"},{"type":"paragraph","text":"Люд честной позабавляючи."},{"type":"paragraph","text":"Поклонился им Данилович:"},{"type":"paragraph","text":"«Ой вы, ой, гусляры бравые!"},{"type":"paragraph","text":"Причинили мне невзгодушку"},{"type":"paragraph","text":"Люди злые и лукавые."},{"type":"paragraph","text":"Помогите мне в кручинушке,"},{"type":"paragraph","text":"Что нежданная случилася:"},{"type":"paragraph","text":"У жены моей, красавицы,"},{"type":"paragraph","text":"Злая немочь расходилася»."},{"type":"paragraph","text":"Рассказал им все Данилович,"},{"type":"paragraph","text":"Как и что с женой случается,"},{"type":"paragraph","text":"Как она в постеле мечется,"},{"type":"paragraph","text":"Как огнем вся разгорается."},{"type":"paragraph","text":"«Да, печаль твоя великая,"},{"type":"paragraph","text":"Сокрушеньце немалое!.."},{"type":"paragraph","text":"Что ж, мы немочь бабью вылечим,"},{"type":"paragraph","text":"Дело это нам бывалое."},{"type":"paragraph","text":"Полезай в мешок холстиновый"},{"type":"paragraph","text":"И лежи в нем без движения;"},{"type":"paragraph","text":"Коль не хочешь — не прогневайся, —"},{"type":"paragraph","text":"Не возьмемся за лечение."},{"type":"paragraph","text":"Мы пойдем в твои хоромины,"},{"type":"paragraph","text":"Словно с ношею тяжелою,"},{"type":"paragraph","text":"Потешать твою хозяюшку"},{"type":"paragraph","text":"Пляской бойкою, веселою."},{"type":"paragraph","text":"Свой мешок под лавку бережно"},{"type":"paragraph","text":"Сложим мы, как рухлядь мягкую,"},{"type":"paragraph","text":"Станем петь, а ты смирнехонько"},{"type":"paragraph","text":"Притаись — лежи под лавкою."},{"type":"paragraph","text":"Трудно будет мужу корчиться,"},{"type":"paragraph","text":"Да зато жена поправится,"},{"type":"paragraph","text":"От своей мудреной немочи"},{"type":"paragraph","text":"Навсегда она избавится»."},{"type":"paragraph","text":"4"},{"type":"paragraph","text":"Под окном жены Терентьевой"},{"type":"paragraph","text":"Ходят молодцы, играючи,"},{"type":"paragraph","text":"Мужа старого, Данилыча,"},{"type":"paragraph","text":"На плечах в мешке таскаючи."},{"type":"paragraph","text":"Их игру жена Терентьева"},{"type":"paragraph","text":"Услыхала, поднимается,"},{"type":"paragraph","text":"И к окну она из спаленки"},{"type":"paragraph","text":"Скоро-наскоро бросается."},{"type":"paragraph","text":"«Ой вы, молодцы удалые!"},{"type":"paragraph","text":"Вы, гусляры поученые!"},{"type":"paragraph","text":"Ваши песенки потешные!"},{"type":"paragraph","text":"Ваши гусли золоченые!"},{"type":"paragraph","text":"Вы Терентья нe видали ли,"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Не видали ли немилого,"},{"type":"paragraph","text":"Мужа старого, Данилыча,"},{"type":"paragraph","text":"Пса смердящего, постылого?»"},{"type":"paragraph","text":"— «Нe тужи, жена Терентьева,"},{"type":"paragraph","text":"Что ты старому досталася, —"},{"type":"paragraph","text":"Me тужи, вернулась волюшка:"},{"type":"paragraph","text":"Ты одна-одной осталася."},{"type":"paragraph","text":"Твой Терентий-муж, Данилович,"},{"type":"paragraph","text":"В чистом поле под ракитою,"},{"type":"paragraph","text":"Меж колючего репейничка,"},{"type":"paragraph","text":"С головой лежит пробитою."},{"type":"paragraph","text":"Над седой его головушкой"},{"type":"paragraph","text":"Черный ворон увивается,"},{"type":"paragraph","text":"Да вокруг его пушистая"},{"type":"paragraph","text":"Ковыль-травонька качается…»"},{"type":"paragraph","text":"5"},{"type":"paragraph","text":"Молода жена с гуслярами"},{"type":"paragraph","text":"Песней, пляской забавляется,"},{"type":"paragraph","text":"А Терентий-муж под лавкою"},{"type":"paragraph","text":"Чуть в мешке не задыхается."},{"type":"paragraph","text":"Ходит баба вдоль по горенке,"},{"type":"paragraph","text":"Пол подолом подметаючи,"},{"type":"paragraph","text":"Мужа старого, Данилыча,"},{"type":"paragraph","text":"Проклинаючи, ругаючи."},{"type":"paragraph","text":"«Уж ты старый пес, Данилович,"},{"type":"paragraph","text":"Спи ты в поле под ракитою!"},{"type":"paragraph","text":"Я потешусь, молодешенька,"},{"type":"paragraph","text":"Вспомню молодость забытую!"},{"type":"paragraph","text":"Спи ты, тело твое старое"},{"type":"paragraph","text":"В чистом поле пусть валяется,"},{"type":"paragraph","text":"Пусть оно дождями мочится"},{"type":"paragraph","text":"Да песками засыпается."},{"type":"paragraph","text":"Загубил мою ты молодость,"},{"type":"paragraph","text":"Света-волюшки лишаючи,"},{"type":"paragraph","text":"За дверями, под запорами"},{"type":"paragraph","text":"Красоту мою скрываючи…»"},{"type":"paragraph","text":"— «Эй, ты слышишь ли, Данилович,"},{"type":"paragraph","text":"Как жена здесь разгулялася,"},{"type":"paragraph","text":"Как ей весело да радостно,"},{"type":"paragraph","text":"Что ей волюшка досталася?"},{"type":"paragraph","text":"Над твоей она над старостью,"},{"type":"paragraph","text":"Муж немилый, издевается…»"},{"type":"paragraph","text":"И не вытерпел Данилович —"},{"type":"paragraph","text":"Из-под лавки поднимается."},{"type":"paragraph","text":"Молода жена Терентьева"},{"type":"paragraph","text":"Побелела, зашаталася,"},{"type":"paragraph","text":"А из спаленки красавицы"},{"type":"paragraph","text":"Стенкой немочь пробиралася."},{"type":"paragraph","text":"Миг один — и немочь скрылася…"},{"type":"paragraph","text":"Не поймаешь вольну пташечку!"},{"type":"paragraph","text":"Только видел муж Данилович"},{"type":"paragraph","text":"Кумачевую рубашечку…"},{"type":"paragraph","text":"1873"}]}]}