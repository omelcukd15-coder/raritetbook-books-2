{"id":"surikov-vasilko","slug":"surikov-vasilko","shard":1,"title":"Василько","altTitles":[],"author":"Иван Захарович Суриков","authorShort":"И. З. Суриков","authorSlug":"surikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1876","editionYear":"1876","description":"Василько","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%92%D0%B0%D1%81%D0%B8%D0%BB%D1%8C%D0%BA%D0%BE_%28%D0%A1%D1%83%D1%80%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1876)","downloadAllowed":true,"fb2Url":"/archive/books/surikov/surikov-vasilko/original.fb2","coverUrl":"/archive/books/surikov/surikov-vasilko/cover.webp","stats":{"chaptersCount":13,"wordsCount":3046,"charsCount":17993,"readingMinutes":17},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"},{"id":"chapter-9","title":"Часть 9"},{"id":"chapter-10","title":"Часть 10"},{"id":"chapter-11","title":"Часть 11"},{"id":"chapter-12","title":"Часть 12"},{"id":"chapter-13","title":"Часть 13"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Василько"},{"type":"paragraph","text":"ВАСИЛЬКО"},{"type":"paragraph","text":"1"},{"type":"paragraph","text":"Василько видел страшный сон,"},{"type":"paragraph","text":"Остановившись на ночлеге."},{"type":"paragraph","text":"Ему приснилось, будто он"},{"type":"paragraph","text":"В глухом лесу, в худой телеге,"},{"type":"paragraph","text":"Лежит закован, недвижим,"},{"type":"paragraph","text":"И ворон каркает над ним,"},{"type":"paragraph","text":"И слышен стук мечей о брони,"},{"type":"paragraph","text":"И ржут испуганные кони."},{"type":"paragraph","text":"Василька ищет Володарь"},{"type":"paragraph","text":"И громко кличет: «Брат, за нами!»"},{"type":"paragraph","text":"И хочет князь, как было встарь,"},{"type":"paragraph","text":"Тряхнуть могучими руками —"},{"type":"paragraph","text":"Но крепко скованы оне;"},{"type":"paragraph","text":"И хочет крикнуть он во сне,"},{"type":"paragraph","text":"Но вместо крика стон раздался:"},{"type":"paragraph","text":"Язык ему не покорялся."},{"type":"paragraph","text":"Не мог он стоном заглушить"},{"type":"paragraph","text":"Шум боя, крик зловещей птицы…"},{"type":"paragraph","text":"Глаза он силился открыть —"},{"type":"paragraph","text":"Не поднимаются ресницы…"},{"type":"paragraph","text":"В немом отчаяньи, дрожа,"},{"type":"paragraph","text":"Он слышит — лезвием ножа"},{"type":"paragraph","text":"К нему вдруг кто-то прикоснулся,"},{"type":"paragraph","text":"И князь испуганный проснулся."},{"type":"paragraph","text":"Прохлада ясного утра"},{"type":"paragraph","text":"Василька скоро освежила."},{"type":"paragraph","text":"Уж рассвело. Кругом шатра"},{"type":"paragraph","text":"Бродили слуги. Слышно было,"},{"type":"paragraph","text":"Как отрок борзого коня"},{"type":"paragraph","text":"Седлал для князя; у огня"},{"type":"paragraph","text":"Проворный повар суетился;"},{"type":"paragraph","text":"Шум, говор в стане разносился."},{"type":"paragraph","text":"Князь поднял край шатра. Пред ним"},{"type":"paragraph","text":"Открылся Днепр, залитый блеском,"},{"type":"paragraph","text":"И нежил слух его своим"},{"type":"paragraph","text":"Невозмутимо ровным плеском."},{"type":"paragraph","text":"Василько влево бросил взгляд —"},{"type":"paragraph","text":"Там возвышался Киев-град, —"},{"type":"paragraph","text":"И сна дурное впечатленье"},{"type":"paragraph","text":"Рассеялось в одно мгновенье."},{"type":"paragraph","text":"Верхушки киевских церквей"},{"type":"paragraph","text":"На солнце ярко золотились,"},{"type":"paragraph","text":"И от посада в глубь полей"},{"type":"paragraph","text":"Далеко нивы расходились;"},{"type":"paragraph","text":"Вдали степей синела ширь"},{"type":"paragraph","text":"И Феодосьев монастырь,"},{"type":"paragraph","text":"Высоким тыном обнесенный,"},{"type":"paragraph","text":"Венчал собою холм зеленый."},{"type":"paragraph","text":"Отрадно стало и светло"},{"type":"paragraph","text":"В душе Василька. Грудь дышала"},{"type":"paragraph","text":"Спокойно. Утро принесло"},{"type":"paragraph","text":"Ему с собою дум немало."}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Как львенок, вышедший впервой"},{"type":"paragraph","text":"На лов, тряхнул он головой,"},{"type":"paragraph","text":"Глаза его сверкали смело:"},{"type":"paragraph","text":"Он замышлял большое дело."},{"type":"paragraph","text":"На съезде в Любече князья"},{"type":"paragraph","text":"Решили: княженецкой власти"},{"type":"paragraph","text":"Опоры нет; что воронья,"},{"type":"paragraph","text":"Мы Русь родную рвем на части."},{"type":"paragraph","text":"Пусть каждый отчиной своей"},{"type":"paragraph","text":"Владеет в мире с этих дней,"},{"type":"paragraph","text":"И да не будет ссор меж нами…"},{"type":"paragraph","text":"Мы братья, — нам ли быть врагами?"},{"type":"paragraph","text":"Василько думает: «Пойду"},{"type":"paragraph","text":"Теперь я смело к Теребовлю"},{"type":"paragraph","text":"И хитрым ляхам на беду"},{"type":"paragraph","text":"Зимой дружину приготовлю."},{"type":"paragraph","text":"Давно душа моя горит"},{"type":"paragraph","text":"Взять землю ляшскую на щит"},{"type":"paragraph","text":"И Руси недругов лукавых"},{"type":"paragraph","text":"Похоронить в глухих дубравах."},{"type":"paragraph","text":"Потом в Дунай ладью спущу"},{"type":"paragraph","text":"И на болгар грозой ударю,"},{"type":"paragraph","text":"И ратной славы поищу"},{"type":"paragraph","text":"Себе и брату Володарю;"},{"type":"paragraph","text":"Сожгу их села, и в полон"},{"type":"paragraph","text":"Возьму детей, девиц и жен,"},{"type":"paragraph","text":"И потоплю в волнах Дуная"},{"type":"paragraph","text":"Всю силу славного их края."},{"type":"paragraph","text":"Потом за помощью приду"},{"type":"paragraph","text":"Я к Святополку с Мономахом"},{"type":"paragraph","text":"И половецкую орду"},{"type":"paragraph","text":"В глухих степях развею прахом."},{"type":"paragraph","text":"Я дам родимой стороне"},{"type":"paragraph","text":"Покой, хотя пришлось бы мне"},{"type":"paragraph","text":"Лечь головой в борьбе кровавой…»"},{"type":"paragraph","text":"Так думал правнук Ярослава."},{"type":"paragraph","text":"Так он задумывал одно,"},{"type":"paragraph","text":"Но у Давыда с Святополком"},{"type":"paragraph","text":"Другое было решено"},{"type":"paragraph","text":"На их совете тихомолком."},{"type":"paragraph","text":"«Василько, — думал князь Давид, —"},{"type":"paragraph","text":"Мое добро себе рачит."},{"type":"paragraph","text":"Покуда род его не вымер,"},{"type":"paragraph","text":"За мной не крепок Володимер»."},{"type":"paragraph","text":"«Возьми его, он ворог злой,"},{"type":"paragraph","text":"Не родич нам, — шептал он брату, —"},{"type":"paragraph","text":"Ужели хочешь Киев свой"},{"type":"paragraph","text":"Отдать ему, как супостату?"},{"type":"paragraph","text":"В крови потопит и в слезах"},{"type":"paragraph","text":"Он нашу землю. Мономах,"},{"type":"paragraph","text":"Его пособник произволу,"},{"type":"paragraph","text":"С ним заодно кует крамолу."},{"type":"paragraph","text":"Как звери лютые, придут"},{"type":"paragraph","text":"Они с наемной силой вражьей,"},{"type":"paragraph","text":"Владимер Галицкий возьмут,"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Отнимут стол великокняжий."},{"type":"paragraph","text":"Нет правды, верь мне, в их сердцах!"},{"type":"paragraph","text":"И дикий половец и лях"},{"type":"paragraph","text":"На Русь пойдут за ними следом."},{"type":"paragraph","text":"Иль замысл их тебе не ведом?"},{"type":"paragraph","text":"О том, что мыслит князь-изгой,"},{"type":"paragraph","text":"Мои дозналися бояре:"},{"type":"paragraph","text":"Он запалит костер большой —"},{"type":"paragraph","text":"И нам, брат, сгибнуть в том пожаре."},{"type":"paragraph","text":"Возьми ж его, пока он тут;"},{"type":"paragraph","text":"Напрасен будет после труд:"},{"type":"paragraph","text":"Мешать нам плохо волку в ловле,"},{"type":"paragraph","text":"Когда он будет в Теребовле."},{"type":"paragraph","text":"Сам бог нам с властью дал устав —"},{"type":"paragraph","text":"Блюсти от зла свою державу»."},{"type":"paragraph","text":"И внял великий князь, сказав:"},{"type":"paragraph","text":"«Да будет так! Когда ж неправо"},{"type":"paragraph","text":"Ты молвишь — бог тебе судья."},{"type":"paragraph","text":"Нам не простят того князья,"},{"type":"paragraph","text":"Противу нас найдут улики,"},{"type":"paragraph","text":"И будет то нам в стыд великий»."},{"type":"paragraph","text":"И князь на Рудицы послал"},{"type":"paragraph","text":"Василька звать на именины."},{"type":"paragraph","text":"Там, недалеко от забрал"},{"type":"paragraph","text":"И киевских бойниц, с дружиной"},{"type":"paragraph","text":"Передвигаясь в город свой,"},{"type":"paragraph","text":"Стал станом княжич удалой,"},{"type":"paragraph","text":"Про то не ведая, что вскоре"},{"type":"paragraph","text":"Его постигнет злое горе."},{"type":"paragraph","text":"2"},{"type":"paragraph","text":"Звонят к обедне. Стольный град"},{"type":"paragraph","text":"Проснулся. Ясен день холодный."},{"type":"paragraph","text":"В стану Васильковом скрипят"},{"type":"paragraph","text":"Телеги с рухлядью походной."},{"type":"paragraph","text":"Трясет серебряной уздой"},{"type":"paragraph","text":"И стременами конь княжой"},{"type":"paragraph","text":"Перед княжьим шатром закрытым,"},{"type":"paragraph","text":"Храпит и в землю бьет копытом."},{"type":"paragraph","text":"Kopмилич княжичий, старик,"},{"type":"paragraph","text":"Торопит в путь дружину с князем."},{"type":"paragraph","text":"«Нам впереди поход велик, —"},{"type":"paragraph","text":"Как раз обоз в грязи увязим."},{"type":"paragraph","text":"Пойдем-ко, князь! Того и жди,"},{"type":"paragraph","text":"Польют осенние дожди,"},{"type":"paragraph","text":"И стой тогда в болотной тине!"},{"type":"paragraph","text":"Вели-ко стан снимать дружине!»"},{"type":"paragraph","text":"Василько вышел из шатра,"},{"type":"paragraph","text":"Чтоб нарядить, уладить сборы,"},{"type":"paragraph","text":"Проститься с берегом Днепра,"},{"type":"paragraph","text":"Взглянуть на киевские горы."},{"type":"paragraph","text":"Быть может, долго не видать"},{"type":"paragraph","text":"Тех мест, где веры благодать"},{"type":"paragraph","text":"Над темной Русью просияла,"},{"type":"paragraph","text":"Где Русь крещенье восприяла."},{"type":"paragraph","text":"И грустно сердце сжалось в нем,"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Как будто чуя скорбь и горе,"},{"type":"paragraph","text":"И вспомнил княжич о былом"},{"type":"paragraph","text":"И о княжой недавней ссоре."},{"type":"paragraph","text":"«Мне, может, — думал он, — сулит"},{"type":"paragraph","text":"Судьба в грядущем ряд обид,"},{"type":"paragraph","text":"От близких родичей — истому,"},{"type":"paragraph","text":"И вместо славы — паполому."},{"type":"paragraph","text":"В худое время мы живем,"},{"type":"paragraph","text":"За распри друг на друга ропщем;"},{"type":"paragraph","text":"Радеет всякий о своем,"},{"type":"paragraph","text":"А о земле, наследьи общем,"},{"type":"paragraph","text":"Никто не хочет пожалеть,"},{"type":"paragraph","text":"Отдав ее врагам на снедь."},{"type":"paragraph","text":"Мы вместо мира, устроенья"},{"type":"paragraph","text":"Заводим ссоры да смятенья."},{"type":"paragraph","text":"Великий прадед Ярослав!"},{"type":"paragraph","text":"Берег ты землю от печали,"},{"type":"paragraph","text":"Храня отеческий устав, —"},{"type":"paragraph","text":"И наши вороги молчали."},{"type":"paragraph","text":"Могуч, как древле царь Давид,"},{"type":"paragraph","text":"Ты громкой славой был покрыт;"},{"type":"paragraph","text":"Но время тихое минуло —"},{"type":"paragraph","text":"И Русь в крамолах потонула»."},{"type":"paragraph","text":"Так Ростиславич размышлял"},{"type":"paragraph","text":"О распре — княжеской заразе,"},{"type":"paragraph","text":"А перед ним уже стоял"},{"type":"paragraph","text":"Посол от киевского князя"},{"type":"paragraph","text":"И молвил; низко поклонясь:"},{"type":"paragraph","text":"«Зовет тебя на праздник князь"},{"type":"paragraph","text":"И просит в Киев, господине,"},{"type":"paragraph","text":"Для именин приехать ныне»."},{"type":"paragraph","text":"«Мне дома быть пора давно, —"},{"type":"paragraph","text":"Князь отвечал, — гулять не время:"},{"type":"paragraph","text":"Рать будет дома неравно,"},{"type":"paragraph","text":"Да и других забот беремя."},{"type":"paragraph","text":"Коль призван править князь землей,"},{"type":"paragraph","text":"Ему гостить в земле чужой"},{"type":"paragraph","text":"Не след: в семье владыка нужен…"},{"type":"paragraph","text":"Скажи: теперь я недосужен»."},{"type":"paragraph","text":"Ушел гонец; но вслед за ним"},{"type":"paragraph","text":"Великий князь прислал другого:"},{"type":"paragraph","text":"«Хоть на денек приди к родным, —"},{"type":"paragraph","text":"С гонцом княжое было слово, —"},{"type":"paragraph","text":"Об этом я прошу любя»."},{"type":"paragraph","text":"Давыд прибавил от себя:"},{"type":"paragraph","text":"«Пожалуй в Киев нынче, брате!"},{"type":"paragraph","text":"Куда спешишь? Не слышно рати!"},{"type":"paragraph","text":"Отказ твой семя к распре даст."},{"type":"paragraph","text":"Ужели хочешь новой ссоры?"},{"type":"paragraph","text":"На злое дело князь горазд,"},{"type":"paragraph","text":"И в нем вражда созреет скоро:"},{"type":"paragraph","text":"Из друга сделаться врагом"},{"type":"paragraph","text":"Ему не диво, — знай о том."},{"type":"paragraph","text":"Коль не приедешь к Святополку,"},{"type":"paragraph","text":"Не будет в съезде нашем толку»."}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Василько вымолвил: «Аминь!"},{"type":"paragraph","text":"О ссоре мне и думать больно»."},{"type":"paragraph","text":"Он стан отправил на Волынь"},{"type":"paragraph","text":"И сам поехал в Киев стольный."},{"type":"paragraph","text":"Торопит он и бьет коня;"},{"type":"paragraph","text":"Но конь, уздечкою звеня,"},{"type":"paragraph","text":"Идет неспешно и лениво,"},{"type":"paragraph","text":"Храпит, потряхивая гривой."},{"type":"paragraph","text":"Беспечно едет князь вперед."},{"type":"paragraph","text":"Навстречу отрок приближенный"},{"type":"paragraph","text":"Спешит от киевских ворот"},{"type":"paragraph","text":"К нему, печальный и смущенный;"},{"type":"paragraph","text":"Он стал пред ним и говорит:"},{"type":"paragraph","text":"«Не езди, князь! Беда грозит!"},{"type":"paragraph","text":"Вернись — иль быть греху да брани!"},{"type":"paragraph","text":"Тебя возьмут, вернись заране!"},{"type":"paragraph","text":"Не езди: Киев-западня,"},{"type":"paragraph","text":"Поверь моей правдивой речи."},{"type":"paragraph","text":"Верни ретивого коня, —"},{"type":"paragraph","text":"Твоя дружина недалече,"},{"type":"paragraph","text":"И ты, как дома, будешь с ней."},{"type":"paragraph","text":"Уйди подальше от князей, —"},{"type":"paragraph","text":"Они лишат тебя удела,"},{"type":"paragraph","text":"В них мысль ехидная созрела»."},{"type":"paragraph","text":"«За что ж князья меня возьмут? —"},{"type":"paragraph","text":"Спросил Василько удивленный.-"},{"type":"paragraph","text":"Не верю я, нет правды тут,"},{"type":"paragraph","text":"Схватить нельзя же беззаконно?"},{"type":"paragraph","text":"Я Святополка не боюсь:"},{"type":"paragraph","text":"Не для того со мной союз"},{"type":"paragraph","text":"Скрепил он крестным целованьем,"},{"type":"paragraph","text":"Чтоб встретить гостя злодеяньем."},{"type":"paragraph","text":"Ходил я всюду напрямик, —"},{"type":"paragraph","text":"Зачем назад мне возвращаться?"},{"type":"paragraph","text":"Я в битвах взрос и не привык"},{"type":"paragraph","text":"От юных лет врагов бояться»."},{"type":"paragraph","text":"Так Ростиславич отвечал"},{"type":"paragraph","text":"И путь свой в Киев продолжал:"},{"type":"paragraph","text":"Был княжич чист и прям душою,"},{"type":"paragraph","text":"Не знался с хитростью людскою."},{"type":"paragraph","text":"Спокоен в Киев въехал он"},{"type":"paragraph","text":"И у хоромин княженецких"},{"type":"paragraph","text":"Остановился. Окружен"},{"type":"paragraph","text":"Толпой дружинников и детских,"},{"type":"paragraph","text":"Выходит к гостю на крыльцо"},{"type":"paragraph","text":"Великий князь; его лицо"},{"type":"paragraph","text":"Омрачено; с улыбкой странной"},{"type":"paragraph","text":"Он молвил: «Здравствуй, гость желанный!»"},{"type":"paragraph","text":"И ввел его он в тот покой,"},{"type":"paragraph","text":"Где князь Давыд, потупя очи,"},{"type":"paragraph","text":"Поникнув хитрой головой,"},{"type":"paragraph","text":"Сидел, темней осенней ночи."},{"type":"paragraph","text":"Увидев гостя, вздрогнул он,"},{"type":"paragraph","text":"И на приветливый поклон"},{"type":"paragraph","text":"И речи князя молодого"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Не может вымолвить ни слова."},{"type":"paragraph","text":"Василько весел и не ждет"},{"type":"paragraph","text":"Грозы; а гром над головою,"},{"type":"paragraph","text":"И скоро час беды придет."},{"type":"paragraph","text":"Великий князь кривит душою,"},{"type":"paragraph","text":"Кривит пред ним, а князь Давыд,"},{"type":"paragraph","text":"Немой, как рыба, вниз глядит."},{"type":"paragraph","text":"Ждут слуги взгляда, и готовы"},{"type":"paragraph","text":"Для Ростиславича оковы."},{"type":"paragraph","text":"3"},{"type":"paragraph","text":"Прошло с тех пор четыре дня."},{"type":"paragraph","text":"В местечке Вздвиженье тревога:"},{"type":"paragraph","text":"И шум, и смердов беготня"},{"type":"paragraph","text":"В избе священника убогой."},{"type":"paragraph","text":"Толпа Давыдовых людей"},{"type":"paragraph","text":"Теснится около дверей,"},{"type":"paragraph","text":"И двое слуг несут в ворота"},{"type":"paragraph","text":"В ковры завернутое что-то."},{"type":"paragraph","text":"То князь Василько. Но зачем"},{"type":"paragraph","text":"В таком печальном он наряде"},{"type":"paragraph","text":"Лежит без чувств, бессилен, нем?"},{"type":"paragraph","text":"В глухую ночь, вчера, в Белграде,"},{"type":"paragraph","text":"Он был злодейски ослеплен."},{"type":"paragraph","text":"Недавний сбылся князя сон!"},{"type":"paragraph","text":"Полуживой, он дышит еле…"},{"type":"paragraph","text":"Давыд достиг желанной цели."},{"type":"paragraph","text":"Народом полон ветхий сруб,"},{"type":"paragraph","text":"Скрипят гнилые половицы;"},{"type":"paragraph","text":"На лавке князь лежит, как труп…"},{"type":"paragraph","text":"Лицо порезано, зеницы"},{"type":"paragraph","text":"Из впадин вырваны глазных,"},{"type":"paragraph","text":"И страшно кровь чернеет в них;"},{"type":"paragraph","text":"Разбита грудь его, и тело"},{"type":"paragraph","text":"Изнемогло и посинело."},{"type":"paragraph","text":"Сняла с Василько попадья"},{"type":"paragraph","text":"Рубаху, кровью залитую,"},{"type":"paragraph","text":"И говорит: «Какой судья"},{"type":"paragraph","text":"Тебе назначил казнь такую!"},{"type":"paragraph","text":"Али так много грешен ты,"},{"type":"paragraph","text":"Что ни очей, ни красоты"},{"type":"paragraph","text":"Не пощадили?.. Вепрь не станет"},{"type":"paragraph","text":"Так мучить, тур так не изранит!"},{"type":"paragraph","text":"Давно на свете я живу,"},{"type":"paragraph","text":"Годам и счет-то потеряла;"},{"type":"paragraph","text":"Но ни во сне, ни наяву"},{"type":"paragraph","text":"Такой я казни не видала."},{"type":"paragraph","text":"Худое времечко пришло:"},{"type":"paragraph","text":"Рвут людям очи, в братьях зло, —"},{"type":"paragraph","text":"Знать, нету в мире божья страху!»"},{"type":"paragraph","text":"И стала мыть она рубаху."},{"type":"paragraph","text":"И слезы горькие свои"},{"type":"paragraph","text":"На полотно она роняла."},{"type":"paragraph","text":"От плача старой попадьи"},{"type":"paragraph","text":"Очнулся князь… Не мог сначала"},{"type":"paragraph","text":"Припомнить он: что было с ним?"}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"И, лютой жаждою томим,"},{"type":"paragraph","text":"Он простонал. Тот стон услыша,"},{"type":"paragraph","text":"Хозяйке стража шепчет: «Тише!»"},{"type":"paragraph","text":"Над ним нагнулась попадья;"},{"type":"paragraph","text":"Ее почувствовав дыханье,"},{"type":"paragraph","text":"Василько вымолвил: «Где я?»"},{"type":"paragraph","text":"И заглушив в себе рыданья,"},{"type":"paragraph","text":"Она, качая головой,"},{"type":"paragraph","text":"Сказала: «В Вздвиженье, родной!»"},{"type":"paragraph","text":"И грудь его с печалью тяжкой"},{"type":"paragraph","text":"Покрыла вымытой рубашкой."},{"type":"paragraph","text":"Рукою грудь ощупал он"},{"type":"paragraph","text":"И через силу приподнялся;"},{"type":"paragraph","text":"Бледнеет стража: страшный стон"},{"type":"paragraph","text":"И вопль княжой в избе раздался."},{"type":"paragraph","text":"Рыдая, он к скамье приник,"},{"type":"paragraph","text":"И проходили в этот миг"},{"type":"paragraph","text":"Перед духовными очами"},{"type":"paragraph","text":"Слепца видения рядами."},{"type":"paragraph","text":"Припомнил он, честной как крест"},{"type":"paragraph","text":"На съезде братья целовали:"},{"type":"paragraph","text":"Надежды светлые на съезд"},{"type":"paragraph","text":"Они великий возлагали."},{"type":"paragraph","text":"И вот — нарушен земский мир!"},{"type":"paragraph","text":"На страшный, вновь кровавый пир,"},{"type":"paragraph","text":"Для казни, прежних казней злейшей,"},{"type":"paragraph","text":"Призвал Василька князь старейший."},{"type":"paragraph","text":"Припомнил он, как без причин"},{"type":"paragraph","text":"Он схвачен был по воле братской,"},{"type":"paragraph","text":"Как на глазах его Торчин"},{"type":"paragraph","text":"Точил свой нож в избе белградской."},{"type":"paragraph","text":"Заране свет померк в очах…"},{"type":"paragraph","text":"Как дикий барс лесной в сетях,"},{"type":"paragraph","text":"Боролся княжич с сильной стражей,"},{"type":"paragraph","text":"Но не осилил злобы княжей."},{"type":"paragraph","text":"Не мог он выдержать борьбы…"},{"type":"paragraph","text":"Василька на пол повалили"},{"type":"paragraph","text":"Немилосердные рабы"},{"type":"paragraph","text":"И грудь доской ему сдавили;"},{"type":"paragraph","text":"Уселись конюхи на ней,"},{"type":"paragraph","text":"Взмахнул ножом Торчин-злодей,"},{"type":"paragraph","text":"Несчастный вскрикнул и рванулся —"},{"type":"paragraph","text":"И теплой кровью захлебнулся…"},{"type":"paragraph","text":"И божий мир для князя стал"},{"type":"paragraph","text":"Безмолвно глух, как склеп огромный;"},{"type":"paragraph","text":"Без чувств и памяти, он спал,"},{"type":"paragraph","text":"Как труп под ризой смерти темной;"},{"type":"paragraph","text":"Но был недолог этот сон!"},{"type":"paragraph","text":"О! для чего проснулся он,"},{"type":"paragraph","text":"Зачем вернулося сознанье"},{"type":"paragraph","text":"К нему для нового страданья!.."},{"type":"paragraph","text":"Весь ужас участи своей"},{"type":"paragraph","text":"Теперь лишь понял князь несчастный;"},{"type":"paragraph","text":"Сознанье это смерти злей,"},{"type":"paragraph","text":"И князь зовет ее напрасно,"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"И с громким воплем говорит:"},{"type":"paragraph","text":"«Кто свет очей мне возвратит?"},{"type":"paragraph","text":"О, пусть господь воздаст Давыду"},{"type":"paragraph","text":"За кровь, за муку, за обиду! —"},{"type":"paragraph","text":"И, участь горькую кляня,"},{"type":"paragraph","text":"Припал Василько к изголовью.-"},{"type":"paragraph","text":"Зачем снимали вы с меня"},{"type":"paragraph","text":"Рубашку, залитую кровью, —"},{"type":"paragraph","text":"Перед всевышним судией"},{"type":"paragraph","text":"Предстал бы я в рубашке той —"},{"type":"paragraph","text":"И кровь ему б заговорила"},{"type":"paragraph","text":"Звончее труб, слышнее била!»"},{"type":"paragraph","text":"Лишь перед утром князь затих."},{"type":"paragraph","text":"В избушке ветхой было жутко;"},{"type":"paragraph","text":"Едва мерцал, дымясь, ночник;"},{"type":"paragraph","text":"В сенях дремали слуги чутко;"},{"type":"paragraph","text":"Храпели кони у крыльца;"},{"type":"paragraph","text":"И попадья у ног слепца,"},{"type":"paragraph","text":"Очей усталых не смыкая,"},{"type":"paragraph","text":"Сидела, точно мать родная."},{"type":"paragraph","text":"В его расстроенном уме"},{"type":"paragraph","text":"Не рассветало, сердце ныло;"},{"type":"paragraph","text":"Как в замуравленной тюрьме,"},{"type":"paragraph","text":"В груди темно и пусто было."},{"type":"paragraph","text":"Его надежд блестящих ряд,"},{"type":"paragraph","text":"Все, чем досель он был богат,"},{"type":"paragraph","text":"Все было отнято с очами"},{"type":"paragraph","text":"И в грязь затоптано врагами."},{"type":"paragraph","text":"И не видал несчастный князь,"},{"type":"paragraph","text":"На жестком ложе плача глухо,"},{"type":"paragraph","text":"Как вскоре стража поднялась,"},{"type":"paragraph","text":"Как ставень вынула старуха"},{"type":"paragraph","text":"И солнца луч блеснул в окно."},{"type":"paragraph","text":"До гроба было суждено"},{"type":"paragraph","text":"Ему нести страданья цепи"},{"type":"paragraph","text":"И в мире жить, как в темном склепе."},{"type":"paragraph","text":"4"},{"type":"paragraph","text":"Неудержимая летит"},{"type":"paragraph","text":"Повсюду весть о деле черном."},{"type":"paragraph","text":"Для всех чудовищем Давыд"},{"type":"paragraph","text":"Стал ненавистным и позорным."},{"type":"paragraph","text":"В стенах хором и тесных хат"},{"type":"paragraph","text":"Гремят проклятья, как набат, —"},{"type":"paragraph","text":"Клянут князья, бояре, смерды"},{"type":"paragraph","text":"Давыдов суд немилосердый."},{"type":"paragraph","text":"Как в бурю грозная волна,"},{"type":"paragraph","text":"Весть о злодействе небывалом"},{"type":"paragraph","text":"Всем одинаково страшна —"},{"type":"paragraph","text":"И старикам и детям малым."},{"type":"paragraph","text":"Молва стоустая донесть"},{"type":"paragraph","text":"Спешит нерадостную весть"},{"type":"paragraph","text":"До Перемышля на Волыни"},{"type":"paragraph","text":"И до Васильковой княгини."},{"type":"paragraph","text":"Досель счастливая, она"},{"type":"paragraph","text":"Врасплох застигнута бедою"}]},{"id":"chapter-9","title":"Часть 9","content":[{"type":"paragraph","text":"И вестью той поражена,"},{"type":"paragraph","text":"Как лебедь меткою стрелою."},{"type":"paragraph","text":"Яд горя в грудь ее проник,"},{"type":"paragraph","text":"И светлой радости родник"},{"type":"paragraph","text":"Иссяк в душе. Заполонила"},{"type":"paragraph","text":"Ее тоска, ей все постыло."},{"type":"paragraph","text":"Ее Василько ослеплен!"},{"type":"paragraph","text":"Как с этим горем примириться?.."},{"type":"paragraph","text":"Бежит от глаз княгини сон;"},{"type":"paragraph","text":"Когда ж заснет, то муж ей снится:"},{"type":"paragraph","text":"Блестит на князе молодом"},{"type":"paragraph","text":"С высоким яловцем шелом,"},{"type":"paragraph","text":"И цареградская кольчуга"},{"type":"paragraph","text":"С крестом надета на супруга."},{"type":"paragraph","text":"В руке Васильковой копье;"},{"type":"paragraph","text":"Глаза, как уголья, сверкают;"},{"type":"paragraph","text":"Когда ж он взглянет на нее —"},{"type":"paragraph","text":"Она, голубка, так и тает;"},{"type":"paragraph","text":"На сына взглянет — и вздохнет,"},{"type":"paragraph","text":"И на губах его мелькнет"},{"type":"paragraph","text":"Улыбка ласки и привета, —"},{"type":"paragraph","text":"И любо ей приметить это."},{"type":"paragraph","text":"И снятся ей былые дни,"},{"type":"paragraph","text":"Дни невозвратного веселья…"},{"type":"paragraph","text":"Прошли-промчалися они!"},{"type":"paragraph","text":"Княгиню скорбь крушит, как зелье."},{"type":"paragraph","text":"Ее супруг-слепец, в плену!.."},{"type":"paragraph","text":"Кто защитит его жену?"},{"type":"paragraph","text":"Кто приголубит крошку сына?"},{"type":"paragraph","text":"С кем в бой пойдет его дружина?"},{"type":"paragraph","text":"Едва ль его освободят"},{"type":"paragraph","text":"Его дружинники, бояре."},{"type":"paragraph","text":"Но разве умер старший брат?"},{"type":"paragraph","text":"Иль воев нет у Володаря,"},{"type":"paragraph","text":"Давно испытанных в боях?"},{"type":"paragraph","text":"Иль не восстанет Мономах,"},{"type":"paragraph","text":"Всегдашний враг деяний темных,"},{"type":"paragraph","text":"Протнву братьев вероломных?"},{"type":"paragraph","text":"И одолеть не в силах гнев,"},{"type":"paragraph","text":"Услыша весть о новом горе,"},{"type":"paragraph","text":"Владимир вспрянул, точно лев,"},{"type":"paragraph","text":"И шлет гонца к Олегу вскоре."},{"type":"paragraph","text":"«Доколе нам коснеть во зле? —"},{"type":"paragraph","text":"Он пишет.- Всей родной земле"},{"type":"paragraph","text":"Грозит беда, — судите сами:"},{"type":"paragraph","text":"Давыд повергнул нож меж нами."},{"type":"paragraph","text":"Коль не исправим зла того"},{"type":"paragraph","text":"И не упрочим мир желанный,"},{"type":"paragraph","text":"То брат на брата своего"},{"type":"paragraph","text":"Восстанет в злобе окаянной,"},{"type":"paragraph","text":"К крови потопится земля,"},{"type":"paragraph","text":"Селенья наши и поля"},{"type":"paragraph","text":"Возьмут враги, разрушат грады,"},{"type":"paragraph","text":"И сгибнут в распрях наши чада."},{"type":"paragraph","text":"Раздорам надо быть концу, —"}]},{"id":"chapter-10","title":"Часть 10","content":[{"type":"paragraph","text":"Давно мы ими Русь бесславим."},{"type":"paragraph","text":"Придите, братья, к Городцу, —"},{"type":"paragraph","text":"Скорее вместе зло исправим,"},{"type":"paragraph","text":"Стоять за правду вы клялись»."},{"type":"paragraph","text":"И княжьи счеты улеглись"},{"type":"paragraph","text":"Перед бедою этой новой,"},{"type":"paragraph","text":"Исчез в них дух вражды суровой."},{"type":"paragraph","text":"И Святославичи пришли,"},{"type":"paragraph","text":"Спеша исправить злое дело,"},{"type":"paragraph","text":"Туда, где грозный страж земли"},{"type":"paragraph","text":"Уже стоял с дружиной смелой."},{"type":"paragraph","text":"К борьбе нешуточной готов,"},{"type":"paragraph","text":"Отправил в Киев он послов"},{"type":"paragraph","text":"С такою речью к Святополку:"},{"type":"paragraph","text":"Зачем затеял он размолвку?"},{"type":"paragraph","text":"Зачем нарушил клятву он —"},{"type":"paragraph","text":"Не изнурять земли враждою?"},{"type":"paragraph","text":"За что Василько ослеплен,"},{"type":"paragraph","text":"Давыду выдан головою?"},{"type":"paragraph","text":"Когда вина была на нем,"},{"type":"paragraph","text":"Зачем судил своим судом?"},{"type":"paragraph","text":"Об этом дал бы братьям вести,"},{"type":"paragraph","text":"Мы рассудить сумели б вместе."},{"type":"paragraph","text":"«Не я слепил его — Давыд, —"},{"type":"paragraph","text":"Князь Святополк на то ответил, —"},{"type":"paragraph","text":"Великий грех на нем лежит:"},{"type":"paragraph","text":"Он сесть на стол Давыдов метил,"},{"type":"paragraph","text":"Хотел со мной затеять рать,"},{"type":"paragraph","text":"И стол и жизнь мою отнять,"},{"type":"paragraph","text":"И с Мономахом заедино"},{"type":"paragraph","text":"Взять Туров, Пинск и Погорину."},{"type":"paragraph","text":"Не сам о том дознался я —"},{"type":"paragraph","text":"Мне обо всем Давыд поведал."},{"type":"paragraph","text":"За то ль винят меня князья,"},{"type":"paragraph","text":"Что я Васильке воли не дал?"},{"type":"paragraph","text":"Вины своей не признаю"},{"type":"paragraph","text":"Пред ними. Голову свою"},{"type":"paragraph","text":"Сложить мне не было охоты."},{"type":"paragraph","text":"Пускай с Давыдом сводят счеты»."},{"type":"paragraph","text":"«Уверишь братьев ты навряд, —"},{"type":"paragraph","text":"Сказали посланные мужи, —"},{"type":"paragraph","text":"Что не тобой Василько взят:"},{"type":"paragraph","text":"Ты взял, — вина твоя наруже»."},{"type":"paragraph","text":"И разошлися до утра,"},{"type":"paragraph","text":"Чтоб с новым днем по льду Днепра"},{"type":"paragraph","text":"Под стольный Киев перебраться"},{"type":"paragraph","text":"И с князем в поле посчитаться."},{"type":"paragraph","text":"Не захотел пропасть в бою"},{"type":"paragraph","text":"Великий князь, объятый страхом."},{"type":"paragraph","text":"Жалея голову свою,"},{"type":"paragraph","text":"Тогда бежать задумал к ляхам,"},{"type":"paragraph","text":"И, матерь русских городов,"},{"type":"paragraph","text":"Он Киев кинуть был готов;"},{"type":"paragraph","text":"Но не пустили киевляне"},{"type":"paragraph","text":"Его, бояся большей брани."}]},{"id":"chapter-11","title":"Часть 11","content":[{"type":"paragraph","text":"Нет, не успеет Мономах"},{"type":"paragraph","text":"Достигнуть утром переправы:"},{"type":"paragraph","text":"Чем свет весь Киев на ногах;"},{"type":"paragraph","text":"Но не воздвигнут величавый"},{"type":"paragraph","text":"Стяг Святополка у ворот,"},{"type":"paragraph","text":"Дружина княжья не зовет"},{"type":"paragraph","text":"Смущенных граждан к обороне,"},{"type":"paragraph","text":"И не стучат мечи о брони."},{"type":"paragraph","text":"Великий князь, земли глава,"},{"type":"paragraph","text":"Боится пасть в бою открытом,"},{"type":"paragraph","text":"И Всеволожская вдова"},{"type":"paragraph","text":"Идет с отцом-митрополитом"},{"type":"paragraph","text":"В стан Мономаха; весь народ,"},{"type":"paragraph","text":"Сопровождая крестный ход,"},{"type":"paragraph","text":"Усердно молится иконам,"},{"type":"paragraph","text":"И полон город красным звоном."},{"type":"paragraph","text":"Перед Владимиром склонясь,"},{"type":"paragraph","text":"Сказала старая княгиня:"},{"type":"paragraph","text":"«Будь милосерд, родной мой князь!"},{"type":"paragraph","text":"К тебе пришли мы с просьбой ныне."},{"type":"paragraph","text":"Князь, покажи нам милость въявь"},{"type":"paragraph","text":"И новой скорби не прибавь"},{"type":"paragraph","text":"В правдивом гневе к нашим болям, —"},{"type":"paragraph","text":"Тебя о том мы слезно молим."},{"type":"paragraph","text":"Земли защитник ты, не враг,"},{"type":"paragraph","text":"Не половчин, не Торчин ярый!»"},{"type":"paragraph","text":"Заплакал горько Мономах,"},{"type":"paragraph","text":"Услыша вопль княгини старой."},{"type":"paragraph","text":"И говорит он братьям речь:"},{"type":"paragraph","text":"«Ужель нам землю не беречь?"},{"type":"paragraph","text":"Ее отцы трудом стяжали,"},{"type":"paragraph","text":"А мы терзать в раздорах стали!"},{"type":"paragraph","text":"Как сын, Василько мной любим, —"},{"type":"paragraph","text":"Но обреку ль бедам и мщенью"},{"type":"paragraph","text":"Людей, невинных перед ним"},{"type":"paragraph","text":"И не причастных преступленью?"},{"type":"paragraph","text":"Пусть бог воздаст его врагам"},{"type":"paragraph","text":"По их неправедным делам,"},{"type":"paragraph","text":"Но мы невинных не осудим»."},{"type":"paragraph","text":"И дал он мир земле и людям."},{"type":"paragraph","text":"5"},{"type":"paragraph","text":"Волынь в тревоге. Снова рать,"},{"type":"paragraph","text":"И дух вражды опять повеял;"},{"type":"paragraph","text":"Князь Володарь заставил сжать"},{"type":"paragraph","text":"Давыда то, что он посеял."},{"type":"paragraph","text":"Васильке им освобожден;"},{"type":"paragraph","text":"За ослепленье и полон,"},{"type":"paragraph","text":"За муки все отмстить заклятым"},{"type":"paragraph","text":"Своим врагам идет он с братом."},{"type":"paragraph","text":"Уже не в силах Мономах"},{"type":"paragraph","text":"Остановить кровопролитья,"},{"type":"paragraph","text":"И пробудил Давыда страх,"},{"type":"paragraph","text":"Как гром, от сладкого забытья."},{"type":"paragraph","text":"Его советники бегут;"},{"type":"paragraph","text":"Но братья требуют на суд"}]},{"id":"chapter-12","title":"Часть 12","content":[{"type":"paragraph","text":"Их, виноватых в грозной брани,"},{"type":"paragraph","text":"И ставят виселицы в стане."},{"type":"paragraph","text":"И должен выдать их Давыд,"},{"type":"paragraph","text":"И должен сам понесть бесчестье."},{"type":"paragraph","text":"Слепец разгневанный грозит"},{"type":"paragraph","text":"И Святополку страшной местью."},{"type":"paragraph","text":"Став с Володарем на Рожне,"},{"type":"paragraph","text":"Предать разгрому и войне"},{"type":"paragraph","text":"Без сожаленья и пощады"},{"type":"paragraph","text":"Он хочет княжеские грады."},{"type":"paragraph","text":"В душе Василька ночи тень,"},{"type":"paragraph","text":"И этот мрак, как смерть, ужасен,"},{"type":"paragraph","text":"А божий мир так светел. День"},{"type":"paragraph","text":"Весенний радостен и ясен;"},{"type":"paragraph","text":"Деревья в зелень убраны;"},{"type":"paragraph","text":"Тепло, но веянье весны"},{"type":"paragraph","text":"Грудь Ростиславича не греет:"},{"type":"paragraph","text":"В ней скорби лед, в ней злоба зреет."},{"type":"paragraph","text":"Луч солнца ласково скользит"},{"type":"paragraph","text":"По золоченому оплечью —"},{"type":"paragraph","text":"Не видит солнца князь; громит"},{"type":"paragraph","text":"Он Святополка грозной речью."},{"type":"paragraph","text":"«Вот чем мне клялся стольный князь!» —"},{"type":"paragraph","text":"Воскликнул он, остановясь"},{"type":"paragraph","text":"Перед дружиной боевою,"},{"type":"paragraph","text":"И поднял крест над головою."},{"type":"paragraph","text":"«Он отнял свет моих очей,"},{"type":"paragraph","text":"Теперь отнять и душу хочет."},{"type":"paragraph","text":"И так я нищего бедней!"},{"type":"paragraph","text":"Я рад бы плакать, но не точат"},{"type":"paragraph","text":"Мои слепые очи слез,"},{"type":"paragraph","text":"И грудь больную злее ос"},{"type":"paragraph","text":"Терзают страшные недуги…"},{"type":"paragraph","text":"За жизнь мою постойте, други!»"},{"type":"paragraph","text":"Пал Святополков скоро стяг."},{"type":"paragraph","text":"Великокняжая дружина"},{"type":"paragraph","text":"Бежит, разбитая во прах."},{"type":"paragraph","text":"Покрыта павшими равнина,"},{"type":"paragraph","text":"Где совершен упорный бой;"},{"type":"paragraph","text":"Но не ликует князь слепой,"},{"type":"paragraph","text":"Победы славной слыша звуки,"},{"type":"paragraph","text":"А говорит, поднявши руки:"},{"type":"paragraph","text":"«От верных ратников моих"},{"type":"paragraph","text":"Бегут и пешие и кмети"},{"type":"paragraph","text":"Уже не первый раз; для них,"},{"type":"paragraph","text":"Как пир, утешны битвы эти."},{"type":"paragraph","text":"А я, несчастный, слыша гром,"},{"type":"paragraph","text":"Могу лишь в воздухе мечом"},{"type":"paragraph","text":"Махать, грозя врагам безвредно."},{"type":"paragraph","text":"Меня не тешит крик победный."},{"type":"paragraph","text":"На свете горько жить слепцу."},{"type":"paragraph","text":"Что мне в моей ненужной силе,"},{"type":"paragraph","text":"Коль не могу лицом к лицу"},{"type":"paragraph","text":"С врагом сойтися? — Лишь в могиле,"},{"type":"paragraph","text":"Когда придет моя пора,"}]},{"id":"chapter-13","title":"Часть 13","content":[{"type":"paragraph","text":"Увижу ясный свет утра"},{"type":"paragraph","text":"Я после долгой, страшной ночи,"},{"type":"paragraph","text":"И только смерть вернет мне очи!..»"},{"type":"paragraph","text":"1876"}]}]}