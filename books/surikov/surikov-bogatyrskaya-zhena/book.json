{"id":"surikov-bogatyrskaya-zhena","slug":"surikov-bogatyrskaya-zhena","shard":1,"title":"Богатырская жена","altTitles":[],"author":"Иван Захарович Суриков","authorShort":"И. З. Суриков","authorSlug":"surikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1875","editionYear":"1875","description":"БОГАТЫРСКАЯ ЖЕНА","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%91%D0%BE%D0%B3%D0%B0%D1%82%D1%8B%D1%80%D1%81%D0%BA%D0%B0%D1%8F_%D0%B6%D0%B5%D0%BD%D0%B0_%28%D0%A1%D1%83%D1%80%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1875)","downloadAllowed":true,"fb2Url":"/archive/books/surikov/surikov-bogatyrskaya-zhena/original.fb2","coverUrl":"/archive/books/surikov/surikov-bogatyrskaya-zhena/cover.webp","stats":{"chaptersCount":12,"wordsCount":2464,"charsCount":15250,"readingMinutes":14},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"},{"id":"chapter-9","title":"Часть 9"},{"id":"chapter-10","title":"Часть 10"},{"id":"chapter-11","title":"Часть 11"},{"id":"chapter-12","title":"Часть 12"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"БОГАТЫРСКАЯ ЖЕНА"},{"type":"paragraph","text":"1"},{"type":"paragraph","text":"Князь Владимир стольно-киевский"},{"type":"paragraph","text":"Созывал на пир гостей,"},{"type":"paragraph","text":"Верных слуг своих — дружинников,"},{"type":"paragraph","text":"Удалых богатырей."},{"type":"paragraph","text":"Звал их яства есть сахарные,"},{"type":"paragraph","text":"Пить медвяные питья;"},{"type":"paragraph","text":"И сходились гости званые,"},{"type":"paragraph","text":"И бояре и князья."},{"type":"paragraph","text":"Много было ими выпито"},{"type":"paragraph","text":"Искрометного вина;"},{"type":"paragraph","text":"То и дело осушалися"},{"type":"paragraph","text":"Чаши полные до дна."},{"type":"paragraph","text":"Обходил дружину храбрую"},{"type":"paragraph","text":"С хмельной брагой турий рог;"},{"type":"paragraph","text":"Только хмель гостей Владимира"},{"type":"paragraph","text":"Под столы свалить не мог."},{"type":"paragraph","text":"Вот, как вполсыта наелися"},{"type":"paragraph","text":"И вполпьяна напились,"},{"type":"paragraph","text":"Гости начали прихвастывать,"},{"type":"paragraph","text":"Похваляться принялись."},{"type":"paragraph","text":"Кто хвалился силой крепкою,"},{"type":"paragraph","text":"Кто несметною казной,"},{"type":"paragraph","text":"Кто своей утехой сладкою —"},{"type":"paragraph","text":"Богатырскою женой."},{"type":"paragraph","text":"Кло товарами заморскими,"},{"type":"paragraph","text":"Кто испытанным конем…"},{"type":"paragraph","text":"Лишь Данило призадумался,"},{"type":"paragraph","text":"Наклонившись над столом."},{"type":"paragraph","text":"На пиру великокняжеском"},{"type":"paragraph","text":"Он не хвалится ничем;"},{"type":"paragraph","text":"И насмешливо дружинники"},{"type":"paragraph","text":"Шепчут: «Глух он али нем?»"},{"type":"paragraph","text":"— «Ты почто, скажи, задумался? —"},{"type":"paragraph","text":"Князь Даниле говорит.-"},{"type":"paragraph","text":"Взор твой ясный темной думою,"},{"type":"paragraph","text":"Словно облаком, покрыт."},{"type":"paragraph","text":"Али нет казны и силушки"},{"type":"paragraph","text":"У тебя, Данило-свет?"},{"type":"paragraph","text":"Платье ль цветное изношено?"},{"type":"paragraph","text":"Aль жены-утехи нет?»"},{"type":"paragraph","text":"Встрепенулся свет Денисьевич,"},{"type":"paragraph","text":"Молвя князю: «Всем богат;"},{"type":"paragraph","text":"А своей я темной думушке,"},{"type":"paragraph","text":"Добрый княже, сам не рад."},{"type":"paragraph","text":"На твоем пиру на княжеском"},{"type":"paragraph","text":"Собеседник я плохой;"},{"type":"paragraph","text":"И тебе я, княже, кланяюсь:"},{"type":"paragraph","text":"Отпусти меня домой."},{"type":"paragraph","text":"Отчего — я сам не ведаю,"},{"type":"paragraph","text":"Грусть взяла меня теперь!..»"},{"type":"paragraph","text":"Встал Данило, князю-солнышку"},{"type":"paragraph","text":"Бил челом — и вышел в дверь…"},{"type":"paragraph","text":"2"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"И дружине молвил ласково"},{"type":"paragraph","text":"Князь Владимир, поклонясь:"},{"type":"paragraph","text":"«Все вы, други, переженены,"},{"type":"paragraph","text":"Не женат лишь я, ваш князь."},{"type":"paragraph","text":"Между вами обездоленным"},{"type":"paragraph","text":"Я хожу холостяком:"},{"type":"paragraph","text":"Помогите же, товарищи,"},{"type":"paragraph","text":"Мне в несчастии таком."},{"type":"paragraph","text":"Приищите мне невестушку,"},{"type":"paragraph","text":"Чтобы ласкова была,"},{"type":"paragraph","text":"И смышлена в книжной грамоте,"},{"type":"paragraph","text":"И румяна, и бела."},{"type":"paragraph","text":"Чтоб женой была мне доброю,"},{"type":"paragraph","text":"Доброй матушкою вам,"},{"type":"paragraph","text":"Чтоб не стыдно государыней"},{"type":"paragraph","text":"Звать ее богатырям»."},{"type":"paragraph","text":"Князь умолк, и призадумались"},{"type":"paragraph","text":"Все его богатыри:"},{"type":"paragraph","text":"Сватом быть для князя стольного"},{"type":"paragraph","text":"Трудно, что ни говори!"},{"type":"paragraph","text":"Лишь Мишата не задумался:"},{"type":"paragraph","text":"«На примете есть одна, —"},{"type":"paragraph","text":"Молвил он, — лебедка белая,"},{"type":"paragraph","text":"Богатырская жена."},{"type":"paragraph","text":"То жена Данилы славного."},{"type":"paragraph","text":"Уж куда как хороша"},{"type":"paragraph","text":"Василиса свет Микулишна,"},{"type":"paragraph","text":"Раскрасавица-душа!"},{"type":"paragraph","text":"Ясны очи соколиные,"},{"type":"paragraph","text":"Брови соболя черней;"},{"type":"paragraph","text":"В целом городе Чернигове"},{"type":"paragraph","text":"Василисы нет умней."},{"type":"paragraph","text":"Не уступит мужу книжному"},{"type":"paragraph","text":"В русской грамоте она,"},{"type":"paragraph","text":"И петью-четью церковному"},{"type":"paragraph","text":"Хорошо обучена»."},{"type":"paragraph","text":"С грозным гневом на Путятича"},{"type":"paragraph","text":"Князь Владимир поглядел:"},{"type":"paragraph","text":"«Спьяну, что ль, заговорился ты"},{"type":"paragraph","text":"Али в петлю захотел?"},{"type":"paragraph","text":"Разве я лишился разума?"},{"type":"paragraph","text":"Разве зверь я али тать?"},{"type":"paragraph","text":"От живого мужа можно ли"},{"type":"paragraph","text":"Мне жену насильно взять?»"},{"type":"paragraph","text":"Нe сробел Мишата, вкрадчиво"},{"type":"paragraph","text":"Князю молвил он в отает\"."},{"type":"paragraph","text":"«Князь Данило ходит под богом —"},{"type":"paragraph","text":"Нынче жив, а завтра нет."},{"type":"paragraph","text":"Коль слова мои не по сердцу,"},{"type":"paragraph","text":"То казнить меня вели;"},{"type":"paragraph","text":"Только прежде поохотиться"},{"type":"paragraph","text":"В лес Денисьича пошли."},{"type":"paragraph","text":"В темных дебрях под Черниговом"},{"type":"paragraph","text":"Зверя тьма, а лову нет:"},{"type":"paragraph","text":"Прикажи поймать Денисьичу"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Злого тура на обед."},{"type":"paragraph","text":"На охоте все случается:"},{"type":"paragraph","text":"С буйным зверем труден бой,"},{"type":"paragraph","text":"И не взять его охотнику,"},{"type":"paragraph","text":"Княже, силою одной»."},{"type":"paragraph","text":"Понял князь Владимир Киевский"},{"type":"paragraph","text":"Смысл лукавых этих слов,"},{"type":"paragraph","text":"И писать к Даниле грамоту"},{"type":"paragraph","text":"Он призвал своих писцов."},{"type":"paragraph","text":"Те писцы писали витязю,"},{"type":"paragraph","text":"Чтобы он в лесах густых"},{"type":"paragraph","text":"Ради князя поохотился"},{"type":"paragraph","text":"На зверей и птиц лесных."},{"type":"paragraph","text":"Поискал бы тура дикого,"},{"type":"paragraph","text":"С поля взял его живьем."},{"type":"paragraph","text":"И отправил князь Путятича"},{"type":"paragraph","text":"С этой грамотой послом."},{"type":"paragraph","text":"3"},{"type":"paragraph","text":"В светлом тереме Даниловом,"},{"type":"paragraph","text":"Призадумавшись, одна"},{"type":"paragraph","text":"У окна сидит красавица,"},{"type":"paragraph","text":"Богатырская жена."},{"type":"paragraph","text":"Муж уехал поохотиться"},{"type":"paragraph","text":"В бор Черниговский чем свет;"},{"type":"paragraph","text":"Вот уж время близко к вечеру,"},{"type":"paragraph","text":"А Денисьича все нет."},{"type":"paragraph","text":"Скучно ей одной без милого,"},{"type":"paragraph","text":"Грусть-тоска ее томит…"},{"type":"paragraph","text":"Вдруг услышала: у терема"},{"type":"paragraph","text":"Раздается стук копыт."},{"type":"paragraph","text":"Гость нежданный и непрошеный"},{"type":"paragraph","text":"У Даниловых ворот,"},{"type":"paragraph","text":"Привязав коня усталого,"},{"type":"paragraph","text":"Скоро к терему идет."},{"type":"paragraph","text":"Не спросился слуг невежливый"},{"type":"paragraph","text":"Володимиров посол:"},{"type":"paragraph","text":"Он в светлицу бездокладочно"},{"type":"paragraph","text":"С княжьей грамотой вошел."},{"type":"paragraph","text":"Василиса гневно встретила"},{"type":"paragraph","text":"Неучтивого посла"},{"type":"paragraph","text":"И неладным смердом княжеским,"},{"type":"paragraph","text":"Рассердившись, назвала."},{"type":"paragraph","text":"А Путятич молвил, до земли"},{"type":"paragraph","text":"Василисе поклонясь:"},{"type":"paragraph","text":"«Не гневися, государыня,"},{"type":"paragraph","text":"Что вошел я не спросясь."},{"type":"paragraph","text":"Не своей сюда охотою"},{"type":"paragraph","text":"Я приехал: князь велел;"},{"type":"paragraph","text":"В терем твой без воли княжеской"},{"type":"paragraph","text":"Я войти бы не посмел."},{"type":"paragraph","text":"К твоему Даниле грамоту"},{"type":"paragraph","text":"Князь велел мне отвезти:"},{"type":"paragraph","text":"Получи; а за невежливость,"},{"type":"paragraph","text":"Государыня, прости»."},{"type":"paragraph","text":"Василиса закручинилась,"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Прочитав княжой приказ:"},{"type":"paragraph","text":"Побелели щеки алые,"},{"type":"paragraph","text":"Слезы хлынули из глаз."},{"type":"paragraph","text":"Поняла она из грамоты,"},{"type":"paragraph","text":"Что недоброе в ней есть,"},{"type":"paragraph","text":"Что замыслил князь Денисьича"},{"type":"paragraph","text":"Злою хитростью известь."},{"type":"paragraph","text":"Кличет слуг к себе Микулишна"},{"type":"paragraph","text":"И велит седлать коня."},{"type":"paragraph","text":"«Снаряжайте, слуги верные,"},{"type":"paragraph","text":"К мужу в поле вы меня!"},{"type":"paragraph","text":"Дайте платье молодецкое,"},{"type":"paragraph","text":"Принесите лук тугой!"},{"type":"paragraph","text":"Сердце чует горе лютое"},{"type":"paragraph","text":"И дрожит перед бедой…»"},{"type":"paragraph","text":"И катились слезы горькие"},{"type":"paragraph","text":"Крупным градом по лицу."},{"type":"paragraph","text":"Слуги верные ретивого"},{"type":"paragraph","text":"Привели коня к крыльцу."},{"type":"paragraph","text":"На коня она садилася,"},{"type":"paragraph","text":"Взяв колчан каленых стрел,"},{"type":"paragraph","text":"И, едва земли касаяся,"},{"type":"paragraph","text":"Конь, как вихорь, полетел."},{"type":"paragraph","text":"4"},{"type":"paragraph","text":"Над собой беды не ведая,"},{"type":"paragraph","text":"Рыщет в поле богатырь."},{"type":"paragraph","text":"Быстрый конь Данилу по полю"},{"type":"paragraph","text":"Быстро носит вдаль и вширь."},{"type":"paragraph","text":"Настрелял с утра Денисьевич"},{"type":"paragraph","text":"Много дичи луговой;"},{"type":"paragraph","text":"Он охотой не натешится,"},{"type":"paragraph","text":"Не спешит к жене домой."},{"type":"paragraph","text":"Вдруг он видит: от Чернигова"},{"type":"paragraph","text":"Не орел к нему летит —"},{"type":"paragraph","text":"Мчится вихрем добрый молодец,"},{"type":"paragraph","text":"Под конем земля дрожит."},{"type":"paragraph","text":"Закричал Данило молодцу,"},{"type":"paragraph","text":"Меч подняв над головой:"},{"type":"paragraph","text":"«Стой, удалый, добрый молодец!"},{"type":"paragraph","text":"Говори, кто ты такой?"},{"type":"paragraph","text":"Если друг, то побратаемся,"},{"type":"paragraph","text":"Поведем любовно речь;"},{"type":"paragraph","text":"Если недруг — потягаемся,"},{"type":"paragraph","text":"У кого тяжеле меч»."},{"type":"paragraph","text":"Говорит проезжий молодец,"},{"type":"paragraph","text":"Шапку сняв с густых кудрей:"},{"type":"paragraph","text":"«Не узнал ты, свет Денисьевич,"},{"type":"paragraph","text":"Молодой жены своей!"},{"type":"paragraph","text":"Знать, не долго нам понежиться"},{"type":"paragraph","text":"И в любви пожить с тобой."},{"type":"paragraph","text":"Перестань охотой тешиться,"},{"type":"paragraph","text":"Поезжай скорей домой!»"},{"type":"paragraph","text":"Тут прочла ему Микулишна"},{"type":"paragraph","text":"Володимиров ярлык,"},{"type":"paragraph","text":"Но Данило в хитрый умысел"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Князя стольного не вник."},{"type":"paragraph","text":"Отвечает он с усмешкою"},{"type":"paragraph","text":"Молодой своей жене:"},{"type":"paragraph","text":"«Вижу я, тебе кручинушка"},{"type":"paragraph","text":"Померещилась во сне."},{"type":"paragraph","text":"Где же видано и слыхано,"},{"type":"paragraph","text":"Чтобы князь богатыря"},{"type":"paragraph","text":"За любовь и службу верную"},{"type":"paragraph","text":"Извести задумал зря?"},{"type":"paragraph","text":"Лучше в тереме хозяйничай,"},{"type":"paragraph","text":"Знай домашний обиход"},{"type":"paragraph","text":"И словами неразумными"},{"type":"paragraph","text":"Не пугай меня вперед."},{"type":"paragraph","text":"Я на тура поохотиться"},{"type":"paragraph","text":"Рад для князя всей душой;"},{"type":"paragraph","text":"Только мало стрел осталося,"},{"type":"paragraph","text":"А запасных нет со мной."},{"type":"paragraph","text":"Привези колчан мне маленький,"},{"type":"paragraph","text":"А большого не бери:"},{"type":"paragraph","text":"Много стрел ловцу не надобно —"},{"type":"paragraph","text":"Метко бьют богатыри!»"},{"type":"paragraph","text":"Говорит она: «Со стрелами"},{"type":"paragraph","text":"Я большой колчан взяла."},{"type":"paragraph","text":"Не сердись, нужна при случае"},{"type":"paragraph","text":"В поле лишняя стрела."},{"type":"paragraph","text":"Чует горе сердце вещее,"},{"type":"paragraph","text":"Ты словам моим поверь:"},{"type":"paragraph","text":"Тур не страшен для охотника, —"},{"type":"paragraph","text":"Человек страшней, чем зверь…»"},{"type":"paragraph","text":"С грустью тяжкою Микулишна"},{"type":"paragraph","text":"Крепко мужа обняла"},{"type":"paragraph","text":"И вернулася к Чернигову,"},{"type":"paragraph","text":"Путь слезами полила."},{"type":"paragraph","text":"5"},{"type":"paragraph","text":"Рыщет витязь день до вечера"},{"type":"paragraph","text":"По лугам и по лесам:"},{"type":"paragraph","text":"Зверя-тура круторогого"},{"type":"paragraph","text":"Ищет он и там и сям:"},{"type":"paragraph","text":"В буераках и кустарниках,"},{"type":"paragraph","text":"В чащах диких и густых…"},{"type":"paragraph","text":"Вот уж день склонился к вечеру,"},{"type":"paragraph","text":"И дремучий лес затих."},{"type":"paragraph","text":"Но не слышно по окружности"},{"type":"paragraph","text":"Рева турьего нигде…"},{"type":"paragraph","text":"Шепчет витязь опечаленный:"},{"type":"paragraph","text":"«Надо ж быть такой беде!»"},{"type":"paragraph","text":"Рыщет по лесу Денисьевич —"},{"type":"paragraph","text":"Как на грех удачи нет!"},{"type":"paragraph","text":"Не привезть и нынче витязю"},{"type":"paragraph","text":"Дичь на княжеский обед!"},{"type":"paragraph","text":"Снова день склонился к вечеру,"},{"type":"paragraph","text":"Нет в лесу души живой,"},{"type":"paragraph","text":"Только рысь порою быстрая"},{"type":"paragraph","text":"Промелькнет вдали стрелой."},{"type":"paragraph","text":"Только вороны зловещие"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"С криком носятся вверху,"},{"type":"paragraph","text":"Громко каркая над витязем:"},{"type":"paragraph","text":"Быть невзгоде! быть греху!"},{"type":"paragraph","text":"Только холодом кладбищенским"},{"type":"paragraph","text":"Вдруг повеет нетопырь…"},{"type":"paragraph","text":"Ночи сумрачней, под дерево"},{"type":"paragraph","text":"Лег могучий богатырь."},{"type":"paragraph","text":"Шею вытянув упругую,"},{"type":"paragraph","text":"Конь дыханием своим"},{"type":"paragraph","text":"Греет доброго хозяина"},{"type":"paragraph","text":"И печально ржет над ним."},{"type":"paragraph","text":"«Что ты льнешь ко мне, ласкаешься,"},{"type":"paragraph","text":"Мой товарищ боевой? —"},{"type":"paragraph","text":"Говорит ему Денисьевич.-"},{"type":"paragraph","text":"Что поник ты головой?"},{"type":"paragraph","text":"Что своим дыханьем огненным"},{"type":"paragraph","text":"Жгешь ты мне лицо и грудь?"},{"type":"paragraph","text":"Иль боишься зверя лютого?"},{"type":"paragraph","text":"Или чуешь что-нибудь?..»"},{"type":"paragraph","text":"Конь трясет косматой гривою"},{"type":"paragraph","text":"И копытом в землю бьет,"},{"type":"paragraph","text":"Точно хочет что-то вымолвить,"},{"type":"paragraph","text":"Только слов недостает."},{"type":"paragraph","text":"Лишь блеснул на небе розовый"},{"type":"paragraph","text":"Луч зари, предвестник дня,"},{"type":"paragraph","text":"Встал Данило с ложа жесткого,"},{"type":"paragraph","text":"Сел на доброго коня."},{"type":"paragraph","text":"Едет он из леса темного"},{"type":"paragraph","text":"В поле счастья попытать…"},{"type":"paragraph","text":"Чу… вдали там что-то слышится:"},{"type":"paragraph","text":"Не идет ли с юга рать?"},{"type":"paragraph","text":"Мать сыра земля колышется,"},{"type":"paragraph","text":"И дремучий бор дрожит;"},{"type":"paragraph","text":"Словно гром гремит раскатистый,"},{"type":"paragraph","text":"Раздается стук копыт."},{"type":"paragraph","text":"Стал Данило за кустарником,"},{"type":"paragraph","text":"Видит: с южной стороны"},{"type":"paragraph","text":"Грозно движутся два всадника,"},{"type":"paragraph","text":"Будто две больших копны."},{"type":"paragraph","text":"Что-то будет, что-то станется?"},{"type":"paragraph","text":"Сердце екнуло в груди…"},{"type":"paragraph","text":"Видно, пасть в борьбе Денисьичу"},{"type":"paragraph","text":"С тем, кто едет впереди."},{"type":"paragraph","text":"Скачет конь под ним, играючи,"},{"type":"paragraph","text":"Блещет золотом шелом…"},{"type":"paragraph","text":"И узнал Данило с горестью"},{"type":"paragraph","text":"Брата названного в нем…"},{"type":"paragraph","text":"Он одет в кольчугу крепкую,"},{"type":"paragraph","text":"Тяжела его рука;"},{"type":"paragraph","text":"И на смертный бой Денисьича"},{"type":"paragraph","text":"Он зовет издалека."},{"type":"paragraph","text":"Словно сокол с черным вороном,"},{"type":"paragraph","text":"Близкой смерти вещуном,"},{"type":"paragraph","text":"Он с Алешею Поповичем"},{"type":"paragraph","text":"Мчится по полю вдвоем…"}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"Дрогнув, слез с коня Денисьевич…"},{"type":"paragraph","text":"Сердце сжала злая боль…"},{"type":"paragraph","text":"Он с Добрынею Никитичем"},{"type":"paragraph","text":"Побратался для того ль? .."},{"type":"paragraph","text":"«Видно, князю я не надобен! —"},{"type":"paragraph","text":"Говорит он сам себе.-"},{"type":"paragraph","text":"Но по воле князя стольного"},{"type":"paragraph","text":"Не погибну я в борьбе."},{"type":"paragraph","text":"Кровью брата и товарища"},{"type":"paragraph","text":"Я земли не обагрю,"},{"type":"paragraph","text":"Для потехи княжьей совестно"},{"type":"paragraph","text":"В бой вступать богатырю."},{"type":"paragraph","text":"Не убить Добрыне молодца"},{"type":"paragraph","text":"В поединке роковом!»"},{"type":"paragraph","text":"И воткнул копье злаченое"},{"type":"paragraph","text":"В землю он тупым концом."},{"type":"paragraph","text":"Сбросил с плеч доспехи твердые,"},{"type":"paragraph","text":"Грудью пал на острие —"},{"type":"paragraph","text":"И пробило молодецкую"},{"type":"paragraph","text":"Грудь злаченое копье."},{"type":"paragraph","text":"Мать сыра земля зарделася,"},{"type":"paragraph","text":"Теплой кровью полита,"},{"type":"paragraph","text":"И душа Данилы чистая"},{"type":"paragraph","text":"Вышла в алые уста."},{"type":"paragraph","text":"И когда борцы подъехали"},{"type":"paragraph","text":"Вызывать его на бой,"},{"type":"paragraph","text":"Только труп один безжизненный"},{"type":"paragraph","text":"Увидали пред собой."},{"type":"paragraph","text":"6"},{"type":"paragraph","text":"Что за праздник в стольном Киеве?"},{"type":"paragraph","text":"Князь с дружиной удалой"},{"type":"paragraph","text":"На помолвку собираются"},{"type":"paragraph","text":"К Василисе молодой."},{"type":"paragraph","text":"Многоценную, жемчужную"},{"type":"paragraph","text":"Он везет невесте нить…"},{"type":"paragraph","text":"Хочет сердце неподкупное"},{"type":"paragraph","text":"Ожерельями купить."},{"type":"paragraph","text":"Весел князь Владимир Киевский:"},{"type":"paragraph","text":"Витязь преданный его"},{"type":"paragraph","text":"На лугу, в траве некошеной,"},{"type":"paragraph","text":"Спит, не слышит ничего."},{"type":"paragraph","text":"Праздно вкруг его валяются"},{"type":"paragraph","text":"Стрелы, меч и крепкий щит,"},{"type":"paragraph","text":"Добрый конь бессменным сторожем"},{"type":"paragraph","text":"Над хозяином стоит."},{"type":"paragraph","text":"Шею гордую, косматую"},{"type":"paragraph","text":"Опустил он грустно ниц"},{"type":"paragraph","text":"И от трупа грозным ржанием"},{"type":"paragraph","text":"Отгоняет хищных птиц."},{"type":"paragraph","text":"Василиса убивается"},{"type":"paragraph","text":"В светлой горнице своей:"},{"type":"paragraph","text":"Не видать ей мужа милого,"},{"type":"paragraph","text":"Не слыхать его речей!"},{"type":"paragraph","text":"А Владимир по дороженьке"},{"type":"paragraph","text":"На ретивом скакуне,"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"Впереди своих дружинников,"},{"type":"paragraph","text":"Мчится к будущей жене."},{"type":"paragraph","text":"Грудь высокая волнуется,"},{"type":"paragraph","text":"В жилах кровь ключом кипит,"},{"type":"paragraph","text":"К голубым очам красавицы"},{"type":"paragraph","text":"Дума пылкая летит…"},{"type":"paragraph","text":"Что стучит-гремит в Чернигове?"},{"type":"paragraph","text":"Что вздымает пыль столбом?"},{"type":"paragraph","text":"Поезд свадебный Владимира"},{"type":"paragraph","text":"К Василисе едет в дом."},{"type":"paragraph","text":"И, предчувствуя недоброе,"},{"type":"paragraph","text":"Слуги в страхе к ней сошлись,"},{"type":"paragraph","text":"Говорят ей: «Государыня!"},{"type":"paragraph","text":"В платье мужа нарядись!"},{"type":"paragraph","text":"Из конюшни мужней лучшего"},{"type":"paragraph","text":"Скакуна себе бери!"},{"type":"paragraph","text":"За тобой идут из Киева"},{"type":"paragraph","text":"Князь и все богатыри»."},{"type":"paragraph","text":"Отвечает им красавица:"},{"type":"paragraph","text":"«Мне не надобно коня;"},{"type":"paragraph","text":"Не хочу, чтоб слуги верные"},{"type":"paragraph","text":"Пострадали за меня."},{"type":"paragraph","text":"Перед князем неповинна я,"},{"type":"paragraph","text":"Перед богом я чиста."},{"type":"paragraph","text":"Принимайте ж князя с почестью,"},{"type":"paragraph","text":"Отворяйте ворота»."},{"type":"paragraph","text":"Слезы вытерла горючие"},{"type":"paragraph","text":"Богатырская жена,"},{"type":"paragraph","text":"И велела платья лучшие"},{"type":"paragraph","text":"Принести к себе она."},{"type":"paragraph","text":"Освежила в мыльне чистою"},{"type":"paragraph","text":"Ключевой водой лицо"},{"type":"paragraph","text":"И встречать гостей непрошеных"},{"type":"paragraph","text":"Смело вышла на крыльцо."},{"type":"paragraph","text":"Словно дня сияньем ласковым"},{"type":"paragraph","text":"Небо пышно рассвело,"},{"type":"paragraph","text":"Словно утром рано на небо"},{"type":"paragraph","text":"Солнце ясное взошло."},{"type":"paragraph","text":"То не зорюшка румянится,"},{"type":"paragraph","text":"То не солнышко блестит-"},{"type":"paragraph","text":"Василиса свет Микулишна"},{"type":"paragraph","text":"На крыльце резном стоит."},{"type":"paragraph","text":"Тихо, словно очарованный,"},{"type":"paragraph","text":"Подошел Владимир к ней"},{"type":"paragraph","text":"И не может от красавицы"},{"type":"paragraph","text":"Оторвать своих очей,"},{"type":"paragraph","text":"И не может ей разумное"},{"type":"paragraph","text":"Слово вымолвить в привет…"},{"type":"paragraph","text":"Изойди всю землю русскую —"},{"type":"paragraph","text":"В ней красы подобной нет!"},{"type":"paragraph","text":"Низко князю поклонилася"},{"type":"paragraph","text":"Богатырская жена"},{"type":"paragraph","text":"И в дверях остановилася,"},{"type":"paragraph","text":"Молчалива и скромна."},{"type":"paragraph","text":"Что ж в душе у ней таилося,"}]},{"id":"chapter-9","title":"Часть 9","content":[{"type":"paragraph","text":"Князь того не угадал"},{"type":"paragraph","text":"И в уста ее сахарные"},{"type":"paragraph","text":"Горячо поцеловал."},{"type":"paragraph","text":"И промолвил он Микулишне:"},{"type":"paragraph","text":"«Твой супруг в лугах погиб."},{"type":"paragraph","text":"На охоте трудной до смерти"},{"type":"paragraph","text":"Дикий тур его зашиб."},{"type":"paragraph","text":"Не вернуть нам к жизни мертвого,"},{"type":"paragraph","text":"Не роняй же горьких слез;"},{"type":"paragraph","text":"Я колечко обручальное"},{"type":"paragraph","text":"Молодой вдове привез."},{"type":"paragraph","text":"Жить не след тебе вдовицею,"},{"type":"paragraph","text":"Век в кручине горевать,"},{"type":"paragraph","text":"Красоту свою и молодость"},{"type":"paragraph","text":"Погубить тебе не стать."},{"type":"paragraph","text":"Будь женою мне и матушкой"},{"type":"paragraph","text":"Для моих богатырей,"},{"type":"paragraph","text":"Одевайся в подвенечное"},{"type":"paragraph","text":"Платье светлое скорей."},{"type":"paragraph","text":"В путь-дорогу мы отправимся, —"},{"type":"paragraph","text":"Поезд свадебный готов»."},{"type":"paragraph","text":"Василиса воле княжеской"},{"type":"paragraph","text":"Покорилася без слов:"},{"type":"paragraph","text":"Нарядилась в платье цветное"},{"type":"paragraph","text":"И покрылася фатой,"},{"type":"paragraph","text":"И в рукав широкий спрятала"},{"type":"paragraph","text":"Нож отточенный складной."},{"type":"paragraph","text":"7"},{"type":"paragraph","text":"Едет князь с невестой милою,"},{"type":"paragraph","text":"В стольный город свой спеша;"},{"type":"paragraph","text":"Все сильней в нем кровь волнуется,"},{"type":"paragraph","text":"И горит его душа."},{"type":"paragraph","text":"Но невесело дружинники"},{"type":"paragraph","text":"Молча следуют за ним;"},{"type":"paragraph","text":"Опустил Добрыня голову,"},{"type":"paragraph","text":"Тяжкой думою томим."},{"type":"paragraph","text":"Шепчет он: «Владимир-солнышко!"},{"type":"paragraph","text":"В деле злом не быть добру!"},{"type":"paragraph","text":"Не подумавши затеяли"},{"type":"paragraph","text":"Мы неладную игру."},{"type":"paragraph","text":"Все мне братний труп мерещится,"},{"type":"paragraph","text":"Что неприбранный лежит;"},{"type":"paragraph","text":"Рана страшная, как грозное"},{"type":"paragraph","text":"Око, на небо глядит."},{"type":"paragraph","text":"Извели мы ясна сокола,"},{"type":"paragraph","text":"Он попался в нашу сеть,"},{"type":"paragraph","text":"Но едва ли белой лебедью"},{"type":"paragraph","text":"Нам удастся завладеть»."},{"type":"paragraph","text":"Молча едут князь с невестою…"},{"type":"paragraph","text":"Слышно ржанье в стороне:"},{"type":"paragraph","text":"Это конь Данилов весточку"},{"type":"paragraph","text":"Подает его жене."},{"type":"paragraph","text":"Василиса встрепенулася,"},{"type":"paragraph","text":"Придержала скакуна"},{"type":"paragraph","text":"И Владимиру, ласкаючись,"}]},{"id":"chapter-10","title":"Часть 10","content":[{"type":"paragraph","text":"Тихо молвила она:"},{"type":"paragraph","text":"«В чистом поле ржанье слышится,"},{"type":"paragraph","text":"В небе вороны кричат…"},{"type":"paragraph","text":"Князь Владимир! Я отправлюся"},{"type":"paragraph","text":"В ту сторонку наугад."},{"type":"paragraph","text":"Видно, там мой муж валяется, —"},{"type":"paragraph","text":"Отпусти меня к нему,"},{"type":"paragraph","text":"Я в последний раз убитого"},{"type":"paragraph","text":"Мужа крепко обниму."},{"type":"paragraph","text":"Вдоволь я над ним наплачуся,"},{"type":"paragraph","text":"Труп слезами орошу;"},{"type":"paragraph","text":"Если ж с мужем не прощуся я —"},{"type":"paragraph","text":"Перед богом согрешу…»"},{"type":"paragraph","text":"Потемнел Владимир-солнышко,"},{"type":"paragraph","text":"Светлых дум пропал и след…"},{"type":"paragraph","text":"Отказать невесте — совестно,"},{"type":"paragraph","text":"Отпустить — охоты нет."},{"type":"paragraph","text":"Голова на грудь склонилася,"},{"type":"paragraph","text":"Шевельнулась совесть в нем,"},{"type":"paragraph","text":"И на просьбу Василисину"},{"type":"paragraph","text":"Согласился он с трудом."},{"type":"paragraph","text":"В провожатые Микулишне"},{"type":"paragraph","text":"Дал он двух богатырей,"},{"type":"paragraph","text":"И помчалася красавица"},{"type":"paragraph","text":"Ветра вольного быстрей."},{"type":"paragraph","text":"8"},{"type":"paragraph","text":"Вот в долине, за кустарником,"},{"type":"paragraph","text":"Труп лежит в траве густой,"},{"type":"paragraph","text":"Точно дерево, разбитое"},{"type":"paragraph","text":"Беспощадною грозой."},{"type":"paragraph","text":"В беспорядке кудри черные"},{"type":"paragraph","text":"Опустились над челом,"},{"type":"paragraph","text":"Истекает кровью алою"},{"type":"paragraph","text":"Грудь, пробитая копьем."},{"type":"paragraph","text":"Изменила смерть холодная"},{"type":"paragraph","text":"Красоту его лица,"},{"type":"paragraph","text":"И раскинуты бессильные"},{"type":"paragraph","text":"Руки мощного бойца…"},{"type":"paragraph","text":"И, спрыгнув с коня ретивого,"},{"type":"paragraph","text":"Точно первый снег бела,"},{"type":"paragraph","text":"Без рыданий, к мужу мертвому"},{"type":"paragraph","text":"Василиса подошла."},{"type":"paragraph","text":"И, упав на грудь Данилову,"},{"type":"paragraph","text":"Горемычная вдова"},{"type":"paragraph","text":"Громко вскрикнула: «Злодеями"},{"type":"paragraph","text":"Ты убит, а я жива!"},{"type":"paragraph","text":"Для чего ж мне жизнь оставлена."},{"type":"paragraph","text":"Если нет тебя со мной?"},{"type":"paragraph","text":"Не грешно ли мне, не стыдно ли"},{"type":"paragraph","text":"Быть Владимира женой!"},{"type":"paragraph","text":"И не лучше ль злому половцу"},{"type":"paragraph","text":"Мне отдать и жизнь и честь,"},{"type":"paragraph","text":"Чем с убийцей мужа милого"},{"type":"paragraph","text":"Целый век в слезах провесть?"},{"type":"paragraph","text":"Нет, не лечь на ложе брачное"}]},{"id":"chapter-11","title":"Часть 11","content":[{"type":"paragraph","text":"Опозоренной вдове"},{"type":"paragraph","text":"И не быть с дружиной княжеской"},{"type":"paragraph","text":"И с Добрынею в родстве;"},{"type":"paragraph","text":"Не носить уборы ценные,"},{"type":"paragraph","text":"Жемчуги и янтари…"},{"type":"paragraph","text":"Подойдите и послушайте"},{"type":"paragraph","text":"Вы меня, богатыри!"},{"type":"paragraph","text":"Вы скажите князю стольному,"},{"type":"paragraph","text":"Чтоб валяться не дал нам"},{"type":"paragraph","text":"В поле он без погребения,"},{"type":"paragraph","text":"На съедение зверям."},{"type":"paragraph","text":"Прикажите, други, плотникам"},{"type":"paragraph","text":"Сколотить нам гроб большой,"},{"type":"paragraph","text":"Чтоб не тесно было милому"},{"type":"paragraph","text":"Спать со мной в земле сырой.»"},{"type":"paragraph","text":"Так сказала им Микулишна —"},{"type":"paragraph","text":"И пробила грудь ножом;"},{"type":"paragraph","text":"Из глубокой раны хлынула"},{"type":"paragraph","text":"Кровь горячая ручьем."},{"type":"paragraph","text":"На груди супруга милого"},{"type":"paragraph","text":"Умерла его жена,"},{"type":"paragraph","text":"Жизнь без слез она оставила,"},{"type":"paragraph","text":"До конца ему верна."},{"type":"paragraph","text":"9"},{"type":"paragraph","text":"Грозен князь Владимир Киевский"},{"type":"paragraph","text":"Возвратился в город свой"},{"type":"paragraph","text":"Не с красавицей княгинею,"},{"type":"paragraph","text":"А с глубокою тоской."},{"type":"paragraph","text":"Не с весельем князя встретили"},{"type":"paragraph","text":"Горожане у ворот, —"},{"type":"paragraph","text":"Пусты улицы широкие,"},{"type":"paragraph","text":"Точно вымер весь народ."},{"type":"paragraph","text":"Над богатым, славным Киевом"},{"type":"paragraph","text":"Тишь могильная стоит;"},{"type":"paragraph","text":"Лишь по улицам в безмолвии"},{"type":"paragraph","text":"Раздается стук копыт."},{"type":"paragraph","text":"Грозен князь вошел в хоромины,"},{"type":"paragraph","text":"Молча слуги вслед идут,"},{"type":"paragraph","text":"И велел им князь Путятича"},{"type":"paragraph","text":"Привести к себе на суд."},{"type":"paragraph","text":"И, дрожа от страха смертного,"},{"type":"paragraph","text":"Стал Путятич у дверей…"},{"type":"paragraph","text":"Не для пира-столования"},{"type":"paragraph","text":"Князь созвал богатырей."},{"type":"paragraph","text":"Знать, прошла пора веселая"},{"type":"paragraph","text":"Шумных княжеских потех, —"},{"type":"paragraph","text":"Смотрят сумрачно дружинники,"},{"type":"paragraph","text":"Стольный князь суровей всех."},{"type":"paragraph","text":"С гневом молвил он Путятичу:"},{"type":"paragraph","text":"«Как нам быть с тобою, сват?"},{"type":"paragraph","text":"Ездил в даль я за невестою,"},{"type":"paragraph","text":"А вернулся не женат."},{"type":"paragraph","text":"Ты затеял дело хитрое,"},{"type":"paragraph","text":"Да пропал задаром труд:"},{"type":"paragraph","text":"Идут слуги в Киев с ношею,"}]},{"id":"chapter-12","title":"Часть 12","content":[{"type":"paragraph","text":"Двух покойников несут."},{"type":"paragraph","text":"Погубил слугу я верного —"},{"type":"paragraph","text":"И остался холостой."},{"type":"paragraph","text":"Видно, князю не приходится"},{"type":"paragraph","text":"Володать чужой женой."},{"type":"paragraph","text":"И не должно князю слушаться"},{"type":"paragraph","text":"Злых советников своих:"},{"type":"paragraph","text":"Злой слуга змеи опаснее,"},{"type":"paragraph","text":"На худое дело лих."},{"type":"paragraph","text":"Мне же речь твоя понравилась;"},{"type":"paragraph","text":"Эта речь была грешна, —"},{"type":"paragraph","text":"И не смыть теперь мне с совести"},{"type":"paragraph","text":"Вековечного пятна."},{"type":"paragraph","text":"Князь Владимир стольно-киевский"},{"type":"paragraph","text":"Щедрым слыл до этих пор…"},{"type":"paragraph","text":"Чем же мне тебя пожаловать,"},{"type":"paragraph","text":"Наградить за мой позор?"},{"type":"paragraph","text":"Все дела твои лукавые"},{"type":"paragraph","text":"И советы были злы, —"},{"type":"paragraph","text":"И за то, Мишата, жалую"},{"type":"paragraph","text":"Я тебя котлом смолы»."},{"type":"paragraph","text":"1875"}]}]}