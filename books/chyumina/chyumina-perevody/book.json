{"id":"chyumina-perevody","slug":"chyumina-perevody","shard":1,"title":"Переводы","altTitles":[],"author":"Ольга Николаевна Чюмина","authorShort":"О. Н. Чюмина","authorSlug":"chyumina","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1887","editionYear":"1887","description":"Переводы","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9F%D0%B5%D1%80%D0%B5%D0%B2%D0%BE%D0%B4%D1%8B_%28%D0%A7%D1%8E%D0%BC%D0%B8%D0%BD%D0%B0%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1887)","downloadAllowed":true,"fb2Url":"/archive/books/chyumina/chyumina-perevody/original.fb2","coverUrl":"/archive/books/chyumina/chyumina-perevody/cover.webp","stats":{"chaptersCount":6,"wordsCount":1464,"charsCount":9304,"readingMinutes":8},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Переводы"},{"type":"paragraph","text":"Арман Сюлли-Прюдом. Поэтам будущего"},{"type":"paragraph","text":"Былое"},{"type":"paragraph","text":"Роберт Гамерлинг. Голос истины"},{"type":"paragraph","text":"Служение красоте"},{"type":"paragraph","text":"Шозе Мария де Эредиа. Средневековые сонеты:"},{"type":"paragraph","text":"Лебединая песнь."},{"type":"paragraph","text":"Догаресса."},{"type":"paragraph","text":"Полдень"},{"type":"paragraph","text":"Жан Ришпен. Любовь:"},{"type":"paragraph","text":"I. Древнеримский сонет"},{"type":"paragraph","text":"II. Средневековый сонет."},{"type":"paragraph","text":"III. Сонет Возрождения"},{"type":"paragraph","text":"Элизабет Браунинг. Сонеты:"},{"type":"paragraph","text":"1. Узник."},{"type":"paragraph","text":"2. Неудовлетвореность"},{"type":"paragraph","text":"3. Слезы."},{"type":"paragraph","text":"4. Непоправимое."},{"type":"paragraph","text":"5. Даль."},{"type":"paragraph","text":"6. Горец и поэт"},{"type":"paragraph","text":"АРМАН СЮЛЛИ-ПРЮДОМ"},{"type":"paragraph","text":"ПОЭТАМ БУДУЩЕГО"},{"type":"paragraph","text":"Певцы грядущего! Все тайны мировые"},{"type":"paragraph","text":"От вас вселенная узнает наконец,"},{"type":"paragraph","text":"И ярко озарит светильник ваш впервые"},{"type":"paragraph","text":"Причины действия, начало и конец."},{"type":"paragraph","text":"Ваш стих — он освежит бессмертные идеи,"},{"type":"paragraph","text":"Когда закроет нас могильная плита,"},{"type":"paragraph","text":"И мы сойдем во мрак, ничтожные пигмеи,"},{"type":"paragraph","text":"И смолкнет голос наш, закроются уста…"},{"type":"paragraph","text":"Но вспомните, что мы поем любовь и розы"},{"type":"paragraph","text":"В суровый век, когда орудий слышен гром,"},{"type":"paragraph","text":"Для тех, кому в удел даны судьбою слезы:"},{"type":"paragraph","text":"Жалейте же о нас, боровшихся со злом;"},{"type":"paragraph","text":"Толпою к вам сойдут счастливейшие грезы"},{"type":"paragraph","text":"И мир страдания вам будет незнаком."},{"type":"paragraph","text":"1886"},{"type":"paragraph","text":"БЫЛОЕ"},{"type":"paragraph","text":"Порою в тишине я говорю былому: —"},{"type":"paragraph","text":"Напомни мне опять о милой старине! —"},{"type":"paragraph","text":"И тут оно, стряхнув дремотную истому,"},{"type":"paragraph","text":"Приподнимается и в очи смотрит мне."},{"type":"paragraph","text":"Потом, облекшися в весенние уборы,"},{"type":"paragraph","text":"Оно ведет меня в волшебные края,"},{"type":"paragraph","text":"Где чаровало все и радовало взоры,"},{"type":"paragraph","text":"Где прежде я любил и был счастливей я."},{"type":"paragraph","text":"Им зажжены огни, горевшие когда-то,"},{"type":"paragraph","text":"И чаши розами украшены богато;"},{"type":"paragraph","text":"Но, пристально вглядясь в спокойный лик его,"},{"type":"paragraph","text":"Я убеждаюся, что пламя прежней страсти"},{"type":"paragraph","text":"Не воскресит его и не имеет власти"},{"type":"paragraph","text":"Над тем, что навсегда останется мертво!"},{"type":"paragraph","text":"1894"},{"type":"paragraph","text":"РОБЕРТ ГАМЕРЛИНГ"},{"type":"paragraph","text":"ГОЛОС ИСТИНЫ"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Сонет"},{"type":"paragraph","text":"Пусть голос истины победно"},{"type":"paragraph","text":"Над миром грянет, как раскат,"},{"type":"paragraph","text":"Пусть он гудит трубою медной"},{"type":"paragraph","text":"Иль раздается, как набат."},{"type":"paragraph","text":"Призыв его пройдет бесследно:"},{"type":"paragraph","text":"Борьбы и ненависти ад,"},{"type":"paragraph","text":"Шипенье зависти зловредной"},{"type":"paragraph","text":"Его на время заглушат."},{"type":"paragraph","text":"Но чем озлобленнее крики,"},{"type":"paragraph","text":"Чем громче рев упорно дикий —"},{"type":"paragraph","text":"Тем он скорее отшумит;"},{"type":"paragraph","text":"А слово истины спокойной"},{"type":"paragraph","text":"Звучит разумно и достойно, —"},{"type":"paragraph","text":"Оно в грядущем победит."},{"type":"paragraph","text":"1895"},{"type":"paragraph","text":"СЛУЖЕНИЕ КРАСОТЕ"},{"type":"paragraph","text":"Сонет"},{"type":"paragraph","text":"Кто сделался жрецом добра и красоты,"},{"type":"paragraph","text":"Тот полный горечи изведает напиток"},{"type":"paragraph","text":"И встретит на пути возвышенных попыток"},{"type":"paragraph","text":"Шипенье зависти и ропот клеветы."},{"type":"paragraph","text":"Кого венчают лавры и цветы —"},{"type":"paragraph","text":"Находит в них порой и терния избыток,"},{"type":"paragraph","text":"И, откровения развертывая свиток,"},{"type":"paragraph","text":"Слезою платит он за светлые мечты."},{"type":"paragraph","text":"Ему, парящему в недостижимых грезах,"},{"type":"paragraph","text":"Как жизнь его порою ни полна,"},{"type":"paragraph","text":"Не суждено покоиться на розах:"},{"type":"paragraph","text":"Избранник муз, кем смерть побеждена,"},{"type":"paragraph","text":"Пред игом жизни, чуждым и наносным,"},{"type":"paragraph","text":"Склоняется челом победоносным."},{"type":"paragraph","text":"1895"},{"type":"paragraph","text":"Ж0ЗE МАРИЯ ДЕ ЭРЕДИА"},{"type":"paragraph","text":"СРЕДНЕВЕКОВЫЕ СОНЕТЫ"},{"type":"paragraph","text":"ЛЕБЕДИНАЯ ПЕСНЬ"},{"type":"paragraph","text":"Опершись о мрамор балюстрады,"},{"type":"paragraph","text":"Над Луарой темн-о-голубой,"},{"type":"paragraph","text":"Вдаль она глядит перед собой,"},{"type":"paragraph","text":"И печалью дышат эти взгляды…"},{"type":"paragraph","text":"Под ее прозрачною рукой"},{"type":"paragraph","text":"Вновь звучат аккорды серенады."},{"type":"paragraph","text":"В камышах береговых цикады"},{"type":"paragraph","text":"Вторят звукам лютни золотой."},{"type":"paragraph","text":"И несется песнь ее далеко,"},{"type":"paragraph","text":"Вслед тому, кого она глубоко"},{"type":"paragraph","text":"Полюбила сердцем молодым."},{"type":"paragraph","text":"Меркнет день над тихою долиной,"},{"type":"paragraph","text":"И, быть может, станет лебединой"},{"type":"paragraph","text":"Эта песня, сложенная им…"},{"type":"paragraph","text":"ДОГАРЕССА"},{"type":"paragraph","text":"С террасы мраморной спускаются сеньоры,"},{"type":"paragraph","text":"Которых написал великий Тициан;"},{"type":"paragraph","text":"Алмазами горят мечи и их уборы,"},{"type":"paragraph","text":"Парча и шелк одели стройный стаи."}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"И часто с дерзкою отвагою во взоре"},{"type":"paragraph","text":"Глядят они туда, где смело над волной"},{"type":"paragraph","text":"Взвиваются цвета Венеции родной"},{"type":"paragraph","text":"И Адриатика синеет на просторе."},{"type":"paragraph","text":"Вдали от их толпы, блестящей и пустой,"},{"type":"paragraph","text":"Блистая дивною и властной красотой,"},{"type":"paragraph","text":"Как в сказке гордая принцесса,"},{"type":"paragraph","text":"Дарит улыбкою приветливой своей"},{"type":"paragraph","text":"Пажа, парчовый шлейф несущего за ней,"},{"type":"paragraph","text":"Их догаресса."},{"type":"paragraph","text":"ПОЛДЕНЬ"},{"type":"paragraph","text":"Полдневная жара. Замолкли в рощах птицы,"},{"type":"paragraph","text":"В траве едва журчит серебряный ручей,"},{"type":"paragraph","text":"И только мотыльков беспечных вереницы"},{"type":"paragraph","text":"Кружатся в сумраке таинственных ветвей."},{"type":"paragraph","text":"В небесной синеве сияние денницы"},{"type":"paragraph","text":"Все ослепительней, все жгучей, горячей,"},{"type":"paragraph","text":"И сквозь смеженные дремотою реснипы"},{"type":"paragraph","text":"Я созерцаю сеть из золотых лучей."},{"type":"paragraph","text":"Купаясь в солнечном, колеблющемся свете,"},{"type":"paragraph","text":"Мелькают бабочки, и, видя игры эти;"},{"type":"paragraph","text":"Мне хочется поймать сияющую нить;"},{"type":"paragraph","text":"Как рифму звучную в изысканном сонете,"},{"type":"paragraph","text":"Я в петлях золотых неуловимой сети"},{"type":"paragraph","text":"Гармонию стиха пытаюсь заключить."},{"type":"paragraph","text":"1896"},{"type":"paragraph","text":"ЖАН РИШПЕН"},{"type":"paragraph","text":"ЛЮБОВЬ"},{"type":"paragraph","text":"(Трилогия)"},{"type":"paragraph","text":"I"},{"type":"paragraph","text":"ДРЕВНЕРИМСКИЙ СОНЕТ"},{"type":"paragraph","text":"Прекрасная Клелия в белой одежде весталки"},{"type":"paragraph","text":"Бесстрастно на бой гладиаторов в цирке глядит,"},{"type":"paragraph","text":"И дева не видит тот взор умоляюще жалкий,"},{"type":"paragraph","text":"Каким на нее побежденный взирает самнит."},{"type":"paragraph","text":"Зависит вся жизнь от ее одного мановенья,"},{"type":"paragraph","text":"Но что ей до всех, до покрытого кровью бойца!"},{"type":"paragraph","text":"В мечтах затаенных является в это мгновенье"},{"type":"paragraph","text":"Ей образ сирийца, Венеры восточной жреца."},{"type":"paragraph","text":"Прекрасный собою, он голосом тихим и страстны:"},{"type":"paragraph","text":"Поет о любви, и сливается вечером ясным"},{"type":"paragraph","text":"С рыданием гонга напев сладострастный его."},{"type":"paragraph","text":"И, вся замирая под нежные звуки напева,"},{"type":"paragraph","text":"Готова погибнуть засыпанной заживо дева,"},{"type":"paragraph","text":"Чтоб дивную тайну в объятьях познать у него."},{"type":"paragraph","text":"II"},{"type":"paragraph","text":"СРЕДНЕВЕКОВЫЙ СОНЕТ"},{"type":"paragraph","text":"Владелица замка в покое старинном"},{"type":"paragraph","text":"За лютней своею сидит у окна,"},{"type":"paragraph","text":"И рыцаря песнею славит она,"},{"type":"paragraph","text":"Стяжавшего славу в бою с сарацином."},{"type":"paragraph","text":"Высокая, в платье закрытом и длинном"},{"type":"paragraph","text":"И в длинной вуали из тонкого льна,"},{"type":"paragraph","text":"Тому, кто явился ее властелином,"},{"type":"paragraph","text":"Она неизменно пребудет верна."}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Герою послужит наградой желанной"},{"type":"paragraph","text":"Ее красоты и девичества цвет,"},{"type":"paragraph","text":"А если падет он в бою бездыханный,"},{"type":"paragraph","text":"Она целомудрия сдержит обет:"},{"type":"paragraph","text":"Дыхание знойное страсти мятежной"},{"type":"paragraph","text":"Собой не коснется груди белоснежной."},{"type":"paragraph","text":"III"},{"type":"paragraph","text":"СОНЕТ ВОЗРОЖДЕНИЯ"},{"type":"paragraph","text":"В берете с перьями и в мантии расшитой,"},{"type":"paragraph","text":"Рукою опершись на стройного пажа,"},{"type":"paragraph","text":"Другую на эфес рапиры положа,"},{"type":"paragraph","text":"Выходит на берег сеньор с своею свитой."},{"type":"paragraph","text":"За плату мадригал педантом сочинен,"},{"type":"paragraph","text":"И в честь красавицы послышалась из сада,"},{"type":"paragraph","text":"Исполнена певцом наёмным, серенада, —"},{"type":"paragraph","text":"Но замок в тишину и сумрак погружен."},{"type":"paragraph","text":"В своем убежище графиня песпе внемлет,"},{"type":"paragraph","text":"Меж тем как старый муж красавицы не дремлет:"},{"type":"paragraph","text":"Везде расставлены капканы для волков."},{"type":"paragraph","text":"Но тут же, к общему устраиваясь благу,"},{"type":"paragraph","text":"Подкупленный бандит оттачивает шпагу,"},{"type":"paragraph","text":"С ревнивым стариком расправиться готов."},{"type":"paragraph","text":"ЭЛИЗАБЕТ БРАУНИНГ"},{"type":"paragraph","text":"СОНЕТЫ"},{"type":"paragraph","text":"1"},{"type":"paragraph","text":"УЗНИК"},{"type":"paragraph","text":"Счет времени веду годами я с тех пор,"},{"type":"paragraph","text":"Как видел я травы зеленой колыханье"},{"type":"paragraph","text":"И на устах моих природы всей дыханье"},{"type":"paragraph","text":"С моим сливалося. Теперь земли простор"},{"type":"paragraph","text":"Мне странным кажется, как дальних сфер сиянье,"},{"type":"paragraph","text":"Как мысль о небесах, туманящая взор."},{"type":"paragraph","text":"Из-за дверей тюрьмы, закрытых на запор,"},{"type":"paragraph","text":"Природы музыка звучит на расстояньи —"},{"type":"paragraph","text":"Безумна и дика, и слуховой обман"},{"type":"paragraph","text":"В мозгу рождает грез несбыточных туман."},{"type":"paragraph","text":"Помимо чувств, мечте — до боли напряженной —"},{"type":"paragraph","text":"Рисуются: река и лес завороженный,"},{"type":"paragraph","text":"И длинный ряд холмов, что солнцем осиян,"},{"type":"paragraph","text":"Божественной красой преображенный."},{"type":"paragraph","text":"2"},{"type":"paragraph","text":"НЕУДОВЛЕТВОРЕННОСТЬ"},{"type":"paragraph","text":"Когда ищу в стихах для мысли выраженья —"},{"type":"paragraph","text":"Мне в пульсе чудится души моей биенье:"},{"type":"paragraph","text":"Как будто хочется освободиться ей,"},{"type":"paragraph","text":"Чтоб шире вылиться, светлее и полней,"},{"type":"paragraph","text":"Достигнув истинной гармонии свершенья"},{"type":"paragraph","text":"Пред человечеством и пред вселенной всей."},{"type":"paragraph","text":"Но, словно дерево, что ветра дуновенье"},{"type":"paragraph","text":"Склоняет в сторону, — калечит и людей"},{"type":"paragraph","text":"Дохнувшее на них проклятие природы,"},{"type":"paragraph","text":"И правда каждого — обман для остальных."},{"type":"paragraph","text":"Для выраженья чувств нам не дано свободы."},{"type":"paragraph","text":"Душа! Лишь сбросив гнет своих одежд земных,"},{"type":"paragraph","text":"Ты звуки обретешь: вне рабства и стесненья"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Найдя достойное для песни завершенье."},{"type":"paragraph","text":"3"},{"type":"paragraph","text":"СЛЕЗЫ"},{"type":"paragraph","text":"Блаженны те из вас, кто скорбь души печальной"},{"type":"paragraph","text":"Слезами изливал! Скорбей легчайших нет,"},{"type":"paragraph","text":"С тех пор как совершен был грех первоначальный."},{"type":"paragraph","text":"Что слезы? Плачут все: ребенок беспечальный"},{"type":"paragraph","text":"Под песню матери, едва увидев свет;"},{"type":"paragraph","text":"Невеста юная, надев убор венчальный;"},{"type":"paragraph","text":"Священные холмы увидевший поэт,"},{"type":"paragraph","text":"Слеза которого — безмолвный им привет."},{"type":"paragraph","text":"Блаженны те из вас, кто слезы лил в кручине!"},{"type":"paragraph","text":"Когда, ослеплены слезами, как в пустыне"},{"type":"paragraph","text":"Встречаете кругом вы только ряд могил —"},{"type":"paragraph","text":"Вам стоит взор поднять, приученный тоскою,"},{"type":"paragraph","text":"И слезы по лицу польются вмиг рекою,"},{"type":"paragraph","text":"И вам откроется блеск солнца и светил."},{"type":"paragraph","text":"4"},{"type":"paragraph","text":"НЕПОПРАВИМОЕ"},{"type":"paragraph","text":"Сегодня я в лугах весь день цветы рвала,"},{"type":"paragraph","text":"Струившие с зарей свое благоуханье,"},{"type":"paragraph","text":"И пело все во мне, как пташка иль пчела,"},{"type":"paragraph","text":"Летящая в поля, встречая дня сиянье."},{"type":"paragraph","text":"Но чем скооей цветы постигло увяданье —"},{"type":"paragraph","text":"Тем крепче я, в руке сжимая их, несла,"},{"type":"paragraph","text":"И рвутся из души не песни, а рыданья…"},{"type":"paragraph","text":"Что скажете вы все, чья дружба мне мила?"},{"type":"paragraph","text":"Нарвать еще цветов? Идти ли снова R поле?"},{"type":"paragraph","text":"Пусть это делает кто может, но не я!"},{"type":"paragraph","text":"Устала я душой, во мне нет силы боле,"},{"type":"paragraph","text":"Цветами прежними полна рука моя,"},{"type":"paragraph","text":"Пускай же их букет, в пей умирая, вянет,"},{"type":"paragraph","text":"Пока и для меня день смерти не настанет."},{"type":"paragraph","text":"5"},{"type":"paragraph","text":"ДАЛЬ"},{"type":"paragraph","text":"Подобье мы детей, когда они, вздыхая,"},{"type":"paragraph","text":"Капризно лбом прильнут к поверхности стекла,"},{"type":"paragraph","text":"Туманят гладь его, которая светла,"},{"type":"paragraph","text":"Даль неба и полей от взора закрывая…"},{"type":"paragraph","text":"С тех пор, как Промыслом разлучена была"},{"type":"paragraph","text":"С душою скорбною за гробом жизнь другая, —"},{"type":"paragraph","text":"Меж ней и взорами, преграду воздвигая,"},{"type":"paragraph","text":"Мешает вдаль смотреть печали нашей мгла."},{"type":"paragraph","text":"О брат! О человек! Сдержи свои рыданья,"},{"type":"paragraph","text":"Будь мужествен, молчи. Души твоей стекло"},{"type":"paragraph","text":"Пусть дуновением не отуманит зло,"},{"type":"paragraph","text":"Чтоб взором ясным ты в конце существованья,"},{"type":"paragraph","text":"Мог видеть издали, когда блеснут они:"},{"type":"paragraph","text":"Предсмертных факелов священные огни."},{"type":"paragraph","text":"6"},{"type":"paragraph","text":"ГОРЕЦ И ПОЭТ"},{"type":"paragraph","text":"Случается порой: пастух простой"},{"type":"paragraph","text":"Меж Альпами и небом средь тумана,"},{"type":"paragraph","text":"Увидев тень свою над высотой,"},{"type":"paragraph","text":"Похожую на образ великана,"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Не возгордясь и чужд самообмана,"},{"type":"paragraph","text":"Еще сильней сжимает посох свой,"},{"type":"paragraph","text":"Меж тем как высь главою снеговой,"},{"type":"paragraph","text":"Сапфировой короной осияна,"},{"type":"paragraph","text":"Вздымается пред ним. Ты, к высоте"},{"type":"paragraph","text":"Стремящийся поэт, познай смиренно:"},{"type":"paragraph","text":"Не ты велик — мир божий, постепенно"},{"type":"paragraph","text":"Во всей его могучей красоте"},{"type":"paragraph","text":"Открывшийся тебе для постиженья,"},{"type":"paragraph","text":"И ты — его же славы отраженье."},{"type":"paragraph","text":"ЧЮМИНА ОЛЬГА НИКОЛАЕВНА (1864—1909). Поэтесса, прозаик, переводчик."},{"type":"paragraph","text":"Политическая реакция 80-х гг. ограничивала возможности поэтессы, но для ее"},{"type":"paragraph","text":"поэзии характерна не только неудовлетворенность действительностью, но и"},{"type":"paragraph","text":"вера в социальные изменения. Переводы, в том числе и сонеты, созвучны"},{"type":"paragraph","text":"мотивам оригинальной поэзии."},{"type":"paragraph","text":"Издательство «Московский рабочий», 1983 г."},{"type":"paragraph","text":"ИБ ? 2370"},{"type":"paragraph","text":"РУССКИЙ СОНЕТ"},{"type":"paragraph","text":"XVIII — НАЧАЛО XX ВЕКА"},{"type":"paragraph","text":"Сборник"},{"type":"paragraph","text":"Составитель Владимир Сергеевич Совалин"}]}]}