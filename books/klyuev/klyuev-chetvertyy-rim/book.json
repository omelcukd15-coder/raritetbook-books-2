{"id":"klyuev-chetvertyy-rim","slug":"klyuev-chetvertyy-rim","shard":1,"title":"Четвертый Рим","altTitles":[],"author":"Николай Алексеевич Клюев","authorShort":"Н. А. Клюев","authorSlug":"klyuev","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1922","editionYear":"1922","description":"Четвертый Рим (Н. А. Клюев): === ЧЕТВЕРТЫЙ РИМ === Николаю Ильичу Архипову","historicalNote":"Проверенное издание (1922).","sourceUrl":"https://ru.wikisource.org/wiki/%D0%A7%D0%B5%D1%82%D0%B2%D0%B5%D1%80%D1%82%D1%8B%D0%B9_%D0%A0%D0%B8%D0%BC_%28%D0%9A%D0%BB%D1%8E%D0%B5%D0%B2%29","legalStatus":"Общественное достояние (PD-old; 1922)","downloadAllowed":true,"fb2Url":"/archive/books/klyuev/klyuev-chetvertyy-rim/original.fb2","coverUrl":"/archive/books/klyuev/klyuev-chetvertyy-rim/cover.webp","stats":{"chaptersCount":4,"wordsCount":912,"charsCount":5763,"readingMinutes":5},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"=== ЧЕТВЕРТЫЙ РИМ === Николаю Ильичу Архипову"},{"type":"paragraph","text":"А теперь хожу в цилиндре"},{"type":"paragraph","text":"И в лаковых башмаках…"},{"type":"paragraph","text":"Сергей Есенин"},{"type":"paragraph","text":"Не хочу быть знаменитым поэтом"},{"type":"paragraph","text":"В цилиндре и в лаковых башмаках,"},{"type":"paragraph","text":"Предстану миру в песню одетым,"},{"type":"paragraph","text":"С медвежьим солнцем в зрачках,"},{"type":"paragraph","text":"С потемками хвои в бородище,"},{"type":"paragraph","text":"Где в случке с рысью рычит лесовик!"},{"type":"paragraph","text":"Я сплел из слов, как закат, лаптище"},{"type":"paragraph","text":"Баюкать чадо — столетий зык."},{"type":"paragraph","text":"В заклятой зыбке седые страхи,"},{"type":"paragraph","text":"Колдуньи дремы, горбун низги…"},{"type":"paragraph","text":"Мое лицо — ребенок на плахе,"},{"type":"paragraph","text":"Святитель в гостях у бабы-яги."},{"type":"paragraph","text":"А сердце — изба, бревна сцеплены в лапу,"},{"type":"paragraph","text":"Там горница — ангелов пир,"},{"type":"paragraph","text":"И точат иконы рублевскую вапу,"},{"type":"paragraph","text":"Молитв молоко и влюбленности сыр."},{"type":"paragraph","text":"Там тайны чулан, лавка снов и раздумий,"},{"type":"paragraph","text":"Но горница сердца лобку не чета:"},{"type":"paragraph","text":"О край золотых сенокосов и гумен!"},{"type":"paragraph","text":"О ткацкая радуг и весен лапта!"},{"type":"paragraph","text":"К тебе притекают искатели кладов —"},{"type":"paragraph","text":"Персты мои — пять забубённых парней,"},{"type":"paragraph","text":"И в рыжем полесье, у жил водопадов"},{"type":"paragraph","text":"Буравят пласты до алмазных ключей."},{"type":"paragraph","text":"Душа — звездоперый петух на нашесте,"},{"type":"paragraph","text":"Заслушалась яростных чмоков сверла…"},{"type":"paragraph","text":"Стихи — огневища о милой невесте,"},{"type":"paragraph","text":"Чьи ядра — два вепря, два лютых орла."},{"type":"paragraph","text":"Не хочу укрывать цилиндром"},{"type":"paragraph","text":"Лесного чёрта рога!"},{"type":"paragraph","text":"Седым кашалотам, зубаткам и выдрам"},{"type":"paragraph","text":"Моих океанов и рек берега!"},{"type":"paragraph","text":"Есть берег сосцов, знойных ягодиц остров,"},{"type":"paragraph","text":"Долина пахов, плоскогорье колен;"},{"type":"paragraph","text":"Для галек певучих и раковин пестрых"},{"type":"paragraph","text":"Сюда заплывает ватага сирен."},{"type":"paragraph","text":"Но хмурится море колдующей плоти,"},{"type":"paragraph","text":"В волнах погребая страстей корабли,"},{"type":"paragraph","text":"Под флейту тритона на ляжек болоте"},{"type":"paragraph","text":"Полощется леший и духи земли."},{"type":"paragraph","text":"О плоть — голубые нагорные липы,"},{"type":"paragraph","text":"Где в губы цветений вонзились шмели,"},{"type":"paragraph","text":"Твои листопады сгребает Архипов"},{"type":"paragraph","text":"Граблями лобзаний в стихов кошели!"},{"type":"paragraph","text":"Стихов кошели полны липовым медом,"},{"type":"paragraph","text":"Подковами радуг, лесными ау…"},{"type":"paragraph","text":"Возлюбленный будет возлюблен народом"},{"type":"paragraph","text":"За то, что баюкал слезинку мою."},{"type":"paragraph","text":"Возлюбленный — камень, где тысячи граней,"},{"type":"paragraph","text":"В их омуте плещет осетр-сатана,"},{"type":"paragraph","text":"В змеиной повязке, на сером кабане,"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Блюдет сладострастье обители сна."},{"type":"paragraph","text":"Возлюбленный — жатва на северном поле,"},{"type":"paragraph","text":"Где тучка — младенчик в венце гробовом,"},{"type":"paragraph","text":"Печаль журавиная русских раздолий,"},{"type":"paragraph","text":"Спрядающих травы и звезды крестом."},{"type":"paragraph","text":"Не хочу цилиндром и башмаками"},{"type":"paragraph","text":"Затыкать пробоину в барке души!"},{"type":"paragraph","text":"Цвету я, как луг избяными коньками,"},{"type":"paragraph","text":"Улыбкой озер в песнозвонной тиши."},{"type":"paragraph","text":"И верен я зыбке плакучей, родимой,"},{"type":"paragraph","text":"Могилушке маминой, лику гумна;"},{"type":"paragraph","text":"Зато, как щеглята, летят серафимы"},{"type":"paragraph","text":"К кормушке моей, где любовь и весна."},{"type":"paragraph","text":"Зато на моем песнолиственном дубе"},{"type":"paragraph","text":"Бессмертная птица и стая веков,"},{"type":"paragraph","text":"Варить Непомерное в черепа срубе"},{"type":"paragraph","text":"Сошлись колдуны у заклятых котлов."},{"type":"paragraph","text":"В котлах печень мира и солнца вязига,"},{"type":"paragraph","text":"Безумия перец, укроп тишины…"},{"type":"paragraph","text":"Как первенец ясный, столикая книга"},{"type":"paragraph","text":"Лежит на руках у родимой страны."},{"type":"paragraph","text":"В той книге страницы — китовьи затоны."},{"type":"paragraph","text":"На буквенных скалах лебяжий базар,"},{"type":"paragraph","text":"И каркают точки — морские вороны,"},{"type":"paragraph","text":"Почуя стихов ледовитый пожар."},{"type":"paragraph","text":"В той книге строка — беломорские села"},{"type":"paragraph","text":"С бревенчатой сказкою изб и дворов,"},{"type":"paragraph","text":"Где темь — медвежонок, и бабы с подола"},{"type":"paragraph","text":"Стряхают словесных куниц и бобров."},{"type":"paragraph","text":"Кукует зегзицею Дева-обида"},{"type":"paragraph","text":"Над слезкой России (о камень драгий!..)"},{"type":"paragraph","text":"Когда-нибудь хрустнет небесная гнида —"},{"type":"paragraph","text":"Рябой полумесяц под ногтем стихий."},{"type":"paragraph","text":"И зуд утолится, по ляжек болотам"},{"type":"paragraph","text":"Взойдет чистоты белоснежный ирис,"},{"type":"paragraph","text":"Заклятым стихам отдадут словно сотам"},{"type":"paragraph","text":"Мед глаз ярославец, вогул и киргиз."},{"type":"paragraph","text":"Не хочу быть лакированным поэтом"},{"type":"paragraph","text":"С обезьяньей славой на лбу!"},{"type":"paragraph","text":"С Ржаного Синая багряным заветом"},{"type":"paragraph","text":"Связую молот и мать-избу."},{"type":"paragraph","text":"Связую думы и сны суслона"},{"type":"paragraph","text":"С многоязычным маховиком…"},{"type":"paragraph","text":"Я — Кит Напевов, у небосклона"},{"type":"paragraph","text":"Моря играют моим хвостом."},{"type":"paragraph","text":"Блюду я, вечен и неизменен,"},{"type":"paragraph","text":"Печные крепи, гумна пяту."},{"type":"paragraph","text":"Пилою-рыбой кружит Есенин,"},{"type":"paragraph","text":"Меж ласт родимых ища мету."},{"type":"paragraph","text":"Пилою-рыбой прослыть почестно"},{"type":"paragraph","text":"У сонных крабов, глухих бодяг…"},{"type":"paragraph","text":"Как дед внучонка, качает вёсны"},{"type":"paragraph","text":"Паучьей лапой запечный мрак."},{"type":"paragraph","text":"И зреют вёсны: блины, драчены,"},{"type":"paragraph","text":"Рогатый сырник, пузан-кулич…"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"«Для варки песен — всех стран"},{"type":"paragraph","text":"Матрены Соединяйтесь!» — несется клич."},{"type":"paragraph","text":"Котел бессмертен, в поморьях щаных"},{"type":"paragraph","text":"Зареет яхонт — Четвертый Рим:"},{"type":"paragraph","text":"Еще немного, и в новых странах"},{"type":"paragraph","text":"Мы желудь сердца Земле вручим."},{"type":"paragraph","text":"В родных ладонях прозябнет дубом"},{"type":"paragraph","text":"Сердечный желудь, листва — зрачки…"},{"type":"paragraph","text":"Подарят саван заводским трубам"},{"type":"paragraph","text":"Великой Азии пески."},{"type":"paragraph","text":"И сядет ворон на череп Стали —"},{"type":"paragraph","text":"Питомец праха, судьбы маяк…"},{"type":"paragraph","text":"Затмит ли колоб на звездном сале"},{"type":"paragraph","text":"Сосцы ковриги, — башмачный лак?"},{"type":"paragraph","text":"Не хочу быть «кобыльим» поэтом,"},{"type":"paragraph","text":"Влюбленным в стойло, где хмара и кал!"},{"type":"paragraph","text":"Цветет в моих снах геенское лето,"},{"type":"paragraph","text":"И в лязге строк кандальный Байкал."},{"type":"paragraph","text":"Я вскормлен гумном, соловецким звоном,"},{"type":"paragraph","text":"Что вьет, как напевы, гнезда в ушах.-"},{"type":"paragraph","text":"Это я плясал перед царским троном"},{"type":"paragraph","text":"В крылатой поддевке и злых сапогах."},{"type":"paragraph","text":"Это я зловещей совою"},{"type":"paragraph","text":"Влетел в Романовский дом,"},{"type":"paragraph","text":"Чтоб связать возмездье с судьбою"},{"type":"paragraph","text":"Неразрывным красным узлом,"},{"type":"paragraph","text":"Чтоб метлою пурги сибирской"},{"type":"paragraph","text":"Замести истории след…"},{"type":"paragraph","text":"Зырянин с душой нумидийской,"},{"type":"paragraph","text":"Я — родной мужицкий поэт. —"},{"type":"paragraph","text":"Черномазой пахоты ухо"},{"type":"paragraph","text":"Жаворонковый ловит гром —"},{"type":"paragraph","text":"Не с того ль кряжистый Пантюха"},{"type":"paragraph","text":"Осеняет себя крестом."},{"type":"paragraph","text":"Не от песни ль пошел в присядку"},{"type":"paragraph","text":"Звонкодугий лихой Валдай,"},{"type":"paragraph","text":"И забросил в кашную латку"},{"type":"paragraph","text":"Многострунный невод Китай."},{"type":"paragraph","text":"На улов таращит Европа"},{"type":"paragraph","text":"Окровавленный жадный глаз,"},{"type":"paragraph","text":"А в кисе у деда Антропа"},{"type":"paragraph","text":"Кудахчет павлиний сказ."},{"type":"paragraph","text":"Анафема, Анафема вам"},{"type":"paragraph","text":"Башмаки с безглазым цилиндром!"},{"type":"paragraph","text":"Пожалкую на вас стрижам,"},{"type":"paragraph","text":"Речным плотицам и выдрам."},{"type":"paragraph","text":"Попечалюсь родной могилке,"},{"type":"paragraph","text":"Коту, горшку-замарашке,"},{"type":"paragraph","text":"Чтобы дьявольские подпилки"},{"type":"paragraph","text":"Не грызли слезинок ляшки."},{"type":"paragraph","text":"Чтоб была как подойник щедра"},{"type":"paragraph","text":"Душа молоком словесным… —"},{"type":"paragraph","text":"Не станут коврижные недра"},{"type":"paragraph","text":"Калачом поджарым и пресным."},{"type":"paragraph","text":"Не будет лаковым Клюев,"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Златорог — задорным кутёнком!"},{"type":"paragraph","text":"Легче сгинуть в песках Чарджуев"},{"type":"paragraph","text":"С мягкозадым бачей-сартёнком."},{"type":"paragraph","text":"В чай-хане дремать на цыновке"},{"type":"paragraph","text":"В полосатом курдском халате,"},{"type":"paragraph","text":"И видеть, как звезд подковки"},{"type":"paragraph","text":"Ныряют в небесной вате."},{"type":"paragraph","text":"Как верблюдица-полумесяц"},{"type":"paragraph","text":"Пьет у Аллы с ладони…"},{"type":"paragraph","text":"У мускусных перелесиц"},{"type":"paragraph","text":"Замедлят времени кони."},{"type":"paragraph","text":"И сойду я с певчей кобылы,"},{"type":"paragraph","text":"Кунак в предвечном ауле…"},{"type":"paragraph","text":"Ау, Николенька милый —"},{"type":"paragraph","text":"Живых поцелуев улей!"},{"type":"paragraph","text":"Ау! Я далеко, далеко…"},{"type":"paragraph","text":"Но в срок как жених вернуся,"},{"type":"paragraph","text":"Стихи — жемчуга востока —"},{"type":"paragraph","text":"Сложить перед образом Руси."},{"type":"paragraph","text":"Клюев Н. Белая Индия. Стихотворения и поэмы. М., 2000. С. 371—428."}]}]}