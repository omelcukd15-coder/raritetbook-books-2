{"id":"burenin-o-sovremennom","slug":"burenin-o-sovremennom","shard":1,"title":"О современном","altTitles":[],"author":"Виктор Петрович Буренин","authorShort":"В. П. Буренин","authorSlug":"burenin","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1871","editionYear":"1871","description":"Буренин Виктор Петрович","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9E_%D1%81%D0%BE%D0%B2%D1%80%D0%B5%D0%BC%D0%B5%D0%BD%D0%BD%D0%BE%D0%BC_%28%D0%91%D1%83%D1%80%D0%B5%D0%BD%D0%B8%D0%BD%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1871)","downloadAllowed":true,"fb2Url":"/archive/books/burenin/burenin-o-sovremennom/original.fb2","coverUrl":"/archive/books/burenin/burenin-o-sovremennom/cover.webp","stats":{"chaptersCount":4,"wordsCount":799,"charsCount":4892,"readingMinutes":4},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Буренин Виктор Петрович"},{"type":"paragraph","text":"(1841—1926 гг.)."},{"type":"paragraph","text":"О современном"},{"type":"paragraph","text":"(По миновании беспорядков)."},{"type":"paragraph","text":"Поэма в октавах."},{"type":"paragraph","text":"1."},{"type":"paragraph","text":"Дни наши, скажем мы, вздохнув,"},{"type":"paragraph","text":"Есть дни солидного порядка:"},{"type":"paragraph","text":"В отчизне нравственность не пуф,"},{"type":"paragraph","text":"И благочиние не шатко,"},{"type":"paragraph","text":"И если б не канканы в «Буфф» —"},{"type":"paragraph","text":"Растленья признак и упадка —"},{"type":"paragraph","text":"Насчёт морали мог бы нам"},{"type":"paragraph","text":"Завидовать Плотицын сам."},{"type":"paragraph","text":"2."},{"type":"paragraph","text":"А, впрочем, для канкана даже"},{"type":"paragraph","text":"Мы вводим действенный устав:"},{"type":"paragraph","text":"Артисткам открывать корсажи"},{"type":"paragraph","text":"И падать, ноги вверх задрав,"},{"type":"paragraph","text":"У нас нельзя: приличий стражи"},{"type":"paragraph","text":"За это взыскивают штраф,"},{"type":"paragraph","text":"Найдя оплот в родных законах"},{"type":"paragraph","text":"От икр и персей обнажённых."},{"type":"paragraph","text":"3."},{"type":"paragraph","text":"В подобном строе зрится мне"},{"type":"paragraph","text":"Залог спокойного прогресса"},{"type":"paragraph","text":"В моей родимой стороне."},{"type":"paragraph","text":"Напрасно ветреная пресса"},{"type":"paragraph","text":"Кричит, что в общей тишине"},{"type":"paragraph","text":"Явила резкий звук Одесса (имеется в виду еврейский погром 1871 г.):"},{"type":"paragraph","text":"Одесский бунт или скандал"},{"type":"paragraph","text":"Благие результаты дал."},{"type":"paragraph","text":"4."},{"type":"paragraph","text":"Он был одним из тех примеров,"},{"type":"paragraph","text":"В котором зреть нам довелось,"},{"type":"paragraph","text":"Как русских революцьонеров"},{"type":"paragraph","text":"Дерут, что сидоровых коз."},{"type":"paragraph","text":"Сечения больших размеров"},{"type":"paragraph","text":"Стал забывать счастливый росс —"},{"type":"paragraph","text":"И вот ему на Красной горке"},{"type":"paragraph","text":"Слегка напомнили о порке."},{"type":"paragraph","text":"5."},{"type":"paragraph","text":"Любители гуманных фраз,"},{"type":"paragraph","text":"Презревши дикость в факте оном,"},{"type":"paragraph","text":"Стыдят перед Европой нас."},{"type":"paragraph","text":"Смешно! Стыдиться в ней кого нам?.."},{"type":"paragraph","text":"Смирители безумных масс,"},{"type":"paragraph","text":"Тьер мудрый с храбрым Мак-Магоном"},{"type":"paragraph","text":"Дают почище нам пример"},{"type":"paragraph","text":"По части энергичных мер."},{"type":"paragraph","text":"6."},{"type":"paragraph","text":"Я одобряю меры эти:"},{"type":"paragraph","text":"Ещё бы! Если б взяли власть"},{"type":"paragraph","text":"Над Францией коммуны дети,"},{"type":"paragraph","text":"Прогресс грозил наверно пасть:"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Нельзя бы было жить на свете,"},{"type":"paragraph","text":"Имея собственности часть"},{"type":"paragraph","text":"Хоть в виде ложек: коммунисты,"},{"type":"paragraph","text":"Известно, на руку не чисты."},{"type":"paragraph","text":"Строфа 7-ая уничтожена цензурой."},{"type":"paragraph","text":"8."},{"type":"paragraph","text":"Последние 3 строки:"},{"type":"paragraph","text":"Но благ"},{"type":"paragraph","text":"Господь: на помощь всем рентьерам (получателям ренты)"},{"type":"paragraph","text":"Послал Он Мак-Магона с Тьером."},{"type":"paragraph","text":"9."},{"type":"paragraph","text":"Распорядились там они"},{"type":"paragraph","text":"Как следует: Париж доселе"},{"type":"paragraph","text":"Не видывал такой резни:"},{"type":"paragraph","text":"Пред этой бойней побледнели"},{"type":"paragraph","text":"Кровавые июня дни…"},{"type":"paragraph","text":"Все отличились в славном деле,"},{"type":"paragraph","text":"Всех больше — Галифе-маркиз:"},{"type":"paragraph","text":"Что пленных избивал, как крыс."},{"type":"paragraph","text":"10."},{"type":"paragraph","text":"Мы слышим жалоб отголоски:"},{"type":"paragraph","text":"«Расстреливать людей, потом"},{"type":"paragraph","text":"Топить в негашеной извёстке"},{"type":"paragraph","text":"И мертвых, и живых притом —"},{"type":"paragraph","text":"Такие меры слишком жестки»."},{"type":"paragraph","text":"Пусть так, но что жалеть о том,"},{"type":"paragraph","text":"Коль от подобного процесса"},{"type":"paragraph","text":"Родится благо для прогресса?"},{"type":"paragraph","text":"11."},{"type":"paragraph","text":"Прогресса шествие никак"},{"type":"paragraph","text":"Не может обойтись, поверьте,"},{"type":"paragraph","text":"Без казней и кровавых драк."},{"type":"paragraph","text":"Коль времена пришли теперь те,"},{"type":"paragraph","text":"Когда людей бьют, как собак:"},{"type":"paragraph","text":"В душе чувствительность умерьте"},{"type":"paragraph","text":"Сознанием, что сим хранят"},{"type":"paragraph","text":"Цивилизации уклад."},{"type":"paragraph","text":"12."},{"type":"paragraph","text":"Цивилизация — объятья"},{"type":"paragraph","text":"К ней вовремя Тьер не простри —"},{"type":"paragraph","text":"Могла бы мир покинуть, братья."},{"type":"paragraph","text":"На целый прусский штраф пари"},{"type":"paragraph","text":"Готов уверенной держать я:"},{"type":"paragraph","text":"Кто сжечь решился Тюильри,"},{"type":"paragraph","text":"Те привели бы очень скоро"},{"type":"paragraph","text":"Европу к участи Гоморры."},{"type":"paragraph","text":"13."},{"type":"paragraph","text":"Вам Тюильри, конечно, жаль?"},{"type":"paragraph","text":"Вы справедливы: это зданье —"},{"type":"paragraph","text":"Из камней крепкая скрижаль,"},{"type":"paragraph","text":"Хранящая веков преданья."},{"type":"paragraph","text":"Да, у других дворцов едва ль"},{"type":"paragraph","text":"Такие есть воспоминанья:"},{"type":"paragraph","text":"Роскошный Тюильри видал"},{"type":"paragraph","text":"В дни оны не один скандал."}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"14."},{"type":"paragraph","text":"Хоть об июне, о двадцатом"},{"type":"paragraph","text":"Припомним, — сцена не дурна:"},{"type":"paragraph","text":"Роскошный зал, шумит толпа там,"},{"type":"paragraph","text":"И в углублении окна"},{"type":"paragraph","text":"Стоит король! Не пышным штатом"},{"type":"paragraph","text":"Придворных лиц окружена"},{"type":"paragraph","text":"Его священная персона,"},{"type":"paragraph","text":"На нём не пышная корона."},{"type":"paragraph","text":"15."},{"type":"paragraph","text":"Нет, шапка красная на нём,"},{"type":"paragraph","text":"Вокруг в лохмотьях безобразных —"},{"type":"paragraph","text":"Кто с пикою, кто с топором —"},{"type":"paragraph","text":"Бушует чернь. Речей несвязных"},{"type":"paragraph","text":"Немолчен гул. Стакан с вином"},{"type":"paragraph","text":"Приняв из рук бродяги грязных,"},{"type":"paragraph","text":"Властитель трона за народ"},{"type":"paragraph","text":"Под гром рукоплесканий пьёт!.."},{"type":"paragraph","text":"16."},{"type":"paragraph","text":"Потом такого рода сцены"},{"type":"paragraph","text":"Бывали в Тюильри не раз,"},{"type":"paragraph","text":"Не раз его дрожали стены"},{"type":"paragraph","text":"От ярости безумной масс."},{"type":"paragraph","text":"Случалось даже, что гамены (уличные мальчишки)"},{"type":"paragraph","text":"И чернь — Господь, помилуй нас! —"},{"type":"paragraph","text":"Таскали трон и для потехи"},{"type":"paragraph","text":"Святыню жгли при общем смехе!"},{"type":"paragraph","text":"17."},{"type":"paragraph","text":"Случалось… Но позвольте мне"},{"type":"paragraph","text":"Здесь прекратить воспоминанья"},{"type":"paragraph","text":"Событий диких, что вполне"},{"type":"paragraph","text":"Приличны Франции. Вниманье"},{"type":"paragraph","text":"Не лучше ль обратить к стране,"},{"type":"paragraph","text":"Где зрим прогресса процветанье?"},{"type":"paragraph","text":"Пойдём, покинувши Париж,"},{"type":"paragraph","text":"Туда, где благодать и тишь."},{"type":"paragraph","text":"18."},{"type":"paragraph","text":"Ах, не в одной отчизне ныне"},{"type":"paragraph","text":"Мы зрим их: есть ещё земля,"},{"type":"paragraph","text":"Где жизнь проходит «в стройном чине»."},{"type":"paragraph","text":"Взыграли ль духом вы, внемля,"},{"type":"paragraph","text":"Как 70 девиц в Берлине,"},{"type":"paragraph","text":"Красою взоры веселя,"},{"type":"paragraph","text":"Встречали виршами героев,"},{"type":"paragraph","text":"Что ехали, парад устроив?"},{"type":"paragraph","text":"19."},{"type":"paragraph","text":"Приятно, победив врагов,"},{"type":"paragraph","text":"Геройство заявив пред светом,"},{"type":"paragraph","text":"Рассеяв тьму сирот и вдов,"},{"type":"paragraph","text":"Внимать приветственным куплетам"},{"type":"paragraph","text":"Из юных и невинных ртов…"},{"type":"paragraph","text":"Зачем я в мир рождён поэтом,"},{"type":"paragraph","text":"Зачем не прусский генерал,"},{"type":"paragraph","text":"Врагов разбивший наповал?"},{"type":"paragraph","text":"20."}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Тогда б я был, наверно, славен,"},{"type":"paragraph","text":"Тогда бы сыпал я не речь,"},{"type":"paragraph","text":"Но — властелинам мира равен —"},{"type":"paragraph","text":"Бросал бы в публику картечь,"},{"type":"paragraph","text":"И в честь мне новых дней Державин"},{"type":"paragraph","text":"Поторопился бы извлечь"},{"type":"paragraph","text":"Из лиры од, пожалуй, до ста:"},{"type":"paragraph","text":"Как сладко мне тогда б жилось-то!"},{"type":"paragraph","text":"21."},{"type":"paragraph","text":"Но не сулил поэту рок"},{"type":"paragraph","text":"В мундир военный облачиться:"},{"type":"paragraph","text":"Над сочиненьем мерных строк"},{"type":"paragraph","text":"Я осуждён бесплодно биться…"},{"type":"paragraph","text":"Однако, я себя отвлёк"},{"type":"paragraph","text":"От дела: надо возвратиться"},{"type":"paragraph","text":"К отчизне «немца» Коцебу"},{"type":"paragraph","text":"Дальнейшее вымарано цензурой и не подлежит восстановлению."},{"type":"paragraph","text":"23."},{"type":"paragraph","text":"Так Пушкин рёк во время оно,"},{"type":"paragraph","text":"И я внезапно так реку:"},{"type":"paragraph","text":"«Страна фон Мольтке, фон Роона,"},{"type":"paragraph","text":"Фон Бисмарка меня в тоску"},{"type":"paragraph","text":"Приводит: так в ней всё казённо!"},{"type":"paragraph","text":"Нет, я туда не потеку"},{"type":"paragraph","text":"И здесь же прекращу, — когда вы"},{"type":"paragraph","text":"Позволите, — свои октавы»."},{"type":"paragraph","text":"1871 г."},{"type":"paragraph","text":"Первая публикация:"},{"type":"paragraph","text":"«Искра», 1871 г, № 30, с. 400—402."}]}]}