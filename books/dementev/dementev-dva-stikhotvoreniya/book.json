{"id":"dementev-dva-stikhotvoreniya","slug":"dementev-dva-stikhotvoreniya","shard":1,"title":"Два стихотворения","altTitles":[],"author":"Николай Иванович Дементьев","authorShort":"Н. И. Дементьев","authorSlug":"dementev","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1933","editionYear":"1933","description":"(1907—1935)","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%94%D0%B2%D0%B0_%D1%81%D1%82%D0%B8%D1%85%D0%BE%D1%82%D0%B2%D0%BE%D1%80%D0%B5%D0%BD%D0%B8%D1%8F_%28%D0%94%D0%B5%D0%BC%D0%B5%D0%BD%D1%82%D1%8C%D0%B5%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1933)","downloadAllowed":true,"fb2Url":"/archive/books/dementev/dementev-dva-stikhotvoreniya/original.fb2","coverUrl":"/archive/books/dementev/dementev-dva-stikhotvoreniya/cover.webp","stats":{"chaptersCount":5,"wordsCount":982,"charsCount":6098,"readingMinutes":5},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"(1907—1935)"},{"type":"paragraph","text":"Стихотворения"},{"type":"paragraph","text":"Студенты в девятнадцатом году"},{"type":"paragraph","text":"Мать"},{"type":"paragraph","text":"СТУДЕНТЫ В ДЕВЯТНАДЦАТОМ ГОДУ"},{"type":"paragraph","text":"Холод."},{"type":"paragraph","text":"Голод."},{"type":"paragraph","text":"И нет в общежитии дров."},{"type":"paragraph","text":"На заштопанных окнах"},{"type":"paragraph","text":"Блестят, как в музее, караты."},{"type":"paragraph","text":"Пар валит к потолку."},{"type":"paragraph","text":"А по трубам, как кровь,"},{"type":"paragraph","text":"Леденеет вода —"},{"type":"paragraph","text":"И взрывается вдруг радиатор."},{"type":"paragraph","text":"В рваных валенках,"},{"type":"paragraph","text":"В серых ошметках галош,"},{"type":"paragraph","text":"В рыжих «польтах»,"},{"type":"paragraph","text":"Похожие на оборотней,"},{"type":"paragraph","text":"Истощенные голодом,"},{"type":"paragraph","text":"Все как один — молодежь —"},{"type":"paragraph","text":"Отправляются в лес по дрова"},{"type":"paragraph","text":"По морозцу,"},{"type":"paragraph","text":"В пургу —"},{"type":"paragraph","text":"На субботник."},{"type":"paragraph","text":"Лес лежит перед ними,"},{"type":"paragraph","text":"Как вспухшая капля чернил"},{"type":"paragraph","text":"На холодном листе"},{"type":"paragraph","text":"Глазированной солнцем бумаги."},{"type":"paragraph","text":"Дом лесничего,"},{"type":"paragraph","text":"Сад его — мертвый."},{"type":"paragraph","text":"Их закоченил"},{"type":"paragraph","text":"Многоградусный бред."},{"type":"paragraph","text":"Растопи его"},{"type":"paragraph","text":"Жаром отваги!"},{"type":"paragraph","text":"Раздроби его визгом"},{"type":"paragraph","text":"Зубастых"},{"type":"paragraph","text":"Ощеренных пил,"},{"type":"paragraph","text":"Разруби колуном на куски,"},{"type":"paragraph","text":"Расщепи топорами"},{"type":"paragraph","text":"Ты,"},{"type":"paragraph","text":"Голодное войско,"},{"type":"paragraph","text":"Да так, чтобы пар повалил,"},{"type":"paragraph","text":"Чтобы жар полыхал"},{"type":"paragraph","text":"Верст на двадцать кругом"},{"type":"paragraph","text":"И над вами!"},{"type":"paragraph","text":"И действительно:"},{"type":"paragraph","text":"Горсточка серых людей,"},{"type":"paragraph","text":"Чуть хлебнув поутру"},{"type":"paragraph","text":"Недоваренную чечевицу,"},{"type":"paragraph","text":"Взгрела первым ударом"},{"type":"paragraph","text":"Декабрьский"},{"type":"paragraph","text":"Простуженный день…"},{"type":"paragraph","text":"И того разморило,"},{"type":"paragraph","text":"И стало ломить поясницу."},{"type":"paragraph","text":"«Гул прошел по трущобам»,"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Как кто-то когда-то писал."},{"type":"paragraph","text":"Сосны падали,"},{"type":"paragraph","text":"Ели невзвидели света."},{"type":"paragraph","text":"Куча, горсточка,"},{"type":"paragraph","text":"Сорок студентов,"},{"type":"paragraph","text":"А залп,"},{"type":"paragraph","text":"Как из гаубиц,"},{"type":"paragraph","text":"От грозно обрушенных веток."},{"type":"paragraph","text":"Все в царапинах, в ссадинах"},{"type":"paragraph","text":"Руки, лицо — не болят."},{"type":"paragraph","text":"Не гудят и не ноют"},{"type":"paragraph","text":"Ходьбой утомленные ноги."},{"type":"paragraph","text":"Шаг за шагом,"},{"type":"paragraph","text":"Удар за ударом,"},{"type":"paragraph","text":"И все — штабеля,"},{"type":"paragraph","text":"Штабеля"},{"type":"paragraph","text":"Вдоль полотен"},{"type":"paragraph","text":"Железной дороги!"},{"type":"paragraph","text":"Все — тебе,"},{"type":"paragraph","text":"В твой гангреной пылающий рот,"},{"type":"paragraph","text":"Паровоз,"},{"type":"paragraph","text":"Наш защитник,"},{"type":"paragraph","text":"Помощник и днями и ночью."},{"type":"paragraph","text":"Все — для вас,"},{"type":"paragraph","text":"Для товарищей,"},{"type":"paragraph","text":"Мерно ушедших"},{"type":"paragraph","text":"На фронт"},{"type":"paragraph","text":"Умирать за республику,"},{"type":"paragraph","text":"За города,"},{"type":"paragraph","text":"За рабочих!"},{"type":"paragraph","text":"Два десятка студентов,"},{"type":"paragraph","text":"Едва уцелевших в тылу,"},{"type":"paragraph","text":"Посылают горячий,"},{"type":"paragraph","text":"Пропахший смолою подарок…"},{"type":"paragraph","text":". . . . . . . . . . . . . . . . ."},{"type":"paragraph","text":"А вернувшись с субботника,"},{"type":"paragraph","text":"Люди заснули в углу"},{"type":"paragraph","text":"На промерзшем полу"},{"type":"paragraph","text":"И дышали сгустившимся паром."},{"type":"paragraph","text":"Хлеба не было."},{"type":"paragraph","text":"В вузы никто не ходил."},{"type":"paragraph","text":"В трубах пухла вода."},{"type":"paragraph","text":"Мертвой ватой"},{"type":"paragraph","text":"Покрылись карнизы…"},{"type":"paragraph","text":"И студенчество слушало"},{"type":"paragraph","text":"Мерную поступь годин:"},{"type":"paragraph","text":"Шел Колчак,"},{"type":"paragraph","text":"Шел Деникин,"},{"type":"paragraph","text":"Рождался в крови"},{"type":"paragraph","text":"Коммунизм."},{"type":"paragraph","text":"Октябрь 1928 г."},{"type":"paragraph","text":"МАТЬ"},{"type":"paragraph","text":"Толпы с поезда. Ну, и народ! Впрямь как с шабаша:"},{"type":"paragraph","text":"Прут и прут, не допрутся пока…"},{"type":"paragraph","text":"— Тише! Бабку затискали! Что тебе, бабушка?"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"«Мне б Петрушу…» — Которого это? — «Сынка…»"},{"type":"paragraph","text":"Бултыхает старуха баулом и чайником."},{"type":"paragraph","text":"У возниц, у шоферов, у публики — смех:"},{"type":"paragraph","text":"— Это что ж за петрушка такая? — «Начальник он…»"},{"type":"paragraph","text":"— Тут начальников много… — «Так мой — выше всех»."},{"type":"paragraph","text":"Уморила!"},{"type":"paragraph","text":"Над сборищем этим, над сонмом"},{"type":"paragraph","text":"Гогот, хохот, шибающий в пот."},{"type":"paragraph","text":"Вдруг один кучерок как смекнет, да как вспомнит,"},{"type":"paragraph","text":"Что начальник строительства —"},{"type":"paragraph","text":"Правильно — Петр!"},{"type":"paragraph","text":"Кулаком по мордам"},{"type":"paragraph","text":"Лошадей задремавших,"},{"type":"paragraph","text":"Чтоб стояли,"},{"type":"paragraph","text":"Чтоб выглядели, как орлы!"},{"type":"paragraph","text":"Сено — в ноги. Кнут — в руки:"},{"type":"paragraph","text":"«Садитесь, мамаша!..»"},{"type":"paragraph","text":"Ой, железные шины круты и круглы!"},{"type":"paragraph","text":"Ты качайся, на клевере вскормленный мерин!"},{"type":"paragraph","text":"Вороная кобылка, пластайся в разлет!"},{"type":"paragraph","text":"Обернется, башкой помотает — и верит —"},{"type":"paragraph","text":"И не верит."},{"type":"paragraph","text":"А бабушка носом клюет."},{"type":"paragraph","text":"Кацавейка на ней — не по-летнему — ватная."},{"type":"paragraph","text":"Ишь! горбатая… Ишь! — неприглядная вся…"},{"type":"paragraph","text":"Загорелая, старая и рябоватая…"},{"type":"paragraph","text":"…У начальника в комнате"},{"type":"paragraph","text":"Карты висят…"},{"type":"paragraph","text":"На кровати начальника — простыни взрыты."},{"type":"paragraph","text":"Шторы — настежь,"},{"type":"paragraph","text":"И солнце —"},{"type":"paragraph","text":"По всем косякам,"},{"type":"paragraph","text":"Книгам, стеклам, приборам…"},{"type":"paragraph","text":"Слепящая бритва"},{"type":"paragraph","text":"Пышет в зеркало,"},{"type":"paragraph","text":"А перед зеркалом! — сам."},{"type":"paragraph","text":"Крепкий, свежий, еще не успел приодеться,"},{"type":"paragraph","text":"Напевает чего-то в усы и под нос,"},{"type":"paragraph","text":"Пена шлепается на полотенце…"},{"type":"paragraph","text":"Входит возчик:"},{"type":"paragraph","text":"«Мамашу — в порядке довез…»"},{"type":"paragraph","text":"А за возчиком,"},{"type":"paragraph","text":"В белом платочке и валенках,"},{"type":"paragraph","text":"Что-то давнее-давнее, и не узнать…"},{"type":"paragraph","text":"Вспоминал… вспоминал… вспоминал…"},{"type":"paragraph","text":"Вспомнил — Маменька! —"},{"type":"paragraph","text":"«Я, Петруша! Я, милый! Я, кровный! Я — мать»…"},{"type":"paragraph","text":"Отобрал у нее узелки и баулы,"},{"type":"paragraph","text":"Рассовал под столы, оглянулся мельком."},{"type":"paragraph","text":"Усадил, оглядел ее всю…-"},{"type":"paragraph","text":"И пахнуло"},{"type":"paragraph","text":"Детством — речкой, репейником, молоком,"},{"type":"paragraph","text":"Молодыми рябинами над оградами."},{"type":"paragraph","text":"Рубашонкой в заплатах, сестренкой в соплях…"},{"type":"paragraph","text":"— Мама! Мамонька!"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Чем же тебя мне порадовать?"},{"type":"paragraph","text":"Ты, наверно, с дороги устала, приляг."},{"type":"paragraph","text":"Уложил ее, старенькую, на топчанике,"},{"type":"paragraph","text":"Одеялом, коротенькую, — до бровей…"},{"type":"paragraph","text":"— Самоварчик?"},{"type":"paragraph","text":"У нас, понимаешь ли, — чайники…"},{"type":"paragraph","text":"В церкву хочешь?"},{"type":"paragraph","text":"А я и не строил церквей."},{"type":"paragraph","text":"Ну, да ты не волнуйся! Ты мало грешила,"},{"type":"paragraph","text":"Я ж тебя от любого греха излечу."},{"type":"paragraph","text":"Знаешь, мамонька, что?"},{"type":"paragraph","text":"У меня есть машина."},{"type":"paragraph","text":"Я тебя по строительству прокачу."},{"type":"paragraph","text":"Ты посмотришь, чего мы настроили… Дела ж"},{"type":"paragraph","text":"До сих пор полон рот — и какие дела!"},{"type":"paragraph","text":"Покатаемся? Хочется? —"},{"type":"paragraph","text":"«Что ты! И где уж!»"},{"type":"paragraph","text":"Два денечка поохала"},{"type":"paragraph","text":"И померла."},{"type":"paragraph","text":"А начальника мы уважали."},{"type":"paragraph","text":"Не с ним ли"},{"type":"paragraph","text":"Возвели комбинат за четыре зимы?"},{"type":"paragraph","text":"Вышло так, что мамашу его хоронили"},{"type":"paragraph","text":"Всем строительством, всеми бригадами мы."},{"type":"paragraph","text":"В полдень, как по сигналу, —"},{"type":"paragraph","text":"Сойтись и собраться!"},{"type":"paragraph","text":"В разогретый асфальт —"},{"type":"paragraph","text":"Многотысячный шаг!"},{"type":"paragraph","text":"Тихо, тихо прошел в голове демонстрации"},{"type":"paragraph","text":"Пятитонный, задернутый черным «фомаг»."},{"type":"paragraph","text":"Там четыре партийца"},{"type":"paragraph","text":"Почетною вахтою"},{"type":"paragraph","text":"Охраняют стоймя,"},{"type":"paragraph","text":"Не опершись на борт,"},{"type":"paragraph","text":"Загорелую, старую и рябоватую"},{"type":"paragraph","text":"Мать начальника наших работ."},{"type":"paragraph","text":"Мы проходим, работоупорные жители,"},{"type":"paragraph","text":"Мимо ясных от яркого света громад."},{"type":"paragraph","text":"Автогеном мерцает"},{"type":"paragraph","text":"Машиностроительный,"},{"type":"paragraph","text":"Равномерно работает"},{"type":"paragraph","text":"Химкомбинат."},{"type":"paragraph","text":"Мерно медные трубы"},{"type":"paragraph","text":"Оркестра умелого,"},{"type":"paragraph","text":"На девчонках платочки"},{"type":"paragraph","text":"Весенних цветов…"},{"type":"paragraph","text":"…Ничего не видала"},{"type":"paragraph","text":"И мало что сделала"},{"type":"paragraph","text":"За семь с лишним десятков"},{"type":"paragraph","text":"Бедняцких годов."},{"type":"paragraph","text":"На голодной степи, у дороги, — песочек."},{"type":"paragraph","text":"Бабий голос — еще молодой — одинок…"},{"type":"paragraph","text":"Сын приехал"},{"type":"paragraph","text":"С уральских заводов,"},{"type":"paragraph","text":"Вальцовщиком,"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Прогармонил недельку —"},{"type":"paragraph","text":"И смылся сынок."},{"type":"paragraph","text":"А у ней, как и встарь, догнивает под дождиком"},{"type":"paragraph","text":"Ощетиненный, малоколосистый сноп…"},{"type":"paragraph","text":"Сын приехал,"},{"type":"paragraph","text":"Бежавши из ссылки"},{"type":"paragraph","text":"Подпольщиком,"},{"type":"paragraph","text":"Ночевал на овине —"},{"type":"paragraph","text":"И смылся сынок."},{"type":"paragraph","text":"А она — со скотом — поднимается раненько."},{"type":"paragraph","text":"Уж от старости пальцы пускаются в пляс…"},{"type":"paragraph","text":"Сын приехал"},{"type":"paragraph","text":"С гражданского фронта."},{"type":"paragraph","text":"Израненный,"},{"type":"paragraph","text":"Отдохнул — и на фронт!"},{"type":"paragraph","text":"А она осталась…"},{"type":"paragraph","text":"Протащилась,"},{"type":"paragraph","text":"Не чуя ни горя, ни времени,"},{"type":"paragraph","text":"Через двадцать беременностей и смертей…"},{"type":"paragraph","text":"…Мы положим тебя,"},{"type":"paragraph","text":"Аграфена Ефремовна,"},{"type":"paragraph","text":"В парке отдыха"},{"type":"paragraph","text":"У пионерлагерей"},{"type":"paragraph","text":"Через светлые,"},{"type":"paragraph","text":"Через стеклянные версты"},{"type":"paragraph","text":"Сын тебя провожает,"},{"type":"paragraph","text":"Как через века…"},{"type":"paragraph","text":"Это строили мы"},{"type":"paragraph","text":"Под его руководством —"},{"type":"paragraph","text":"Инженера, начальника, большевика."},{"type":"paragraph","text":"Это мы возводили,"},{"type":"paragraph","text":"Чтобы крепче дышалось,"},{"type":"paragraph","text":"Чтобы легче работалось,"},{"type":"paragraph","text":"Лучше жилось,"},{"type":"paragraph","text":"Чтобы с ног не валила"},{"type":"paragraph","text":"Ни хворь,"},{"type":"paragraph","text":"Ни усталость…"},{"type":"paragraph","text":"Мы положим тебя"},{"type":"paragraph","text":"У веселых берез,"},{"type":"paragraph","text":"Изможденную, темную мать неимущих,"},{"type":"paragraph","text":"Всех, кто новым и властным! хозяином встал."},{"type":"paragraph","text":"Пусть в оркестре"},{"type":"paragraph","text":"Все трубы играют «Замучен"},{"type":"paragraph","text":"Тяжелой неволей…»"},{"type":"paragraph","text":"И «Интернационал»!"},{"type":"paragraph","text":"1933"}]}]}