{"id":"podolinskiy-nishchiy","slug":"podolinskiy-nishchiy","shard":1,"title":"Нищий","altTitles":[],"author":"Андрей Иванович Подолинский","authorShort":"А. И. Подолинский","authorSlug":"podolinskiy","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1830","editionYear":"1830","description":"Нищий","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9D%D0%B8%D1%89%D0%B8%D0%B9_%28%D0%9F%D0%BE%D0%B4%D0%BE%D0%BB%D0%B8%D0%BD%D1%81%D0%BA%D0%B8%D0%B9%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1830)","downloadAllowed":true,"fb2Url":"/archive/books/podolinskiy/podolinskiy-nishchiy/original.fb2","coverUrl":"/archive/books/podolinskiy/podolinskiy-nishchiy/cover.webp","stats":{"chaptersCount":14,"wordsCount":3656,"charsCount":20989,"readingMinutes":20},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"},{"id":"chapter-9","title":"Часть 9"},{"id":"chapter-10","title":"Часть 10"},{"id":"chapter-11","title":"Часть 11"},{"id":"chapter-12","title":"Часть 12"},{"id":"chapter-13","title":"Часть 13"},{"id":"chapter-14","title":"Часть 14"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Нищий"},{"type":"paragraph","text":"----------------------------------------------------------------------------"},{"type":"paragraph","text":"Русская романтическая поэма."},{"type":"paragraph","text":"М., Правда, 1985"},{"type":"paragraph","text":"----------------------------------------------------------------------------"},{"type":"paragraph","text":"Occhi piangete, accompagnate il core."},{"type":"paragraph","text":"Petrarca. {*}"},{"type":"paragraph","text":"{* Плачьте очи согласно с сердцем. Петрарка (ит.).}"},{"type":"paragraph","text":"Далеко родина моя!"},{"type":"paragraph","text":"Ее давно покинул я —"},{"type":"paragraph","text":"Давно!.. но душу старика"},{"type":"paragraph","text":"Томит по родине тоска!"},{"type":"paragraph","text":"О если б мне, когда-нибудь,"},{"type":"paragraph","text":"Опять на милую взглянуть!"},{"type":"paragraph","text":"Еще я помню: горы там,"},{"type":"paragraph","text":"Снега и льдины по горам,"},{"type":"paragraph","text":"Они блестят венцом златым"},{"type":"paragraph","text":"Под небом вечно-голубым;"},{"type":"paragraph","text":"Долин и нега, и краса,"},{"type":"paragraph","text":"Роскошно зыблются леса,"},{"type":"paragraph","text":"И брызжет искрами залив"},{"type":"paragraph","text":"У корней миртов и олив;"},{"type":"paragraph","text":"Там — ряд священных мне могил"},{"type":"paragraph","text":"Широко явор осенил-"},{"type":"paragraph","text":"И, может быть, в его тени,"},{"type":"paragraph","text":"И я бы мирно кончил дни…"},{"type":"paragraph","text":"Я?.. Нет! Ничтожные мечты!.."},{"type":"paragraph","text":"Меня, мой прах отринешь ты —"},{"type":"paragraph","text":"И тихим шелестом ветвей"},{"type":"paragraph","text":"Не освежить главы моей!"},{"type":"paragraph","text":"Она горит! она в огне!"},{"type":"paragraph","text":"И наяву, и в кратком сне,"},{"type":"paragraph","text":"Хотя бы одр мой был из роз,"},{"type":"paragraph","text":"Не избежать мне страшных грёз!"},{"type":"paragraph","text":"Везде тоскующая тень"},{"type":"paragraph","text":"Следит за мной и ночь, и день; —"},{"type":"paragraph","text":"В дыханьи ветра, в шуме вод,"},{"type":"paragraph","text":"Она мне голос подает —"},{"type":"paragraph","text":"И слышу я: «Куда? куда?.."},{"type":"paragraph","text":"Забудь отчизну навсегда!"},{"type":"paragraph","text":"Не донести тебе костей"},{"type":"paragraph","text":"К горам Италии твоей!"},{"type":"paragraph","text":"И, безымянно, самый прах"},{"type":"paragraph","text":"Потонет в Северных снегах!»"},{"type":"paragraph","text":"Так! я заране узнаю"},{"type":"paragraph","text":"Судьбу грядущую мою!"},{"type":"paragraph","text":"И я бы снова, может быть,"},{"type":"paragraph","text":"Хотел отчизну разлюбить-"},{"type":"paragraph","text":"Но, как по вольности, о ней"},{"type":"paragraph","text":"Тоска живет в груди моей!"},{"type":"paragraph","text":"С какою жадностью, с каким"},{"type":"paragraph","text":"Участьем нежным и живым"},{"type":"paragraph","text":"Порой прислушиваюсь я"},{"type":"paragraph","text":"К вечерней песни соловья:"},{"type":"paragraph","text":"Он был в Италии — и мне"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Поет о милой стороне, —"},{"type":"paragraph","text":"И этой песни каждый звук"},{"type":"paragraph","text":"Душе давно знакомый друг!"},{"type":"paragraph","text":"И, мнится, вновь наводит он"},{"type":"paragraph","text":"На душу сладкий, сладкий сон"},{"type":"paragraph","text":"О прошлых днях, когда я жил-"},{"type":"paragraph","text":"Когда мечтал, — когда любил!.."},{"type":"paragraph","text":"Любил!.. Зачем я утаю"},{"type":"paragraph","text":"Любовь печальную мою?.."},{"type":"paragraph","text":"Аньола! незабвенный звук!"},{"type":"paragraph","text":"Как много дум, как много мук"},{"type":"paragraph","text":"Вновь в сердце вспыхнуло моем"},{"type":"paragraph","text":"При этом имени одном!"},{"type":"paragraph","text":"О если б я его забыл!"},{"type":"paragraph","text":"О если б грудь опустошил"},{"type":"paragraph","text":"Порыв губительных страстей —"},{"type":"paragraph","text":"И память самую о ней"},{"type":"paragraph","text":"Рассеял он — как брызги вод"},{"type":"paragraph","text":"Грозы стремительной полет!"},{"type":"paragraph","text":"О чем молю?.. до этих пор,"},{"type":"paragraph","text":"Сединам сим наперекор,"},{"type":"paragraph","text":"Как отголосок прежних дней,"},{"type":"paragraph","text":"Сей звук живет в груди моей —"},{"type":"paragraph","text":"И разве с жизнью будет он"},{"type":"paragraph","text":"Навек из сердца извлечен!"},{"type":"paragraph","text":"Как я любил! — казалось мне,"},{"type":"paragraph","text":"Тогда я чувствовал вдвойне"},{"type":"paragraph","text":"Всю прелесть жизни, — я постиг"},{"type":"paragraph","text":"Как тот в творении велик,"},{"type":"paragraph","text":"Кто цепью вечною любви"},{"type":"paragraph","text":"Сковал создания свои!"},{"type":"paragraph","text":"Казалось: все вокруг меня"},{"type":"paragraph","text":"Блистало заревом огня"},{"type":"paragraph","text":"Любви и вечной и святой;"},{"type":"paragraph","text":"И целый мир передо мной,"},{"type":"paragraph","text":"Как бы созданье чудных снов,"},{"type":"paragraph","text":"Облекся в радужный покров;"},{"type":"paragraph","text":"И сердце мне давало весть,"},{"type":"paragraph","text":"Что в сем прекрасном мире есть,"},{"type":"paragraph","text":"Есть сердце полное огня"},{"type":"paragraph","text":"Любви живой и для меня,"},{"type":"paragraph","text":"И что в цепи существ оно"},{"type":"paragraph","text":"Необходимое звено!"},{"type":"paragraph","text":"Тот беден, беден на земли,"},{"type":"paragraph","text":"Чьи дни без дум любви текли!"},{"type":"paragraph","text":"Кто к людям холодом дыша,"},{"type":"paragraph","text":"Не мог постигнуть, как душа"},{"type":"paragraph","text":"Роднится с близкою душой,"},{"type":"paragraph","text":"Тот между братьями — чужой!"},{"type":"paragraph","text":"С презреньем горьким ко всему,"},{"type":"paragraph","text":"Он покорил себя уму,"},{"type":"paragraph","text":"И первой страсти пылкий сон"},{"type":"paragraph","text":"Мечтою детской назвал он."},{"type":"paragraph","text":"Порывы сердца заглуша,"},{"type":"paragraph","text":"Его надменная душа"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"В самой себе погребена,"},{"type":"paragraph","text":"И недоступна и темна:"},{"type":"paragraph","text":"Так, в Африке, среди степей,"},{"type":"paragraph","text":"Стоит огромный мавзолей"},{"type":"paragraph","text":"И под собой, свою нее тень,"},{"type":"paragraph","text":"Бесплодно кроет в жаркий день."},{"type":"paragraph","text":"Под небом пламенным рожден,"},{"type":"paragraph","text":"Я не таков! Нет! охлажден"},{"type":"paragraph","text":"Заране к людям не был я;"},{"type":"paragraph","text":"Все впечатленья бытия"},{"type":"paragraph","text":"Я принял жадно, — и любовь"},{"type":"paragraph","text":"Мне сильно волновала кровь!"},{"type":"paragraph","text":"Мне согревала грудь она,"},{"type":"paragraph","text":"Как землю ранняя весна,"},{"type":"paragraph","text":"И, как весенние цветы,"},{"type":"paragraph","text":"Рождались новые мечты"},{"type":"paragraph","text":"О всем прекрасном, о святом"},{"type":"paragraph","text":"В уме взволнованном моем."},{"type":"paragraph","text":"Я говорил: ее нам бог,"},{"type":"paragraph","text":"Благ наших будущих в залог,"},{"type":"paragraph","text":"Еще в сей жизни даровал,"},{"type":"paragraph","text":"Чтоб человек заране знал,"},{"type":"paragraph","text":"Как щедро в вечном будет он"},{"type":"paragraph","text":"За миг страданий награжден!"},{"type":"paragraph","text":"Видали ль вы, когда дитя,"},{"type":"paragraph","text":"Цветок на волны опустя,"},{"type":"paragraph","text":"С беспечной радостью глядит,"},{"type":"paragraph","text":"Как он трепещет и скользит?"},{"type":"paragraph","text":"Но, если влагой напоен,"},{"type":"paragraph","text":"На дно внезапно канет он,"},{"type":"paragraph","text":"Его малютке станет жаль,"},{"type":"paragraph","text":"И сердца детского печаль"},{"type":"paragraph","text":"Не облегчит незрелый ум:"},{"type":"paragraph","text":"Он слышит волн досадный шум,"},{"type":"paragraph","text":"Он их задумчиво следит —"},{"type":"paragraph","text":"И слезы падают с ланит…"},{"type":"paragraph","text":"Вот образ мой! Мечты мои,"},{"type":"paragraph","text":"Надежды мира и любви,"},{"type":"paragraph","text":"Я безрассудно предал сам"},{"type":"paragraph","text":"На волю гибельным страстям,"},{"type":"paragraph","text":"И необузданный поток"},{"type":"paragraph","text":"Невозвратимо, их увлек!.."},{"type":"paragraph","text":"Однажды, праздником весны —"},{"type":"paragraph","text":"Храня обычай старины —"},{"type":"paragraph","text":"Плясал под сению дерев"},{"type":"paragraph","text":"Круг резвых юношей и дев,"},{"type":"paragraph","text":"И между них была она,"},{"type":"paragraph","text":"Моя Аньола! Что весна?"},{"type":"paragraph","text":"Что пышной радуги цветы"},{"type":"paragraph","text":"Пред блеском девы-красоты?"},{"type":"paragraph","text":"Утомлена, ко мне на грудь"},{"type":"paragraph","text":"Она поникла; я дохнуть"},{"type":"paragraph","text":"Не смел; не мог отвесть от ней"},{"type":"paragraph","text":"Я очарованных очей —"},{"type":"paragraph","text":"И вдруг руки моей слегка"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Коснулась жаркая рука,"},{"type":"paragraph","text":"Я вспыхнул — к пламенным устам"},{"type":"paragraph","text":"Прижал ее, — не помнил сам,"},{"type":"paragraph","text":"Что делал я, кипела кровь —"},{"type":"paragraph","text":"И я ей высказал любовь!"},{"type":"paragraph","text":"Но, между тем, изумлена,"},{"type":"paragraph","text":"Глядела в очи мне она,"},{"type":"paragraph","text":"Как будто в грудь ей не проник"},{"type":"paragraph","text":"Любви мучительный язык!"},{"type":"paragraph","text":"Я ждал ответа… но без слов"},{"type":"paragraph","text":"Она ушла; — я был готов"},{"type":"paragraph","text":"За нею вслед: у милых ног,"},{"type":"paragraph","text":"Хоть слово б вымолвить я мог, —"},{"type":"paragraph","text":"Но, как мечта, в толпе густой"},{"type":"paragraph","text":"Аньола скрылась… я главой"},{"type":"paragraph","text":"На грудь стесненную поник —"},{"type":"paragraph","text":"О как я помню этот миг!"},{"type":"paragraph","text":"Впервые на сердце тогда"},{"type":"paragraph","text":"Запала страшная мечта:"},{"type":"paragraph","text":"Что жизнь — пучина слез и бед,"},{"type":"paragraph","text":"Любовь — огонь, а счастья — нет!.."},{"type":"paragraph","text":"И слезы с щек моих текли"},{"type":"paragraph","text":"На грудь холодную земли…"},{"type":"paragraph","text":"С тех пор, задумчив и уныл,"},{"type":"paragraph","text":"От всех я ревностно хранил"},{"type":"paragraph","text":"Мою любовь; никто не знал,"},{"type":"paragraph","text":"О чем я втайне тосковал;"},{"type":"paragraph","text":"Бежал всего, родных, друзей,"},{"type":"paragraph","text":"И часто, в сумраке ночей,"},{"type":"paragraph","text":"Тревоги полный, чуждый сну,"},{"type":"paragraph","text":"Один всходил на крутизну;"},{"type":"paragraph","text":"Не раз, объятый темнотой,"},{"type":"paragraph","text":"Гранит срывался предо мной,"},{"type":"paragraph","text":"Но неподвижно я стоял,"},{"type":"paragraph","text":"Как бы прикованный у скал."},{"type":"paragraph","text":"Мне смерть казалась не страшна;"},{"type":"paragraph","text":"В душе была мечта одна:"},{"type":"paragraph","text":"Аньолы имя вторил я"},{"type":"paragraph","text":"И был утешен как дитя,"},{"type":"paragraph","text":"Коль отголосок дальних скал"},{"type":"paragraph","text":"Мне милый звук передавал."},{"type":"paragraph","text":"Кто знает пламенную страсть,"},{"type":"paragraph","text":"Кто над собой изведал власть"},{"type":"paragraph","text":"Улыбки, взгляда и речей"},{"type":"paragraph","text":"Младой любовницы своей,"},{"type":"paragraph","text":"И, грусть бесплодную тая,"},{"type":"paragraph","text":"Не пролил слез у ног ея,"},{"type":"paragraph","text":"Тот много дум моих постиг —"},{"type":"paragraph","text":"Но их не выразит язык!"},{"type":"paragraph","text":"Они прерывисты как сны,"},{"type":"paragraph","text":"Как бездна дики и темны."},{"type":"paragraph","text":"В слезах молил напрасно я"},{"type":"paragraph","text":"Отрады грустной забытья,"},{"type":"paragraph","text":"Ни днем, ни ночью, ни во сне"},{"type":"paragraph","text":"Не мог забыться я вполне;"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Видений в вихре надо мной"},{"type":"paragraph","text":"Носился образ дорогой —"},{"type":"paragraph","text":"С зарей он снова исчезал, —"},{"type":"paragraph","text":"И я бессмысленно рыдал."},{"type":"paragraph","text":"Но, как луны осенней луч"},{"type":"paragraph","text":"Падет порою из-за туч,"},{"type":"paragraph","text":"Скалы и льдины серебрит,"},{"type":"paragraph","text":"И в пропасть темную скользит:"},{"type":"paragraph","text":"Так заронялась иногда"},{"type":"paragraph","text":"Надежды вкрадчивой мечта"},{"type":"paragraph","text":"В больную грудь; я был готов"},{"type":"paragraph","text":"Лелеять призрак давних снов,"},{"type":"paragraph","text":"Я мыслил: детская душа,"},{"type":"paragraph","text":"Любовью к вольности дыша,"},{"type":"paragraph","text":"Любви иной не поняла —"},{"type":"paragraph","text":"Еще беспечность ей мила;"},{"type":"paragraph","text":"Но будет время — может быть,"},{"type":"paragraph","text":"В ней можно чувство пробудить…"},{"type":"paragraph","text":"Но, как луны скользящий луч"},{"type":"paragraph","text":"Мгновенно гаснет в лоне туч,"},{"type":"paragraph","text":"Так навсегда, в последний раз,"},{"type":"paragraph","text":"Надежды огнь во мне погас…"},{"type":"paragraph","text":"Бледнело небо; тень легла;"},{"type":"paragraph","text":"На Юге долго ночь тепла,"},{"type":"paragraph","text":"И было душно между скал:"},{"type":"paragraph","text":"Какой-то зной от них дышал,"},{"type":"paragraph","text":"Но меж расселистых громад"},{"type":"paragraph","text":"Гремит и блещет водопад,"},{"type":"paragraph","text":"В пещере сумрачной рожден,"},{"type":"paragraph","text":"И в жар прохладой веет он;"},{"type":"paragraph","text":"Ему внимал с утеса я,"},{"type":"paragraph","text":"Свежо дышала грудь моя,"},{"type":"paragraph","text":"И не смущали темных дум"},{"type":"paragraph","text":"Однообразный гул и шум."},{"type":"paragraph","text":"На льдинах гаснул отблеск дня,"},{"type":"paragraph","text":"Вдруг тихий шорох близ меня-"},{"type":"paragraph","text":"Гляжу и что ж? Не сон ли? Нет!"},{"type":"paragraph","text":"Она! Аньола! Слабый свет"},{"type":"paragraph","text":"На ней едва, едва мелькал —"},{"type":"paragraph","text":"Но я ль Аньолы не узнал?"},{"type":"paragraph","text":"И, как мертвец под властью чар,"},{"type":"paragraph","text":"Воспрянул я; и страх и жар"},{"type":"paragraph","text":"Текли по членам; я… но вдруг"},{"type":"paragraph","text":"Я поцелуя слышу звук…"},{"type":"paragraph","text":"Опять… о боже! и она"},{"type":"paragraph","text":"Лобзаньям чуждым предана!"},{"type":"paragraph","text":"Приникнув к ней, рука с рукой,"},{"type":"paragraph","text":"Ее ласкал соперник мой!"},{"type":"paragraph","text":"Я вынесть более не мог:"},{"type":"paragraph","text":"Как демон, страшен и жесток,"},{"type":"paragraph","text":"Пылая местию слепой,"},{"type":"paragraph","text":"Пред изумленною четой"},{"type":"paragraph","text":"Явился я… Мой дикий взгляд"},{"type":"paragraph","text":"Окинул скалы, водопад,"},{"type":"paragraph","text":"И, как бессильное дитя,"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Врага внезапно обхватя,"},{"type":"paragraph","text":"Прижал к груди — и со скалы"},{"type":"paragraph","text":"Его я бросил в бездну мглы!"},{"type":"paragraph","text":"И нет его! затихнул гул;"},{"type":"paragraph","text":"Я в пропасть дико заглянул,"},{"type":"paragraph","text":"Во мгле не видно ничего!"},{"type":"paragraph","text":"Но вдруг до слуха моего"},{"type":"paragraph","text":"Доходит крик… он мне знаком!"},{"type":"paragraph","text":"То голос брата! — Если б гром"},{"type":"paragraph","text":"С небес разгневанных упал,"},{"type":"paragraph","text":"И под развалинами скал"},{"type":"paragraph","text":"Братоубийцу он погреб, —"},{"type":"paragraph","text":"Чтоб бездна приняла, как гроб,"},{"type":"paragraph","text":"Мою главу… чтоб в Судный день"},{"type":"paragraph","text":"Моя испуганная тень"},{"type":"paragraph","text":"Укрылась в сумраке земли-"},{"type":"paragraph","text":"Чтоб мне на сердце налегли"},{"type":"paragraph","text":"Громады гор, — но гром молчал!"},{"type":"paragraph","text":"Лишь братний вопль не умолкал…"},{"type":"paragraph","text":"И в онемении, как труп,"},{"type":"paragraph","text":"Я пал на каменный уступ!.."},{"type":"paragraph","text":"Минула ночь — и мутный взор"},{"type":"paragraph","text":"Открыл я вновь; по темю гор"},{"type":"paragraph","text":"Светились льдины как стекло,"},{"type":"paragraph","text":"Их солнце раннее зажгло."},{"type":"paragraph","text":"Вдали, на зелени полян,"},{"type":"paragraph","text":"Роса сверкала сквозь туман,"},{"type":"paragraph","text":"И сквозь туманы, в стороне,"},{"type":"paragraph","text":"Сияла в утреннем огне,"},{"type":"paragraph","text":"Как бы серебряный ковер,"},{"type":"paragraph","text":"Поверхность ясная озер."},{"type":"paragraph","text":"И здесь и там любви приют,"},{"type":"paragraph","text":"Склонились рощи, будто ждут,"},{"type":"paragraph","text":"Чтоб мановеньем легких крыл"},{"type":"paragraph","text":"Их ветер утра освежил;"},{"type":"paragraph","text":"И ветер дунул на леса"},{"type":"paragraph","text":"И вольных птичек голоса,"},{"type":"paragraph","text":"И шум дерев, и звон рожка"},{"type":"paragraph","text":"Ко мне принес издалека."},{"type":"paragraph","text":"В благоговении немом,"},{"type":"paragraph","text":"Как бы объятый чутким сном,"},{"type":"paragraph","text":"Еще стоял я, — вдруг в уме,"},{"type":"paragraph","text":"Как искра вспыхнувшая в тьме,"},{"type":"paragraph","text":"Блеснула мысль: Аньола!.. Брат!.."},{"type":"paragraph","text":"То сон иль нет?.. Тревожный взгляд"},{"type":"paragraph","text":"Бросаю всюду: пустота!"},{"type":"paragraph","text":"Так это сон! одна мечта!"},{"type":"paragraph","text":"Не в первый раз такие сны"},{"type":"paragraph","text":"Моей тоской наведены! —"},{"type":"paragraph","text":"Но страх опять меня объял,"},{"type":"paragraph","text":"Казалось, будто услыхал"},{"type":"paragraph","text":"Я братний голос-беглый взгляд"},{"type":"paragraph","text":"Случайно пал на водопад,"},{"type":"paragraph","text":"И что же? Брата епанча"},{"type":"paragraph","text":"У ската горного ключа,"}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"Полой вцепившись о гранит,"},{"type":"paragraph","text":"По ветру вьется и шумит!"},{"type":"paragraph","text":"И, как безумный, долго я"},{"type":"paragraph","text":"Очей недвижных не сводя,"},{"type":"paragraph","text":"Стоял над бездной; стыла кровь,"},{"type":"paragraph","text":"Хладела грудь; но младость вновь"},{"type":"paragraph","text":"Спасла мне жизнь — и я опять"},{"type":"paragraph","text":"Стесненной грудью мог дышать!.."},{"type":"paragraph","text":"Как рассказать, что в этот миг"},{"type":"paragraph","text":"Сбылось со мною? Кто постиг"},{"type":"paragraph","text":"Тот страх, которым поражен"},{"type":"paragraph","text":"Злодей, когда изобличен"},{"type":"paragraph","text":"В своей вине, и для него"},{"type":"paragraph","text":"Нет в оправданье ничего —"},{"type":"paragraph","text":"Лишь тот достиг бы, что со мной"},{"type":"paragraph","text":"Сбылося в миг сей роковой!"},{"type":"paragraph","text":"И страшным замыслом моя"},{"type":"paragraph","text":"Душа смутилась: в пропасть я"},{"type":"paragraph","text":"С размаха броситься готов —"},{"type":"paragraph","text":"Вдруг — слышу звон колоколов…"},{"type":"paragraph","text":"По сердцу холод пробежал,"},{"type":"paragraph","text":"Я всеми членами дрожал, —"},{"type":"paragraph","text":"Но все звучней колокола:"},{"type":"paragraph","text":"И робость душу объяла"},{"type":"paragraph","text":"Невольно; грозного Суда"},{"type":"paragraph","text":"Их звон предвестником тогда"},{"type":"paragraph","text":"Казался мне. Замолкнул он,"},{"type":"paragraph","text":"Но мыслью страшней поражен,"},{"type":"paragraph","text":"Уже не смел решиться я"},{"type":"paragraph","text":"Сорвать оковы бытия!"},{"type":"paragraph","text":"И с гор извилистой тропой"},{"type":"paragraph","text":"Схожу в раздумьи: предо мной"},{"type":"paragraph","text":"Открылись долы и поля;"},{"type":"paragraph","text":"Улыбкой дружеской земля"},{"type":"paragraph","text":"Встречала солнце — и светло,"},{"type":"paragraph","text":"Как царь, оно по небу шло,"},{"type":"paragraph","text":"И снег под ним на теме скал,"},{"type":"paragraph","text":"Как бархат пурпурный, сиял."},{"type":"paragraph","text":"И слышны вновь колокола:"},{"type":"paragraph","text":"Не знаю, вера ли вела"},{"type":"paragraph","text":"Мои шаги, иль случай был,"},{"type":"paragraph","text":"Но я уж к роще подходил,"},{"type":"paragraph","text":"Где меж дерев, ее краса,"},{"type":"paragraph","text":"Был сельский храм. Вдруг голоса"},{"type":"paragraph","text":"Вблизи услышал я и стал:"},{"type":"paragraph","text":"Аньолы голос я узнал!"},{"type":"paragraph","text":"Она рыдала — но ясней"},{"type":"paragraph","text":"Рыданья матери моей"},{"type":"paragraph","text":"Неслись ко мне; — и что очам"},{"type":"paragraph","text":"Тогда явилось? В божий храм"},{"type":"paragraph","text":"Теснились люди с двух сторон,"},{"type":"paragraph","text":"И меж толпою дев и жен"},{"type":"paragraph","text":"Не мог я скоро распознать"},{"type":"paragraph","text":"Мою рыдающую мать;"},{"type":"paragraph","text":"Но мне был слышен вопль ея,"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"И к ней рвалась душа моя!"},{"type":"paragraph","text":"И вдруг раздвинулась толпа,"},{"type":"paragraph","text":"Гляжу: приникнув у столпа,"},{"type":"paragraph","text":"Как полумертвая, она"},{"type":"paragraph","text":"Стоит недвижна и бледна;"},{"type":"paragraph","text":"И на коленах подле ней."},{"type":"paragraph","text":"Еще безжизненней, бледней,"},{"type":"paragraph","text":"Аньола!.. Сжалась грудь моя!"},{"type":"paragraph","text":"И вот в толпу врываюсь я;"},{"type":"paragraph","text":"Уж подле них; и вдруг стою —"},{"type":"paragraph","text":"Я вижу труп; я узнаю"},{"type":"paragraph","text":"В чертах недвижных мертвеца"},{"type":"paragraph","text":"Черты знакомого лица —"},{"type":"paragraph","text":"То брат! к нему… зову его…"},{"type":"paragraph","text":"Не слышит зову моего!"},{"type":"paragraph","text":"Устам коснулся — хлад могил"},{"type":"paragraph","text":"От них повеял, — я без сил"},{"type":"paragraph","text":"С ступеней пал… и у крыльца"},{"type":"paragraph","text":"Лежал мертвец близ мертвеца!"},{"type":"paragraph","text":"Очнулся я — вокруг гляжу:"},{"type":"paragraph","text":"Темно везде; и я сижу"},{"type":"paragraph","text":"На чем-то жестком, и рука"},{"type":"paragraph","text":"Мне крепко сжата; — я слегка"},{"type":"paragraph","text":"Ее приподнял… тяжела!"},{"type":"paragraph","text":"Хочу привстать — и замерла"},{"type":"paragraph","text":"Душа от страха: цепи звук"},{"type":"paragraph","text":"Внезапно слышу я вокруг!"},{"type":"paragraph","text":"Вперед напрасно рвуся я —"},{"type":"paragraph","text":"Она к стене влечет меня!"},{"type":"paragraph","text":"Зловещий звук мне все сказал:"},{"type":"paragraph","text":"Но долго я не понимал,"},{"type":"paragraph","text":"Когда и кем перенесен"},{"type":"paragraph","text":"Я был в тюрьму; — вдруг тихий стон"},{"type":"paragraph","text":"Услышал я; казалось мне,"},{"type":"paragraph","text":"Он сквозь отверстие в стене"},{"type":"paragraph","text":"Проник в тюрьму… я трепетал…"},{"type":"paragraph","text":"Знакомый голос я узнал:"},{"type":"paragraph","text":"«О, не отринь мольбы моей!"},{"type":"paragraph","text":"Я здесь умру! Я от дверей"},{"type":"paragraph","text":"Не отойду! — хоть раз один"},{"type":"paragraph","text":"Пускай еще обнимет сын"},{"type":"paragraph","text":"Свою тоскующую мать!"},{"type":"paragraph","text":"Возьми: вот злато! все отдать"},{"type":"paragraph","text":"Тебе готова!»… И теперь"},{"type":"paragraph","text":"Визжит заржавленная дверь,"},{"type":"paragraph","text":"И, мрак темницы озаря"},{"type":"paragraph","text":"Внезапно светом фонаря,"},{"type":"paragraph","text":"Тюремщик входит; с криком вслед"},{"type":"paragraph","text":"Вбегает мать — я к ней!.. но нет,"},{"type":"paragraph","text":"Уже на грудь мою, в слезах,"},{"type":"paragraph","text":"Она упала, и в очах"},{"type":"paragraph","text":"Потухла жизнь; но слышал я,"},{"type":"paragraph","text":"Как сильно билась груди ея;"},{"type":"paragraph","text":"И я горел, и я дрожал,"},{"type":"paragraph","text":"И как ребенок зарыдал."}]},{"id":"chapter-9","title":"Часть 9","content":[{"type":"paragraph","text":"Склонясь челом, недвижен, нем,"},{"type":"paragraph","text":"Я долго плакал; между тем"},{"type":"paragraph","text":"Она опомнилась опять,"},{"type":"paragraph","text":"Хотела что-то мне сказать;"},{"type":"paragraph","text":"Но я, собрав остаток сил,"},{"type":"paragraph","text":"Ее слова предупредил:"},{"type":"paragraph","text":"«Не проклинай меня! постой!"},{"type":"paragraph","text":"Укор мне смертью будет твой!"},{"type":"paragraph","text":"Но я хочу, я должен жить,"},{"type":"paragraph","text":"Чтобы слезами искупить"},{"type":"paragraph","text":"Мою вину!» — «Не проклинать"},{"type":"paragraph","text":"К тебе в тюрьму приходит мать!"},{"type":"paragraph","text":"Преступен ты — но ты мне сын!"},{"type":"paragraph","text":"Тебе судья господь один!"},{"type":"paragraph","text":"И строго не осудит он,"},{"type":"paragraph","text":"Как осудил земный закон —"},{"type":"paragraph","text":"Его умолят за тебя"},{"type":"paragraph","text":"И брата тень — и тень ея»…"},{"type":"paragraph","text":"«Чья тень? Ответствуй!» — я вскричал."},{"type":"paragraph","text":"Увы! я сердцем угадал,"},{"type":"paragraph","text":"Что мне еще удар один"},{"type":"paragraph","text":"Судьба готовила. «Мой сын, —"},{"type":"paragraph","text":"Сказала мать, — давно с тобой"},{"type":"paragraph","text":"Рассталась я; еще больной,"},{"type":"paragraph","text":"Без памяти, без чувств ты был,"},{"type":"paragraph","text":"И сам себя изобличил"},{"type":"paragraph","text":"В своей вине — и тщетно мать"},{"type":"paragraph","text":"Ее хотела оправдать:"},{"type":"paragraph","text":"Мне сына слезы не спасли!"},{"type":"paragraph","text":"Полуживого увлекли"},{"type":"paragraph","text":"Тебя от матери твоей"},{"type":"paragraph","text":"Сюда!.. Минуло много дней,"},{"type":"paragraph","text":"И, неотступная как тень,"},{"type":"paragraph","text":"Я здесь у двери каждый день,"},{"type":"paragraph","text":"Но дверь, как камень гробовой,"},{"type":"paragraph","text":"Была недвижна предо мной!»"},{"type":"paragraph","text":"«Но что ж Аньола?»… «День от дня,"},{"type":"paragraph","text":"Как нежный мирт главу клоня,"},{"type":"paragraph","text":"Когда у корня втайне он"},{"type":"paragraph","text":"Весенним червем поврежден,"},{"type":"paragraph","text":"В те дни, как все весна живит,"},{"type":"paragraph","text":"Один безжизненный стоит,"},{"type":"paragraph","text":"Его не греют небеса,"},{"type":"paragraph","text":"И не свежит его роса:"},{"type":"paragraph","text":"Так и Аньола! День и ночь"},{"type":"paragraph","text":"Она томилась; превозмочь"},{"type":"paragraph","text":"Ее печали не могли"},{"type":"paragraph","text":"Родные ласки; на земли"},{"type":"paragraph","text":"Ей было грустно; в мир иной"},{"type":"paragraph","text":"Перенеслась она душой;"},{"type":"paragraph","text":"И там опять того нашла,"},{"type":"paragraph","text":"Кого здесь другом назвала."},{"type":"paragraph","text":"Земле, как выдохшийся цвет,"},{"type":"paragraph","text":"Достался труп, — небесной нет!»"},{"type":"paragraph","text":"Умолкла мать; и я молчал,"}]},{"id":"chapter-10","title":"Часть 10","content":[{"type":"paragraph","text":"Укор преступника терзал;"},{"type":"paragraph","text":"Но я слезы не уронил,"},{"type":"paragraph","text":"Молитву тихую творил,"},{"type":"paragraph","text":"Как о страдалице, о ней"},{"type":"paragraph","text":"Я в глубине души моей."},{"type":"paragraph","text":"Мне легче стало: тишиной"},{"type":"paragraph","text":"Душа исполнилась святой;"},{"type":"paragraph","text":"И сладко было верить мне,"},{"type":"paragraph","text":"Что там, в надзвездной стороне,"},{"type":"paragraph","text":"Где безграничней и святей"},{"type":"paragraph","text":"Любовь и жизнь, где нет страстей,"},{"type":"paragraph","text":"Нет мук и слез — она и брат"},{"type":"paragraph","text":"В венцах бессмертия блестят!.."},{"type":"paragraph","text":"Но между тем свиданья час"},{"type":"paragraph","text":"Прошел, мой стране расторгнул нас,"},{"type":"paragraph","text":"Уходит мать, гремит замок —"},{"type":"paragraph","text":"И я остался одинок."},{"type":"paragraph","text":"Тянулись грустно дни; порой"},{"type":"paragraph","text":"Мой страх рукою подкупной"},{"type":"paragraph","text":"Темницу тайно растворял:"},{"type":"paragraph","text":"Я видел мать — и забывал"},{"type":"paragraph","text":"О горькой участи моей;"},{"type":"paragraph","text":"Темница самая при ней"},{"type":"paragraph","text":"Не так мрачна казалась мне:"},{"type":"paragraph","text":"Текли беседы в тишине;"},{"type":"paragraph","text":"И на закате поздних лет"},{"type":"paragraph","text":"Не позабыть мне тех бесед!"},{"type":"paragraph","text":"Лишь ими жил я, их я ждал,"},{"type":"paragraph","text":"И жизнь еще благословлял!"},{"type":"paragraph","text":"Но, помню, горестней, трудней"},{"type":"paragraph","text":"Однажды с матерью моей"},{"type":"paragraph","text":"Расстался я, как будто знал,"},{"type":"paragraph","text":"Что я навек ее терял,"},{"type":"paragraph","text":"Что и за гробом, может быть,"},{"type":"paragraph","text":"Мы с нею розно будем жить!.."},{"type":"paragraph","text":"И то пророчество души"},{"type":"paragraph","text":"Сбылось давно; в моей тиши"},{"type":"paragraph","text":"Я ждал ее: она не шла!"},{"type":"paragraph","text":"Но, окрыленна и светла,"},{"type":"paragraph","text":"Еще однажды, в вещем сне,"},{"type":"paragraph","text":"Как дух, она явилась мне."},{"type":"paragraph","text":"С тех пор никто не навестил"},{"type":"paragraph","text":"Моей тюрьмы; я дни влачил"},{"type":"paragraph","text":"Как тяжкий сон; и много лет"},{"type":"paragraph","text":"Прошло; казалось, целый свет"},{"type":"paragraph","text":"Страдальца-узника забыл;"},{"type":"paragraph","text":"Мне хлеб и воду приносил"},{"type":"paragraph","text":"Все тот же страж — и от него"},{"type":"paragraph","text":"Не ждал я больше ничего!"},{"type":"paragraph","text":"В моей темнице я не знал,"},{"type":"paragraph","text":"Была ли ночь иль день сиял,"},{"type":"paragraph","text":"Мне все равно, как будто я"},{"type":"paragraph","text":"И не видал светила дня!"},{"type":"paragraph","text":"Шли за годами годы вслед;"},{"type":"paragraph","text":"Однообразных много лет"}]},{"id":"chapter-11","title":"Часть 11","content":[{"type":"paragraph","text":"Еще провел я; и во сне"},{"type":"paragraph","text":"О вольности не снилось мне!"},{"type":"paragraph","text":"А между тем мой край родной"},{"type":"paragraph","text":"Опустошительной войной"},{"type":"paragraph","text":"Кипел везде: Наполеон"},{"type":"paragraph","text":"Писал Италии закон,"},{"type":"paragraph","text":"И волновались в ней умы; —"},{"type":"paragraph","text":"Как мертвый, в сумраке тюрьмы,"},{"type":"paragraph","text":"Я ничего не знал… но вот"},{"type":"paragraph","text":"Однажды, слышу я, падет"},{"type":"paragraph","text":"Затвор с дверей моих, потом"},{"type":"paragraph","text":"Блеснули факелы; кругом"},{"type":"paragraph","text":"Толпятся люди; в их руках"},{"type":"paragraph","text":"Сверкают ружья… тайный страх"},{"type":"paragraph","text":"Стеснил мне грудь; я трепетал —"},{"type":"paragraph","text":"Хотя как блага смерти ждал!.."},{"type":"paragraph","text":"Но не на казнь меня влекли:"},{"type":"paragraph","text":"Иноплеменники пришли"},{"type":"paragraph","text":"Свободу узнику отдать;"},{"type":"paragraph","text":"Зачем? и кто? Мне нужно ль знать!"},{"type":"paragraph","text":"Одно я знаю: может быть,"},{"type":"paragraph","text":"Мой долг того благословить,"},{"type":"paragraph","text":"С кем на свободе каждый шаг"},{"type":"paragraph","text":"Я бы оспоривал как враг!.."},{"type":"paragraph","text":"Ведут меня: вдруг свет дневной"},{"type":"paragraph","text":"На очи хлынул мне волной!"},{"type":"paragraph","text":"Я был недвижен, ослеплен,"},{"type":"paragraph","text":"Казалось мне, со всех сторон,"},{"type":"paragraph","text":"В потоках яркого огня,"},{"type":"paragraph","text":"Клубились солнцы вкруг меня;"},{"type":"paragraph","text":"Но ветер грудь мне освежал,"},{"type":"paragraph","text":"И быстро, жадно я дышал,"},{"type":"paragraph","text":"И, с каждым вздохом, к жизни вновь"},{"type":"paragraph","text":"Теснилась в грудь мою любовь!.."},{"type":"paragraph","text":"Но что мне в жизни? И к чему"},{"type":"paragraph","text":"Открылись взору моему"},{"type":"paragraph","text":"Громады гор и дол, и лес,"},{"type":"paragraph","text":"И свод безоблачных небес?"},{"type":"paragraph","text":"Меня тревожила мечта,"},{"type":"paragraph","text":"Что я в сем мире сирота!"},{"type":"paragraph","text":"И что, быть может, на земли"},{"type":"paragraph","text":"Два поколенья перешли,"},{"type":"paragraph","text":"С тех пор, как я, мертвец живой,"},{"type":"paragraph","text":"Дни вел без счета под землей…"},{"type":"paragraph","text":"Земля богата, велика,"},{"type":"paragraph","text":"Но мне на ней — ни уголка!"},{"type":"paragraph","text":"Кого искать? Куда пойду?"},{"type":"paragraph","text":"В ком утешителя найду?"},{"type":"paragraph","text":"Я только рад был одному:"},{"type":"paragraph","text":"Быть может, в отческом дому"},{"type":"paragraph","text":"Еще, как некогда, приют"},{"type":"paragraph","text":"Седины сирые найдут."},{"type":"paragraph","text":"И вот пришел я в отчий дом;"},{"type":"paragraph","text":"Он обветшал; зеленым мхом"},{"type":"paragraph","text":"Оделась кровля по краям,"}]},{"id":"chapter-12","title":"Часть 12","content":[{"type":"paragraph","text":"Лишь виноградник здесь и там"},{"type":"paragraph","text":"Еще вился, как будто он"},{"type":"paragraph","text":"Один годами пощажен."},{"type":"paragraph","text":"И умиленьем и тоской"},{"type":"paragraph","text":"Я был проникнут, и ногой"},{"type":"paragraph","text":"Вступаю робкой на крыльцо…"},{"type":"paragraph","text":"Вдруг незнакомое лицо"},{"type":"paragraph","text":"Навстречу мне; хочу назад —"},{"type":"paragraph","text":"Но мне, я слышу, говорят:"},{"type":"paragraph","text":"«Постой! возьми себе, старик!»"},{"type":"paragraph","text":"Дают мне — хлеб! я взял — и вмиг"},{"type":"paragraph","text":"Его я судорожно сжал:"},{"type":"paragraph","text":"Мне хлеб так горек не бывал!"},{"type":"paragraph","text":"Слезами жаркими омыт"},{"type":"paragraph","text":"Хлеб подаянья ядовит!"},{"type":"paragraph","text":"И край прекрасный, край родной"},{"type":"paragraph","text":"Мне стал печален как чужой,"},{"type":"paragraph","text":"И только сердцу дорог был"},{"type":"paragraph","text":"Святыней горестной могил!"},{"type":"paragraph","text":"Я к ним пригнел: уже кресты"},{"type":"paragraph","text":"Полураспались; но кусты"},{"type":"paragraph","text":"Живыми розами цвели"},{"type":"paragraph","text":"Над влажным лоном той земли,"},{"type":"paragraph","text":"Где был зарыт Аньолы прах;"},{"type":"paragraph","text":"Мечта ль была? но в их листах"},{"type":"paragraph","text":"Мне веял дух нездешних роз;"},{"type":"paragraph","text":"Казалось, ангел перенес"},{"type":"paragraph","text":"Из рая их — и не роса —"},{"type":"paragraph","text":"На них горит его слеза!"},{"type":"paragraph","text":"Над братом темный кипарис"},{"type":"paragraph","text":"Надгробной зеленью повис,"},{"type":"paragraph","text":"И был он к розам наклонен,"},{"type":"paragraph","text":"И запах розы принял он."},{"type":"paragraph","text":"Могилу матери моей"},{"type":"paragraph","text":"Густою сению ветвей"},{"type":"paragraph","text":"Роскошно явор осенял;"},{"type":"paragraph","text":"Он ветви к брату простирал —"},{"type":"paragraph","text":"И мне казалось: это мать"},{"type":"paragraph","text":"Хотела милого обнять!"},{"type":"paragraph","text":"О, для чего ж: главу мою"},{"type":"paragraph","text":"Не принял ты под сень твою!"},{"type":"paragraph","text":"Помыслил я — и тяжело"},{"type":"paragraph","text":"Мне стало вдруг; склонив чело,"},{"type":"paragraph","text":"Я к гробу матери припал,"},{"type":"paragraph","text":"И жарко, жарко лобызал"},{"type":"paragraph","text":"Сырую землю — но она"},{"type":"paragraph","text":"Казалась вдвое холодна!"},{"type":"paragraph","text":"О, если б землю ту пробить"},{"type":"paragraph","text":"Я мог слезами, может быть,"},{"type":"paragraph","text":"Они б как пламя потекли"},{"type":"paragraph","text":"И в самом прахе жизнь зажгли!"},{"type":"paragraph","text":"Тоской бесплодной утомлен,"},{"type":"paragraph","text":"Я сел на камне; чудный сон"},{"type":"paragraph","text":"Меня внезапно посетил:"},{"type":"paragraph","text":"(Не знаю, сон ли это был);"}]},{"id":"chapter-13","title":"Часть 13","content":[{"type":"paragraph","text":"Но видел я: рука с рукой,"},{"type":"paragraph","text":"Вились три тени надо мной,"},{"type":"paragraph","text":"Полунеясны, как мечты,"},{"type":"paragraph","text":"Но мне знакомы их черты:"},{"type":"paragraph","text":"Преображенных мог узнать"},{"type":"paragraph","text":"Аньолу, брата я и мать."},{"type":"paragraph","text":"И я услышал голос их,"},{"type":"paragraph","text":"Он сладкозвучен был и тих,"},{"type":"paragraph","text":"Но приговор изрек он мне,"},{"type":"paragraph","text":"Чтоб их могилы в тишине"},{"type":"paragraph","text":"Навек покинул я и вдаль"},{"type":"paragraph","text":"Понес души моей печаль;"},{"type":"paragraph","text":"Чтоб и слеза моя одна"},{"type":"paragraph","text":"Не потревожила их сна…"},{"type":"paragraph","text":"И чту я свято приговор:"},{"type":"paragraph","text":"Моей Италии с тех пор"},{"type":"paragraph","text":"Я не видал; убог и сир,"},{"type":"paragraph","text":"Я обхожу печальный мир."},{"type":"paragraph","text":"Порою тучные поля"},{"type":"paragraph","text":"Объемлю жадным взором я"},{"type":"paragraph","text":"И мыслю: если б хоть одно"},{"type":"paragraph","text":"Здесь было и мое зерно!"},{"type":"paragraph","text":"Чужое все! весь мир чужой!"},{"type":"paragraph","text":"И часто, часто хлеб дневной"},{"type":"paragraph","text":"Себе я вымолить не мог;"},{"type":"paragraph","text":"И я душою изнемог"},{"type":"paragraph","text":"Под бремем тяжкого креста:"},{"type":"paragraph","text":"Презренье, скорбь и нищета"},{"type":"paragraph","text":"В один удел достались мне,"},{"type":"paragraph","text":"Нет крова грустной седине,"},{"type":"paragraph","text":"И нагло шлет насмешку ей"},{"type":"paragraph","text":"Толпа бессмысленных детей!.."},{"type":"paragraph","text":"Примечания"},{"type":"paragraph","text":"Нищий (с. 396). — Впервые — отдельным изданием (СПб., 1830). «Нищему»"},{"type":"paragraph","text":"предшествовали поэмы «Див и Пери» (1827), развивающая мотивы поэмы Т. Мура"},{"type":"paragraph","text":"«Лалла-Рук» (1817) и Жуковского «Пери и Ангел» (1821), и «Борский» (1829)."},{"type":"paragraph","text":"Поэмы эти вызвали большое количество доброжелательных отзывов (особенно"},{"type":"paragraph","text":"поддерживал Подолинского редактор «Московского телеграфа» Н. А. Полевой) и"},{"type":"paragraph","text":"выдвинули их автора на авансцену литературного движения. До издания «Нищего»"},{"type":"paragraph","text":"Подолинский поддерживает контакты с пушкинским окружением, посещает собрания"},{"type":"paragraph","text":"А. А. Дельвига, участвует в пушкинско-дельвиговских изданиях («Северные"},{"type":"paragraph","text":"цветы», «Подснежник», «Литературная газета»). Однако творчество его вызывает"},{"type":"paragraph","text":"скептическое отношение Пушкина (см. письмо С. П. Шевырева М. П. Погодину от"},{"type":"paragraph","text":"25 февраля 1829 г. — Литературное наследство, т. 16-18. М.-Л., 1934, с. 703;"},{"type":"paragraph","text":"см. также письмо Пушкина П. А. Плетневу от апреля 1831 г., где Подолинскому"},{"type":"paragraph","text":"дана холодная оценка). Стремления ряда враждебных Пушкину и его кругу"},{"type":"paragraph","text":"литераторов противопоставить Подолинского Пушкину вызвали резко"},{"type":"paragraph","text":"отрицательную рецензию А. А. Дельвига на «Нищего» («Литературная газета»,"},{"type":"paragraph","text":"1830, т. I, Ќ19, 1 апреля; без подписи), где, в частности, говорилось:"},{"type":"paragraph","text":"«Благозвучные стихи без мыслей обнаруживают не талант поэтический, а хорошо"},{"type":"paragraph","text":"усвоенный орган слуха». Но в большинстве журналов поэма получила"},{"type":"paragraph","text":"восторженные оценки («Московский телеграф», 1830, кн. 7, ч. 32; «Северный"},{"type":"paragraph","text":"Меркурий», 1830, Ќ35; «Галатея», 1830, ч. 16 и др.). На рецензию Дельвига"},{"type":"paragraph","text":"отвечал в «Северном Меркурии» (ЌЌ49-50) М. А. Бестужев-Рюмин сатирическим"},{"type":"paragraph","text":"рассказом «Сплетница». Литературная полемика 1830 г. не может закрыть от"}]},{"id":"chapter-14","title":"Часть 14","content":[{"type":"paragraph","text":"современного читателя ни огрехов, ни поэтических достоинств поэмы"},{"type":"paragraph","text":"Подолинского. В сюжетном плане «Нищий» ориентирован на «Чернеца» Козлова,"},{"type":"paragraph","text":"форма поэмы сложилась под воздействием «Шильонского узника» Байрона —"},{"type":"paragraph","text":"Жуковского, в свою очередь, отголоски «Нищего» слышны в поэмах Лермонтова"},{"type":"paragraph","text":"«Боярин Орша», «Мцыри». Эпиграф — первая строка LXXXTV сонета Петрарки."},{"type":"paragraph","text":"Стр. 397. И слышу я: «Куда? куда?..» — полемически переосмысливается"},{"type":"paragraph","text":"общеромантический мотив мечты об Италии, выраженный в «Песне Миньоны» Гете с"},{"type":"paragraph","text":"рефреном: «Dahin, dahin!» — «Туда, туда!»"},{"type":"paragraph","text":"Стр. 400. Все впечатленья бытия — цитата из стихотворения Пушкина"},{"type":"paragraph","text":"«Демон» (1824): «В те дни, когда мне были новы // Все впечатленья бытия…»"},{"type":"paragraph","text":"Стр. 404. …и со скалы // Его я бросил в бездну мглы. — В этом месте"},{"type":"paragraph","text":"А. А. Дельвиг усмотрел реминисценцию из «Цыган» («Я в волны моря, не"},{"type":"paragraph","text":"бледнея, // И беззащитного б толкнул») и заметил, что герой Подолинского"},{"type":"paragraph","text":"«исполняет на деле ревнивое мечтание Алеко, прекрасно высказанное Пушкиным»"},{"type":"paragraph","text":"(«Литературная газета», 1830, Ќ19, 1 апреля, с. 153)."},{"type":"paragraph","text":"Стр. 405. Вдруг — слышу звон колоколов… — ср. сходный мотив в"},{"type":"paragraph","text":"«Чернеце» Козлова; позднее мотив этот полемически переосмысливается в"},{"type":"paragraph","text":"«Мцыри» Лермонтова."},{"type":"paragraph","text":"Стр. 410. Наполеон // Писал Италии закон. — Имеется в виду Итальянская"},{"type":"paragraph","text":"кампания 1796—1797 гг."},{"type":"paragraph","text":"А. С. Немзер,"},{"type":"paragraph","text":"А. М. Песков"}]}]}