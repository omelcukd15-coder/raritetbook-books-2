{"id":"makoley-virginiya","slug":"makoley-virginiya","shard":1,"title":"Виргиния","altTitles":[],"author":"Томас Бабингтон Маколей","authorShort":"Т. Б. Маколей","authorSlug":"makoley","authorYears":"","translator":"Томас Бабингтон Маколей","language":"ru","category":"foreign-classics","writtenYear":"1859","editionYear":"1859","description":"Виргиния (Т. Б. Маколей): Виргиния","historicalNote":"Проверенное издание (1859).","sourceUrl":"https://ru.wikisource.org/wiki/%D0%92%D0%B8%D1%80%D0%B3%D0%B8%D0%BD%D0%B8%D1%8F_%28%D0%9C%D0%B0%D0%BA%D0%BE%D0%BB%D0%B5%D0%B9%29","legalStatus":"Общественное достояние (PD-old; 1859)","downloadAllowed":true,"fb2Url":"/archive/books/makoley/makoley-virginiya/original.fb2","coverUrl":"/archive/books/makoley/makoley-virginiya/cover.webp","stats":{"chaptersCount":12,"wordsCount":2410,"charsCount":14432,"readingMinutes":13},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"},{"id":"chapter-9","title":"Часть 9"},{"id":"chapter-10","title":"Часть 10"},{"id":"chapter-11","title":"Часть 11"},{"id":"chapter-12","title":"Часть 12"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Виргиния"},{"type":"paragraph","text":"Песня из времён древнего Рима."},{"type":"paragraph","text":"Плебеи, люди с любящей"},{"type":"paragraph","text":"И верною душой,"},{"type":"paragraph","text":"За вас трибуны смелые"},{"type":"paragraph","text":"И вы за них — горой!"},{"type":"paragraph","text":"Ко мне, в кружок! и слушайте"},{"type":"paragraph","text":"С вниманьем мой рассказ"},{"type":"paragraph","text":"О том, что Рим терпел и что"},{"type":"paragraph","text":"Потерпит он не раз."},{"type":"paragraph","text":"Не басни расскажу я вам,"},{"type":"paragraph","text":"Как например о том,"},{"type":"paragraph","text":"Что где-то есть ключи, всегда"},{"type":"paragraph","text":"Кипящие вином,"},{"type":"paragraph","text":"О чудных косах девичьих,"},{"type":"paragraph","text":"Подобных кольцам змей,"},{"type":"paragraph","text":"О том, как были моряки"},{"type":"paragraph","text":"Превращены в свиней…"},{"type":"paragraph","text":"Нет, речь о происшествии"},{"type":"paragraph","text":"Кровавом поведу,"},{"type":"paragraph","text":"Случившемся на форуме"},{"type":"paragraph","text":"У римлян на виду."},{"type":"paragraph","text":"Тому ужь семьдесят семь лет,"},{"type":"paragraph","text":"Но старцы есть у нас,"},{"type":"paragraph","text":"Что видели тот страшный день"},{"type":"paragraph","text":"И подтвердят рассказ."},{"type":"paragraph","text":"Мы проклинаем имена"},{"type":"paragraph","text":"Всех децемвиров злых,"},{"type":"paragraph","text":"Но Аппий Клавдий[1] — самый злой"},{"type":"paragraph","text":"И худший был из них."},{"type":"paragraph","text":"Он гордо, как Тарквиний сам,"},{"type":"paragraph","text":"По форуму шагал,"},{"type":"paragraph","text":"Конвой из ликторов всегда"},{"type":"paragraph","text":"Его сопровождал,"},{"type":"paragraph","text":"Идя с секирами вокруг"},{"type":"paragraph","text":"Владыки своего."},{"type":"paragraph","text":"И разбегались граждане,"},{"type":"paragraph","text":"Завидевши его,"},{"type":"paragraph","text":"Косясь на этот низкий лоб,"},{"type":"paragraph","text":"Что вечно хмурил он,"},{"type":"paragraph","text":"На этот рот, что был всегда"},{"type":"paragraph","text":"Насмешкой искривлён…"},{"type":"paragraph","text":"И слуги стоили его:"},{"type":"paragraph","text":"Везде, где Аппий был,"},{"type":"paragraph","text":"За ним подобострастно Марк,"},{"type":"paragraph","text":"Его клиент, ходил;"},{"type":"paragraph","text":"И, шею вытянув вперёд,"},{"type":"paragraph","text":"В глаза ему смотрел,"},{"type":"paragraph","text":"Готовый тотчас исполнять"},{"type":"paragraph","text":"Всё, что патрон велел."},{"type":"paragraph","text":"Таких рабов межь греками"},{"type":"paragraph","text":"Видали мы не раз:"},{"type":"paragraph","text":"Они играют роль шутов"},{"type":"paragraph","text":"И сводников у нас,"},{"type":"paragraph","text":"За деньги дерзкая толпа"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Таких рабов кричит,"},{"type":"paragraph","text":"Когда достойный наш трибун"},{"type":"paragraph","text":"Люциний говорит."},{"type":"paragraph","text":"Где пролит мёд, наверно там"},{"type":"paragraph","text":"И мухи закишат,"},{"type":"paragraph","text":"Где падаль брошена, туда"},{"type":"paragraph","text":"И вороны летят."},{"type":"paragraph","text":"Всегда есть жадные багры,"},{"type":"paragraph","text":"Где требуха плывёт,"},{"type":"paragraph","text":"Всегда подобный господин"},{"type":"paragraph","text":"Подобных слугь найдёт."},{"type":"paragraph","text":"Обычною тревогою"},{"type":"paragraph","text":"Взволнован форум был;"},{"type":"paragraph","text":"С ужасной свитою своей"},{"type":"paragraph","text":"Там Аппий проходил."},{"type":"paragraph","text":"Случилось так на этоть раз,"},{"type":"paragraph","text":"Что тою же порой"},{"type":"paragraph","text":"Прекрасная Виргиния"},{"type":"paragraph","text":"Из школы шла домой."},{"type":"paragraph","text":"Беспечно шла она вблизи"},{"type":"paragraph","text":"Сверкающих секир,"},{"type":"paragraph","text":"Которыми был окружён"},{"type":"paragraph","text":"Надменный децемвир."},{"type":"paragraph","text":"В своей невинности резва"},{"type":"paragraph","text":"Беспечна, весела,"},{"type":"paragraph","text":"Увы! не знала девушка,"},{"type":"paragraph","text":"Что много в мире зла;"},{"type":"paragraph","text":"Не ведала, что значит в нём"},{"type":"paragraph","text":"Бесчестье и позор,"},{"type":"paragraph","text":"И непонятен был для ней"},{"type":"paragraph","text":"Мужчины наглый взор…"},{"type":"paragraph","text":"Весёлой беззаботности"},{"type":"paragraph","text":"И резвости полна,"},{"type":"paragraph","text":"Дорогой пела песенку"},{"type":"paragraph","text":"Старинную она."},{"type":"paragraph","text":"Вспорхнув из зелени хлебов"},{"type":"paragraph","text":"Так жавронок поёт,"},{"type":"paragraph","text":"Направив к ясным небесам"},{"type":"paragraph","text":"Стремительный полёт."},{"type":"paragraph","text":"И Аппий увидал её…"},{"type":"paragraph","text":"И вдруг зажгла в нём кровь"},{"type":"paragraph","text":"Проклятых этихь Клавдиев"},{"type":"paragraph","text":"Проклятая любовь."},{"type":"paragraph","text":"И к девушке свои глаза"},{"type":"paragraph","text":"Он жадно приковал"},{"type":"paragraph","text":"И взглядом коршуна её"},{"type":"paragraph","text":"Чрез форум провожал…"},{"type":"paragraph","text":"Верхи албанских тёмных гор"},{"type":"paragraph","text":"Свет утра озарил;"},{"type":"paragraph","text":"Из трубъ домов Семи Холмов"},{"type":"paragraph","text":"Дым к небу восходил;"},{"type":"paragraph","text":"Ворота города, стуча,"},{"type":"paragraph","text":"Давно ужь отперлись."},{"type":"paragraph","text":"Купцы и покупатели"},{"type":"paragraph","text":"На форум собрались, —"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"И ожил он и закипел"},{"type":"paragraph","text":"Их пестрою толпой,"},{"type":"paragraph","text":"Шумя, гудя и суетясь"},{"type":"paragraph","text":"Как пчёл жужжащий рой,"},{"type":"paragraph","text":"И громко зазвенела медь"},{"type":"paragraph","text":"У медника в руках,"},{"type":"paragraph","text":"И раздавался весело"},{"type":"paragraph","text":"Тот звон и шум в ушах;"},{"type":"paragraph","text":"Резва, игрива песенка"},{"type":"paragraph","text":"Фруктовщицы была,"},{"type":"paragraph","text":"И весело Виргиния"},{"type":"paragraph","text":"Из дома в школу шла."},{"type":"paragraph","text":"Не шла она, а прыгала"},{"type":"paragraph","text":"Под радостный напев…"},{"type":"paragraph","text":"Увы! тебе, Виргиния,"},{"type":"paragraph","text":"Краса всех римских дев!"},{"type":"paragraph","text":"Идёт она, подобная"},{"type":"paragraph","text":"Сяющей звезде,"},{"type":"paragraph","text":"Идёт она, не думая"},{"type":"paragraph","text":"О горе и стыде,"},{"type":"paragraph","text":"Всё напевая песенку"},{"type":"paragraph","text":"Старинную свою,"},{"type":"paragraph","text":"И ужь дошла до точки той,"},{"type":"paragraph","text":"Где я теперь стою."},{"type":"paragraph","text":"Как вдруг явился этоть Марк,"},{"type":"paragraph","text":"Но не таков, как был,"},{"type":"paragraph","text":"Когда с улыбкою раба"},{"type":"paragraph","text":"За Аппием ходил:"},{"type":"paragraph","text":"Теперь он гордо выступал,"},{"type":"paragraph","text":"С нахмуренным челом,"},{"type":"paragraph","text":"С надутой важностью в лице"},{"type":"paragraph","text":"И сжатым кулаком."},{"type":"paragraph","text":"И на пути Виргинию"},{"type":"paragraph","text":"Холоп остановил"},{"type":"paragraph","text":"И с дерзкой наглостью её"},{"type":"paragraph","text":"Вдруг за руку схватил."},{"type":"paragraph","text":"И закричала девушка, —"},{"type":"paragraph","text":"Был страх её велик, —"},{"type":"paragraph","text":"Народ бежал со всех сторон"},{"type":"paragraph","text":"На этот громкий крик:"},{"type":"paragraph","text":"Седой меняло Крисп, за ним —"},{"type":"paragraph","text":"Торговец Ганно тожь,"},{"type":"paragraph","text":"И Волеро мясник, держа"},{"type":"paragraph","text":"Окровавленный нож,"},{"type":"paragraph","text":"Кузнец Мурена, с полосой"},{"type":"paragraph","text":"Железною в руках…"},{"type":"paragraph","text":"Все, кто как был, к Виргинии"},{"type":"paragraph","text":"Сбежались в попыхах:"},{"type":"paragraph","text":"Все знали это милое,"},{"type":"paragraph","text":"Прекрасное дитя,"},{"type":"paragraph","text":"И кланялись ей каждый день,"},{"type":"paragraph","text":"Приветливо шутя. —"},{"type":"paragraph","text":"И здоровеннейший кузнец"},{"type":"paragraph","text":"Нанёс удар такой"},{"type":"paragraph","text":"Холопу Марку гнусному"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Тяжёлою рукой,"},{"type":"paragraph","text":"Что тот пустил Виргинию"},{"type":"paragraph","text":"И на земь полетел;"},{"type":"paragraph","text":"Однако встал, взглянул вокруг"},{"type":"paragraph","text":"И злобно прохрипел:"},{"type":"paragraph","text":"«Она моя! я требую"},{"type":"paragraph","text":"Лишь своего: она"},{"type":"paragraph","text":"Моей рабою родилась"},{"type":"paragraph","text":"И тайно продана"},{"type":"paragraph","text":"В тот год, когда был страшный мор"},{"type":"paragraph","text":"Все помнят этот год:"},{"type":"paragraph","text":"Как мухи гибнул кучами"},{"type":"paragraph","text":"Напуганный народ."},{"type":"paragraph","text":"Её украли у меня, —"},{"type":"paragraph","text":"В тот день лишились мы"},{"type":"paragraph","text":"Двух авгуров и консула,"},{"type":"paragraph","text":"Погибших от чумы."},{"type":"paragraph","text":"Теперь я Аппию служу,"},{"type":"paragraph","text":"Отцу его служил, —"},{"type":"paragraph","text":"О, горе тем, кто Клавдиев"},{"type":"paragraph","text":"Клиента оскорбил!»"},{"type":"paragraph","text":"Так говорил негодный Марк,"},{"type":"paragraph","text":"И страх всех оковал,"},{"type":"paragraph","text":"При грозном слове: «Клавдии»,"},{"type":"paragraph","text":"Народ затрепетал."},{"type":"paragraph","text":"Тогда ведь было некому"},{"type":"paragraph","text":"Вступиться за него."},{"type":"paragraph","text":"Теперь Лициний доблестный"},{"type":"paragraph","text":"И Секстий есть у нас,"},{"type":"paragraph","text":"Они спасали бедняков"},{"type":"paragraph","text":"От гибели не раз,"},{"type":"paragraph","text":"И могут слово грозное"},{"type":"paragraph","text":"За них произнести, —"},{"type":"paragraph","text":"Тогда ж весь Рим покорен был"},{"type":"paragraph","text":"Жестоким Десяти."},{"type":"paragraph","text":"Но не пришлось опять схватить"},{"type":"paragraph","text":"Клиенту-наглецу"},{"type":"paragraph","text":"Виргинию прильнувшую"},{"type":"paragraph","text":"В испуге к кузнецу:"},{"type":"paragraph","text":"Из-за безмолвных зрителей,"},{"type":"paragraph","text":"Стеснившихся толпой,"},{"type":"paragraph","text":"Пробился с нетерпением"},{"type":"paragraph","text":"Ицилий молодой."},{"type":"paragraph","text":"Он в гневе разорвал свою"},{"type":"paragraph","text":"Одежду на груди,"},{"type":"paragraph","text":"И, топнув в бешенстве ногой,"},{"type":"paragraph","text":"Стал смело впереди,"},{"type":"paragraph","text":"На столб, который многими"},{"type":"paragraph","text":"Певцами был воспет,"},{"type":"paragraph","text":"Где три заржавевших меча"},{"type":"paragraph","text":"Висят ужь с давних лет,"},{"type":"paragraph","text":"И подал знак, чтобы толпы"},{"type":"paragraph","text":"Внимание привлечь,"},{"type":"paragraph","text":"И громким, ясным голосом"},{"type":"paragraph","text":"Сказал такую речь:"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"«Квириты! заклинаю вас"},{"type":"paragraph","text":"Красой родных полей,"},{"type":"paragraph","text":"Костями ваших прадедов"},{"type":"paragraph","text":"И жизнию детей,"},{"type":"paragraph","text":"Восстаньте, чтоб избавиться"},{"type":"paragraph","text":"От тягостных оков,"},{"type":"paragraph","text":"Не то — вы вечно будете"},{"type":"paragraph","text":"Носить клеймо рабов."},{"type":"paragraph","text":"Затем ли мудрость Сервия"},{"type":"paragraph","text":"Законы нам дала"},{"type":"paragraph","text":"И кровь свою Лукреция"},{"type":"paragraph","text":"Невинно пролила?"},{"type":"paragraph","text":"..................................."},{"type":"paragraph","text":"..................................."},{"type":"paragraph","text":"Ужели дух отцов погас"},{"type":"paragraph","text":"В испорченных сынах?"},{"type":"paragraph","text":"Отцы сражались много лет"},{"type":"paragraph","text":"В защиту прав своих,"},{"type":"paragraph","text":"Мы жь потеряли всё, что нам"},{"type":"paragraph","text":"Завещано от них!"},{"type":"paragraph","text":"Всё, с бою ими взятое,"},{"type":"paragraph","text":"Исчезло точно тень,"},{"type":"paragraph","text":"И плод шестидесяти лет"},{"type":"paragraph","text":"Погиб в единый день!"},{"type":"paragraph","text":"Ликуйте же, патриции!"},{"type":"paragraph","text":"Жестокая борьба"},{"type":"paragraph","text":"Окончилась — и торжеством"},{"type":"paragraph","text":"Венчала вас судьба:"},{"type":"paragraph","text":"Сражались мы за почести —"},{"type":"paragraph","text":"Напрасная война!"},{"type":"paragraph","text":"Свободы добивалась мы —"},{"type":"paragraph","text":"Но где теперь она?"},{"type":"paragraph","text":"Ужь нет глашатаев, чтоб нас"},{"type":"paragraph","text":"На форум созывать,"},{"type":"paragraph","text":"Трибунов нет, чтоб слабого"},{"type":"paragraph","text":"От сильных защищать;"},{"type":"paragraph","text":"Под вашим гнётом преклонясь,"},{"type":"paragraph","text":"И волю и умы"},{"type":"paragraph","text":"И свой, когда-то гордый, дух —"},{"type":"paragraph","text":"Вам покорили мы!"},{"type":"paragraph","text":"Богатства, земли, блеск и власть"},{"type":"paragraph","text":"В тот злополучный час"},{"type":"paragraph","text":"Достались вам — так пусть же всё"},{"type":"paragraph","text":"Останется при вас:"},{"type":"paragraph","text":"Одежды пышные жрецов"},{"type":"paragraph","text":"И пурпур на плечах,"},{"type":"paragraph","text":"И ликторы с секирами"},{"type":"paragraph","text":"И связками в руках,"},{"type":"paragraph","text":"Курульные седалища,"},{"type":"paragraph","text":"Лавровые венки…"},{"type":"paragraph","text":"Насильно забирайте нас"},{"type":"paragraph","text":"Опять в свои полки,"},{"type":"paragraph","text":"Пусть будут ваши житницы"},{"type":"paragraph","text":"Наполнены зерном"},{"type":"paragraph","text":"Той почвы, что приобрели"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Мы собственным мечом."},{"type":"paragraph","text":"Как злая язва, что ростёт"},{"type":"paragraph","text":"Черна и глубока,"},{"type":"paragraph","text":"Пусть ваша алчность гнусная"},{"type":"paragraph","text":"Пьёт соки бедняка."},{"type":"paragraph","text":"Терзайте, мучьте вы своих"},{"type":"paragraph","text":"Несчастных должников,"},{"type":"paragraph","text":"Как некогда вы мучили,"},{"type":"paragraph","text":"Терзали их отцов,"},{"type":"paragraph","text":"В тех клетках, где так холодно"},{"type":"paragraph","text":"Суровою зимой,"},{"type":"paragraph","text":"И душно и нет воздуха"},{"type":"paragraph","text":"В палящий летний зной;"},{"type":"paragraph","text":"Где кандалы и к этому"},{"type":"paragraph","text":"Пук розог не один"},{"type":"paragraph","text":"Припасены заботливо"},{"type":"paragraph","text":"Для наших ног и спин…"},{"type":"paragraph","text":"Замучьте нас оковами,"},{"type":"paragraph","text":"Пусть льётся наша кровь,"},{"type":"paragraph","text":"Но прочь от нас жестокая"},{"type":"paragraph","text":"Патрициев любовь!"},{"type":"paragraph","text":"Или красавиц молодых"},{"type":"paragraph","text":"У вас недостаёт,"},{"type":"paragraph","text":"Которые от консулов"},{"type":"paragraph","text":"Ведут свой знатный род,"},{"type":"paragraph","text":"И созерцают, с гордою"},{"type":"paragraph","text":"Улыбкой на губах,"},{"type":"paragraph","text":"Свою надменную красу"},{"type":"paragraph","text":"В коринфских зеркалах;"},{"type":"paragraph","text":"Что в колесницах, разрядясь,"},{"type":"paragraph","text":"По улицам летят"},{"type":"paragraph","text":"И на глазеющую чернь"},{"type":"paragraph","text":"С презрением глядят?"},{"type":"paragraph","text":"Плебеев вы уже и так"},{"type":"paragraph","text":"Ограбили давно."},{"type":"paragraph","text":"Вы взяли всё почти у них —"},{"type":"paragraph","text":"Оставьте жь им одно…"},{"type":"paragraph","text":"Одно, чем жизнь их горькая"},{"type":"paragraph","text":"Становится сносней:"},{"type":"paragraph","text":"Любовь отрадную их жён,"},{"type":"paragraph","text":"Сестёр и дочерей…"},{"type":"paragraph","text":"Избавьте от позора нас,"},{"type":"paragraph","text":"Избавьте нас от той"},{"type":"paragraph","text":"Обиды неизгладимой,"},{"type":"paragraph","text":"Которая порой"},{"type":"paragraph","text":"Способна сердце робкое"},{"type":"paragraph","text":"Отвагой закалить"},{"type":"paragraph","text":"И в пламя кровь холодную"},{"type":"paragraph","text":"Ленивца превратить…"},{"type":"paragraph","text":"Когда жь у нас последняя"},{"type":"paragraph","text":"Надежда пропадёт —"},{"type":"paragraph","text":"Отчаянье в нас мужество"},{"type":"paragraph","text":"Безумное вдохнёт."},{"type":"paragraph","text":"И вы тогда узнаете,"},{"type":"paragraph","text":"Из наших страшных дел."}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"Как человек озлобленный"},{"type":"paragraph","text":"И угнетённый смел!»"},{"type":"paragraph","text":"..................................."},{"type":"paragraph","text":"Старик Виргиний подошёл:"},{"type":"paragraph","text":"Нахмуренный как ночь,"},{"type":"paragraph","text":"И тихо в сторону отвёл"},{"type":"paragraph","text":"Трепещущую дочь"},{"type":"paragraph","text":"К той арке, где багряною"},{"type":"paragraph","text":"Струёю кровь бежит,"},{"type":"paragraph","text":"И куча безобразная,"},{"type":"paragraph","text":"Рогов и кож лежит,"},{"type":"paragraph","text":"И там он взял широкий нож"},{"type":"paragraph","text":"Со стойки мясника…"},{"type":"paragraph","text":"Стеснясь, дыханье замерло"},{"type":"paragraph","text":"В груди у старика;"},{"type":"paragraph","text":"Глаза его померкнули"},{"type":"paragraph","text":"От подступивших слёз"},{"type":"paragraph","text":"И голосом прерывистым"},{"type":"paragraph","text":"Он тихо произнёс:"},{"type":"paragraph","text":"«Прощай, моё сокровище,"},{"type":"paragraph","text":"Прощай, — всему конец!"},{"type":"paragraph","text":"Ты знаешь, как любил тебя"},{"type":"paragraph","text":"Несчастный твой отец…"},{"type":"paragraph","text":"О, как любил, Виргиния!"},{"type":"paragraph","text":"Хоть я порой суров,"},{"type":"paragraph","text":"Но для тебя, дитя моё,"},{"type":"paragraph","text":"Я не бывал таков."},{"type":"paragraph","text":"И ты любила старика:"},{"type":"paragraph","text":"Я помню, прошлый год,"},{"type":"paragraph","text":"Когда вернулся я домой."},{"type":"paragraph","text":"Окончив свой поход,"},{"type":"paragraph","text":"Как ты на встречу бросилась,"},{"type":"paragraph","text":"Обрадовавшись, мне!"},{"type":"paragraph","text":"Мой меч тяжёлый убрала,"},{"type":"paragraph","text":"Повесив на стене;"},{"type":"paragraph","text":"Как раздавался весело"},{"type":"paragraph","text":"Твой звонкий голосок!"},{"type":"paragraph","text":"Как прыгала ты, видя мой"},{"type":"paragraph","text":"Цивический венок!"},{"type":"paragraph","text":"Теперь — исчезло всё: твой смех,"},{"type":"paragraph","text":"Твой ласковый привет,"},{"type":"paragraph","text":"Твоё шитьё, твой разговор"},{"type":"paragraph","text":"И песни древних лет:"},{"type":"paragraph","text":"Никто не будет горевать,"},{"type":"paragraph","text":"Прощаяся со мной,"},{"type":"paragraph","text":"Иль улыбаться радостно,"},{"type":"paragraph","text":"Когда вернусь домой,"},{"type":"paragraph","text":"Иль у постели старика"},{"type":"paragraph","text":"Сидеть в тиши ночей,"},{"type":"paragraph","text":"Иль тихо слёзы проливать"},{"type":"paragraph","text":"Над урною моей…"},{"type":"paragraph","text":"И будет пуст и мрачен мой"},{"type":"paragraph","text":"Осиротевший дом,"},{"type":"paragraph","text":"Не будет слышно голоса"},{"type":"paragraph","text":"Моей голубки в нём,"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"И для него свет глаз твоих"},{"type":"paragraph","text":"Угаснет навсегда…"},{"type":"paragraph","text":"Взгляни, как Аппий устремил"},{"type":"paragraph","text":"Свой жадный взор сюда!"},{"type":"paragraph","text":"Вот он рукою указал…"},{"type":"paragraph","text":"Глаза его горят,"},{"type":"paragraph","text":"Как будто скорбию твоей"},{"type":"paragraph","text":"Насытиться хотят."},{"type":"paragraph","text":"В слепой надменности своей"},{"type":"paragraph","text":"Не ведает глупец."},{"type":"paragraph","text":"Что презренный, обиженный,"},{"type":"paragraph","text":"Поруганный отец"},{"type":"paragraph","text":"Ещё имееть у себя"},{"type":"paragraph","text":"Прибежище одно,"},{"type":"paragraph","text":"Что над тобой торжествовать"},{"type":"paragraph","text":"Тирану не дано,"},{"type":"paragraph","text":"Что я могу избавить дочь"},{"type":"paragraph","text":"От участи рабов —"},{"type":"paragraph","text":"От грубаго ругательства,"},{"type":"paragraph","text":"Побоев и толчков"},{"type":"paragraph","text":"И от того, что хуже их…"},{"type":"paragraph","text":"О! этого стыда"},{"type":"paragraph","text":"Не знала ты, дитя, и знать"},{"type":"paragraph","text":"Не будешь никогда!"},{"type":"paragraph","text":"Прижмись ко мне, и поцелуй"},{"type":"paragraph","text":"Меня в последний раз!"},{"type":"paragraph","text":"Теперь, дитя моё, одно"},{"type":"paragraph","text":"Осталося для нас…»"},{"type":"paragraph","text":"И вдруг, подняв свой нож, старик"},{"type":"paragraph","text":"Её ударил в бок,"},{"type":"paragraph","text":"И, вся в крови, Виргиния"},{"type":"paragraph","text":"Упала на песок."},{"type":"paragraph","text":"Тогда, на миг один, народ"},{"type":"paragraph","text":"Дыханье притаил,"},{"type":"paragraph","text":"Как будто форум вдругь объят"},{"type":"paragraph","text":"Молчаньем смерти был;"},{"type":"paragraph","text":"Потом пронёсся, точно гром,"},{"type":"paragraph","text":"Всеобший крик над ним,"},{"type":"paragraph","text":"Как будто Волски ворвались"},{"type":"paragraph","text":"Внезапно в самый Рим."},{"type":"paragraph","text":"Кто в страхе побежал домой,"},{"type":"paragraph","text":"Кто — лекаря позвать,"},{"type":"paragraph","text":"Толпа к убитой бросилась,"},{"type":"paragraph","text":"Чтоб помощь оказать."},{"type":"paragraph","text":"Кто трогал, слушал, чтоб открыть"},{"type":"paragraph","text":"Хоть искру жизни в ней,"},{"type":"paragraph","text":"Кто рану ей обвязывал"},{"type":"paragraph","text":"Одеждою своей…"},{"type":"paragraph","text":"Напрасно хлопотали все"},{"type":"paragraph","text":"И суетились там:"},{"type":"paragraph","text":"Увы! не дрогнула рука,"},{"type":"paragraph","text":"Привыкшая к боям."},{"type":"paragraph","text":"Сам Аппий Клавдий поражён"},{"type":"paragraph","text":"Был зрелищем таким,"},{"type":"paragraph","text":"Он вздрогнул и закрыл себе"}]},{"id":"chapter-9","title":"Часть 9","content":[{"type":"paragraph","text":"Глаза плащом своимъ"},{"type":"paragraph","text":"И в онемении стоял."},{"type":"paragraph","text":"Согнувшись, наконец,"},{"type":"paragraph","text":"К нему, шатаясь, подошёл"},{"type":"paragraph","text":"Озлобленный отец."},{"type":"paragraph","text":"И пред курульною скамьёй"},{"type":"paragraph","text":"Виргиний стал, и там"},{"type":"paragraph","text":"Свой кровью обагрённый нож"},{"type":"paragraph","text":"Он поднял к небесам:"},{"type":"paragraph","text":"«О, боги преисподних стран,"},{"type":"paragraph","text":"Где вечный мрак живёт,"},{"type":"paragraph","text":"К вам эта дорогая кровь"},{"type":"paragraph","text":"О мщеньи вопиёт!"},{"type":"paragraph","text":"Тиран нанёс мне, старику,"},{"type":"paragraph","text":"Бесчестье и позор,"},{"type":"paragraph","text":"Постановите же над ним"},{"type":"paragraph","text":"Свой правый приговор:"},{"type":"paragraph","text":"Как Аппий Клавдий погубил"},{"type":"paragraph","text":"Ребёнка моего,"},{"type":"paragraph","text":"Так погубите Аппия"},{"type":"paragraph","text":"И подлый род его!»"},{"type":"paragraph","text":"Так опозоренный отец"},{"type":"paragraph","text":"О мщении взывал,"},{"type":"paragraph","text":"И бросил изступлённый взор"},{"type":"paragraph","text":"Туда, где труп лежал,"},{"type":"paragraph","text":"И испустил он страшный стон,"},{"type":"paragraph","text":"И с сумрачным челом"},{"type":"paragraph","text":"Пошёл чрез площадь шумную"},{"type":"paragraph","text":"В свой опустевший дом."},{"type":"paragraph","text":"Очнулся Аппий Клавдий вдруг"},{"type":"paragraph","text":"От страха своего:"},{"type":"paragraph","text":"«Я десять тысяч меди дам"},{"type":"paragraph","text":"За голову его!»"},{"type":"paragraph","text":"И на клиентов он взглянул —"},{"type":"paragraph","text":"Недвижно те стоят;"},{"type":"paragraph","text":"Взглянул на ликторов — они"},{"type":"paragraph","text":"Бледнеют и дрожат."},{"type":"paragraph","text":"Меж тем Виргиний молча шёлъ"},{"type":"paragraph","text":"К жилищу своему,"},{"type":"paragraph","text":"И расступалася толпа,"},{"type":"paragraph","text":"Чтоб место дать ему;"},{"type":"paragraph","text":"И тотчас севши на коня,"},{"type":"paragraph","text":"Он в лагерь поскакал,"},{"type":"paragraph","text":"И обо всём случившемся"},{"type":"paragraph","text":"Там войску рассказал."},{"type":"paragraph","text":"Толпа росла, как раннею"},{"type":"paragraph","text":"Весной поток ростёт,"},{"type":"paragraph","text":"И приливал со всех сторон"},{"type":"paragraph","text":"Взволнованный народ."},{"type":"paragraph","text":"А возле тела девушки"},{"type":"paragraph","text":"Собрался тесный круг"},{"type":"paragraph","text":"Друзей, родных Виргинии"},{"type":"paragraph","text":"И дорогих подруг;"},{"type":"paragraph","text":"Оне носилки принесли,"},{"type":"paragraph","text":"Заботливо потом"}]},{"id":"chapter-10","title":"Часть 10","content":[{"type":"paragraph","text":"Ветвями кипарисными"},{"type":"paragraph","text":"Убрали их кругом,"},{"type":"paragraph","text":"И бережно, как мать кладёт"},{"type":"paragraph","text":"Ребёнка в колыбель,"},{"type":"paragraph","text":"Переложили девушку,"},{"type":"paragraph","text":"На смертную постель…"},{"type":"paragraph","text":"И Аппий вдруг нахмурился"},{"type":"paragraph","text":"И побагровел весь,"},{"type":"paragraph","text":"И закричал: «что делает"},{"type":"paragraph","text":"Вся эта сволочь здесь?"},{"type":"paragraph","text":"Иль дома нет забот у них,"},{"type":"paragraph","text":"Чтоб шляться день и ночь?"},{"type":"paragraph","text":"Эй, ликторы! прогнать толпу,"},{"type":"paragraph","text":"Да труп возьмите прочь!»"},{"type":"paragraph","text":"До этих пор народ свой гнев"},{"type":"paragraph","text":"Не громко выражал,"},{"type":"paragraph","text":"Лишь ропот сдержанный, глухой"},{"type":"paragraph","text":"В толпе перебегал."},{"type":"paragraph","text":"Когдажь двенадцать ликторов,"},{"type":"paragraph","text":"Всех граждан бич и страх,"},{"type":"paragraph","text":"По слову Аппия, пошли"},{"type":"paragraph","text":"С секирами в руках,"},{"type":"paragraph","text":"То форум так забушевал,"},{"type":"paragraph","text":"Что никогда на нёмъ"},{"type":"paragraph","text":"Такого шума не было"},{"type":"paragraph","text":"Ни прежде, ни потом."},{"type":"paragraph","text":"Проклятья, вопли, стоны, крик…"},{"type":"paragraph","text":"Весь этот страшный гром"},{"type":"paragraph","text":"Был слышен за заставами,"},{"type":"paragraph","text":"За Пинцийским холмом."},{"type":"paragraph","text":"Но возле тела, где стоял"},{"type":"paragraph","text":"Угрюмо тесный круг"},{"type":"paragraph","text":"Родных убитой девушки,"},{"type":"paragraph","text":"И близких и подруг, —"},{"type":"paragraph","text":"Всё было тихо, не смотря"},{"type":"paragraph","text":"На гвалт со всех сторон;"},{"type":"paragraph","text":"Ни разу там не вырвался"},{"type":"paragraph","text":"Ни крик, ни громкий стон, —"},{"type":"paragraph","text":"Но гнев и скорбь глубокая"},{"type":"paragraph","text":"Заметны были там"},{"type":"paragraph","text":"По сдержанному шопоту,"},{"type":"paragraph","text":"По сдвинутым, бровям."},{"type":"paragraph","text":"Счастливы были ликторы,"},{"type":"paragraph","text":"Что им не удалось"},{"type":"paragraph","text":"Пробиться к трупу: иначе"},{"type":"paragraph","text":"Им плохо бы пришлось."},{"type":"paragraph","text":"И рады были ужь они,"},{"type":"paragraph","text":"Что вырвалися вновь"},{"type":"paragraph","text":"Из этой свалки, хоть ручьём"},{"type":"paragraph","text":"С их лиц бежала кровь…"},{"type":"paragraph","text":"От их секир осталися"},{"type":"paragraph","text":"Лишь щепки в их руках,"},{"type":"paragraph","text":"Их платье грязным рубищем"},{"type":"paragraph","text":"Висело на плечах."},{"type":"paragraph","text":"И Аппий губы закусил"}]},{"id":"chapter-11","title":"Часть 11","content":[{"type":"paragraph","text":"И страшно побледнел"},{"type":"paragraph","text":"И трижды подал знак рукой"},{"type":"paragraph","text":"И говорить хотел."},{"type":"paragraph","text":"Но крики бешеной толпы"},{"type":"paragraph","text":"В ответ ему неслись:"},{"type":"paragraph","text":"«Взгляни, что сделал с нами ты —"},{"type":"paragraph","text":"И в тартар провались!"},{"type":"paragraph","text":"Ты женщин в рабство хочешь взять,"},{"type":"paragraph","text":"Возьми мужчин вперёд!"},{"type":"paragraph","text":"Прочь десять, прочь! трибунов нам!»"},{"type":"paragraph","text":"Ярясь кричал народ."},{"type":"paragraph","text":"И вдруг осыпали, как град,"},{"type":"paragraph","text":"Как тучи стрел в бою,"},{"type":"paragraph","text":"Поленья, камни, кирпичи"},{"type":"paragraph","text":"Курульную скамью."},{"type":"paragraph","text":"И ужас Аппия объял,"},{"type":"paragraph","text":"Забилось сердце в нём:"},{"type":"paragraph","text":"Трусливо племя Клавдиев,"},{"type":"paragraph","text":"Лишь стыд им ни по чём."},{"type":"paragraph","text":"Нас важные фамилии"},{"type":"paragraph","text":"Не любят, но они,"},{"type":"paragraph","text":"За исключением одной,"},{"type":"paragraph","text":"Все храбры на войне."},{"type":"paragraph","text":"Таков был Кай Королан:"},{"type":"paragraph","text":"Пред лагерным огнём"},{"type":"paragraph","text":"О славе, бедствиях его"},{"type":"paragraph","text":"Доныне мы поём;"},{"type":"paragraph","text":"Под игом Фурия не раз"},{"type":"paragraph","text":"Был Туск и Галл смирён…"},{"type":"paragraph","text":"Рим может вынесть гордость тех,"},{"type":"paragraph","text":"Кем сам гордится он."},{"type":"paragraph","text":"Но Клавдий, подлый трус, в бою"},{"type":"paragraph","text":"Трепещет и дрожит,"},{"type":"paragraph","text":"Как девочка бледнеет он,"},{"type":"paragraph","text":"Завидев меч и щит;"},{"type":"paragraph","text":"Он в городских стенах свои"},{"type":"paragraph","text":"Трумфы получил,"},{"type":"paragraph","text":"Не вражьи, наши шеи он"},{"type":"paragraph","text":"Ярмом своим давил."},{"type":"paragraph","text":"Косс прыгает как дикий кот"},{"type":"paragraph","text":"В лицо врагов своих,"},{"type":"paragraph","text":"А Фабий? Как гонимый вепрь"},{"type":"paragraph","text":"Бросается на них."},{"type":"paragraph","text":"Но подлый Клавдий не таков:"},{"type":"paragraph","text":"Он точно пёс ворчит"},{"type":"paragraph","text":"И лает на бегущего,"},{"type":"paragraph","text":"От сильного жь бежит."},{"type":"paragraph","text":"Так было с Аппием. Когда"},{"type":"paragraph","text":"Град камней стал летать,"},{"type":"paragraph","text":"Он задрожал и съёжился,"},{"type":"paragraph","text":"И руки стал ломать."},{"type":"paragraph","text":"«Спасите, братья-ликторы!"},{"type":"paragraph","text":"Клиенты-земляки,"},{"type":"paragraph","text":"Скорей домой! не то меня"},{"type":"paragraph","text":"Чернь изорвёт в куски.»"}]},{"id":"chapter-12","title":"Часть 12","content":[{"type":"paragraph","text":"Так он вопил, и подняли"},{"type":"paragraph","text":"На шею на свою"},{"type":"paragraph","text":"Четыре дюжих ликтора"},{"type":"paragraph","text":"Курульную скамью,"},{"type":"paragraph","text":"Клиенты, сжатою толпой,"},{"type":"paragraph","text":"Стеснилися кругомъ-"},{"type":"paragraph","text":"И двинулися с палками,"},{"type":"paragraph","text":"С мечами на пролом."},{"type":"paragraph","text":"Но и без палок и мечей"},{"type":"paragraph","text":"Так бешен был народ,"},{"type":"paragraph","text":"Что свита Аппия с трудом"},{"type":"paragraph","text":"Могла идти вперёд."},{"type":"paragraph","text":"Толпа с ожесточением"},{"type":"paragraph","text":"Кидалась на него,"},{"type":"paragraph","text":"Чтобы на части разорвать его —"},{"type":"paragraph","text":"Тирана своего."},{"type":"paragraph","text":"И камни полетели вновь,"},{"type":"paragraph","text":"И яростен и дик,"},{"type":"paragraph","text":"«Трибунов нам, трибунов намъ?»"},{"type":"paragraph","text":"Звучал всё громче крик."},{"type":"paragraph","text":"Скамья качалась над толпой."},{"type":"paragraph","text":"Как в бурю мелкий чолн"},{"type":"paragraph","text":"Над бездной Адриатики,"},{"type":"paragraph","text":"Средь возмущённых волн,"},{"type":"paragraph","text":"Когда Мыс Грома чёрной мглой"},{"type":"paragraph","text":"И тучами одет,"},{"type":"paragraph","text":"И в брызгах пены пропадёт"},{"type":"paragraph","text":"Вех калабрийских след."},{"type":"paragraph","text":"Два камня Аппию в лицо"},{"type":"paragraph","text":"Попали с двух сторон,"},{"type":"paragraph","text":"И к дому на полупути"},{"type":"paragraph","text":"Ужь чувств лишился он."},{"type":"paragraph","text":"И голова проклятая,"},{"type":"paragraph","text":"Что не привык он гнуть,"},{"type":"paragraph","text":"Качалась как у пьяного"},{"type":"paragraph","text":"И свесилась на грудь."},{"type":"paragraph","text":"Когда же принесли его"},{"type":"paragraph","text":"Приверженцы домой,"},{"type":"paragraph","text":"Недвижным трупом он лежал"},{"type":"paragraph","text":"С разбитой головой…"},{"type":"paragraph","text":"Перевод: Д. Михаловского"},{"type":"paragraph","text":"Оригинал здесь — http://www.m-words.ru/author.php?id=20&poem=899"}]}]}