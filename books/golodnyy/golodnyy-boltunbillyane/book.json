{"id":"golodnyy-boltunbillyane","slug":"golodnyy-boltunbillyane","shard":1,"title":"Болтунбилльяне","altTitles":[],"author":"Михаил Семенович Голодный","authorShort":"М. С. Голодный","authorSlug":"golodnyy","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1933","editionYear":"1933","description":"Мих. Голодный","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%91%D0%BE%D0%BB%D1%82%D1%83%D0%BD%D0%B1%D0%B8%D0%BB%D0%BB%D1%8C%D1%8F%D0%BD%D0%B5_%28%D0%93%D0%BE%D0%BB%D0%BE%D0%B4%D0%BD%D1%8B%D0%B9%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1933)","downloadAllowed":true,"fb2Url":"/archive/books/golodnyy/golodnyy-boltunbillyane/original.fb2","coverUrl":"/archive/books/golodnyy/golodnyy-boltunbillyane/cover.webp","stats":{"chaptersCount":4,"wordsCount":551,"charsCount":3554,"readingMinutes":3},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Мих. Голодный"},{"type":"paragraph","text":"Болтунбилльяне"},{"type":"paragraph","text":"Отрывок из поэмы «Романтическое путешествие» 1 )"},{"type":"paragraph","text":"В городе Болтумбилле"},{"type":"paragraph","text":"— Который год! —"},{"type":"paragraph","text":"Конференция болтунбилль-"},{"type":"paragraph","text":"ян идет."},{"type":"paragraph","text":"Над городом"},{"type":"paragraph","text":"Эмблемы болтунбилльян"},{"type":"paragraph","text":"Бог, Собственность, Семья."},{"type":"paragraph","text":"У болтунбилльян"},{"type":"paragraph","text":"Висят языки"},{"type":"paragraph","text":"Двенадцать"},{"type":"paragraph","text":"Сантиметров длины,"},{"type":"paragraph","text":"И сразу"},{"type":"paragraph","text":"При слове «большевики»"},{"type":"paragraph","text":"На них закипает"},{"type":"paragraph","text":"Пена слюны."},{"type":"paragraph","text":"Мое — кричат."},{"type":"paragraph","text":"Они — моя!"},{"type":"paragraph","text":"Моя кровать!"},{"type":"paragraph","text":"Моя семья!"},{"type":"paragraph","text":"Мои хлеба!"},{"type":"paragraph","text":"Моя свинья!"},{"type":"paragraph","text":"Моя корова!"},{"type":"paragraph","text":"Жена моя!"},{"type":"paragraph","text":"Виват — радуйтесь —"},{"type":"paragraph","text":"Болтунбилльяне!"},{"type":"paragraph","text":"Новый год"},{"type":"paragraph","text":"Вас не обманет."},{"type":"paragraph","text":"Болтунбилльяве."},{"type":"paragraph","text":"Христиане,"},{"type":"paragraph","text":"Виват!"},{"type":"paragraph","text":"Да здравствует процветанье!"},{"type":"paragraph","text":"От Франции — делегат,"},{"type":"paragraph","text":"От Британии — делегат,"},{"type":"paragraph","text":"От папы римского —"},{"type":"paragraph","text":"Ладзинни легат."},{"type":"paragraph","text":"Барон фон Бер-Босс"},{"type":"paragraph","text":"И Герр-Демократ"},{"type":"paragraph","text":"С ученым Мумие"},{"type":"paragraph","text":"Рядом сидят."},{"type":"paragraph","text":"«Милорды."},{"type":"paragraph","text":"Первый вопрос — о Семье."},{"type":"paragraph","text":"Будет докладывать"},{"type":"paragraph","text":"Профессор Мумие»."},{"type":"paragraph","text":"На павиана"},{"type":"paragraph","text":"Похож в полутьме."},{"type":"paragraph","text":"Речь начинает"},{"type":"paragraph","text":"Профессор Мумие."},{"type":"paragraph","text":"— Гип! Гип!"},{"type":"paragraph","text":"Да живет процветанье!"},{"type":"paragraph","text":"Профессор Мумие"},{"type":"paragraph","text":"Нас не обмапет!"},{"type":"paragraph","text":"Болтунбилльяне,"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Христиане,"},{"type":"paragraph","text":"Открывается заседанье."},{"type":"paragraph","text":"Милорды,"},{"type":"paragraph","text":"Доклад на живом материале."},{"type":"paragraph","text":"Цифры представил"},{"type":"paragraph","text":"Коллега Бер."},{"type":"paragraph","text":"Быт и семья в"},{"type":"paragraph","text":"В Мариентале 2 ."},{"type":"paragraph","text":"Он рядом."},{"type":"paragraph","text":"Беру его как пример."},{"type":"paragraph","text":"На тысячу — в городе"},{"type":"paragraph","text":"Двадцать семь —"},{"type":"paragraph","text":"Работают молча."},{"type":"paragraph","text":"Не зная зачем."},{"type":"paragraph","text":"Все остальные"},{"type":"paragraph","text":"Пять лет без работы."},{"type":"paragraph","text":"Плодят кретинов,"},{"type":"paragraph","text":"Растят идиотов."},{"type":"paragraph","text":"Люди там ходят"},{"type":"paragraph","text":"Еле-еле,"},{"type":"paragraph","text":"Чтоб не сносилась"},{"type":"paragraph","text":"Рубашка на теле."},{"type":"paragraph","text":"А те, кому ноги свои"},{"type":"paragraph","text":"Надоели."},{"type":"paragraph","text":"Лежат в постели"},{"type":"paragraph","text":"По три недели."},{"type":"paragraph","text":"Кошачье мясо"},{"type":"paragraph","text":"Идет на обед,"},{"type":"paragraph","text":"Собачий жир —"},{"type":"paragraph","text":"На лампадный свет."},{"type":"paragraph","text":"По праздникам сходятся"},{"type":"paragraph","text":"В скучном споре"},{"type":"paragraph","text":"Члены лиги"},{"type":"paragraph","text":"«За крематорий»."},{"type":"paragraph","text":"Кто высох, как щепка,"},{"type":"paragraph","text":"Кто страшно распух,"},{"type":"paragraph","text":"От скуки"},{"type":"paragraph","text":"Волосы лезут, как пух."},{"type":"paragraph","text":"В окна глазея"},{"type":"paragraph","text":"На вялых мух,"},{"type":"paragraph","text":"Дети теряют"},{"type":"paragraph","text":"Зренье и слух."},{"type":"paragraph","text":"Не спешат они,"},{"type":"paragraph","text":"Копошась у руин,"},{"type":"paragraph","text":"За год был встречен"},{"type":"paragraph","text":"Бегущий один."},{"type":"paragraph","text":"Потом оказалось:"},{"type":"paragraph","text":"Без признаков речи"},{"type":"paragraph","text":"Метался по городу"},{"type":"paragraph","text":"Сумасшедший."},{"type":"paragraph","text":"В Мариентале"},{"type":"paragraph","text":"Не знают газет."},{"type":"paragraph","text":"Мыслям мучителен этот бред."},{"type":"paragraph","text":"Один журнал —"},{"type":"paragraph","text":"За пятилетье."}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Был обнаружен —"},{"type":"paragraph","text":"Увы! — в клозете."},{"type":"paragraph","text":"Теряются в семьях"},{"type":"paragraph","text":"Признаки пола,"},{"type":"paragraph","text":"Встречались их женщины"},{"type":"paragraph","text":"В ваших селах."},{"type":"paragraph","text":"Но, к сожаленью,"},{"type":"paragraph","text":"Убитые ленью."},{"type":"paragraph","text":"Они не способны"},{"type":"paragraph","text":"К деторожденью."},{"type":"paragraph","text":"А общий вывод,"},{"type":"paragraph","text":"А общий дебет?"},{"type":"paragraph","text":"У нас и у них —"},{"type":"paragraph","text":"Равно плоховато."},{"type":"paragraph","text":"На десять здоровых —"},{"type":"paragraph","text":"Венериков девять."},{"type":"paragraph","text":"На сотню рогатых —"},{"type":"paragraph","text":"Сотня рогатых."},{"type":"paragraph","text":"Милорды,"},{"type":"paragraph","text":"Спасайте нашу Семью."},{"type":"paragraph","text":"Я предлагаю"},{"type":"paragraph","text":"Мою статью."},{"type":"paragraph","text":"Она на опыте"},{"type":"paragraph","text":"Мариенталя"},{"type":"paragraph","text":"В параграф устава"},{"type":"paragraph","text":"Вносит детали."},{"type":"paragraph","text":"Первое —"},{"type":"paragraph","text":"Это ручной труд:"},{"type":"paragraph","text":"Машины — нас к гибели ведут."},{"type":"paragraph","text":"Второе:"},{"type":"paragraph","text":"Согласно всех прав конституций,"},{"type":"paragraph","text":"Огосударствите"},{"type":"paragraph","text":"Дома проституции!"},{"type":"paragraph","text":"Гип! Гип!"},{"type":"paragraph","text":"Да живет процветанье!"},{"type":"paragraph","text":"Профессор Мумие"},{"type":"paragraph","text":"Нас не обманет!"},{"type":"paragraph","text":"Болтунбилльяне,"},{"type":"paragraph","text":"Христиане,"},{"type":"paragraph","text":"Продолжается заседание."},{"type":"paragraph","text":"Двадцать седьмой год."},{"type":"paragraph","text":"Тридцатый год."},{"type":"paragraph","text":"На улицы вышел"},{"type":"paragraph","text":"Год тридцать третий."},{"type":"paragraph","text":"Растет событий"},{"type":"paragraph","text":"Водоворот —"},{"type":"paragraph","text":"У болтунбилльянцев"},{"type":"paragraph","text":"Спор о бюджете."},{"type":"paragraph","text":"Прогресс идет"},{"type":"paragraph","text":"Полным ходом назад."},{"type":"paragraph","text":"На выход из кризиса"},{"type":"paragraph","text":"Нет надежды."},{"type":"paragraph","text":"Скончался от астмы Герр-Демократ."},{"type":"paragraph","text":"Болтунбилльянцы."},{"type":"paragraph","text":"Заседают как прежде."}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Растет на фашистов"},{"type":"paragraph","text":"Продажа и спрос."},{"type":"paragraph","text":"Интеллигенция —"},{"type":"paragraph","text":"На коленях."},{"type":"paragraph","text":"Бер-Боссу сифилис"},{"type":"paragraph","text":"Выгрыз нос,"},{"type":"paragraph","text":"Болтунбилльянцы"},{"type":"paragraph","text":"Потеют в преньях."},{"type":"paragraph","text":"На глазах у голодных"},{"type":"paragraph","text":"Топят зерно."},{"type":"paragraph","text":"Профиль войны"},{"type":"paragraph","text":"Встает в тумане."},{"type":"paragraph","text":"От желтухи"},{"type":"paragraph","text":"Ладзинни издох давно."},{"type":"paragraph","text":"Болтунбилльянцы"},{"type":"paragraph","text":"На заседанье."},{"type":"paragraph","text":"Перерождаются"},{"type":"paragraph","text":"В каждой семье,"},{"type":"paragraph","text":"Хромая буржуйка"},{"type":"paragraph","text":"Рождает косую."},{"type":"paragraph","text":"Сошел с ума."},{"type":"paragraph","text":"Меланхолик Мумме —"},{"type":"paragraph","text":"Болтунбилльянцы"},{"type":"paragraph","text":"Голосуют."},{"type":"paragraph","text":"Европа в сумерках"},{"type":"paragraph","text":"Рычит от мук."},{"type":"paragraph","text":"Наука — в тюрьме."},{"type":"paragraph","text":"Искусство — в яме."},{"type":"paragraph","text":"Треть делегатов"},{"type":"paragraph","text":"Без правых рук —"},{"type":"paragraph","text":"Болтунбилльянцы"},{"type":"paragraph","text":"Голосуют ногами."},{"type":"paragraph","text":"Германия в ранах,"},{"type":"paragraph","text":"Еле жива."},{"type":"paragraph","text":"Идет наступленье"},{"type":"paragraph","text":"Фашистских партий."},{"type":"paragraph","text":"Из ушей делегатов"},{"type":"paragraph","text":"Лезет трава —"},{"type":"paragraph","text":"Болтунбилльянцы"},{"type":"paragraph","text":"Хрипят в азарте."},{"type":"paragraph","text":"Гип! Гип!"},{"type":"paragraph","text":"Да живет процветанье!"},{"type":"paragraph","text":"Новый год"},{"type":"paragraph","text":"Нас не обманет!"},{"type":"paragraph","text":"Болтунбилльяне,"},{"type":"paragraph","text":"Христиане,"},{"type":"paragraph","text":"Продолжается"},{"type":"paragraph","text":"Заседанье."},{"type":"paragraph","text":"1 ) Поэма полностью выйдет в журн. «Красная новь»."},{"type":"paragraph","text":"2 Город рядом с Болтунбиллем."}]}]}